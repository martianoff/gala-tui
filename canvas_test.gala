package gala_tui

import (
    "martianoff/gala/stream"
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Canvas — sub-cell shape rendering.
//
// The claims worth testing here are geometric, not textual: does a dot land
// in the cell it should, does a line actually connect its endpoints, does a
// shape drawn outside the bounds clip instead of wrapping. Asserting "the
// output is non-empty" would pass for a canvas that plots everything in the
// top-left corner.
// ============================================================================

func unitBounds() Bounds = XBounds(0.0, 1.0)

func canvasBuf(w Widget, width int, height int) *Buffer {
    val buf = NewBuffer(width, height)
    RenderTo(w, Rect(X = 0, Y = 0, Width = width, Height = height), buf)
    return buf
}

// litCellsIn counts cells carrying a non-space glyph in columns [x0, x1),
// down to `height` rows. The column range is what lets a test ask "did this
// shape put more ink on the right than the left" without hand-rolling the
// walk each time.
func litCellsIn(buf *Buffer, x0 int, x1 int, height int) int =
    stream.Range(0, height)
        .FlatMap((y) => stream.Range(x0, x1).Map((x) => buf.Get(x, y).Ch))
        .Filter((c) => c != ' ')
        .Count()

// litCells counts cells carrying a non-space glyph.
func litCells(buf *Buffer, width int, height int) int = litCellsIn(buf, 0, width, height)

// shapeCanvas renders one shape over `w` x `h` cells of unit bounds.
func shapeCanvas(s Shape, w int, h int) *Buffer =
    canvasBuf(CanvasOf(unitBounds(), unitBounds(), ArrayOf[Shape](s)), w, h)

// ----------------------------------------------------------------------------
// Projection — a point lands in the cell its coordinates name
// ----------------------------------------------------------------------------

func TestPointProjectsIntoTheExpectedCell(t T) T {
    // Braille packs 2x4 dots per cell, so on a 4x2 pane the grid is 8x8.
    // (0.0, 1.0) is the top-left corner and must light cell (0, 0).
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.0, Y = 1.0)),
            Style = DefaultStyle())))
    val buf = canvasBuf(w, 4, 2)
    val t1 = IsTrue(t, buf.Get(0, 0).Ch != ' ')
    // ...and nothing else is lit.
    return Eq(t1, litCells(buf, 4, 2), 1)
}

func TestYAxisIsInvertedForScreenCoordinates(t T) T {
    // A plot's Y grows up; screen rows grow down. Y=0.0 is the BOTTOM.
    val low = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.0, Y = 0.0)), Style = DefaultStyle())))
    val buf = canvasBuf(low, 4, 2)
    val t1 = IsTrue(t, buf.Get(0, 1).Ch != ' ')
    return IsTrue(t1, buf.Get(0, 0).Ch == ' ')
}

func TestPointsSpreadAcrossTheFullWidth(t T) T {
    // Two points at opposite X must land in different cells — a projection
    // that collapsed everything into one column would still "render".
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(
                CanvasPoint(X = 0.0, Y = 1.0),
                CanvasPoint(X = 1.0, Y = 1.0),
            ),
            Style = DefaultStyle())))
    val buf = canvasBuf(w, 8, 1)
    val t1 = IsTrue(t, buf.Get(0, 0).Ch != ' ')
    return IsTrue(t1, buf.Get(7, 0).Ch != ' ')
}

// ----------------------------------------------------------------------------
// Shapes
// ----------------------------------------------------------------------------

func TestHorizontalLineConnectsItsEndpoints(t T) T {
    // Every cell between the endpoints is lit — a Bresenham that stepped
    // wrongly would leave gaps, which "non-empty" would not catch.
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapeLine(
            X1 = 0.0, Y1 = 0.5, X2 = 1.0, Y2 = 0.5, Style = DefaultStyle())))
    val buf = canvasBuf(w, 10, 1)
    return stream.Range(0, 10).Fold(t, (acc, x) => IsTrue(acc, buf.Get(x, 0).Ch != ' '))
}

func TestVerticalLineConnectsItsEndpoints(t T) T {
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapeLine(
            X1 = 0.5, Y1 = 0.0, X2 = 0.5, Y2 = 1.0, Style = DefaultStyle())))
    val buf = canvasBuf(w, 4, 4)
    return stream.Range(0, 4).Fold(t, (acc, y) => IsTrue(acc, buf.Get(2, y).Ch != ' '))
}

func TestDiagonalLineTouchesBothCorners(t T) T {
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapeLine(
            X1 = 0.0, Y1 = 1.0, X2 = 1.0, Y2 = 0.0, Style = DefaultStyle())))
    val buf = canvasBuf(w, 8, 4)
    val t1 = IsTrue(t, buf.Get(0, 0).Ch != ' ')
    return IsTrue(t1, buf.Get(7, 3).Ch != ' ')
}

func TestRectOutlineLightsCornersAndLeavesTheMiddleEmpty(t T) T {
    // It is an outline, not a fill — the interior must stay clear so a
    // rect can frame a series.
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapeRect(
            X = 0.0, Y = 0.0, Width = 1.0, Height = 1.0, Style = DefaultStyle())))
    val buf = canvasBuf(w, 9, 5)
    val t1 = IsTrue(t, buf.Get(0, 0).Ch != ' ' && buf.Get(8, 4).Ch != ' ')
    return IsTrue(t1, buf.Get(4, 2).Ch == ' ')
}

func TestCircleIsHollowAndSpansItsDiameter(t T) T {
    val w = Canvas(XBounds(-1.0, 1.0), YBounds(-1.0, 1.0), BrailleMarker(),
        ArrayOf[Shape](ShapeCircle(
            X = 0.0, Y = 0.0, Radius = 1.0, Style = DefaultStyle())))
    val buf = canvasBuf(w, 12, 6)
    // Centre is empty...
    val t1 = IsTrue(t, buf.Get(6, 3).Ch == ' ')
    // ...and the rim reaches both horizontal extremes.
    return IsTrue(t1, buf.Get(0, 3).Ch != ' ' && buf.Get(11, 3).Ch != ' ')
}

// ----------------------------------------------------------------------------
// Markers
// ----------------------------------------------------------------------------

func TestBrailleResolvesFourPointsWithinOneCell(t T) T {
    // The whole reason braille is the default: four distinct Y values must
    // produce four DIFFERENT glyphs in the same cell, not one blob.
    val seen = ArrayTabulate(4, (i) => {
        val y = float64(i) / 4.0 + 0.05
        val w = Canvas(unitBounds(), unitBounds(), BrailleMarker(),
            ArrayOf[Shape](ShapePoints(
                Pts = ArrayOf(CanvasPoint(X = 0.1, Y = y)), Style = DefaultStyle())))
        return canvasBuf(w, 1, 1).Get(0, 0).Ch
    })
    return Eq(t, seen.Distinct().Length(), 4)
}

func TestHalfBlockPicksUpperLowerAndFull(t T) T {
    val upper = Canvas(unitBounds(), unitBounds(), HalfBlockMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.5, Y = 0.9)), Style = DefaultStyle())))
    val lower = Canvas(unitBounds(), unitBounds(), HalfBlockMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.5, Y = 0.1)), Style = DefaultStyle())))
    val both = Canvas(unitBounds(), unitBounds(), HalfBlockMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(
                CanvasPoint(X = 0.5, Y = 0.9),
                CanvasPoint(X = 0.5, Y = 0.1),
            ), Style = DefaultStyle())))
    val t1 = Eq(t, canvasBuf(upper, 1, 1).Get(0, 0).Ch, '▀')
    val t2 = Eq(t1, canvasBuf(lower, 1, 1).Get(0, 0).Ch, '▄')
    return Eq(t2, canvasBuf(both, 1, 1).Get(0, 0).Ch, '█')
}

// pointsAt draws `pts` into a 1x1 canvas over the unit square with `m`.
func pointsAt(m CanvasMarker, pts Array[CanvasPoint]) rune =
    canvasBuf(Canvas(unitBounds(), unitBounds(), m,
        ArrayOf[Shape](ShapePoints(Pts = pts, Style = DefaultStyle()))), 1, 1).Get(0, 0).Ch

func TestQuadrantPicksEachCornerAndTheDiagonal(t T) T {
    val tl = CanvasPoint(X = 0.1, Y = 0.9)
    val br = CanvasPoint(X = 0.9, Y = 0.1)
    val t1 = Eq(t, pointsAt(QuadrantMarker(), ArrayOf(tl)), '▘')
    val t2 = Eq(t1, pointsAt(QuadrantMarker(), ArrayOf(CanvasPoint(X = 0.9, Y = 0.9))), '▝')
    val t3 = Eq(t2, pointsAt(QuadrantMarker(), ArrayOf(CanvasPoint(X = 0.1, Y = 0.1))), '▖')
    val t4 = Eq(t3, pointsAt(QuadrantMarker(), ArrayOf(br)), '▗')
    return Eq(t4, pointsAt(QuadrantMarker(), ArrayOf(tl, br)), '▚')
}

// Six single dots give six different glyphs, and a whole column is the
// half block the Legacy Computing block leaves out.
func TestSextantResolvesSixDotsAndReusesTheHalfBlocks(t T) T {
    val dots = ArrayOf(0.9, 0.5, 0.1).FlatMap((y) =>
        ArrayOf(0.1, 0.9).Map((x) => CanvasPoint(X = x, Y = y)))
    val singles = dots.Map((p) => pointsAt(SextantMarker(), ArrayOf(p)))
    val t1 = Eq(t, singles.Distinct().Length(), 6)
    val t2 = Eq(t1, singles.Get(0), rune(0x1FB00))
    val left = dots.ZipWithIndex().Collect({ case (p, i) if i % 2 == 0 => p })
    return Eq(t2, pointsAt(SextantMarker(), left), '▌')
}

// Every 2x3 pattern has its own glyph, and the Legacy Computing block is
// used end to end: its first and last code points, nothing past them.
func TestSextantGlyphsCoverEveryPatternOnce(t T) T {
    val glyphs = ArrayTabulate(64, (bits) => sextantGlyph(bits))
    val block = glyphs.Filter((r) => r >= rune(0x1FB00))
    val t1 = Eq(t, glyphs.Distinct().Length(), 64)
    val t2 = Eq(t1, block.Length(), 60)
    return Eq(t2, block.FoldLeft(rune(0), (a, r) => if (r > a) r else a), rune(0x1FB3B))
}

func TestDotAndBlockMarkersAreOneCellResolution(t T) T {
    val dot = Canvas(unitBounds(), unitBounds(), DotMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.5, Y = 0.5)), Style = DefaultStyle())))
    val blk = Canvas(unitBounds(), unitBounds(), BlockMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.5, Y = 0.5)), Style = DefaultStyle())))
    val t1 = Eq(t, canvasBuf(dot, 1, 1).Get(0, 0).Ch, '•')
    return Eq(t1, canvasBuf(blk, 1, 1).Get(0, 0).Ch, '█')
}

// ----------------------------------------------------------------------------
// Robustness — the cases that trap a rasteriser
// ----------------------------------------------------------------------------

func TestShapesOutsideTheBoundsClipRatherThanWrap(t T) T {
    // A point far outside must not appear at the opposite edge, which is
    // what an unclamped modulo projection would produce.
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(
                CanvasPoint(X = 50.0, Y = 50.0),
                CanvasPoint(X = -50.0, Y = -50.0),
            ), Style = DefaultStyle())))
    return Eq(t, litCells(canvasBuf(w, 6, 3), 6, 3), 0)
}

func TestDegenerateBoundsDoNotTrap(t T) T {
    // Min == Max is a zero span; dividing by it must not blow up.
    val w = Canvas(XBounds(1.0, 1.0), YBounds(1.0, 1.0), BrailleMarker(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 1.0, Y = 1.0)), Style = DefaultStyle())))
    return IsTrue(t, litCells(canvasBuf(w, 4, 2), 4, 2) >= 0)
}

func TestEmptyCanvasDrawsNothing(t T) T {
    val w = CanvasOf(unitBounds(), unitBounds(), EmptyArray[Shape]())
    return Eq(t, Snapshot(w, 4, 2), "    \n    ")
}

func TestCanvasComposesOverWhatIsUnderneath(t T) T {
    // Only lit cells are written, so a canvas can overlay a background
    // instead of blanking its area.
    val w = Overlay(
        FillCh('.'),
        CanvasOf(unitBounds(), unitBounds(),
            ArrayOf[Shape](ShapePoints(
                Pts = ArrayOf(CanvasPoint(X = 0.0, Y = 1.0)), Style = DefaultStyle()))),
    )
    val buf = canvasBuf(w, 4, 2)
    val t1 = IsTrue(t, buf.Get(0, 0).Ch != ' ' && buf.Get(0, 0).Ch != '.')
    return Eq(t1, buf.Get(3, 1).Ch, '.')
}

// ----------------------------------------------------------------------------
// Style and labels
// ----------------------------------------------------------------------------

func TestEachShapeKeepsItsOwnStyle(t T) T {
    val w = CanvasOf(unitBounds(), unitBounds(), ArrayOf[Shape](
        ShapePoints(Pts = ArrayOf(CanvasPoint(X = 0.0, Y = 1.0)),
                    Style = DefaultStyle().WithFg(Red)),
        ShapePoints(Pts = ArrayOf(CanvasPoint(X = 1.0, Y = 1.0)),
                    Style = DefaultStyle().WithFg(Green)),
    ))
    val buf = canvasBuf(w, 8, 1)
    val t1 = IsTrue(t, ColorEq(buf.Get(0, 0).St.Fg, Red))
    return IsTrue(t1, ColorEq(buf.Get(7, 0).St.Fg, Green))
}

func TestLabelsDrawOverTheSeriesNotUnderIt(t T) T {
    // Labels are emitted after the glyph pass, so a caption is never buried
    // beneath the data it annotates.
    val w = CanvasOf(unitBounds(), unitBounds(), ArrayOf[Shape](
        ShapeLine(X1 = 0.0, Y1 = 1.0, X2 = 1.0, Y2 = 1.0, Style = DefaultStyle()),
        ShapeLabel(X = 0.0, Y = 1.0, Text = "hi", Style = DefaultStyle()),
    ))
    val buf = canvasBuf(w, 8, 1)
    val t1 = Eq(t, buf.Get(0, 0).Ch, 'h')
    return Eq(t1, buf.Get(1, 0).Ch, 'i')
}

func TestRestylingACanvasReachesItsShapes(t T) T {
    val w = CanvasOf(unitBounds(), unitBounds(),
        ArrayOf[Shape](ShapePoints(
            Pts = ArrayOf(CanvasPoint(X = 0.0, Y = 1.0)),
            Style = DefaultStyle()))).WithBold()
    return IsTrue(t, canvasBuf(w, 4, 2).Get(0, 0).St.Bold)
}

// ----------------------------------------------------------------------------
// Labels are clipped to the canvas, like every other shape
//
// Dot shapes clip in `plot`, but the label pass projected freely and called
// `renderText` with no bounds check. A label anchored outside the bounds
// projects outside the grid — `canvasProject` folds a value that is ON the
// upper bound, not one past it — so the text landed on whatever widget was
// laid out next to the canvas.
// ----------------------------------------------------------------------------

func TestLabelBelowTheBoundsDoesNotPaintOutsideTheCanvas(t T) T {
    val buf = NewBuffer(12, 3)
    // Fill row 2 with a sentinel standing in for a neighbouring widget.
    RenderTo(FillCh('#'), Rect(X = 0, Y = 2, Width = 12, Height = 1), buf)
    // Canvas owns rows 0-1 only; the label's Y is below yMin.
    RenderTo(
        CanvasW(XMin = 0.0, XMax = 1.0, YMin = 0.0, YMax = 1.0,
                Marker = BrailleMarker(),
                Shapes = ArrayOf[Shape](
                    ShapeLabel(X = 0.0, Y = -0.1, Text = "LEAK",
                               Style = DefaultStyle()))),
        Rect(X = 0, Y = 0, Width = 12, Height = 2), buf)
    return Eq(t, RowText(buf, 2), "############")
}

func TestLabelLeftOfTheBoundsDoesNotPaintOutsideTheCanvas(t T) T {
    val buf = NewBuffer(12, 1)
    RenderTo(FillCh('#'), Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    // Canvas starts at column 4; the label's X is below xMin.
    RenderTo(
        CanvasW(XMin = 0.0, XMax = 1.0, YMin = 0.0, YMax = 1.0,
                Marker = BrailleMarker(),
                Shapes = ArrayOf[Shape](
                    ShapeLabel(X = -0.5, Y = 1.0, Text = "LEAK",
                               Style = DefaultStyle()))),
        Rect(X = 4, Y = 0, Width = 8, Height = 1), buf)
    return Eq(t, strings.HasPrefix(RowText(buf, 0), "####"), true)
}

// ============================================================================
// ShapeFilledLine — the band between a series and a reference
// ============================================================================

func TestFilledLineFillsBetweenTheLineAndTheReference(t T) T {
    // A flat line at y = 0.5 filled down to 0.0 lights the bottom half of
    // every column and leaves the top half dark. Counting lit cells per row
    // is the claim: an unfilled line would light one row, not half of them.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = 0.0, Y1 = 0.5, X2 = 1.0, Y2 = 0.5, YRef = 0.0,
                        Style = DefaultStyle()),
        8, 4)
    val topRow = litCells(buf, 8, 1)
    val wholeCanvas = litCells(buf, 8, 4)
    val t1 = EqMsg(t, topRow, 0, "the band reached above the line")
    return EqMsg(t1, wholeCanvas > 8, true, "the band did not fill a column")
}

func TestFilledLineFillsUpwardsWhenTheReferenceIsAbove(t T) T {
    // The band is between the line and the reference, whichever is higher —
    // a series below a budget line fills up to it.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = 0.0, Y1 = 0.0, X2 = 1.0, Y2 = 0.0, YRef = 1.0,
                        Style = DefaultStyle()),
        8, 4)
    return EqMsg(t, litCells(buf, 8, 1) > 0, true,
                 "a reference above the line left the top of the band unfilled")
}

func TestFilledLineAtItsReferenceDrawsOnlyTheLine(t T) T {
    // Degenerate band: the line and the reference coincide, so the shape is
    // its own outline and nothing more.
    val flat = shapeCanvas(
        ShapeFilledLine(X1 = 0.0, Y1 = 0.0, X2 = 1.0, Y2 = 0.0, YRef = 0.0,
                        Style = DefaultStyle()),
        8, 4)
    val plain = shapeCanvas(
        ShapeLine(X1 = 0.0, Y1 = 0.0, X2 = 1.0, Y2 = 0.0, Style = DefaultStyle()),
        8, 4)
    return Eq(t, litCells(flat, 8, 4), litCells(plain, 8, 4))
}

func TestFilledLineFollowsASlope(t T) T {
    // A rising series must light more of the right of the canvas than the
    // left — the test that a fill interpolates rather than filling a box.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = 0.0, Y1 = 0.0, X2 = 1.0, Y2 = 1.0, YRef = 0.0,
                        Style = DefaultStyle()),
        8, 4)
    return EqMsg(t, litCellsIn(buf, 4, 8, 4) > litCellsIn(buf, 0, 4, 4), true,
                 "the fill did not follow the slope")
}

func TestVerticalFilledLineFillsItsOwnColumn(t T) T {
    // No columns to walk: the degenerate case that an interpolation would
    // divide by zero on.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = 0.5, Y1 = 1.0, X2 = 0.5, Y2 = 0.5, YRef = 0.0,
                        Style = DefaultStyle()),
        8, 4)
    // One braille column of a full-height band: four cells, and no more —
    // "something was drawn" would also pass for a fill that leaked sideways.
    return Eq(t, litCells(buf, 8, 4), 4)
}

func TestFilledLineFarOffCanvasCostsNothing(t T) T {
    // Clipping is not only about what is painted. A fill's loops are nested,
    // and a segment that starts a million units off-canvas and ends on it
    // spans ~16 million grid columns — walking them to discard all but the
    // last few took long enough to read as a hang. The assertion is that
    // this test returns at all; what it paints is the visible tail.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = -1000000.0, Y1 = 0.5, X2 = 1.0, Y2 = 0.5,
                        YRef = 0.0, Style = DefaultStyle()),
        8, 4)
    return EqMsg(t, litCells(buf, 8, 4) > 0, true,
                 "the visible tail of a far-off-canvas fill was dropped")
}

func TestFilledLineReferenceFarBelowTheBoundsFillsToTheEdge(t T) T {
    // The ordinary version of the same hazard, and the one the docs invite:
    // `YRef = 0.0` against bounds auto-scaled to a byte count puts the
    // reference tens of thousands of rows below the canvas. The band must
    // stop at the bottom edge, in time proportional to what is visible.
    val buf = shapeCanvas(
        ShapeFilledLine(X1 = 0.0, Y1 = 1.0, X2 = 1.0, Y2 = 1.0,
                        YRef = -50000.0, Style = DefaultStyle()),
        8, 4)
    return EqMsg(t, litCells(buf, 8, 4), 32,
                 "a reference below the canvas did not fill exactly to the edge")
}

func TestFilledLineKeepsItsSlopeWhenPartlyOffCanvas(t T) T {
    // The clip is on the walk, not on the geometry: the visible half of a
    // segment that starts off-canvas must keep the slope the caller asked
    // for, not one refitted to the part that survived.
    val whole = shapeCanvas(
        ShapeFilledLine(X1 = -1.0, Y1 = -1.0, X2 = 1.0, Y2 = 1.0, YRef = 0.0,
                        Style = DefaultStyle()),
        8, 4)
    // Same line, clipped by the canvas rather than by the caller: the right
    // half rises from the middle of the canvas to its top-right corner.
    return EqMsg(t, litCellsIn(whole, 4, 8, 4) > litCellsIn(whole, 0, 4, 4), true,
                 "the visible span was refitted instead of clipped")
}

func TestPlainLineFarOffCanvasCostsNothingEither(t T) T {
    // The same hazard, in the shape that has been shipping for longer.
    // `plotLine`'s `limit` is a termination guard sized by the walk, not a
    // clamp to the canvas: before the segment was clipped, these endpoints
    // made Bresenham step sixteen million times to light one column, and
    // ShapeRect paid it four times over. The assertion is that this returns.
    val buf = shapeCanvas(
        ShapeLine(X1 = -1000000.0, Y1 = 0.5, X2 = 1.0, Y2 = 0.5,
                  Style = DefaultStyle()),
        8, 4)
    return EqMsg(t, litCells(buf, 8, 4) > 0, true,
                 "the visible tail of a far-off-canvas line was dropped")
}

func TestClippingALineKeepsItOnItsOriginalPath(t T) T {
    // Clipping trims the walk, not the geometry. A diagonal that starts one
    // canvas-width off the left must still arrive at the corner it was aimed
    // at, rather than being refitted between the edge and the endpoint.
    val buf = shapeCanvas(
        ShapeLine(X1 = -1.0, Y1 = 1.5, X2 = 1.0, Y2 = 0.0, Style = DefaultStyle()),
        8, 4)
    // The aimed-at corner is the bottom right. The top right is off a path
    // that descends left to right — a slope refitted to the clipped span
    // would be shallower and would light it.
    val t1 = IsTrue(t, buf.Get(7, 3).Ch != ' ')
    return IsTrue(t1, buf.Get(7, 0).Ch == ' ')
}

func TestFilledLineOutsideTheBoundsClips(t T) T {
    // Same contract every other shape keeps: off-canvas clips, it does not
    // wrap, and it does not reach into the widget laid out next door.
    val buf = NewBuffer(12, 2)
    RenderTo(FillCh('#'), Rect(X = 0, Y = 0, Width = 4, Height = 2), buf)
    RenderTo(
        CanvasW(XMin = 0.0, XMax = 1.0, YMin = 0.0, YMax = 1.0,
                Marker = BrailleMarker(),
                Shapes = ArrayOf[Shape](
                    ShapeFilledLine(X1 = -3.0, Y1 = 0.5, X2 = -2.0, Y2 = 0.5,
                                    YRef = 0.0, Style = DefaultStyle()))),
        Rect(X = 4, Y = 0, Width = 8, Height = 2), buf)
    return Eq(t, strings.HasPrefix(RowText(buf, 0), "####"), true)
}

func TestLabelInsideTheBoundsStillRenders(t T) T {
    val buf = NewBuffer(12, 1)
    RenderTo(
        CanvasW(XMin = 0.0, XMax = 1.0, YMin = 0.0, YMax = 1.0,
                Marker = BrailleMarker(),
                Shapes = ArrayOf[Shape](
                    ShapeLabel(X = 0.0, Y = 1.0, Text = "OK",
                               Style = DefaultStyle()))),
        Rect(X = 0, Y = 0, Width = 12, Height = 1), buf)
    return IsTrue(t, strings.Contains(RowText(buf, 0), "OK"))
}
