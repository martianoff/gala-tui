package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    "martianoff/gala/stream"
)

// Constraint is the language Row / Column widgets use to sub-allocate their
// area among children. Four rules cover every common TUI layout pattern:
//
//   - Length(n):   exactly n cells — the workhorse for fixed-size bars,
//                  footers, padding columns.
//   - Percent(p):  p% of the parent area — useful for side-panels that
//                  resize with the terminal.
//   - Fill(w):     take a share of the leftover space, proportional to w.
//                  `Fill(1)` is the default "greedy" behavior; weights let
//                  two Fills split 2:1 by writing Fill(2) and Fill(1).
//   - MinLen(n):   *at least* n cells of the leftover space. Used to stop
//                  a Fill from collapsing a panel below a useful minimum.
//   - MaxLen(n):   *at most* n cells. The mirror of MinLen: lets a child
//                  grow with the terminal but stop at a readable width
//                  (a text column that shouldn't stretch to 300 chars).
//   - Ratio(a, b): the fraction a/b of the parent area. Percent's precise
//                  sibling — `Ratio(1, 3)` is exactly a third, where
//                  `Percent(33)` drifts by a cell on most widths.
sealed type Constraint {
    case Length(N int)
    case Percent(N int)
    case Fill(Weight int)
    case MinLen(N int)
    case MaxLen(N int)
    case Ratio(Num int, Den int)
}

// Solve returns the allocated size (in cells) for each constraint given a
// parent total. Guarantees the sum of returned sizes ≤ total, and exactly
// equals total whenever at least one Fill or the sum of non-Fill constraints
// fills the space — so a renderer can lay children out edge-to-edge with no
// gap.
//
// The algorithm is intentionally simple and deterministic: compute fixed +
// percent + minlen in one pass, distribute leftover space to Fill weights,
// then clip any overflow from the tail.
func Solve(total int, cs Array[Constraint]) Array[int] {
    if cs.IsEmpty() || total <= 0 {
        return ArrayFill(cs.Length(), 0)
    }

    // Pass 1: assign fixed sizes (Length / Percent / MinLen / MaxLen /
    // Ratio) and total fill weight so we know how much room is left.
    val fixed = cs.Map((c) => fixedSize(c, total))
    val fixedTotal = sumInt(fixed)
    val totalWeight = cs.FoldLeft(0, (acc, c) => acc + fillWeight(c))

    // Pass 2: distribute leftover cells to Fill constraints, weighted, and
    // give the rounding remainder to the last Fill.
    val remaining = MaxInt(0, total - fixedTotal)
    val sized = if (totalWeight <= 0) fixed else {
        val shared = cs.Zip(fixed).Map((t) => t.V1 match {
            case Fill(w) => remaining * MaxInt(0, w) / totalWeight
            case _       => t.V2
        })
        val distributed = sumInt(shared) - fixedTotal
        cs.ZipWithIndex().FindLast((t) => isFill(t.V1)).Map((t) => t.V2) match {
            case Some(j) => shared.Updated(j, shared.Get(j) + remaining - distributed)
            case None()  => shared
        }
    }

    // Pass 3: clamp tail — if fixed sizes already overflow the parent, chop
    // off children that don't fit rather than rendering past the edge. The
    // running total capped at `total` marks where each child may end.
    val ends = stream.FromArray(sized).Scan(0, (used, s) => used + s).Map((used) => MinInt(used, total)).ToArray()
    return ends.Zip(ends.Drop(1)).Map((t) => t.V2 - t.V1)
}

// fixedSize is what a non-Fill constraint claims of `total` before any Fill
// is considered; a Fill claims nothing yet.
func fixedSize(c Constraint, total int) int = c match {
    case Length(v)  => MaxInt(0, v)
    case Percent(p) => total * clampPct(p) / 100
    case MinLen(v)  => MaxInt(0, v)
    // A cap, not a request: take what is asked for unless the parent is
    // narrower, in which case the parent wins.
    case MaxLen(v)  => MinInt(MaxInt(0, v), total)
    // Guard a zero denominator rather than trapping — a bad ratio collapses
    // the child instead of killing the render.
    case Ratio(num, den) => if (den <= 0) 0 else total * MaxInt(0, num) / den
    case Fill(_)    => 0
}

// fillWeight is a Fill's share weight (negative weights count as zero);
// every other constraint weighs nothing.
func fillWeight(c Constraint) int = c match {
    case Fill(w) => MaxInt(0, w)
    case _       => 0
}

func isFill(c Constraint) bool = c match {
    case Fill(_) => true
    case _       => false
}

// clampPct keeps percentage inputs in the [0..100] range.
func clampPct(p int) int {
    if p < 0   { return 0 }
    if p > 100 { return 100 }
    return p
}

// ----------------------------------------------------------------------------
// Flex — what a Row / Column does with space its children did not claim.
//
// `Solve` answers "how big is each child"; FlexMode answers the question that
// only shows up once every child is sized and cells are still left over:
// where does the slack go? Without it the only expressible answer is "give it
// to the last Fill", which is why centering a fixed-width dialog needs two
// throwaway spacer children today.
//
// Named FlexMode rather than Flex because `Flex(weight, widget)` is already
// the Fill-constrained LayoutChild constructor.
//
// A mode only has something to do when there IS slack, so any `Fill` child
// makes every mode behave like FlexLegacy: Fill absorbs the leftover space
// by definition, leaving nothing to distribute. `FlexCenter` over a row
// containing a Fill therefore looks like it does nothing. Size the children
// you want positioned (Length / Percent / Ratio) and leave the Fills out.
// ----------------------------------------------------------------------------
sealed type FlexMode {
    // FlexLegacy is the historical behavior and stays the default: slack
    // goes to the last Fill child, or is simply left unused when there is
    // no Fill. Existing layouts must keep rendering identically.
    case FlexLegacy()
    // FlexStart packs children at the start; slack collects at the end.
    case FlexStart()
    // FlexEnd packs children at the end; slack collects at the start.
    case FlexEnd()
    // FlexCenter splits the slack evenly before and after the children.
    case FlexCenter()
    // FlexSpaceBetween puts all slack *between* children, none at the edges.
    case FlexSpaceBetween()
    // FlexSpaceAround gives each child equal slack on both sides, so edge
    // gaps are half the size of the gaps between children.
    case FlexSpaceAround()
    // FlexSpaceEvenly makes every gap equal, edges included.
    case FlexSpaceEvenly()
}

// ----------------------------------------------------------------------------
// VAlign — vertical placement, the counterpart to Align.
//
// `Align` has always been horizontal-only; a widget shorter than its area
// could not be pushed to the middle or bottom without a hand-computed
// spacer. Kept as its own type rather than adding cases to `Align` so the
// two axes cannot be confused at a call site.
// ----------------------------------------------------------------------------
sealed type VAlign {
    case VAlignTop()
    case VAlignMiddle()
    case VAlignBottom()
}
