package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
)

// This file adds the *interactive* widgets — the ones that model visible
// state like "which item is selected" or "how far along is this download".
//
// Every widget is pure-data. The Model the user defines holds the actual
// state (Selected: int, Value: string, Progress: int). At view() time the
// user converts model state into a widget. This is what makes hot reload,
// time-travel debugging, and snapshot testing trivial: a Widget tree is
// just a value — identical inputs always yield identical outputs.

// ----------------------------------------------------------------------------
// Selectable list.
//
// Bubble Tea's list.Model is ~400 lines of state-carrying mutation.
// Ratatui's List is ~350 lines of builder struct. Our list is:
// a value with items, a selection index, two styles. The renderer handles
// scrolling automatically based on the viewport height.
// ----------------------------------------------------------------------------

// ListItem is a single row of a list. Style lets individual rows carry
// their own color/weight (e.g., a "priority: high" row rendered red).
struct ListItem(
    Label string,
    Style Style,
)

// NewListItem wraps a plain string as a ListItem with default styling.
func NewListItem(label string) ListItem =
    ListItem(Label = label, Style = DefaultStyle())

// ----------------------------------------------------------------------------
// Progress bar helpers.
//
// Shown as `[█████████████░░░░░░░░]` — filled glyph repeats for the
// integer percentage of the bar's width, the remainder is the empty glyph.
// Percent is stored as an int in 0..100 so nobody has to think about
// floating-point rounding when a download finishes at 99.9999%.
//
// The bar renders no number. `ProgressW` fills whatever slot the layout
// gives it, and slots are frequently narrow — a table cell, a status
// footer, a 12-column column in a dashboard grid. A widget that silently
// reserved six columns for `  100%` would leave nothing to be a bar there,
// and the reservation would have to grow and shrink with the digit count.
// Callers that want the number compose it, so they choose where the
// columns come from:
//
//     Row(ArrayOf[LayoutChild](
//         Flex(1, Progress(pct)),
//         Fixed(6, Text(s"  ${pct}%")),
//     ))
// ----------------------------------------------------------------------------

// renderProgressBar produces a string that looks like `[████░░░░]` for the
// given filled-percent and width. Width includes the surrounding brackets.
// Called by ProgressWidget's render path.
func renderProgressBar(percent int, width int, filled rune, empty rune) string {
    val p = clampPct(percent)
    val inner = MaxInt(0, width - 2)
    val fillCells = inner * p / 100
    var sb strings.Builder
    sb.WriteRune('[')
    var i = 0
    for i < fillCells {
        sb.WriteRune(filled)
        i = i + 1
    }
    for i < inner {
        sb.WriteRune(empty)
        i = i + 1
    }
    sb.WriteRune(']')
    return sb.String()
}

// ----------------------------------------------------------------------------
// Spinner glyph cycles.
//
// A Spinner is a seam between the runtime (which ticks) and the view (which
// renders the current frame). Several conventional glyph sets ship:
//   - Braille (⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)     — smooth, modern
//   - Dots    (· ‥ …)                     — low-fi ". .. ..." in one cell
//   - Pipe    (| / - \)                   — classic
//   - Arrow   (← ↖ ↑ ↗ → ↘ ↓ ↙)           — compass style
//
// Every cycle is one cell wide and every frame paints something. A frame
// that is a blank makes the spinner wink out of existence for that slice
// of the revolution, which reads as "the app froze", the opposite of what
// a spinner is for — so the dots cycle uses the dot-leader glyphs rather
// than growing a run of ASCII periods across cells it does not own.
//
// The widget stores a frame number; the user increments it on every Tick.
// Which spinner style is picked is a SpinnerKind sealed variant.
// ----------------------------------------------------------------------------

sealed type SpinnerKind {
    case BrailleSpinner()
    case DotsSpinner()
    case PipeSpinner()
    case ArrowSpinner()
}

// spinnerFrames returns the glyph cycle for a spinner kind — user code
// picks which to use; the runtime tick drives the frame index.
func spinnerFrames(kind SpinnerKind) Array[rune] {
    return kind match {
        case BrailleSpinner() => ArrayOf[rune]('⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏')
        case DotsSpinner()    => ArrayOf[rune]('·', '‥', '…')
        case PipeSpinner()    => ArrayOf[rune]('|', '/', '-', '\\')
        case ArrowSpinner()   => ArrayOf[rune]('←', '↖', '↑', '↗', '→', '↘', '↓', '↙')
    }
}

// SpinnerGlyph returns the glyph at `frame` (wraps around the cycle).
func SpinnerGlyph(kind SpinnerKind, frame int) rune {
    val frames = spinnerFrames(kind)
    val n = frames.Length()
    if n == 0 {
        return ' '
    }
    val raw = frame % n
    val idx = if (raw < 0) raw + n else raw
    return frames.Get(idx)
}

// ----------------------------------------------------------------------------
// Gauge — like a progress bar, but renders with a half-block character at
// the boundary for sub-cell fill resolution. Matches Ratatui's Gauge and
// Bubble Tea's progress.Model when called with `ProgressOption.WithGradient`.
// ----------------------------------------------------------------------------

// gaugeTrack is the glyph the unfilled part of a Gauge is drawn with.
//
// It used to be a space, which made `Gauge(0)` paint nothing at all: an
// empty gauge and an empty slot were the same picture, so a bar at zero
// looked like a widget that had failed to render. `Progress` has always
// drawn its track (`[░░░░░░]`), and two bar widgets in one library should
// not disagree about whether "nothing done yet" is visible.
func gaugeTrack() rune = '░'

// renderGauge returns a width-wide bar where the last partial cell uses a
// sub-cell Unicode block — much smoother than the integer-only progress bar
// when the terminal is narrow. Cells past the fill carry the track glyph,
// so the bar's extent is visible at every percentage including 0.
func renderGauge(percent int, width int) string {
    val p = clampPct(percent)
    if width <= 0 {
        return ""
    }
    // Pre-condition: width is the total bar width in cells.
    val totalEighths = width * 8 * p / 100
    val fullCells = totalEighths / 8
    val remainder = totalEighths - fullCells * 8
    var sb strings.Builder
    var i = 0
    for i < fullCells {
        sb.WriteRune('█')
        i = i + 1
    }
    // A zero remainder has no partial block to draw — emitting one anyway
    // would spend a cell on a glyph indistinguishable from the track.
    if remainder > 0 && fullCells < width {
        sb.WriteRune(gaugeEighthRune(remainder))
        i = i + 1
    }
    for i < width {
        sb.WriteRune(gaugeTrack())
        i = i + 1
    }
    return sb.String()
}

// gaugeEighthRune maps an eighths-of-cell fill count (1..7) to its Unicode
// partial-block glyph, U+258F (▏, one eighth) up to U+2589 (▉, seven
// eighths). Zero has no glyph of its own — `renderGauge` draws the track
// there instead — so callers pass 1..7 and anything at or above 8 is a
// full block.
func gaugeEighthRune(eighths int) rune {
    if eighths <= 0 { return gaugeTrack() }
    if eighths == 1 { return '▏' }
    if eighths == 2 { return '▎' }
    if eighths == 3 { return '▍' }
    if eighths == 4 { return '▌' }
    if eighths == 5 { return '▋' }
    if eighths == 6 { return '▊' }
    if eighths == 7 { return '▉' }
    return '█'
}

// ----------------------------------------------------------------------------
// LineGauge — a gauge drawn as a rule rather than a bar.
//
// `Gauge` spends a whole row on a block bar. A dashboard that wants six
// progress readouts stacked in a sidebar, or one progress line per item in
// a list, cannot afford that: what it wants is a caption and a rule on the
// same row. That is this widget.
//
// Where `Gauge` reaches for partial *blocks*, the rule reaches for partial
// *weight*: the completed run is heavy (`━`), the track is light (`─`), and
// the boundary cell is `╾` — heavy left, light right — when the fill lands
// mid-cell. The weight contrast survives a monochrome terminal, a `NO_COLOR`
// session and a colour-blind reader, none of which a distinction carried by
// colour alone would; `╾` then buys back the half cell of resolution that
// whole-cell glyphs would otherwise cost.
// ----------------------------------------------------------------------------

// lineGaugeFilled is the glyph for the completed run of a LineGauge.
func lineGaugeFilled() rune = '━'

// lineGaugeHead is the boundary glyph, drawn when the fill ends inside a
// cell rather than on its edge: U+257E, heavy on its left half and light on
// its right. It continues the filled run into the cell and hands the rest of
// the cell to the track, so the rule stays unbroken across the boundary —
// U+2578 `╸`, the other candidate, is heavy-left and *blank* right, which
// puts a half-cell hole in the middle of the gauge.
//
// It is deliberately not the same picture as a full cell: rounding a fill up
// to `━` would let 99% paint the same rule as 100%, and "done" is the one
// state a progress widget must never claim early.
func lineGaugeHead() rune = '╾'

// lineGaugeTrack is the glyph for the remainder — the same rule, drawn
// light, so the gauge's full extent is visible at 0% exactly as `Gauge`'s
// `░` track is.
func lineGaugeTrack() rune = '─'

// lineGaugeMinRule is the narrowest rule worth drawing *next to a label*.
// Below four cells a rule cannot show a position — every percentage rounds
// to one of a handful of pictures — so a labelled gauge keeps the label
// instead and drops the rule.
//
// This is a trade between two things that both want the row. A gauge with no
// label has nothing to trade: `lineGaugeRuleOnly` draws the rule at whatever
// width it is given, because the alternative is a blank row, and a widget
// that renders as nothing is the failure `gaugeTrack` was introduced to
// eliminate.
func lineGaugeMinRule() int = 4

// lineGaugeCaptionWidth is the fixed slot `LineGauge`'s own percentage is
// right-aligned into: four columns, enough for "100%".
//
// Fixed rather than fitted, for the reason `ProgressLabeled` gives one
// screen up: a caption that grows a digit moves everything after it. Here
// that is worse than a twitch — the rule would start a column later *and*
// end a column shorter, and since floor(0.99 * n) == n - 1 for every rule
// width a terminal can hold, 99% and 100% would paint the same number of
// heavy cells. The most important transition the widget has would render as
// a sideways slide with no forward motion.
func lineGaugeCaptionWidth() int = 4

// lineGaugeLabelWidth is the columns a label claims, including the single
// space that separates it from the rule. An empty label claims nothing, so
// `LineGaugeLabeled("", pct)` gets a rule across the whole row.
func lineGaugeLabelWidth(label string) int =
    if (label == "") 0 else StringCellWidth(label) + 1

// lineGaugeCaption right-aligns a percentage into `lineGaugeCaptionWidth`.
func lineGaugeCaption(percent int) string =
    padLeftToCells(s"${clampPct(percent)}%", lineGaugeCaptionWidth())

// padLeftToCells right-aligns `s` in a `width`-cell slot. A string already
// at or past the slot width is returned as-is — padding is this function's
// job, truncation is the renderer's.
func padLeftToCells(s string, width int) string = cellPad(width - StringCellWidth(s)) + s

// padRightToCells left-aligns `s` in a `width`-cell slot. Used where a
// widget must own every cell of its area: an unwritten cell is not blank,
// it is whatever the parent painted there.
func padRightToCells(s string, width int) string = s + cellPad(width - StringCellWidth(s))

// cellPad is `n` spaces, or "" for a non-positive count.
func cellPad(n int) string {
    var pad = ""
    var i = 0
    for i < n {
        pad = pad + " "
        i = i + 1
    }
    return pad
}

// renderLineGaugeRule paints `width` cells of rule at (x, y): the completed
// run, then the boundary cell when the fill ends mid-cell, then the track.
//
// The fill is floored to the half cell — `full` whole cells, plus a head
// when the next half is fully earned. Floored, not rounded to nearest, and
// that is load-bearing: `(width * 2 * p + 50) / 100` at width 19 and p = 99
// yields 38 halves, a full 19 cells, so 99% would paint the exact picture of
// 100%. Flooring keeps the widget's one hard promise — nothing short of done
// renders as done — and costs only a half cell of resolution, which the head
// glyph is there to buy back.
func renderLineGaugeRule(
    buf *Buffer,
    x int,
    y int,
    width int,
    percent int,
    filled Style,
    unfilled Style,
) {
    val p = clampPct(percent)
    // Halves of a cell, so the boundary test is integer arithmetic: `halves`
    // odd means the fill ended mid-cell.
    val halves = width * 2 * p / 100
    val full = halves / 2
    val head = halves - full * 2 > 0 && full < width
    var i = 0
    for i < width {
        val glyph =
            if (i < full) lineGaugeFilled()
            else if (i == full && head) lineGaugeHead()
            else lineGaugeTrack()
        val st = if (i < full || (i == full && head)) filled else unfilled
        buf.Set(x + i, y, Cell(Ch = glyph, St = st))
        i = i + 1
    }
}

