package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
    . "martianoff/gala/test"
)

// ============================================================================
// Backend seam (G7) — driving the whole run loop without a terminal.
//
// Everything between "bytes arrive on stdin" and "a frame is painted" had no
// test before this: the widget harness renders widgets directly, so parsing,
// carry-over, click resolution, quit handling and teardown were exercised
// only by running the binary by hand. Every bracketed-paste defect found in
// the 0.12.0 review lived in that gap.
//
// These tests script the input and read back what the program did.
// ============================================================================

sealed type BeMsg {
    case BeKey(K string)
    case BePaste(Text string)
    case BeQuit()
    case BeNoOp()
}

struct BeModel(Keys Array[string], Pasted string)

func beInitial() BeModel = BeModel(Keys = EmptyArray[string](), Pasted = "")

func beUpdate(m BeModel, msg BeMsg) Tuple[BeModel, Cmd[BeMsg]] = msg match {
    case BeKey(k)     => (m.Copy(Keys = m.Keys.Append(k)), NoCmd[BeMsg]())
    case BePaste(txt) => (m.Copy(Pasted = txt), NoCmd[BeMsg]())
    case BeQuit()     => (m, QuitCmd[BeMsg]())
    case BeNoOp()     => (m, NoCmd[BeMsg]())
}

func beView(m BeModel) Widget =
    Text("keys=" + strings.Join(m.Keys.ToGoSlice(), ",") + " paste=" + m.Pasted)

func beKeyToMsg(ev KeyEvent) BeMsg = ev.Key match {
    case Char(c) => if (c == 'q') BeQuit() else BeKey(K = string(c))
    case Up()    => BeKey(K = "up")
    case Enter() => BeKey(K = "enter")
    case _       => BeNoOp()
}

func beProgram() Program[BeModel, BeMsg] =
    Program[BeModel, BeMsg](Initial = beInitial(), Update = beUpdate, View = beView)

// A second program whose update() prints: 'p' logs a line and carries on,
// 'z' logs one and quits in the same Batch.
func bePrintUpdate(m BeModel, msg BeMsg) Tuple[BeModel, Cmd[BeMsg]] = msg match {
    case BeKey(k) =>
        (m.Copy(Keys = m.Keys.Append(k)), PrintAbove[BeMsg]("logged: " + k))
    case BeQuit() =>
        (m, Batch[BeMsg](PrintAbove[BeMsg]("bye"), QuitCmd[BeMsg]()))
    case _ => (m, NoCmd[BeMsg]())
}

func bePrintKeyToMsg(ev KeyEvent) BeMsg = ev.Key match {
    case Char(c) => if (c == 'z') BeQuit() else BeKey(K = string(c))
    case _       => BeNoOp()
}

func bePrintProgram() Program[BeModel, BeMsg] =
    Program[BeModel, BeMsg](Initial = beInitial(), Update = bePrintUpdate, View = beView)

// ----------------------------------------------------------------------------
// The loop runs, paints, and terminates
// ----------------------------------------------------------------------------

func TestRunPaintsTheInitialModelBeforeAnyInput(t T) T {
    val (backend, st) = NewTestBackend(24, 3, "")
    val _ = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, st.Wrote("keys= paste="), true,
                 "the first frame was never painted")
}

func TestRunConsumesScriptedKeystrokes(t T) T {
    val (backend, st) = NewTestBackend(40, 3, "abc")
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    val t1 = Eq(t, strings.Join(final.Keys.ToGoSlice(), ","), "a,b,c")
    return EqMsg(t1, st.Wrote("keys=a,b,c"), true, "the final frame was not painted")
}

func TestRunStopsWhenInputEnds(t T) T {
    // A scripted run must terminate on its own. Before the seam there was no
    // way to assert this at all — an infinite loop in the runtime could only
    // be found by hanging a terminal.
    val (backend, _) = NewTestBackend(20, 3, "xy")
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return Eq(t, final.Keys.Length(), 2)
}

func TestQuitCmdEndsTheLoopImmediately(t T) T {
    // 'q' quits; the 'z' after it must never be dispatched.
    val (backend, _) = NewTestBackend(20, 3, "aqz")
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, strings.Join(final.Keys.ToGoSlice(), ","), "a",
                 "input after QuitCmd was still processed")
}

// ----------------------------------------------------------------------------
// Terminal acquisition and release
// ----------------------------------------------------------------------------

func TestRunOpensAndClosesTheBackendExactlyOnce(t T) T {
    // The `use` binding must release on the normal return path. A leak here
    // is what leaves a real user's shell in the alternate screen with no
    // cursor and mouse reporting still on.
    val (backend, st) = NewTestBackend(20, 3, "ab")
    val _ = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    val t1 = EqMsg(t, st.Opened, 1, "backend opened the wrong number of times")
    return EqMsg(t1, st.Closed, 1, "backend was not released exactly once")
}

func TestRunReleasesTheBackendOnAnEarlyQuit(t T) T {
    // Quit returns from deep inside the read loop, which is the path most
    // likely to skip cleanup if it were written by hand.
    val (backend, st) = NewTestBackend(20, 3, "q")
    val _ = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, st.Closed, 1, "quitting from inside the loop skipped release")
}

// ----------------------------------------------------------------------------
// Escape sequences through the real loop
// ----------------------------------------------------------------------------

func TestArrowKeyDecodesThroughTheRunLoop(t T) T {
    val (backend, _) = NewTestBackend(20, 3, "\x1b[Ab")
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, strings.Join(final.Keys.ToGoSlice(), ","), "up,b",
                 "arrow key did not decode as one event")
}

func TestAltBracketDoesNotSwallowTheNextKeyInTheLoop(t T) T {
    // The regression the 0.12.0 review found, pinned end to end rather than
    // at the parser alone. The two keystrokes must arrive in SEPARATE reads,
    // which is what a terminal actually does — it writes each keypress as it
    // happens. Carrying the bodyless `ESC [` waited for a completion that
    // never came and absorbed the next keystroke into the pending sequence.
    val (backend, _) = NewTestBackendChunks(20, 3, ArrayOf[string]("\x1b[", "b"))
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, final.Keys.Contains("b"), true,
                 "the keystroke after Alt+[ was swallowed by the run loop")
}

func TestEscBracketAndTheNextKeyInOneReadIsACsiSequence(t T) T {
    // The honest limit of the fix above, asserted so nobody "fixes" it into
    // a regression. `ESC [ b` delivered in ONE read is a complete, valid CSI
    // sequence — `b` is in the final-byte range — and is indistinguishable
    // from Alt+[ followed by `b` without a timeout, which this runtime does
    // not have. It decodes as the sequence, and the `b` is consumed by it.
    //
    // Terminals write each keypress as its own call, so a human typing
    // Alt+[ then `b` produces two reads and hits the test above. This case
    // needs the two to arrive inside one read.
    val (backend, _) = NewTestBackend(20, 3, "\x1b[b")
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, final.Keys.Contains("b"), false,
                 "ESC [ b in one read should decode as a single CSI sequence")
}

func TestSequenceSplitInsideItsBodyStillReassembles(t T) T {
    // The reason the carry buffer exists, and the half that still works:
    // once a CSI has a body, a split anywhere inside it carries and
    // reassembles. `ESC [ 1` + `5~` is F5 torn mid-parameter.
    val (backend, _) = NewTestBackendChunks(20, 3, ArrayOf[string]("\x1b[1", "5~b"))
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, final.Keys.Contains("b"), true,
                 "a split F5 consumed the keystroke after it")
}

func TestSplitAtTheBodylessPrefixResolvesAsAltBracket(t T) T {
    // The documented cost of making Alt+[ work, asserted so the tradeoff is
    // visible rather than discovered.
    //
    // `ESC [` and `A` arriving in two separate reads is ambiguous: it is
    // either Alt+[ then `A`, or an arrow key torn at the one boundary that
    // leaves no body to carry. Without a read timeout the runtime cannot
    // tell, and it resolves to Alt+[ — because a terminal writes a whole
    // escape sequence in a single call, so a real arrow key does not split
    // here, while Alt+[ produces a bodyless two-byte read every time it is
    // pressed.
    //
    // A read timeout is the actual fix and would satisfy both. Until then
    // this is the better half of the trade.
    val (backend, _) = NewTestBackendChunks(20, 3, ArrayOf[string]("\x1b[", "A"))
    val final = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    return EqMsg(t, final.Keys.Contains("up"), false,
                 "a bodyless split should resolve as Alt+[ , not as an arrow key")
}

func TestSizeComesFromTheBackend(t T) T {
    // A 12-column backend must produce 12-column frames. This is the
    // property the inline `TermSize()` made untestable and the one a
    // non-fullscreen viewport depends on.
    val (backend, st) = NewTestBackend(12, 2, "")
    val prog = Program[BeModel, BeMsg](
        Initial = beInitial(), Update = beUpdate,
        View = (m) => FillCh('#'))
    val _ = Run[BeModel, BeMsg](prog, beKeyToMsg, backend)
    // Twelve '#' in a row, and not thirteen.
    val t1 = EqMsg(t, strings.Contains(st.Written, "############"), true,
                   "frame was not 12 columns wide")
    return EqMsg(t1, strings.Contains(st.Written, "#############"), false,
                 "frame was wider than the backend's 12 columns")
}

// ----------------------------------------------------------------------------
// The test backend itself
// ----------------------------------------------------------------------------

func TestTestBackendReportsEndOfScript(t T) T {
    val (backend, _) = NewTestBackend(10, 2, "hi")
    val buf = SliceWithSize[byte](8)
    val (n1, ok1) = backend.Read(buf)
    val t1 = Eq(t, n1, 2)
    val t2 = Eq(t1, ok1, true)
    val (_, ok2) = backend.Read(buf)
    return EqMsg(t2, ok2, false, "exhausted script should report not-ok")
}

func TestTestBackendSplitsLongInputAcrossReads(t T) T {
    // A read buffer smaller than the script is how a test reproduces an
    // escape sequence torn across two reads.
    val (backend, _) = NewTestBackend(10, 2, "abcdef")
    val small = SliceWithSize[byte](4)
    val (n1, _) = backend.Read(small)
    val (n2, _) = backend.Read(small)
    return Eq(t, s"$n1/$n2", "4/2")
}

// ============================================================================
// Inline viewport (G8)
//
// An inline app draws into N rows below the shell prompt instead of taking
// the whole terminal. The properties that matter are all about NOT owning
// the screen: never position absolutely, never enter the alternate screen,
// and leave the final frame on screen when the program exits.
// ============================================================================

func inlineFrame(rows int, width int, w Widget) string {
    val buf = NewBuffer(width, rows)
    RenderTo(w, Rect(X = 0, Y = 0, Width = width, Height = rows), buf)
    return inlineFrameString(buf, rows)
}

func TestInlineNeverPositionsAbsolutely(t T) T {
    // `ESC [ H` homes to the top-left of the SCREEN. An inline app that
    // emitted it would draw over the user's scrollback instead of into its
    // own block — the single most damaging thing it could do.
    val out = inlineFrame(3, 10, FillCh('#'))
    val t1 = EqMsg(t, strings.Contains(out, ansiHome()), false,
                   "inline frame used absolute cursor-home")
    return EqMsg(t1, strings.Contains(out, ansiAltScreenOn()), false,
                 "inline frame entered the alternate screen")
}

func TestInlineReturnsToTheTopOfItsBlock(t T) T {
    // Each paint must leave the cursor where the next paint expects it.
    // Without the walk-back, every frame would step one block further down
    // the screen and the viewport would crawl away from the prompt.
    val out = inlineFrame(4, 8, FillCh('x'))
    return EqMsg(t, strings.HasSuffix(out, ansiCursorUp(3)), true,
                 "frame did not walk the cursor back to the top of the block")
}

func TestInlineClearsEachRowBeforeRewriting(t T) T {
    // Frames are painted in place over the previous one. A row that gets
    // shorter would otherwise keep the tail of the old frame after it.
    val out = inlineFrame(2, 6, Text("hi"))
    return EqMsg(t, strings.Contains(out, ansiClearLine()), true,
                 "inline row was rewritten without clearing it first")
}

func TestInlineEmitsExactlyTheRequestedRows(t T) T {
    // Three rows means two row separators — one fewer than the row count.
    val out = inlineFrame(3, 6, FillCh('.'))
    return Eq(t, strings.Count(out, "\r\n"), 2)
}

func TestInlineUsesCarriageReturnsNotBareNewlines(t T) T {
    // In raw mode a bare LF moves down without returning to column 0, so
    // rows would stair-step diagonally across the screen.
    val out = inlineFrame(3, 6, FillCh('.'))
    return EqMsg(t, strings.Contains(out, "\n") == strings.Contains(out, "\r\n"),
                 true, "inline frame emitted a newline without a carriage return")
}

func TestInlineEnterReservesRowsBeforeDrawing(t T) T {
    // The newlines are what make the terminal scroll when the prompt is near
    // the bottom. Drawing first and scrolling later would push the top of
    // the frame into the scrollback mid-render.
    val out = inlineEnterString(4, "")
    val t1 = Eq(t, strings.Count(out, "\r\n"), 3)
    val t2 = EqMsg(t1, strings.HasSuffix(out, ansiCursorUp(3)), true,
                   "enter did not return to the top of the reserved block")
    return EqMsg(t2, strings.Contains(out, ansiAltScreenOn()), false,
                 "inline enter switched to the alternate screen")
}

func TestInlineExitLeavesTheFrameOnScreen(t T) T {
    // Leaving the output visible is the entire point: the alternate screen
    // erases it on exit, which is what a command whose output should survive
    // must not do. Exit steps BELOW the block and stops.
    val out = inlineExitString(3, "")
    val t1 = EqMsg(t, strings.Contains(out, ansiAltScreenOff()), false,
                   "inline exit left the alternate screen it never entered")
    val t2 = EqMsg(t1, strings.Contains(out, ansiClear()), false,
                   "inline exit cleared the screen, destroying its own output")
    return EqMsg(t2, strings.Contains(out, ansiCursorDown(2)), true,
                 "inline exit did not step past its block")
}

func TestInlineExitRestoresTheCursorAndModes(t T) T {
    val out = inlineExitString(2, ansiPasteOff())
    val t1 = EqMsg(t, strings.Contains(out, ansiCursorShow()), true,
                   "inline exit left the cursor hidden")
    return EqMsg(t1, strings.Contains(out, ansiPasteOff()), true,
                 "inline exit did not emit the mode-disable string")
}

func TestInlineBackendReportsTheViewportHeightNotTheTerminals(t T) T {
    // Size is what the runtime allocates its Buffer from, so an inline
    // backend claiming the terminal's height would render a full-screen
    // frame into a five-row block.
    val b = InlineBackend(5)
    val (_, h) = b.Size()
    return Eq(t, h, 5)
}

func TestInlineHeightIsAtLeastOne(t T) T {
    val b = InlineBackend(0)
    val (_, h) = b.Size()
    return Eq(t, h, 1)
}

func TestSingleRowInlineNeedsNoCursorMovement(t T) T {
    // A one-row viewport is the degenerate case: no separators, and nothing
    // to walk back up. `ansiCursorUp(0)` must be empty, not `ESC [ 0 A`,
    // which some terminals read as "up one".
    val out = inlineFrame(1, 8, Text("x"))
    val t1 = Eq(t, strings.Count(out, "\r\n"), 0)
    return EqMsg(t1, strings.Contains(out, "\x1b[0A"), false,
                 "emitted a zero-row cursor move")
}

// ============================================================================
// insert_before — lines into the scrollback, above the viewport
// ============================================================================

func TestInsertBeforeWritesEveryLineInOrder(t T) T {
    val out = inlineInsertBeforeString(ArrayOf[string]("first", "second"), 3)
    val t1 = EqMsg(t, strings.Index(out, "first") >= 0, true, "first line missing")
    val t2 = EqMsg(t1, strings.Index(out, "second") >= 0, true, "second line missing")
    return EqMsg(t2, strings.Index(out, "first") < strings.Index(out, "second"), true,
                 "lines reached the scrollback out of order")
}

func TestInsertBeforeClearsEachRowItWritesOver(t T) T {
    // The lines are written over viewport rows that still hold the previous
    // frame. Without the erase, a line shorter than the row it lands on
    // keeps the frame's tail — `done` over `working…` reads as `done ng…`.
    val out = inlineInsertBeforeString(ArrayOf[string]("done"), 2)
    return EqMsg(t, strings.Contains(out, "\r" + ansiClearLine() + "done"), true,
                 "a scrollback line did not erase the row it overwrote")
}

func TestInsertBeforeReReservesTheViewportAndComesBack(t T) T {
    // Two lines into a 3-row viewport. Six row-advances: two to walk the
    // block while blanking it, two for the lines, two to scroll the
    // viewport's rows back into existence. Without the re-reservation the
    // viewport would shrink by a row for every line printed.
    val out = inlineInsertBeforeString(ArrayOf[string]("a", "b"), 3)
    val t1 = Eq(t, strings.Count(out, "\r\n"), 6)
    // Twice: once to come back from blanking, once at the end.
    val t2 = Eq(t1, strings.Count(out, ansiCursorUp(2)), 2)
    return EqMsg(t2, strings.HasSuffix(out, "\r" + ansiCursorUp(2)), true,
                 "cursor was not left at the top of the viewport")
}

func TestInsertBeforeBlanksTheRowsTheLinesLandOn(t T) T {
    // A line wider than the terminal soft-wraps onto the next row, which is
    // still showing the previous frame. `ESC[K` only erases to the end of
    // the row the cursor is on, so the wrapped row's tail would keep the
    // frame's cells — and by the time the caller repaints, that row has
    // scrolled out of the viewport and into permanent scrollback. Blanking
    // the block first is what makes a wrapped line land on clean rows.
    val out = inlineInsertBeforeString(ArrayOf[string]("x"), 3)
    return EqMsg(t, strings.HasPrefix(out, inlineBlankBlockString(3)), true,
                 "the viewport's rows were not blanked before the lines landed")
}

func TestInsertBeforeResetsStyleAfterEveryLine(t T) T {
    // `ESC[K` erases with the *current* background, so a line that set a
    // colour and did not clear it would paint the full width of every row
    // after it — including the rows the re-reservation scrolls in.
    val out = inlineInsertBeforeString(ArrayOf[string]("\x1b[41mred", "plain"), 2)
    val t1 = EqMsg(t, strings.Contains(out, "red" + ResetSgr()), true,
                   "a line's style leaked into the next row")
    return EqMsg(t1, strings.Contains(out, "plain" + ResetSgr()), true,
                 "the last line's style leaked into the re-reserved rows")
}

func TestPrintedLinesSplitOnEmbeddedNewlines(t T) T {
    // In raw mode ONLCR is off, so a bare "\n" moves down a row without
    // returning to column 0: the text after it would start wherever the
    // text before it ended, on a row nothing cleared. One element, one row.
    val lines = PendingPrints(PrintAbove[CM]("one\ntwo"))
    val t1 = Eq(t, lines.Length(), 2)
    val t2 = Eq(t1, lines.Get(0), "one")
    val t3 = Eq(t2, lines.Get(1), "two")
    // A trailing newline is not an extra row — `PrintAbove("done\n")` means
    // what a caller porting a println expects it to mean.
    return Eq(t3, PendingPrints(PrintAbove[CM]("done\n")).Length(), 1)
}

func TestInsertBeforeNeverPositionsAbsolutely(t T) T {
    // Same rule the frame painter follows: an inline app that homed the
    // cursor would write over the user's scrollback rather than into it.
    val out = inlineInsertBeforeString(ArrayOf[string]("x"), 4)
    return EqMsg(t, strings.Contains(out, "\x1b[H"), false,
                 "insert_before homed the cursor")
}

func TestSingleRowInlineInsertNeedsNoCursorMovement(t T) T {
    val out = inlineInsertBeforeString(ArrayOf[string]("x"), 1)
    return EqMsg(t, strings.Contains(out, "\x1b[0A"), false,
                 "emitted a zero-row cursor move")
}

// ----------------------------------------------------------------------------
// …and the whole way through the run loop
// ----------------------------------------------------------------------------

func TestRunEmitsPrintedLinesThroughTheBackend(t T) T {
    // 'p' prints. The line must reach the backend, not the frame — a widget
    // rendering it would put it inside the viewport, where the next paint
    // overwrites it.
    val (backend, st) = NewTestBackend(30, 2, "p")
    val _ = Run[BeModel, BeMsg](bePrintProgram(), bePrintKeyToMsg, backend)
    return EqMsg(t, st.Wrote("logged: p"), true,
                 "a PrintCmd line never reached the backend")
}

func TestPrintedLinesSurviveAQuitInTheSameUpdate(t T) T {
    // An app whose last act is to print a summary and exit means both. If
    // the quit check came first, whether the output survived would depend on
    // the order of a Batch.
    val (backend, st) = NewTestBackend(30, 2, "z")
    val _ = Run[BeModel, BeMsg](bePrintProgram(), bePrintKeyToMsg, backend)
    return EqMsg(t, st.Wrote("bye"), true,
                 "a line printed alongside QuitCmd was dropped")
}

func TestTheFinalFrameIsRepaintedAfterAPrintingQuit(t T) T {
    // The defect this pins: printed lines are written over the viewport's
    // rows on their way into the scrollback, and the loop's next paint is
    // what puts the frame back. Quitting in the same update() returned
    // before that paint, freezing a half-scrolled frame into the user's
    // scrollback — with as many lines as the viewport is tall, the whole
    // final frame was replaced by blank rows.
    val (backend, st) = NewTestBackend(30, 2, "z")
    val _ = Run[BeModel, BeMsg](bePrintProgram(), bePrintKeyToMsg, backend)
    val printedAt = strings.Index(st.Written, "bye")
    val framedAt = strings.LastIndex(st.Written, "keys=")
    val t1 = EqMsg(t, printedAt >= 0, true, "the line was not printed")
    return EqMsg(t1, framedAt > printedAt, true,
                 "no frame was painted after the printed line")
}

func TestTheExitPaintShowsTheFinalModelNotTheInitialOne(t T) T {
    // The exit guard closes over `model`, which the loop reassigns. If the
    // closure captured its value at declaration instead of reading the
    // variable, every run would end by repainting the initial frame over
    // the final one — a worse bug than the one the guard fixes.
    val (backend, st) = NewTestBackend(40, 2, "ab")
    val _ = Run[BeModel, BeMsg](beProgram(), beKeyToMsg, backend)
    // The last "keys=" in the stream is the exit repaint; it must be the
    // two-keystroke frame, not the empty initial one.
    val lastFrame = strings.LastIndex(st.Written, "keys=a,b")
    val lastAny = strings.LastIndex(st.Written, "keys=")
    return EqMsg(t, lastFrame, lastAny, "the exit repaint used a stale model")
}

func TestFullScreenBackendReportsThatItDroppedTheLines(t T) T {
    // The alternate screen has no scrollback to insert into. Saying so is
    // what keeps the runtime from throwing away its frame diff for an
    // insert that never happened — DiffString(nil) is a whole screen of
    // cells, so an app printing on a ticker would rewrite the terminal on
    // every frame to no purpose.
    return Eq(t, TerminalBackend().InsertBefore(ArrayOf[string]("nowhere")), false)
}

func TestEmitPrintsToleratesABackendWithoutInsertBefore(t T) T {
    // Backend is public and its fields are plain functions, so a consumer's
    // backend built before PrintAbove existed still compiles against this
    // version — with a nil field. Without the guard the first PrintAbove in
    // any app using one would nil-deref inside the run loop.
    val (complete, _) = NewTestBackend(10, 1, "")
    val legacy = Backend(
        Name      = "legacy",
        Size      = complete.Size,
        Write     = complete.Write,
        Read      = complete.Read,
        ReadAsync = complete.ReadAsync,
        Open      = complete.Open,
        Paint     = complete.Paint,
    )
    return Eq(t, emitPrints(legacy, ArrayOf[string]("x")), false)
}
