package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Table tests
// ============================================================================

func TestTableWithHeadersRenders(t T) T {
    val data = NewTableWithHeaders(
        ArrayOf[string]("Name", "Age"),
        ArrayOf[Constraint](Length(5), Length(5)),
        ArrayOf[Array[string]](
            ArrayOf[string]("Alice", "30"),
            ArrayOf[string]("Bob",   "25"),
        ),
        -1,
    )
    // Two Length(5) columns with one column of row spacing between them.
    // "Alice" exactly fills its slot, which is the case a per-cell gutter
    // could not separate without shortening the column: it used to render
    // "Alice30", one token naming nobody. The spacing comes off the row,
    // so the declared width still shows all five characters.
    val buf = NewBuffer(11, 4)
    RenderTo(Table(data), Rect(X = 0, Y = 0, Width = 11, Height = 4), buf)
    val t1 = Eq(t, RowText(buf, 0), "Name  Age  ")
    val t2 = Eq(t1, RowText(buf, 1), "───────────")
    val t3 = Eq(t2, RowText(buf, 2), "Alice 30   ")
    return Eq(t3, RowText(buf, 3), "Bob   25   ")
}

func TestTableSelectionHighlight(t T) T {
    // Length(4) + spacing + Length(2) → row 0 is "one " + " " + "1 "
    val data = NewTable(
        ArrayOf[Constraint](Length(4), Length(2)),
        ArrayOf[Array[string]](
            ArrayOf[string]("one", "1"),
            ArrayOf[string]("two", "2"),
        ),
        1,
    )
    val buf = NewBuffer(7, 2)
    RenderTo(Table(data), Rect(X = 0, Y = 0, Width = 7, Height = 2), buf)
    val t1 = Eq(t, RowText(buf, 0), "one  1 ")
    // Second row should be reverse-video (the selected row).
    return IsTrue(t1, buf.Get(0, 1).St.Reverse)
}

func TestExactFitColumnsStaySeparated(t T) T {
    // The regression this guards: with the gutter charged to the cell, a
    // value that exactly filled its column got no separator AND no
    // ellipsis, so two columns ran together into one unreadable token.
    // Charging the row instead keeps the declared width intact and still
    // puts a blank between them.
    val data = NewTable(
        ArrayOf[Constraint](Length(5), Length(5)),
        ArrayOf[Array[string]](ArrayOf[string]("Alice", "Bobby")),
        -1,
    )
    val buf = NewBuffer(11, 1)
    RenderTo(Table(data), Rect(X = 0, Y = 0, Width = 11, Height = 1), buf)
    val t1 = Eq(t, RowText(buf, 0), "Alice Bobby")
    // Neither value was shortened to pay for the gap.
    return Eq(t1, buf.Get(4, 0).Ch, 'e')
}

func TestTableEmpty(t T) T {
    val data = NewTable(EmptyArray[Constraint](), EmptyArray[Array[string]](), -1)
    val buf = NewBuffer(5, 2)
    RenderTo(Table(data), Rect(X = 0, Y = 0, Width = 5, Height = 2), buf)
    return Eq(t, RowText(buf, 0), "     ")
}

// ============================================================================
// Sparkline tests
// ============================================================================

func TestSparklineRendersBlocks(t T) T {
    val buf = NewBuffer(6, 1)
    val w = Sparkline(ArrayOf(0, 1, 2, 4, 6, 8))
    RenderTo(w, Rect(X = 0, Y = 0, Width = 6, Height = 1), buf)
    // Values 0..8 with max=8 give ratios 0/1/2/4/6/8 eighths. The series
    // MINIMUM now floors to the smallest visible block instead of rendering
    // as a blank cell — a low value and a missing one were indistinguishable,
    // so a dip in a series read as a hole in the data.
    return Eq(t, RowText(buf, 0), "▁▁▂▄▆█")
}

// A fixed max keeps a low series low: 2..8 of 16 is the bottom half of the
// ramp, where the series' own max would stretch 8 to a full block.
func TestSparklineFixedMaxKeepsTheScale(t T) T {
    val buf = NewBuffer(4, 1)
    RenderTo(SparklineStyled(ArrayOf(2, 4, 6, 8), DefaultStyle(), SparkLeftToRight(), 16),
        Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    return Eq(t, RowText(buf, 0), "▁▂▃▄")
}

// A sample over the fixed max draws full rather than past the ramp.
func TestSparklineClampsSamplesAboveTheFixedMax(t T) T {
    val buf = NewBuffer(3, 1)
    RenderTo(SparklineOf(ArrayOf(Some(5), Some(10), Some(40)), DefaultStyle(), SparkLeftToRight(), 10),
        Rect(X = 0, Y = 0, Width = 3, Height = 1), buf)
    return Eq(t, RowText(buf, 0), "▄██")
}

func TestSparklineEmptyIsNothing(t T) T {
    val buf = NewBuffer(4, 1)
    val w = Sparkline(EmptyArray[int]())
    RenderTo(w, Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    return Eq(t, RowText(buf, 0), "    ")
}

func TestSparklineAllZerosIsAFlatLineNotBlank(t T) T {
    // An all-zero series is DATA, and it must not look like no data. The
    // distinction that matters is against `TestSparklineEmptyIsNothing`
    // above, which still renders blank: an empty series has nothing to
    // show, a flat-at-zero series has something to show and it is flat.
    //
    // This is the same rule as the LineChart flat-series case — a steady
    // metric was rendering as an empty panel.
    val buf = NewBuffer(4, 1)
    val w = Sparkline(ArrayOf(0, 0, 0, 0))
    RenderTo(w, Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    return Eq(t, RowText(buf, 0), "▁▁▁▁")
}

// ============================================================================
// BarChart tests
// ============================================================================

func TestBarChartRendersRows(t T) T {
    val data = ArrayOf[BarChartDatum](
        BarChartDatum(Label = "A", Value = 10),
        BarChartDatum(Label = "B", Value = 5),
    )
    val buf = NewBuffer(12, 2)
    RenderTo(BarChart(data), Rect(X = 0, Y = 0, Width = 12, Height = 2), buf)
    // Row 0: "A " label (2 cells) + Gauge(100) for 10 wide = all full
    // Row 1: "B " label + Gauge(50) for 10 wide = 5 full + 5 empty
    val t1 = IsTrue(t, strings.HasPrefix(RowText(buf, 0), "A "))
    return IsTrue(t1, strings.HasPrefix(RowText(buf, 1), "B "))
}

// ============================================================================
// Tree tests
// ============================================================================

func TestTreeRendersCollapsed(t T) T {
    val root = NewTreeBranch("root", ArrayOf(
        NewTreeLeaf("child1"),
        NewTreeLeaf("child2"),
    ))
    val buf = NewBuffer(15, 3)
    RenderTo(Tree(root), Rect(X = 0, Y = 0, Width = 15, Height = 3), buf)
    // Collapsed: only root visible, with ▶ marker.
    val t1 = IsTrue(t, strings.Contains(RowText(buf, 0), "▶ root"))
    // Child rows should NOT appear.
    return IsFalse(t1, strings.Contains(RowText(buf, 1), "child"))
}

func TestTreeRendersExpanded(t T) T {
    val root = NewTreeBranchExpanded("root", ArrayOf(
        NewTreeLeaf("child1"),
        NewTreeLeaf("child2"),
    ))
    val buf = NewBuffer(15, 3)
    RenderTo(Tree(root), Rect(X = 0, Y = 0, Width = 15, Height = 3), buf)
    val t1 = IsTrue(t, strings.Contains(RowText(buf, 0), "▼ root"))
    val t2 = IsTrue(t1, strings.Contains(RowText(buf, 1), "child1"))
    return IsTrue(t2, strings.Contains(RowText(buf, 2), "child2"))
}

func TestTreeLeafMarker(t T) T {
    val leaf = NewTreeLeaf("alone")
    val buf = NewBuffer(10, 1)
    RenderTo(Tree(leaf), Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    // Leaf uses • marker.
    return IsTrue(t, strings.Contains(RowText(buf, 0), "• alone"))
}

func TestTreeDeepIndentation(t T) T {
    val deep = NewTreeBranchExpanded("a", ArrayOf(
        NewTreeBranchExpanded("b", ArrayOf(
            NewTreeLeaf("c"),
        )),
    ))
    val buf = NewBuffer(12, 3)
    RenderTo(Tree(deep), Rect(X = 0, Y = 0, Width = 12, Height = 3), buf)
    // "c" is indented 2 levels — 4 spaces of leading whitespace.
    return IsTrue(t, strings.HasPrefix(RowText(buf, 2), "    • c"))
}
