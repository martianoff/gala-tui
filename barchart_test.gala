package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// BarChartOf / HBarChartOf
// ============================================================================

func barRows(w Widget, width int, height int) Array[string] {
    val buf = renderAt(w, width, height)
    return ArrayTabulate(height, (y) => BufferText(buf, y))
}

func oneGroup(bars Array[Bar]) Array[BarGroup] = ArrayOf[BarGroup](BarGroupOf("", bars))

func narrowBars() BarGeometry = BarGeometry(Width = 1, Gap = 1, GroupGap = 2)

// The tallest bar fills the plot, the value row above it included, and a
// bar half its value reaches half as high. Rows read top to bottom.
func TestVerticalBarsStandOnTheBaseline(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 4), BarOf("", 2))),
                       DefaultStyle(), narrowBars())
    val rows = barRows(w, 3, 5)
    val t1 = Eq(t, rows.Get(0), "4  ")
    val t2 = Eq(t1, rows.Get(1), "█  ")
    val t3 = Eq(t2, rows.Get(2), "█ 2")
    val t4 = Eq(t3, rows.Get(3), "█ █")
    return Eq(t4, rows.Get(4), "█ █")
}

// A bar ends in eighths, so 1 in a four-row plot scaled to 8 is half a cell,
// not a whole one — the resolution whole cells would throw away.
func TestVerticalBarEndsInEighths(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 1).WithText(""), BarOf("", 8).WithText(""))),
                       DefaultStyle(), narrowBars())
    val rows = barRows(w, 3, 5)
    return Eq(t, rows.Get(4), "▄ █")
}

// Labels sit under their bars and group labels under the whole group, and
// a group's gap is its own: the second group starts GroupGap past the first.
func TestGroupLabelsCentreUnderTheirBars(t T) T {
    val groups = ArrayOf[BarGroup](
        BarGroupOf("ab", ArrayOf[Bar](BarOf("a", 1), BarOf("b", 1))),
        BarGroupOf("cd", ArrayOf[Bar](BarOf("c", 1), BarOf("d", 1))),
    )
    val rows = barRows(BarChartOf(groups, DefaultStyle(), narrowBars()), 8, 5)
    val t1 = Eq(t, rows.Get(3), "a b  c d")
    return Eq(t1, rows.Get(4), "ab   cd ")
}

// A value wider than its bar is not printed rather than spilling over the
// neighbour it would be read as belonging to.
func TestValueWiderThanTheBarIsOmitted(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 100), BarOf("", 7))),
                       DefaultStyle(), narrowBars(), 100)
    return Eq(t, barRows(w, 3, 4).Get(3), "█ ▁")
}

// A bar that does not fit whole is not drawn: a clipped column reads as a
// thinner bar, not as a missing one.
func TestBarThatDoesNotFitIsDropped(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 5), BarOf("", 5))))
    return Eq(t, barRows(w, 6, 3).Get(2), "███   ")
}

// An explicit maximum fixes the scale; a value past it saturates rather
// than growing into the value row.
func TestExplicitMaxFixesTheScaleAndSaturates(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 5).WithText(""), BarOf("", 50).WithText(""))),
                       DefaultStyle(), narrowBars(), 10)
    val rows = barRows(w, 3, 3)
    val t1 = Eq(t, rows.Get(0), "   ")
    val t2 = Eq(t1, rows.Get(1), "  █")
    return Eq(t2, rows.Get(2), "█ █")
}

// A zero or negative value draws no bar but still prints its value on the
// baseline, so "0" reads as a measurement.
func TestZeroBarPrintsItsValueOnTheBaseline(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 0), BarOf("", -3).WithText("x"), BarOf("", 4))),
                       DefaultStyle(), narrowBars())
    return Eq(t, barRows(w, 5, 3).Get(2), "0 x █")
}

// An unstyled bar takes the chart's style; a styled one keeps its own.
func TestBarStyleOverridesTheChartStyle(t T) T {
    val chart = DefaultStyle().WithFg(Blue())
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 1), BarOf("", 1).WithStyle(DefaultStyle().WithFg(Red())))),
                       chart, narrowBars())
    val buf = renderAt(w, 3, 2)
    val t1 = Eq(t, buf.StyleAt(0, 1).Fg, Blue())
    return Eq(t1, buf.StyleAt(2, 1).Fg, Red())
}

// Dimming a pane dims its bar chart — bars with their own style included —
// through the fluent path, which is why the chart is a Widget case rather
// than a CustomW: `restyleLeaves` passes a CustomW through untouched.
func TestBarChartRestylesWithItsPane(t T) T {
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", 1), BarOf("", 1).WithStyle(DefaultStyle().WithFg(Red())))),
                       DefaultStyle(), narrowBars()).WithDim()
    val buf = renderAt(w, 3, 2)
    val t1 = IsTrue(t, buf.StyleAt(0, 1).Dim)
    val t2 = IsTrue(t1, buf.StyleAt(2, 1).Dim)
    return Eq(t2, buf.StyleAt(2, 1).Fg, Red())
}

func TestEmptyBarChartIsEmpty(t T) T =
    Eq(t, barRows(BarChartOf(oneGroup(EmptyArray[Bar]())), 3, 2).Get(1), "   ")

// Horizontal: labels in a column, bars from a common left edge, each value
// just past the end of its bar.
func TestHorizontalBarsGrowFromTheLabelColumn(t T) T {
    val w = HBarChartOf(oneGroup(ArrayOf[Bar](BarOf("a", 8), BarOf("bb", 4))))
    val rows = barRows(w, 12, 2)
    // label column 3 ("bb "), value column 2 (" 8"): 7 cells of bar.
    val t1 = Eq(t, rows.Get(0), "a  ███████ 8")
    return Eq(t1, rows.Get(1), "bb ███▌ 4   ")
}

// Horizontal groups get a label row each and a blank row between them.
func TestHorizontalGroupsAreLabelledAndSeparated(t T) T {
    val groups = ArrayOf[BarGroup](
        BarGroupOf("g1", ArrayOf[Bar](BarOf("", 2).WithText(""))),
        BarGroupOf("g2", ArrayOf[Bar](BarOf("", 1).WithText(""))),
    )
    val rows = barRows(HBarChartOf(groups), 4, 5)
    val t1 = Eq(t, rows.Get(0), "g1  ")
    val t2 = Eq(t1, rows.Get(1), "████")
    val t3 = Eq(t2, rows.Get(2), "    ")
    val t4 = Eq(t3, rows.Get(3), "g2  ")
    return Eq(t4, rows.Get(4), "██  ")
}

func TestBarChartOfValuesIsOneUngroupedChart(t T) T {
    val w = BarChartOfValues(ArrayOf[BarChartDatum](
        BarChartDatum(Label = "api", Value = 2), BarChartDatum(Label = "db", Value = 1)))
    val rows = barRows(w, 7, 4)
    val t1 = Eq(t, rows.Get(0), " 2     ")
    return Eq(t1, rows.Get(3), "api db ")
}

// A horizontal group whose first bar does not fit leaves no label behind:
// a label on the last row with nothing under it names data that is off
// screen.
func TestHorizontalGroupLabelNeedsRoomForABar(t T) T {
    val groups = ArrayOf[BarGroup](
        BarGroupOf("g1", ArrayOf[Bar](BarOf("", 2).WithText(""))),
        BarGroupOf("g2", ArrayOf[Bar](BarOf("", 1).WithText(""))),
    )
    return Eq(t, barRows(HBarChartOf(groups), 4, 4).Get(3), "    ")
}

// A maximum near the top of the int range still draws the bar that reaches
// it, rather than wrapping the multiplication to an empty bar.
func TestHugeMaximumDoesNotOverflow(t T) T {
    val big = 9223372036854775807
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", big).WithText(""))),
                       DefaultStyle(), narrowBars())
    return Eq(t, barRows(w, 1, 3).Get(2), "█")
}

// A bar below the maximum is scaled without an int product: at byte-count
// magnitudes `value * cells * 8` wraps negative, and the bar vanished while
// its value printed below the baseline.
func TestLargeValuesBelowTheMaximumScaleWithoutWrapping(t T) T {
    val big = 9223372036854775807
    val w = BarChartOf(oneGroup(ArrayOf[Bar](BarOf("", big).WithText(""), BarOf("", big / 2).WithText(""))),
                       DefaultStyle(), narrowBars())
    return Eq(t, barRows(w, 3, 3).Get(2), "█ █")
}

// A short chart gives up the value row, then group labels, then bar labels —
// and draws bars in whatever is left rather than going blank.
func TestShortVerticalChartGivesUpLabelsBeforeBars(t T) T {
    val groups = ArrayOf[BarGroup](BarGroupOf("g", ArrayOf[Bar](BarOf("a", 1), BarOf("b", 1))))
    val two = barRows(BarChartOf(groups, DefaultStyle(), narrowBars()), 3, 2)
    val t1 = Eq(t, two.Get(0), "█ █")
    val t2 = Eq(t1, two.Get(1), "a b")
    return Eq(t2, barRows(BarChartOf(groups, DefaultStyle(), narrowBars()), 3, 1).Get(0), "█ █")
}

// One long label no longer reserves the whole width: the label column is
// capped at half and truncated, and the bar still draws.
func TestLongHorizontalLabelIsCappedNotFatal(t T) T {
    val w = HBarChartOf(oneGroup(ArrayOf[Bar](BarOf("payments-reconciliation", 1).WithText(""))))
    return Eq(t, barRows(w, 10, 1).Get(0), "payme ████")
}

// With GroupGap < Gap the next group's first bar could squeeze in where the
// rest of a truncated group did not, and read as that group's missing bar.
// The first bar that does not fit ends the chart.
func TestBarThatDoesNotFitEndsTheChartNotJustItsGroup(t T) T {
    val geom = BarGeometry(Width = 1, Gap = 2, GroupGap = 0)
    val groups = ArrayOf[BarGroup](
        BarGroupOf("", ArrayOf[Bar](BarOf("", 1).WithText(""), BarOf("", 1).WithText(""))),
        BarGroupOf("", ArrayOf[Bar](BarOf("", 1).WithText(""))),
    )
    return Eq(t, barRows(BarChartOf(groups, DefaultStyle(), geom), 2, 2).Get(1), "█ ")
}

// The intrinsic width counts each group's own inner gaps — an empty group
// contributes none — and a group label wider than its bars widens the group.
func TestIntrinsicWidthCountsGapsPerGroupAndGroupLabels(t T) T {
    val geom = BarGeometry(Width = 3, Gap = 1, GroupGap = 2)
    val gapped = ArrayOf[BarGroup](
        BarGroupOf("", ArrayOf[Bar](BarOf("", 1), BarOf("", 1))),
        BarGroupOf("", EmptyArray[Bar]()),
    )
    val labelled = ArrayOf[BarGroup](BarGroupOf("frontend", ArrayOf[Bar](BarOf("", 1))))
    val t1 = Eq(t, barChartIntrinsic(gapped, geom, BarsVertical()).V1, 9)
    return Eq(t1, barChartIntrinsic(labelled, geom, BarsVertical()).V1, 8)
}
