package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/test"
)

// ============================================================================
// FormState tests — verify update semantics and validator behavior.
// ============================================================================

func sampleForm() FormState = NewForm(ArrayOf(
    NewFieldRequired("name", "Name", "your name"),
    NewFieldRequired("email", "Email", "you@example.com"),
))

func TestFormStartsWithFocusAtZero(t T) T {
    return Eq(t, sampleForm().Focused, 0)
}

func TestFormCharInsertAppendsToFocusedField(t T) T {
    val f1 = FormUpdate(sampleForm(), FEChar(C = 'A'))
    val f2 = FormUpdate(f1, FEChar(C = 'l'))
    val f3 = FormUpdate(f2, FEChar(C = 'i'))
    return Eq(t, FormValue(f3, "name"), "Ali")
}

func TestFormBackspaceDropsOneRune(t T) T {
    val f1 = FormUpdate(sampleForm(), FEChar(C = 'A'))
    val f2 = FormUpdate(f1, FEChar(C = 'B'))
    val f3 = FormUpdate(f2, FEBackspace())
    return Eq(t, FormValue(f3, "name"), "A")
}

func TestFormBackspaceOnEmptyIsNoOp(t T) T {
    val f = FormUpdate(sampleForm(), FEBackspace())
    return Eq(t, FormValue(f, "name"), "")
}

func TestFormNextCyclesFocus(t T) T {
    val f1 = FormUpdate(sampleForm(), FENext())
    val t1 = Eq(t, f1.Focused, 1)
    val f2 = FormUpdate(f1, FENext())
    return Eq(t1, f2.Focused, 0)
}

func TestFormPrevWrapsAround(t T) T {
    val f = FormUpdate(sampleForm(), FEPrev())
    return Eq(t, f.Focused, 1)
}

func TestFormTypingIntoSecondField(t T) T {
    val f0 = sampleForm()
    val f1 = FormUpdate(f0, FENext())          // focus email
    val f2 = FormUpdate(f1, FEChar(C = 'a'))
    val f3 = FormUpdate(f2, FEChar(C = '@'))
    val f4 = FormUpdate(f3, FEChar(C = 'b'))
    val t1 = Eq(t, FormValue(f4, "name"), "")
    return Eq(t1, FormValue(f4, "email"), "a@b")
}

func TestFormInvalidSubmitJumpsToFirstInvalid(t T) T {
    // Both fields empty — first invalid is "name" (index 0). Focus starts
    // there, so submitting while empty keeps focus at 0 and leaves
    // Submitted = false.
    val f0 = FormUpdate(sampleForm(), FENext())   // focus the second one
    val f1 = FormUpdate(f0, FESubmit())
    val t1 = IsFalse(t, f1.Submitted)
    return Eq(t1, f1.Focused, 0)
}

func TestFormValidSubmitMarksSubmitted(t T) T {
    var f = sampleForm()
    // Fill both fields with any non-empty value.
    f = FormUpdate(f, FEChar(C = 'A'))
    f = FormUpdate(f, FENext())
    f = FormUpdate(f, FEChar(C = 'B'))
    val submitted = FormUpdate(f, FESubmit())
    return IsTrue(t, submitted.Submitted)
}

func TestFormIsValidFalseWhenAnyInvalid(t T) T {
    val f1 = FormUpdate(sampleForm(), FEChar(C = 'A'))  // name set
    return IsFalse(t, FormIsValid(f1))   // email still empty → invalid
}

func TestFormValueOptMissingFieldReturnsNone(t T) T {
    val missing = FormValueOpt(sampleForm(), "nonexistent")
    return IsFalse(t, missing.IsDefined())
}

func TestFormCustomValidator(t T) T {
    val emailValidator = (v string) => {
        if v == "" {
            return Some[string]("required")
        }
        // Look for '@'.
        var hasAt = false
        for _, c := range v {
            if c == '@' { hasAt = true }
        }
        if !hasAt {
            return Some[string]("missing @")
        }
        return None[string]()
    }
    val custom = NewForm(ArrayOf(
        NewFieldValidated("email", "Email", "you@…", emailValidator),
    ))
    var f = custom
    f = FormUpdate(f, FEChar(C = 'b'))
    f = FormUpdate(f, FEChar(C = 'a'))
    f = FormUpdate(f, FEChar(C = 'd'))
    // "bad" has no '@' — should be invalid.
    val t1 = IsFalse(t, FormIsValid(f))
    f = FormUpdate(f, FEChar(C = '@'))
    // "bad@" has '@' — now valid.
    return IsTrue(t1, FormIsValid(f))
}

// ----------------------------------------------------------------------------
// View rendering
// ----------------------------------------------------------------------------

func TestFormViewRendersLabelsAndErrors(t T) T {
    val f = sampleForm()
    val buf = NewBuffer(30, 9)
    RenderTo(FormView(f), Rect(X = 0, Y = 0, Width = 30, Height = 9), buf)
    val joined = joinAllRows(buf)
    val t1 = IsTrue(t, strings.Contains(joined, "Name"))
    val t2 = IsTrue(t1, strings.Contains(joined, "Email"))
    // Required error should appear on the first field (empty).
    return IsTrue(t2, strings.Contains(joined, "required"))
}

func joinAllRows(buf *Buffer) string {
    var s = ""
    var y = 0
    for y < buf.Height {
        s = s + BufferText(buf, y) + "\n"
        y = y + 1
    }
    return s
}

// ============================================================================
// Masked fields — a password is drawn, never carried
// ============================================================================

func maskedForm() FormState = NewForm(ArrayOf(
    NewFieldRequired("user", "User", "who"),
    NewFieldRequired("pass", "Password", "at least 12 chars").Copy(Masked = true),
))

func TestMaskedFieldStillYieldsTheRealValue(t T) T {
    // Masking is a drawing decision. Submit has to see what was typed.
    val f = ArrayOf[FormEvent](FENext(), FEChar(C = 'p'), FEChar(C = 'w'))
        .FoldLeft(maskedForm(), FormUpdate)
    return Eq(t, FormValue(f, "pass"), "pw")
}

func TestMaskedFieldValidatesAgainstTheRealValue(t T) T {
    // The required validator must run on the value, not on the bullets —
    // an empty masked field is empty, however many characters are drawn.
    val t1 = EqMsg(t, FormIsValid(maskedForm()), false,
                   "an empty required password passed validation")
    val f = ArrayOf[FormEvent](FEChar(C = 'u'), FENext(), FEChar(C = 'p'))
        .FoldLeft(maskedForm(), FormUpdate)
    return EqMsg(t1, FormIsValid(f), true, "a filled masked field failed validation")
}

func TestUnmaskedFieldsAreUnaffected(t T) T {
    val f = ArrayOf[FormEvent](FEChar(C = 'a'), FEChar(C = 'l'))
        .FoldLeft(maskedForm(), FormUpdate)
    val out = Render(FormView(f, true))
    return EqMsg(t, strings.Contains(out, "al"), true,
                 "a plain field stopped rendering its value")
}

func TestAMaskedFieldsPlaceholderIsDrawnVerbatim(t T) T {
    // Not a defect — an empty field holds no secret, and a form that hid its
    // own prompt would be unusable. Pinned because it is the trap: a
    // placeholder that looks like a sample password reads as the value.
    val out = Render(FormView(maskedForm(), true))
    return EqMsg(t, strings.Contains(out, "at least 12 chars"), true,
                 "a masked field stopped showing its placeholder")
}

func TestAValidatorThatQuotesTheValueLeaksIt(t T) T {
    // The one hole in "the tree never holds the secret", pinned so it is a
    // documented contract rather than a surprise. The validator is handed
    // the plaintext — it has to be, that is what it validates — and its
    // message is drawn as given. A validator that echoes its input puts the
    // secret back on screen, and masking cannot stop it.
    val echoing = (v string) => if (v == "") None[string]() else Some(s"bad: $v")
    val f = ArrayOf[FormEvent](FEChar(C = 'x'), FEChar(C = 'y')).FoldLeft(
        NewForm(ArrayOf(
            NewFieldValidated("pass", "Password", "", echoing).Copy(Masked = true),
        )),
        FormUpdate,
    )
    val out = Render(FormView(f, true))
    val t1 = EqMsg(t, strings.Contains(out, "••"), true, "the value was not masked")
    return EqMsg(t1, strings.Contains(out, "bad: xy"), true,
                 "the contract changed: validator messages are no longer verbatim")
}

func TestMaskedFieldDrawsTheCallersMaskChar(t T) T {
    // A terminal configured East-Asian-ambiguous-wide draws the default
    // bullet in two cells, which smears a frame across a long password.
    val f = ArrayOf[FormEvent](FEChar(C = 'a'), FEChar(C = 'b')).FoldLeft(
        NewForm(ArrayOf(
            NewFieldRequired("pass", "Password", "").Copy(Masked = true, MaskChar = '*'),
        )),
        FormUpdate,
    )
    val out = Render(FormView(f, true))
    val t1 = EqMsg(t, strings.Contains(out, "**"), true, "the mask glyph was ignored")
    return EqMsg(t1, strings.Contains(out, "••"), false, "the default mask was drawn anyway")
}

func TestMaskedFieldDrawsBulletsNotTheValue(t T) T {
    val f = ArrayOf[FormEvent](
        FENext(), FEChar(C = 'h'), FEChar(C = 'u'), FEChar(C = 'n'), FEChar(C = 't'),
    ).FoldLeft(maskedForm(), FormUpdate)
    val out = joinAllRows(renderAt(FormView(f, true), 24, 8))
    val t1 = EqMsg(t, strings.Contains(out, "hunt"), false,
                   "the typed password was rendered in clear text")
    return EqMsg(t1, strings.Contains(out, "••••"), true,
                 "the masked field drew no bullets")
}

func TestAFieldLiteralWithoutMaskCharStillMasks(t T) T {
    // A struct-field default does not apply to a literal that omits the
    // field, so every FormField written before MaskChar existed carries the
    // zero rune. Without the fallback, switching such a field to Masked
    // would draw the password as a run of NULs — an invisible field that
    // looks empty while holding a secret.
    val legacy = FormField(
        Name        = "pass",
        Label       = "Password",
        Value       = "",
        Placeholder = "",
        Validator   = (_) => None[string](),
    ).Copy(Masked = true)
    val f = ArrayOf[FormEvent](FEChar(C = 'a'), FEChar(C = 'b'))
        .FoldLeft(NewForm(ArrayOf(legacy)), FormUpdate)
    val out = Render(FormView(f, true))
    return EqMsg(t, strings.Contains(out, "••"), true,
                 "a field built without MaskChar drew no visible mask")
}
