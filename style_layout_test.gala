package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
    "strings"
)

// ============================================================================
// Overlap spacing, quadrant / custom borders, Hidden + RapidBlink, colours
// ============================================================================

// Negative spacing overlaps neighbours by that many cells: two bordered
// panes with spacing -1 share the line between them.
func TestNegativeSpacingCollapsesBorders(t T) T {
    val w = RowSpaced(ArrayOf[LayoutChild](Fixed(3, Border(Empty())), Fixed(3, Border(Empty()))), -1)
    val buf = renderAt(w, 5, 3)
    val t1 = Eq(t, bufferLines(buf).Get(0), "┌─┬─┐")
    val t2 = Eq(t1, bufferLines(buf).Get(1), "│ │ │")
    return Eq(t2, bufferLines(buf).Get(2), "└─┴─┘")
}

// Overlap gives the children the room it takes back: two Fill children in 5
// columns with spacing -1 are 3 wide each and end exactly at the edge.
func TestOverlapChildrenFillTheArea(t T) T {
    val w = RowSpaced(ArrayOf[LayoutChild](Flex(1, FillCh('a')), Flex(1, FillCh('b'))), -1)
    return Eq(t, bufferLines(renderAt(w, 5, 1)).Get(0), "aabbb")
}

func TestQuadrantBorders(t T) T {
    val out = RowText(renderAt(BorderOf(Empty(), QuadrantOutsideBorder()), 4, 3), 0)
    val inside = RowText(renderAt(BorderOf(Empty(), QuadrantInsideBorder()), 4, 3), 2)
    val t1 = Eq(t, out, "▛▀▀▜")
    return Eq(t1, inside, "▝▀▀▘")
}

func TestCustomBorderUsesItsGlyphs(t T) T {
    val g = BorderGlyphs(TL = '1', TR = '2', BL = '3', BR = '4', Top = 't', Bottom = 'b', Left = 'l', Right = 'r')
    val buf = renderAt(BorderOf(Empty(), CustomBorder(g)), 3, 3)
    val t1 = Eq(t, bufferLines(buf).Get(0), "1t2")
    val t2 = Eq(t1, bufferLines(buf).Get(1), "l r")
    return Eq(t2, bufferLines(buf).Get(2), "3b4")
}

func TestHiddenAndRapidBlinkSgr(t T) T {
    val t1 = IsTrue(t, strings.Contains(DefaultStyle().WithHidden().ToSgr(), "8"))
    val t2 = IsTrue(t1, strings.Contains(DefaultStyle().WithRapidBlink().ToSgr(), "6"))
    return IsFalse(t2, StyleEqual(DefaultStyle().WithHidden(), DefaultStyle()))
}

func TestColorFromString(t T) T {
    val cases = ArrayOf(
        ("#ff8000", Some[Color](RGB(255, 128, 0))),
        ("#f80", Some[Color](RGB(255, 136, 0))),
        ("202", Some[Color](Indexed(202))),
        ("Light Blue", Some[Color](BrightBlue)),
        ("red", Some[Color](Red)),
        ("dark_gray", Some[Color](BrightBlack)),
        ("gray", Some[Color](White)),
        ("reset", Some[Color](DefaultColor())),
        ("-1", None[Color]()),
        ("", None[Color]()),
        ("chartreuse", None[Color]()),
    )
    val sgr = (o Option[Color]) => o.Map((c) => ToSgrFg(c)).GetOrElse("none")
    return cases.FoldLeft(t, (acc, c) => EqMsg(acc, sgr(ColorFromString(c.V1)), sgr(c.V2), c.V1))
}

// An overlap wider than a child never places the next child outside the row
// or backwards over the one before.
func TestLargeOverlapStaysInsideTheRow(t T) T {
    val w = Row(ArrayOf[LayoutChild](
        Fixed(2, FillCh('x')),
        Fixed(4, RowSpaced(ArrayOf[LayoutChild](Fixed(1, FillCh('a')), Fixed(1, FillCh('b'))), -5)),
        Fixed(2, FillCh('y')),
    ))
    return IsTrue(t, strings.HasPrefix(bufferLines(renderAt(w, 8, 1)).Get(0), "xx"))
}

// A full-width glyph in a custom set falls back rather than breaking the
// frame.
func TestCustomBorderRejectsWideGlyphs(t T) T {
    val g = BorderGlyphs(TL = '中', TR = '2', BL = '3', BR = '4', Top = 't', Bottom = 'b', Left = 'l', Right = 'r')
    return Eq(t, RowText(renderAt(BorderOf(Empty(), CustomBorder(g)), 3, 3), 0), "┌t2")
}

// A modal's frame drawn over a bordered screen does not merge with it: the
// modal clears its panel first.
func TestModalFrameDoesNotMergeWithTheScreenBelow(t T) T {
    val out = RowText(renderAt(ModalOver(Border(Empty()), 5, 3, Empty()), 9, 5), 1)
    return IsFalse(t, strings.Contains(out, "┼"))
}
