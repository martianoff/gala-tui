package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/test"
)

// TEMPORARY scratch file — prints rendered frames so the UX defects can be
// quoted verbatim. Deleted before commit.

func dumpFrame(label string, w Widget, width int, height int) {
    Println("### " + label)
    val lines = SnapshotLines(w, width, height)
    lines.ForEach((l) => Println("|" + l + "|"))
}

func TestZZPreview(t T) T {
    dumpFrame("Gauge(0) 20x1", Gauge(0), 20, 1)
    dumpFrame("Gauge(37) 20x1", Gauge(37), 20, 1)
    dumpFrame("Progress(0) 20x1", Progress(0), 20, 1)
    dumpFrame("Progress(63) 22x1", Progress(63), 22, 1)

    dumpFrame("LineChart flat (5,5,5,5,5) 40x5",
        LineChart(ArrayOf[int](5, 5, 5, 5, 5)), 40, 5)
    dumpFrame("LineChart 3,7,2,9,4,6,1,8,5,10,2,7 40x5",
        LineChart(ArrayOf[int](3, 7, 2, 9, 4, 6, 1, 8, 5, 10, 2, 7)), 40, 5)
    dumpFrame("Sparkline same 40x1",
        Sparkline(ArrayOf[int](3, 7, 2, 9, 4, 6, 1, 8, 5, 10, 2, 7)), 40, 1)
    dumpFrame("Sparkline empty 12x1", Sparkline(EmptyArray[int]()), 12, 1)

    val tabTitles = ArrayOf[string]("Running", "Passed", "Failed")
    val bodies = ArrayOf[Widget](Text("a"), Text("b"), Text("c"))
    dumpFrame("Tabs 40x2", Tabs(tabTitles, bodies, 0, true), 40, 2)
    dumpFrame("Tabs 18x2", Tabs(tabTitles, bodies, 0, true), 18, 2)
    dumpFrame("Tabs 10x2", Tabs(tabTitles, bodies, 0, true), 10, 2)

    val menu = NewHorizontalMenu(ArrayOf[MenuItem](
        NewMenuItem("Running"), NewMenuItem("Passed"), NewMenuItem("Failed")))
    dumpFrame("HMenu 40x1", MenuView(menu, true), 40, 1)
    dumpFrame("HMenu 18x1", MenuView(menu, true), 18, 1)

    val tbl = NewTable(
        ArrayOf[Constraint](Length(10), Fill(1)),
        ArrayOf[Array[string]](
            ArrayOf[string]("build-101", "passed"),
            ArrayOf[string]("build-103-running-forever", "running"),
        ),
        -1)
    dumpFrame("Table 30x2", Table(tbl), 30, 2)

    val dt = NewDataTable(
        ArrayOf[string]("id", "state"),
        ArrayOf[Constraint](Length(10), Fill(1)),
        ArrayOf[Array[string]](
            ArrayOf[string]("build-101", "passed"),
            ArrayOf[string]("build-103-running-forever", "running"),
            ArrayOf[string]("build-104", "failed"),
        ))
    dumpFrame("DataTable unfiltered 30x6", DataTableView(dt, true), 30, 6)
    val dtf = DataTableUpdate(dt, DTFilter("build-10"))
    dumpFrame("DataTable filtered build-10 30x6", DataTableView(dtf, true), 30, 6)
    val dtf2 = DataTableUpdate(dt, DTFilter("zzz"))
    dumpFrame("DataTable filtered zzz 30x6", DataTableView(dtf2, true), 30, 6)

    var frames = ""
    var i = 0
    for i < 8 {
        frames = frames + "[" + string(SpinnerGlyph(DotsSpinner(), i)) + "]"
        i = i + 1
    }
    Println("### DotsSpinner cycle: " + frames)

    val lst = ArrayOf[ListItem](
        NewListItem("a-very-long-item-label-here"),
        NewListItem("short"))
    dumpFrame("SelectList 12x2", SelectList(lst, 0), 12, 2)

    return t
}
