package gala_tui

import (
    "strconv"
    "time"
    . "martianoff/gala/collection_immutable"
)

// ============================================================================
// Calendar / DatePicker widget.
//
// Displays a one-month grid (Sun-Mon-…-Sat columns by default, Mon-…-Sun
// with `StartingMonday`) with a movable selection cursor. Apps drive
// Up/Down/Left/Right + Enter and read `Selected()` to retrieve the chosen
// date. `Mark` gives a date a style of its own — the days with a deploy
// scheduled, the holidays.
//
//     ↑ ↓ ← →    move cursor by week / day
//     PgUp/PgDn  previous / next month
//     Enter       confirm selection (the app handles this Msg directly)
//     Esc        (handled by app)
//
// Calendar is a pure value — apps copy state forward each update().
// ============================================================================

struct Calendar(
    Year   int,
    Month  int,                        // 1..12
    SelDay int,                        // currently-selected day-of-month (1..31)
    // Marks holds the style of each marked date, keyed by `calKey`. They
    // stay put as the cursor pages through months: a mark is on a date,
    // not on a cell of the grid.
    Marks  HashMap[string, Style] = EmptyHashMap[string, Style](),
    // MondayFirst starts each week on Monday instead of Sunday.
    MondayFirst bool = false,
)

// Mark gives the date `year-month-day` a style of its own, drawn under the
// today and selection highlights — so a marked day that is also selected
// still reads as marked. Marking a date again replaces its style.
func (c Calendar) Mark(year int, month int, day int, style Style) Calendar =
    c.Copy(Marks = c.Marks.Put(calKey(year, month, day), style))

// Unmark removes a date's mark.
func (c Calendar) Unmark(year int, month int, day int) Calendar =
    c.Copy(Marks = c.Marks.Remove(calKey(year, month, day)))

// StartingMonday lays the weeks out Monday to Sunday.
func (c Calendar) StartingMonday() Calendar = c.Copy(MondayFirst = true)

// calKey is the Marks key for a date.
func calKey(year int, month int, day int) string = s"$year-$month-$day"

// NewCalendar builds a calendar focused on today.
func NewCalendar() Calendar {
    val now = time.Now()
    return Calendar(
        Year   = now.Year(),
        Month  = int(now.Month()),
        SelDay = now.Day(),
    )
}

// NewCalendarAt builds a calendar focused on a specific date.
func NewCalendarAt(year int, month int, day int) Calendar =
    Calendar(Year = year, Month = month, SelDay = day)

// Selected returns the currently-selected date as a Go time.Time at midnight.
func (c Calendar) Selected() time.Time =
    time.Date(c.Year, time.Month(c.Month), c.SelDay, 0, 0, 0, 0, time.UTC)

// ----------------------------------------------------------------------------
// Update
// ----------------------------------------------------------------------------

sealed type CalendarEvent {
    case CalDayLeft()
    case CalDayRight()
    case CalDayUp()
    case CalDayDown()
    case CalMonthPrev()
    case CalMonthNext()
    case CalNoOp()
}

func CalendarUpdate(c Calendar, ev CalendarEvent) Calendar {
    return ev match {
        case CalDayLeft()    => calStep(c, -1)
        case CalDayRight()   => calStep(c, 1)
        case CalDayUp()      => calStep(c, -7)
        case CalDayDown()    => calStep(c, 7)
        case CalMonthPrev()  => calMonth(c, -1)
        case CalMonthNext()  => calMonth(c, 1)
        case CalNoOp()       => c
    }
}

// calStep advances/retreats the selected date by `delta` days, automatically
// crossing month and year boundaries.
func calStep(c Calendar, delta int) Calendar {
    val current = c.Selected()
    val moved = current.AddDate(0, 0, delta)
    return c.Copy(
        Year   = moved.Year(),
        Month  = int(moved.Month()),
        SelDay = moved.Day(),
    )
}

// calMonth jumps to the same day in the prev/next month, clamping the day
// when the destination month is shorter.
func calMonth(c Calendar, delta int) Calendar {
    var newMonth = c.Month + delta
    var newYear = c.Year
    if newMonth < 1 {
        newMonth = 12
        newYear = newYear - 1
    }
    if newMonth > 12 {
        newMonth = 1
        newYear = newYear + 1
    }
    val maxDay = daysInMonth(newYear, newMonth)
    val day = if (c.SelDay > maxDay) maxDay else c.SelDay
    return c.Copy(Year = newYear, Month = newMonth, SelDay = day)
}

// daysInMonth: 28-31 depending on month. Uses time.Date's normalisation.
func daysInMonth(year int, month int) int {
    val firstNext = time.Date(year, time.Month(month + 1), 0, 0, 0, 0, 0, time.UTC)
    return firstNext.Day()
}

// ----------------------------------------------------------------------------
// View
// ----------------------------------------------------------------------------

// CalendarView renders the calendar as a header (Month YYYY) + weekday
// column labels + 6 rows × 7 columns of day numbers. The selected day is
// reverse-highlighted; today is bold; a marked day keeps its own style
// underneath both.
// `focused` (default false) brightens the selected day so it pops as
// "the cursor", as opposed to the just-highlighted active selection.
func CalendarView(c Calendar, focused bool = false) Widget {
    val title = TextStyled(
        " " + monthName(c.Month) + " " + strconv.Itoa(c.Year) + " ",
        DefaultStyle().WithBold().WithFg(BrightCyan()),
    )
    val labels = ArrayOf(" Su", " Mo", " Tu", " We", " Th", " Fr", " Sa")
    val dayLabels = Row(ArrayTabulate(7, (col) =>
        Fixed(3, TextStyled(labels.Get((col + calWeekStart(c)) % 7), calLabelStyle()))))
    val today = time.Now()
    val rows = calBuildGrid(c, today, focused)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, title),
        Fixed(1, dayLabels),
        Flex(1, Column(rows)),
    ))
}

func calLabelStyle() Style = DefaultStyle().WithDim().WithBold()

// calWeekStart is the weekday of the grid's first column: 0 Sunday, 1 Monday.
func calWeekStart(c Calendar) int = if (c.MondayFirst) 1 else 0

// calBuildGrid produces 6 rows × 7 day-cells representing the month grid.
// Empty cells (before the first / after the last) render as blanks.
func calBuildGrid(c Calendar, today time.Time, focused bool) Array[LayoutChild] {
    // How many columns the 1st sits in from the week's first day.
    val weekday = int(time.Date(c.Year, time.Month(c.Month), 1, 0, 0, 0, 0, time.UTC).Weekday())
    val firstWeekday = (weekday - calWeekStart(c) + 7) % 7
    val totalDays = daysInMonth(c.Year, c.Month)
    return ArrayTabulate(6, (week) => {
        val cells = ArrayTabulate(7, (col) => {
            val day = week * 7 + col - firstWeekday + 1
            return Fixed(3, calDayCell(c, today, day, totalDays, focused))
        })
        return Fixed(1, Row(cells))
    })
}

func calDayCell(c Calendar, today time.Time, day int, totalDays int, focused bool) Widget {
    if day < 1 || day > totalDays {
        return Text("   ")
    }
    val isSel = day == c.SelDay
    val isToday = c.Year == today.Year() &&
                  c.Month == int(today.Month()) &&
                  day == today.Day()
    val highlight = if (isSel && focused)
        DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
    else if (isSel)
        DefaultStyle().WithReverse().WithBold()
    else if (isToday)
        DefaultStyle().WithBold().WithFg(BrightYellow())
    else
        DefaultStyle()
    val mark = c.Marks.GetOrElse(calKey(c.Year, c.Month, day), DefaultStyle())
    return TextStyled(calPad(day), mark.Patch(highlight))
}

// calPad formats a day number into a 3-cell string (" D " or " DD").
func calPad(day int) string {
    if day < 10 { return " " + strconv.Itoa(day) + " " }
    return " " + strconv.Itoa(day)
}

// ----------------------------------------------------------------------------
// Small helpers
// ----------------------------------------------------------------------------

func monthName(m int) string = m match {
    case 1  => "January"
    case 2  => "February"
    case 3  => "March"
    case 4  => "April"
    case 5  => "May"
    case 6  => "June"
    case 7  => "July"
    case 8  => "August"
    case 9  => "September"
    case 10 => "October"
    case 11 => "November"
    case _  => "December"
}
