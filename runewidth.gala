package gala_tui

// ============================================================================
// Grapheme-aware display widths.
//
// The framework historically counted every rune as one cell — fine for
// ASCII, wrong for:
//
//   - **CJK ideographs** (U+4E00..U+9FFF and friends) render at DOUBLE width
//   - **Emoji** (U+1F300..U+1FAFF, plus misc symbols) render at DOUBLE width
//   - **Zero-width combiners** (U+0300..U+036F, U+FE00..U+FE0F, ZWJ) render
//     at ZERO width — they modify the preceding grapheme
//   - **Fullwidth forms** (U+FF00..U+FFEF) render at DOUBLE width
//   - **Hangul syllables** (U+AC00..U+D7A3) render at DOUBLE width
//
// RuneCellWidth(r) returns the display width of a single code point.
// StringCellWidth(s) sums the widths of every rune in `s`, giving the
// correct cell count the string will occupy when rendered.
//
// This is the practical subset of Unicode East Asian Width + emoji width
// rules; a full implementation would require a giant generated table
// (tens of KB). Our approach covers the common cases with a compact
// rune-range classifier — any app that needs 100% coverage of rare blocks
// can swap in `github.com/mattn/go-runewidth` via a tiny shim.
// ============================================================================

import (
    "strings"
)

// RuneCellWidth returns how many terminal cells `r` occupies.
//   0 = zero-width (combining mark, variation selector, ZWJ)
//   1 = narrow (ASCII, Latin-1, most European scripts)
//   2 = wide (CJK, emoji, fullwidth forms)
func RuneCellWidth(r rune) int {
    // Fast path: basic ASCII printable + space.
    if r >= 0x20 && r < 0x7F { return 1 }
    // Control characters render as 0 cells in our model — the renderer
    // skips them so this is safe.
    if r < 0x20 || r == 0x7F { return 0 }

    // Zero-width combining marks.
    if r >= 0x0300 && r <= 0x036F { return 0 }     // Combining Diacritical Marks
    if r >= 0x1AB0 && r <= 0x1AFF { return 0 }     // Combining Diacritical Marks Extended
    if r >= 0x1DC0 && r <= 0x1DFF { return 0 }     // Combining Diacritical Marks Supplement
    if r >= 0x20D0 && r <= 0x20FF { return 0 }     // Combining Diacritical Marks for Symbols
    if r >= 0xFE20 && r <= 0xFE2F { return 0 }     // Combining Half Marks
    if r == 0x200D { return 0 }                    // Zero Width Joiner
    if r == 0x200C { return 0 }                    // Zero Width Non-Joiner
    if r == 0x200B { return 0 }                    // Zero Width Space
    if r == 0xFEFF { return 0 }                    // Byte Order Mark
    if r >= 0xFE00 && r <= 0xFE0F { return 0 }     // Variation Selectors
    if r >= int32(0xE0100) && r <= int32(0xE01EF) { return 0 }   // Variation Selectors Supplement

    // Double-width ranges.
    if r >= 0x1100 && r <= 0x115F { return 2 }     // Hangul Jamo
    if r >= 0x2E80 && r <= 0x303E { return 2 }     // CJK Radicals Supplement, Kangxi
    if r >= 0x3041 && r <= 0x33FF { return 2 }     // Hiragana, Katakana, Bopomofo, etc.
    if r >= 0x3400 && r <= 0x4DBF { return 2 }     // CJK Unified Ideographs Extension A
    if r >= 0x4E00 && r <= 0x9FFF { return 2 }     // CJK Unified Ideographs
    if r >= 0xA000 && r <= 0xA4CF { return 2 }     // Yi Syllables, Yi Radicals
    if r >= 0xAC00 && r <= 0xD7A3 { return 2 }     // Hangul Syllables
    if r >= 0xF900 && r <= 0xFAFF { return 2 }     // CJK Compatibility Ideographs
    if r >= 0xFE30 && r <= 0xFE4F { return 2 }     // CJK Compatibility Forms
    if r >= 0xFF00 && r <= 0xFF60 { return 2 }     // Fullwidth Forms (ASCII range)
    if r >= 0xFFE0 && r <= 0xFFE6 { return 2 }     // Fullwidth signs

    // Emoji and pictographs — 16-bit ranges.
    //
    // Miscellaneous Symbols (2600..26FF) and Dingbats (2700..27BF) are NOT
    // wide as blocks. Most of their codepoints are East Asian *Ambiguous*,
    // which is one cell in every Western terminal (xterm, iTerm2, Windows
    // Terminal, Alacritty) and two only under a CJK locale. Treating the
    // blocks as wide mis-measured glyphs this library ships itself — the
    // ✓ and ✕ in toastPrefix, ⚠ ★ ☑ — so the layout engine sat one column
    // ahead of the cursor on every row containing one.
    //
    // Only the codepoints with Emoji_Presentation are genuinely Wide.
    if isWideSymbol(r) { return 2 }

    // Emoji — supplementary planes.
    if r >= int32(0x1F300) && r <= int32(0x1F64F) { return 2 }   // Symbols + emoticons
    if r >= int32(0x1F680) && r <= int32(0x1F6FF) { return 2 }   // Transport + Map Symbols
    if r >= int32(0x1F900) && r <= int32(0x1F9FF) { return 2 }   // Supplemental Symbols
    if r >= int32(0x1FA00) && r <= int32(0x1FAFF) { return 2 }   // Symbols and Pictographs Ext-A
    if r >= int32(0x20000) && r <= int32(0x2FFFD) { return 2 }   // CJK Extensions B–F
    if r >= int32(0x30000) && r <= int32(0x3FFFD) { return 2 }   // CJK Extension G
    if r >= int32(0xE0000) && r <= int32(0xE0FFF) { return 0 }   // Tags (zero-width)

    // Default: narrow (one cell).
    return 1
}

// isWideSymbol reports whether `r` is one of the symbol codepoints that is
// East Asian Wide (W) rather than Ambiguous (A) — i.e. the ones that render
// two cells everywhere, not just under a CJK locale.
//
// This is the Emoji_Presentation set inside the symbol blocks, taken from
// Unicode's EastAsianWidth. Everything else in 2600..27BF defaults to one
// cell, which is what a Western terminal draws. A codepoint that only
// becomes emoji-presented via U+FE0F is Ambiguous on its own and stays 1
// here; the variation selector itself is already zero-width above, so
// "⚠️" measures 1 — matching terminals that do not widen for VS16.
func isWideSymbol(r rune) bool {
    // Wide symbols that sit just below the Miscellaneous Symbols block.
    if r == 0x231A || r == 0x231B { return true }               // ⌚ ⌛
    if r >= 0x23E9 && r <= 0x23EC { return true }               // ⏩ ⏪ ⏫ ⏬
    if r == 0x23F0 || r == 0x23F3 { return true }               // ⏰ ⏳
    if r == 0x25FD || r == 0x25FE { return true }               // ◽ ◾

    // Miscellaneous Symbols (2600..26FF).
    if r >= 0x2614 && r <= 0x2615 { return true }               // ☔ ☕
    if r >= 0x2648 && r <= 0x2653 { return true }               // zodiac ♈..♓
    if r == 0x267F { return true }                              // ♿
    if r == 0x2693 { return true }                              // ⚓
    if r == 0x26A1 { return true }                              // ⚡
    if r >= 0x26AA && r <= 0x26AB { return true }               // ⚪ ⚫
    if r >= 0x26BD && r <= 0x26BE { return true }               // ⚽ ⚾
    if r >= 0x26C4 && r <= 0x26C5 { return true }               // ⛄ ⛅
    if r == 0x26CE { return true }                              // ⛎
    if r == 0x26D4 { return true }                              // ⛔
    if r == 0x26EA { return true }                              // ⛪
    if r >= 0x26F2 && r <= 0x26F3 { return true }               // ⛲ ⛳
    if r == 0x26F5 { return true }                              // ⛵
    if r == 0x26FA { return true }                              // ⛺
    if r == 0x26FD { return true }                              // ⛽

    // Dingbats (2700..27BF).
    if r == 0x2705 { return true }                              // ✅
    if r >= 0x270A && r <= 0x270B { return true }               // ✊ ✋
    if r == 0x2728 { return true }                              // ✨
    if r == 0x274C { return true }                              // ❌
    if r == 0x274E { return true }                              // ❎
    if r >= 0x2753 && r <= 0x2755 { return true }               // ❓ ❔ ❕
    if r == 0x2757 { return true }                              // ❗
    if r >= 0x2795 && r <= 0x2797 { return true }               // ➕ ➖ ➗
    if r == 0x27B0 { return true }                              // ➰
    if r == 0x27BF { return true }                              // ➿

    return false
}

// StringCellWidth returns the total cell count the string `s` will occupy
// when rendered on a grid-based terminal. Equivalent to the sum of
// RuneCellWidth across all runes — runs in O(n) with a single pass.
func StringCellWidth(s string) int {
    var w = 0
    for _, r := range s {
        w = w + RuneCellWidth(r)
    }
    return w
}

// StringCellTruncate returns a prefix of `s` whose cell width is ≤ `maxW`.
// Never breaks a double-width rune in half — if adding the next rune would
// overflow, the truncation stops just before it. Useful for fitting a
// title into a fixed-width slot.
// Builds into a `strings.Builder` rather than re-concatenating: this runs
// per overflowing cell on every frame, and `out = out + string(r)` copies
// the whole accumulated prefix each rune, which is quadratic in the kept
// width. A 200-column pane of long rows spent about a megabyte a frame on
// strings it then threw away.
func StringCellTruncate(s string, maxW int) string {
    var sb strings.Builder
    var w = 0
    for _, r := range s {
        val rw = RuneCellWidth(r)
        if w + rw > maxW {
            return sb.String()
        }
        sb.WriteRune(r)
        w = w + rw
    }
    return sb.String()
}

// stringFitsInCells reports whether `s` is at most `maxW` cells wide,
// stopping as soon as it knows. `StringCellWidth(s) <= maxW` measures the
// whole string first, which is the wrong shape on the render path: the
// common overflow case is content far wider than its slot — a 4 KB stack
// trace in an 80-column log pane measured all 4 KB to learn it did not
// fit. This walks `maxW` cells at most.
func stringFitsInCells(s string, maxW int) bool {
    var w = 0
    for _, r := range s {
        w = w + RuneCellWidth(r)
        if w > maxW {
            return false
        }
    }
    return true
}

// StringCellEllipsis fits `s` into `maxW` cells, marking a cut with "…".
// A string that already fits comes back untouched; one that doesn't is
// truncated to `maxW - 1` cells and gets the marker, so the result is
// never wider than `maxW`.
//
// This is `StringCellTruncate` plus the affordance. A hard clip and an
// exact fit look identical on screen — "build-103-running-forever" cut to
// ten columns reads as a record called "build-103-", not as a name the
// pane was too narrow to show — and the user has no way to tell which one
// they are looking at. Anything laid into a slot it may overflow (a table
// cell, a list label, a tab title) should come through here.
//
// The budget is counted in CELLS, not runes: a CJK cell is two columns
// wide, and `StringCellTruncate` stops before splitting one, so the result
// can land a column short of `maxW`. Short is safe; over is not.
func StringCellEllipsis(s string, maxW int) string {
    if maxW <= 0 { return "" }
    if stringFitsInCells(s, maxW) { return s }
    if maxW == 1 { return "…" }
    return StringCellTruncate(s, maxW - 1) + "…"
}

// padLeftToCells right-aligns `s` in a `width`-cell slot. A string already
// at or past the slot width is returned as-is — padding is this function's
// job, truncation is its neighbours' above.
//
// Right-aligning a number into a fixed slot is what keeps whatever follows
// it from sliding sideways as the number grows a digit; `progressLabelText`
// and `lineGaugeCaption` are both here for that reason.
func padLeftToCells(s string, width int) string = cellPad(width - StringCellWidth(s)) + s

// cellPad is `n` spaces, or "" for a non-positive count.
//
// `strings.Repeat` rather than a concat loop: `out = out + " "` copies the
// whole accumulated prefix each step, the quadratic pattern StringCellTruncate
// documents a few lines up. Every caller today pads by less than a handful of
// cells, where that is arithmetic rather than a cost — but the width comes
// from the caller, and the next one may hand it a 200-column row.
func cellPad(n int) string {
    // strings.Repeat panics on a negative count, so this guard carries the
    // "already at or past the slot width" case rather than decorating it.
    if n <= 0 {
        return ""
    }
    return strings.Repeat(" ", n)
}
