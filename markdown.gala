package gala_tui

import (
    gs "martianoff/gala/strings"
    "strconv"
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/std"
    . "martianoff/gala/go_interop"
)

// ============================================================================
// Markdown rendering.
//
// MarkdownView renders a subset of CommonMark sufficient for TUI help
// screens, changelogs, and documentation popups:
//
//   - Headings: `# H1`, `## H2`, `### H3`
//   - Bold:     `**bold**`
//   - Italic:   `_italic_` or `*italic*`
//   - Code:     `` `inline code` ``
//   - Links:    `[label](url)` — rendered as underlined label (URL available
//               via the returned markdown model for OSC 8 promotion later)
//   - Bullets:  `- item` or `* item`
//   - Numbered: `1. item`
//   - Rules:    `---` or `***`
//   - Paragraphs separated by blank lines
//
// The renderer is two-pass:
//   1. Parse → Array[MdBlock], each block carries its kind and its
//      inline runs (Array[MdInline]).
//   2. Render → Widget (Column of per-block widgets).
//
// Inline styling is flat (bold/italic/code/link don't nest in v1).
// ============================================================================

sealed type MdBlock {
    case MdHeading(Level int, Inlines Array[MdInline])
    case MdParagraph(Inlines Array[MdInline])
    case MdBullet(Inlines Array[MdInline])
    case MdNumbered(Num int, Inlines Array[MdInline])
    case MdCodeBlock(Lang string, Lines Array[string])
    case MdRule()
    case MdBlank()
}

sealed type MdInline {
    case MdText(Text string)
    case MdBold(Text string)
    case MdItalic(Text string)
    case MdCode(Text string)
    case MdLink(Label string, Url string)
}

// ParseMarkdown splits `source` into a sequence of blocks. The block-level
// parser recognises the prefixes listed above; everything else becomes a
// paragraph. Inline parsing runs per-block.
//
// The line loop stays a loop: a fence consumes a variable number of lines,
// so the body decides the stride.
func ParseMarkdown(source string) Array[MdBlock] {
    val lines = mdSplitLines(source)
    val n = lines.Length()
    var out = EmptyArray[MdBlock]()
    // Consecutive plain lines; joined with a space into one paragraph when a
    // block line (or the end of input) closes them.
    var para = EmptyArray[string]()
    var i = 0
    for i < n {
        val line = lines.Get(i)
        if mdIsFenceOpen(line) {
            // The body runs to the matching close fence (or end of file).
            val body = lines.Drop(i + 1).TakeWhile((l) => !mdIsFenceClose(l))
            out = mdFlushParagraph(out, para).Append(MdCodeBlock(Lang = mdFenceLang(line), Lines = body))
            para = EmptyArray[string]()
            // Skip the opener, the body and the closing fence (if present).
            i = i + body.Length() + 2
        } else {
            mdLineBlock(line) match {
                case Some(block) => {
                    out = mdFlushParagraph(out, para).Append(block)
                    para = EmptyArray[string]()
                }
                case _ => para = para.Append(line)
            }
            i = i + 1
        }
    }
    return mdFlushParagraph(out, para)
}

// mdFlushParagraph closes the pending paragraph lines, if any, onto `out`.
func mdFlushParagraph(out Array[MdBlock], para Array[string]) Array[MdBlock] =
    if (para.IsEmpty()) out
    else out.Append(MdParagraph(Inlines = parseInlines(para.MkString(" "))))

// mdLineBlock classifies one non-fence line: the block it forms on its own,
// or None when it is paragraph text.
func mdLineBlock(line string) Option[MdBlock] {
    if line == "" { return Some(MdBlank()) }
    if mdIsRule(line) { return Some(MdRule()) }
    val headingLevel = mdHeadingLevel(line)
    if headingLevel > 0 {
        return Some(MdHeading(Level = headingLevel, Inlines = parseInlines(mdStripHeading(line, headingLevel))))
    }
    if mdIsBullet(line) {
        return Some(MdBullet(Inlines = parseInlines(mdStripBulletPrefix(line))))
    }
    return mdNumberedPrefix(line) match {
        case Some(num) => Some(MdNumbered(Num = num, Inlines = parseInlines(mdStripNumberedPrefix(line))))
        case _ => None()
    }
}

// ----------------------------------------------------------------------------
// Block-prefix detection
// ----------------------------------------------------------------------------

// mdHeadingLevel returns N for a line of N '#' (1..6) followed by a space,
// 0 otherwise.
func mdHeadingLevel(line string) int {
    val rest = strings.TrimLeft(line, "#")
    val lvl = line.Size() - rest.Size()
    return if (lvl >= 1 && lvl <= 6 && strings.HasPrefix(rest, " ")) lvl else 0
}

// mdStripHeading drops the `level` '#' chars and the mandatory space.
func mdStripHeading(line string, level int) string = gs.S(line).Drop(level + 1).ToString()

func mdIsBullet(line string) bool =
    strings.HasPrefix(line, "- ") || strings.HasPrefix(line, "* ")

func mdStripBulletPrefix(line string) string = gs.S(line).Drop(2).ToString()

// mdNumberedPrefix returns the integer prefix for "N. rest" (e.g., "1. Hello"),
// or None if the line doesn't start with a number followed by ". ".
func mdNumberedPrefix(line string) Option[int] {
    val rest = strings.TrimLeft(line, "0123456789")
    if rest == line || !strings.HasPrefix(rest, ". ") { return None() }
    return Try(strconv.Atoi(strings.TrimSuffix(line, rest))).ToOption()
}

// mdStripNumberedPrefix drops the "N. " that mdNumberedPrefix matched.
func mdStripNumberedPrefix(line string) string =
    strings.TrimPrefix(strings.TrimLeft(line, "0123456789"), ". ")

func mdIsRule(line string) bool {
    if line != "---" && line != "***" { return false }
    return true
}

// mdIsFenceOpen detects a fenced code-block opening line: ``` or ```lang.
func mdIsFenceOpen(line string) bool = strings.HasPrefix(line, "```")

// mdIsFenceClose matches exactly ``` (no language tag).
func mdIsFenceClose(line string) bool = line == "```"

// mdFenceLang extracts the language tag from a fenced opener (whatever
// follows the three backticks). Empty string when no tag is present.
func mdFenceLang(line string) string = gs.S(line).Drop(3).ToString()

// mdSplitLines is strings.Split on '\n' minus the empty last piece that a
// trailing newline (or empty input) produces: "a\n" is one line, "" none.
func mdSplitLines(s string) Array[string] {
    val parts = gs.Split(s, "\n")
    return if (parts.Last() == "") parts.Init() else parts
}

// ----------------------------------------------------------------------------
// Inline parser
// ----------------------------------------------------------------------------

// parseInlines walks the string character by character, emitting an MdInline
// sequence. Delimiters: `**bold**`, `_italic_` or `*italic*`, `` `code` ``,
// `[label](url)`. Unmatched delimiters become literal text.
//
// A scanner with variable stride: a matched delimiter advances past its
// closer. Literal text is never built rune by rune; it is the run
// rs[textStart:i], cut once when a delimiter (or the end) closes it.
func parseInlines(s string) Array[MdInline] {
    val rs = ToRunes(s)
    val n = rs.Size()
    var out = EmptyArray[MdInline]()
    var textStart = 0
    var i = 0
    for i < n {
        mdInlineAt(rs, i) match {
            case Some(hit) => {
                out = mdFlushText(out, rs, textStart, i).Append(hit.V1)
                i = hit.V2
                textStart = i
            }
            case _ => {
                // An unmatched backtick still closes the pending text: it
                // starts a new text run of its own.
                if rs[i] == '`' {
                    out = mdFlushText(out, rs, textStart, i)
                    textStart = i
                }
                i = i + 1
            }
        }
    }
    return mdFlushText(out, rs, textStart, n)
}

// mdInlineAt matches a delimited inline starting at rs[i]: the inline and
// the index just past its closer, or None when rs[i] is literal text.
func mdInlineAt(rs []rune, i int) Option[Tuple[MdInline, int]] {
    val n = rs.Size()
    val c = rs[i]
    if c == '`' {
        return runeIndexFrom(rs, '`', i + 1) match {
            case Some(end) => Some((MdCode(Text = runeRange(rs, i + 1, end)), end + 1))
            case _ => None()
        }
    }
    if c == '*' && i + 1 < n && rs[i + 1] == '*' {
        return runeIndexWhere(rs, i + 2, (k) => k + 1 < n && rs[k] == '*' && rs[k + 1] == '*') match {
            case Some(end) => Some((MdBold(Text = runeRange(rs, i + 2, end)), end + 2))
            case _ => None()
        }
    }
    if c == '_' || c == '*' {
        return runeIndexFrom(rs, c, i + 1) match {
            case Some(end) => Some((MdItalic(Text = runeRange(rs, i + 1, end)), end + 1))
            case _ => None()
        }
    }
    if c == '[' {
        return runeIndexFrom(rs, ']', i + 1).Filter((e) => e + 1 < n && rs[e + 1] == '(') match {
            case Some(linkEnd) => runeIndexFrom(rs, ')', linkEnd + 2) match {
                case Some(urlEnd) => Some((MdLink(
                    Label = runeRange(rs, i + 1, linkEnd),
                    Url   = runeRange(rs, linkEnd + 2, urlEnd),
                ), urlEnd + 1))
                case _ => None()
            }
            case _ => None()
        }
    }
    return None()
}

// mdFlushText appends rs[lo:hi] as literal text when the run is non-empty.
func mdFlushText(out Array[MdInline], rs []rune, lo int, hi int) Array[MdInline] =
    if (hi > lo) out.Append(MdText(Text = runeRange(rs, lo, hi))) else out

// ----------------------------------------------------------------------------
// Rendering
// ----------------------------------------------------------------------------

// MarkdownView parses `source` and returns a Column of widgets, one per
// parsed block. Inline runs are joined into a single styled line per block.
//
// NOTE: this variant treats every paragraph / bullet / numbered item as a
// single 1-row block — content longer than the rendered width is clipped.
// For variable-height widgets that need exact row counts (e.g.
// `ConversationLog` entries that pre-compute `Height`), use
// `MarkdownViewAt(source, width)` paired with `MarkdownLineCountAt`.
func MarkdownView(source string) Widget =
    renderMdBlocks(ParseMarkdown(source))

// MarkdownViewAt is the width-aware variant. Paragraphs / bullets /
// numbered items wrap at the given width using the same routine
// `Paragraph` does at render time. Per-block heights match what the
// renderer will actually produce, so this is the variant to use when
// the parent layout needs exact heights up-front.
//
// Tradeoff: when a paragraph wraps to more than one row, inline styling
// (bold / italic / inline-code / link) is dropped — wrap is computed on
// the joined plain text. Short (1-row) paragraphs keep their styling.
func MarkdownViewAt(source string, width int) Widget =
    renderMdBlocksWidth(ParseMarkdown(source), width)

// MarkdownLineCountAt: total rendered row count for `source` at `width`.
// Mirrors `MarkdownViewAt` row-for-row so callers can pre-compute the
// height they need to allocate.
func MarkdownLineCountAt(source string, width int) int =
    ParseMarkdown(source).FoldLeft(0, (total, b) => total + mdBlockHeightAt(b, width))

func renderMdBlocks(blocks Array[MdBlock]) Widget {
    if blocks.IsEmpty() {
        return Empty()
    }
    val rows = blocks.Map((b) => Fixed(renderMdBlockHeight(b), renderMdBlock(b)))
    return Column(rows)
}

// renderMdBlocksWidth: width-aware sibling of `renderMdBlocks`. Each
// block is given a Fixed slot whose height equals what the renderer
// will actually produce given `width`.
func renderMdBlocksWidth(blocks Array[MdBlock], width int) Widget {
    if blocks.IsEmpty() {
        return Empty()
    }
    val rows = blocks.Map((b) => Fixed(mdBlockHeightAt(b, width), renderMdBlockWidth(b, width)))
    return Column(rows)
}

func mdBlockHeightAt(b MdBlock, width int) int = b match {
    case MdHeading(_, _)        => 1
    case MdParagraph(inlines)   => MaxInt(1, WrapParagraph(mdInlinesToText(inlines), MaxInt(1, width)).Length())
    case MdBullet(inlines)      => MaxInt(1, WrapParagraph(mdInlinesToText(inlines), MaxInt(1, width - 3)).Length())
    case MdNumbered(_, inlines) => MaxInt(1, WrapParagraph(mdInlinesToText(inlines), MaxInt(1, width - 4)).Length())
    case MdCodeBlock(_, lines)  => MaxInt(3, lines.Length() + 3)
    case MdRule()               => 1
    case MdBlank()              => 1
}

func renderMdBlockWidth(b MdBlock, width int) Widget = b match {
    case MdHeading(level, inlines)   => renderMdHeading(level, inlines)
    case MdParagraph(inlines)        => renderMdParagraphWidth(inlines, MaxInt(1, width))
    case MdBullet(inlines)           =>
        Row(ArrayOf[LayoutChild](
            Fixed(2, TextStyled(" •", DefaultStyle().WithBold())),
            Flex(1, PaddingHV(0, 1, renderMdParagraphWidth(inlines, MaxInt(1, width - 3)))),
        ))
    case MdNumbered(num, inlines)    =>
        Row(ArrayOf[LayoutChild](
            Fixed(4, TextStyled(s"$num. ", DefaultStyle().WithBold())),
            Flex(1, renderMdParagraphWidth(inlines, MaxInt(1, width - 4))),
        ))
    case MdCodeBlock(lang, lines)    => renderMdCodeBlock(lang, lines)
    case MdRule()                    => FillCh('─')
    case MdBlank()                   => Empty()
}

// renderMdParagraphWidth wraps a paragraph to `width`, keeping inline
// styling on every row it produces.
//
// Wrapping used to be computed on the joined plain text and re-emitted as
// rows of `Text`, so a paragraph that flowed onto a second line lost every
// bold, italic, code span and link in it. The styling did not degrade
// gracefully — it vanished at a width threshold, which meant the same
// document rendered correctly in a wide pane and flat in a narrow one.
//
// `WrapSpans` is the same engine `WrapParagraph` now delegates to, so the
// row count here still matches `renderMdBlockHeightWidth` exactly. That
// agreement is what lets variable-height containers like `ConversationLog`
// pre-compute heights.
func renderMdParagraphWidth(inlines Array[MdInline], width int) Widget {
    val lines = WrapSpans(mdInlinesToSpans(inlines, DefaultStyle()), width)
    // One row keeps the original Row-of-cells path, whose trailing fill
    // spans the rest of the line — changing it would alter the background
    // of every short paragraph already shipped.
    if lines.Length() <= 1 { return renderMdInlineRow(inlines) }
    return RichTextW(Text = RichTextOf(lines))
}

// mdInlinesToSpans is the styled counterpart of `mdInlinesToText`: one Span
// per inline run, carrying the style that run renders with.
func mdInlinesToSpans(inlines Array[MdInline], base Style) Array[Span] =
    inlines.Map((r) => Span(Content = mdInlineText(r), Style = mdInlineStyle(r, base)))

// mdInlinesToText collapses an inline-run sequence to its bare text
// content (no styling, no link URLs) so callers like
// `renderMdParagraphWidth` can ask `WrapParagraph` how many rows the
// rendered paragraph will occupy.
func mdInlinesToText(inlines Array[MdInline]) string =
    inlines.Map(mdInlineText).MkString("")

func renderMdBlockHeight(b MdBlock) int {
    return b match {
        case MdHeading(_, _)        => 1
        case MdParagraph(_)         => 1
        case MdBullet(_)            => 1
        case MdNumbered(_, _)       => 1
        case MdCodeBlock(_, lines)  => MaxInt(3, lines.Length() + 3)   // title + top border + lines + bottom border
        case MdRule()               => 1
        case MdBlank()              => 1
    }
}

func renderMdBlock(b MdBlock) Widget {
    return b match {
        case MdHeading(level, inlines)   => renderMdHeading(level, inlines)
        case MdParagraph(inlines)        => renderMdInlineRow(inlines)
        case MdBullet(inlines)           =>
            Row(ArrayOf[LayoutChild](
                Fixed(2, TextStyled(" •", DefaultStyle().WithBold())),
                Flex(1, PaddingHV(0, 1, renderMdInlineRow(inlines))),
            ))
        case MdNumbered(num, inlines)    =>
            Row(ArrayOf[LayoutChild](
                Fixed(4, TextStyled(s"$num. ", DefaultStyle().WithBold())),
                Flex(1, renderMdInlineRow(inlines)),
            ))
        case MdCodeBlock(lang, lines)     => renderMdCodeBlock(lang, lines)
        case MdRule()                     => FillCh('─')
        case MdBlank()                    => Empty()
    }
}

// renderMdCodeBlock paints fenced ``` code blocks with a thin border, the
// language tag in dim text on the top edge, and per-line syntax-highlighted
// content. The highlighter is intentionally minimal — a single tokenizer
// distinguishes keywords, string literals, numeric literals, and comments
// for a handful of popular languages. Apps that want a full PrismJS-class
// highlighter can pre-format their content and skip MarkdownView's renderer.
func renderMdCodeBlock(lang string, lines Array[string]) Widget {
    val rows = lines.Map((line) => Fixed(1, highlightCodeLine(line, lang)))
    val title = if (lang == "") " code "
                else " " + lang + " "
    val titleW = TextStyled(title, DefaultStyle().WithDim().WithBold())
    val body = Column(rows)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, titleW),
        Flex(1, BorderOf(body, RoundedBorder())),
    ))
}

func renderMdHeading(level int, inlines Array[MdInline]) Widget {
    val style = mdHeadingStyle(level)
    val prefix = if (level == 1) "" else ""
    return renderMdInlineRowStyled(inlines, style, prefix)
}

func mdHeadingStyle(level int) Style {
    if level == 1 { return DefaultStyle().WithBold().WithUnderline().WithFg(BrightCyan) }
    if level == 2 { return DefaultStyle().WithBold().WithFg(BrightMagenta) }
    return DefaultStyle().WithBold()
}

// renderMdInlineRow composes one Widget per inline run; each gets its own
// style. Stitched with Row so each run occupies its natural width.
func renderMdInlineRow(inlines Array[MdInline]) Widget =
    renderMdInlineRowStyled(inlines, DefaultStyle(), "")

func renderMdInlineRowStyled(inlines Array[MdInline], base Style, prefix string) Widget {
    val lead = if (prefix == "") EmptyArray[LayoutChild]()
               else ArrayOf[LayoutChild](Fixed(RuneCount(prefix), TextStyled(prefix, base)))
    val runs = inlines.Map((run) => mdInlineCell(mdInlineText(run), mdInlineStyle(run, base)))
    return Row(lead.AppendAll(runs).Append(Flex(1, FillCh(' '))))
}

func mdInlineCell(text string, style Style) LayoutChild =
    Fixed(RuneCount(text), TextStyled(text, style))

func mdInlineText(r MdInline) string {
    return r match {
        case MdText(t)     => t
        case MdBold(t)     => t
        case MdItalic(t)   => t
        case MdCode(t)     => t
        case MdLink(l, _)  => l
    }
}

func mdInlineStyle(r MdInline, base Style) Style {
    return r match {
        case MdText(_)      => base
        case MdBold(_)      => base.WithBold()
        case MdItalic(_)    => base.WithItalic()
        case MdCode(_)      => base.WithFg(BrightYellow).On(Black)
        // Carries the URL as an OSC 8 hyperlink, not just link-coloured
        // text: the parser already has the target, and a terminal that
        // supports OSC 8 makes it clickable. One that does not ignores the
        // sequence, so the underline-and-blue still reads as a link.
        case MdLink(_, url) => base.WithUnderline().WithFg(BrightBlue).WithLink(url)
    }
}
