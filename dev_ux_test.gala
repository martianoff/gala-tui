package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Tests for the dev-UX shortcuts.
// ============================================================================

sealed type DUTestMsg {
    case DUInc()
    case DUDec()
    case DUQuit()
    case DUNoOp()
    case DUScrollUp()
    case DUScrollDown()
    case DUPaste(Text string)
}

// ----------------------------------------------------------------------------
// DispatchKeys
// ----------------------------------------------------------------------------

func TestDispatchKeysFirstMatchWins(t T) T {
    val keyToMsg = DispatchKeys[DUTestMsg](
        ArrayOf[KeyBinding[DUTestMsg]](
            KeyBind[DUTestMsg]("ctrl+c", DUQuit()),
            KeyBind[DUTestMsg]("+",      DUInc()),
            KeyBind[DUTestMsg]("-",      DUDec()),
        ),
        DUNoOp(),
    )
    val gotInc = keyToMsg(PlainKey(Char('+')))
    val isInc = gotInc match {
        case DUInc() => true
        case _       => false
    }
    return IsTrue(t, isInc)
}

func TestDispatchKeysFallbackOnNoMatch(t T) T {
    val keyToMsg = DispatchKeys[DUTestMsg](
        ArrayOf[KeyBinding[DUTestMsg]](
            KeyBind[DUTestMsg]("+", DUInc()),
        ),
        DUNoOp(),
    )
    val got = keyToMsg(PlainKey(Char('z')))
    val isNoOp = got match {
        case DUNoOp() => true
        case _        => false
    }
    return IsTrue(t, isNoOp)
}

func TestDispatchKeysCtrlBindingMatches(t T) T {
    val keyToMsg = DispatchKeys[DUTestMsg](
        ArrayOf[KeyBinding[DUTestMsg]](
            KeyBind[DUTestMsg]("ctrl+c", DUQuit()),
        ),
        DUNoOp(),
    )
    val got = keyToMsg(Ctrl(Char('c')))
    val isQuit = got match {
        case DUQuit() => true
        case _        => false
    }
    return IsTrue(t, isQuit)
}

func TestDispatchKeysCtrlBindingDoesNotMatchPlainKey(t T) T {
    val keyToMsg = DispatchKeys[DUTestMsg](
        ArrayOf[KeyBinding[DUTestMsg]](
            KeyBind[DUTestMsg]("ctrl+c", DUQuit()),
        ),
        DUNoOp(),
    )
    val got = keyToMsg(PlainKey(Char('c')))   // no ctrl
    val isNoOp = got match {
        case DUNoOp() => true
        case _        => false
    }
    return IsTrue(t, isNoOp)
}

// ----------------------------------------------------------------------------
// LiftKeysToInputScroll
// ----------------------------------------------------------------------------

func TestLiftKeysToInputScrollKeysPassThrough(t T) T {
    val keyToMsg = (ev KeyEvent) => DUInc()
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        keyToMsg, (s) => DUPaste(Text = s), DUScrollUp(), DUScrollDown(), DUNoOp(), DUNoOp(),
    )
    val got = inputToMsg(KeyInput(Ev = PlainKey(Char('+'))))
    val isInc = got match {
        case DUInc() => true
        case _       => false
    }
    return IsTrue(t, isInc)
}

func TestLiftKeysToInputScrollWheelUpRoutes(t T) T {
    val keyToMsg = (ev KeyEvent) => DUNoOp()
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        keyToMsg, (s) => DUPaste(Text = s), DUScrollUp(), DUScrollDown(), DUNoOp(), DUNoOp(),
    )
    val got = inputToMsg(MouseInput(Ev = MouseEvent(
        Btn = MouseScrollUp(), X = 0, Y = 0, Pressed = true,
    )))
    val isUp = got match {
        case DUScrollUp() => true
        case _            => false
    }
    return IsTrue(t, isUp)
}

func TestLiftKeysToInputScrollWheelDownRoutes(t T) T {
    val keyToMsg = (ev KeyEvent) => DUNoOp()
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        keyToMsg, (s) => DUPaste(Text = s), DUScrollUp(), DUScrollDown(), DUNoOp(), DUNoOp(),
    )
    val got = inputToMsg(MouseInput(Ev = MouseEvent(
        Btn = MouseScrollDown(), X = 0, Y = 0, Pressed = true,
    )))
    val isDown = got match {
        case DUScrollDown() => true
        case _              => false
    }
    return IsTrue(t, isDown)
}

func TestLiftKeysToInputScrollClickGetsFallback(t T) T {
    val keyToMsg = (ev KeyEvent) => DUInc()  // shouldn't fire
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        keyToMsg, (s) => DUPaste(Text = s), DUScrollUp(), DUScrollDown(), DUDec(), DUNoOp(),
    )
    val got = inputToMsg(MouseInput(Ev = MouseEvent(
        Btn = MouseLeft(), X = 5, Y = 5, Pressed = true,
    )))
    val isClick = got match {
        case DUDec() => true
        case _       => false
    }
    return IsTrue(t, isClick)
}

func TestLiftKeysToInputScrollResizeGetsFallback(t T) T {
    val keyToMsg = (ev KeyEvent) => DUInc()
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        keyToMsg, (s) => DUPaste(Text = s), DUScrollUp(), DUScrollDown(), DUInc(), DUDec(),
    )
    val got = inputToMsg(ResizeInput(W = 80, H = 24))
    val isResize = got match {
        case DUDec() => true
        case _       => false
    }
    return IsTrue(t, isResize)
}

// ----------------------------------------------------------------------------
// Paste reaches the app through the library's own lifts
//
// The runtime turns bracketed paste on by default, on the argument that
// GALA's exhaustiveness check makes a swallowed paste impossible: every
// match on InputEvent has to name PasteInput. These lifts ARE such a
// match, and they used to answer `fallback` on the app's behalf — so an
// app built on the documented lift silently stopped receiving pasted text
// the moment the mode went on, with nothing at compile time to say so.
// ----------------------------------------------------------------------------

func TestLiftKeysToInputDeliversPastedText(t T) T {
    val inputToMsg = LiftKeysToInput[DUTestMsg](
        (ev) => DUInc(), (s) => DUPaste(Text = s), DUNoOp(), DUNoOp(),
    )
    val got = inputToMsg(PasteInput(Content = "hello world"))
    return got match {
        case DUPaste(text) => Eq(t, text, "hello world")
        case _             => IsTrue(t, false)
    }
}

func TestLiftKeysToInputScrollDeliversPastedText(t T) T {
    val inputToMsg = LiftKeysToInputScroll[DUTestMsg](
        (ev) => DUInc(), (s) => DUPaste(Text = s),
        DUScrollUp(), DUScrollDown(), DUNoOp(), DUNoOp(),
    )
    val got = inputToMsg(PasteInput(Content = "pasted"))
    return got match {
        case DUPaste(text) => Eq(t, text, "pasted")
        case _             => IsTrue(t, false)
    }
}
