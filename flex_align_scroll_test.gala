package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Renderer-level tests for Wave A (2/2): Flex distribution, inter-child
// spacing, vertical alignment, list offset / direction, and scrollbar
// orientation.
//
// Two of these pin *fixes* to bugs the UX audit found, not new features:
// the ScrollPane scrollbar that never moved, and the no-scroll bar that
// painted a solid black column.
// ============================================================================

// ----------------------------------------------------------------------------
// Flex — where unclaimed space goes
// ----------------------------------------------------------------------------

func flexRow(mode FlexMode, spacing int) Widget =
    RowFlex(ArrayOf[LayoutChild](Fixed(2, Text("ab")), Fixed(2, Text("cd"))),
            mode, spacing)

func TestFlexLegacyPacksAtStart(t T) T {
    // The historical behavior, and still the default: children at the start,
    // slack left at the end.
    return Eq(t, Snapshot(flexRow(FlexLegacy(), 0), 10, 1), "abcd      ")
}

func TestRowDefaultMatchesFlexLegacy(t T) T {
    // `Row` must keep rendering exactly as it always did.
    val plain = Row(ArrayOf[LayoutChild](Fixed(2, Text("ab")), Fixed(2, Text("cd"))))
    return Eq(t, Snapshot(plain, 10, 1), Snapshot(flexRow(FlexLegacy(), 0), 10, 1))
}

func TestFlexEndPacksAtEnd(t T) T {
    return Eq(t, Snapshot(flexRow(FlexEnd(), 0), 10, 1), "      abcd")
}

func TestFlexCenterSplitsSlack(t T) T {
    // 10 wide, 4 claimed, 6 slack → 3 before.
    return Eq(t, Snapshot(flexRow(FlexCenter(), 0), 10, 1), "   abcd   ")
}

func TestFlexSpaceBetweenPutsSlackBetweenOnly(t T) T {
    // No slack at the edges; all 6 cells land in the single gap.
    return Eq(t, Snapshot(flexRow(FlexSpaceBetween(), 0), 10, 1), "ab      cd")
}

func TestFlexSpaceEvenlyEqualisesEveryGap(t T) T {
    // 3 gaps (lead, middle, trail) of 6/3 = 2 each.
    return Eq(t, Snapshot(flexRow(FlexSpaceEvenly(), 0), 10, 1), "  ab  cd  ")
}

func TestFlexCenterRemovesTheSpacerSandwich(t T) T {
    // Centering a fixed-width child used to need two throwaway Flex(1)
    // spacers. One FlexCenter row must produce the identical frame.
    val sandwich = Row(ArrayOf[LayoutChild](
        Flex(1, Empty()),
        Fixed(4, Text("abcd")),
        Flex(1, Empty()),
    ))
    val direct = RowFlex(ArrayOf[LayoutChild](Fixed(4, Text("abcd"))), FlexCenter(), 0)
    return Eq(t, Snapshot(direct, 10, 1), Snapshot(sandwich, 10, 1))
}

// ----------------------------------------------------------------------------
// Spacing — gaps between children
// ----------------------------------------------------------------------------

func TestRowSpacingInsertsGapsBetweenChildren(t T) T {
    return Eq(t, Snapshot(flexRow(FlexLegacy(), 2), 10, 1), "ab  cd    ")
}

func TestSpacingIsNotAppliedAtTheEdges(t T) T {
    // One child means no adjacent pair, so spacing costs nothing.
    val one = RowSpaced(ArrayOf[LayoutChild](Fixed(2, Text("ab"))), 4)
    return Eq(t, Snapshot(one, 6, 1), "ab    ")
}

func TestColumnSpacingInsertsBlankRows(t T) T {
    val col = ColumnSpaced(ArrayOf[LayoutChild](
        Fixed(1, Text("a")),
        Fixed(1, Text("b")),
    ), 1)
    return Eq(t, Snapshot(col, 1, 3), "a\n \nb")
}

func TestSpacingReducesSpaceAvailableToChildren(t T) T {
    // Gaps are taken out of the axis before Solve runs, so a Fill child
    // shrinks rather than the row overflowing.
    val row = RowSpaced(ArrayOf[LayoutChild](
        Fixed(2, Text("ab")),
        Flex(1, FillCh('.')),
    ), 3)
    return Eq(t, Snapshot(row, 10, 1), "ab   .....")
}

// ----------------------------------------------------------------------------
// VAlign — vertical placement
// ----------------------------------------------------------------------------

func TestVAlignTopIsTheTopRow(t T) T {
    val w = Text("x").AlignedAt(AlignLeft(), VAlignTop(), 1, 1)
    return Eq(t, Snapshot(w, 1, 3), "x\n \n ")
}

func TestVAlignMiddleCentresVertically(t T) T {
    val w = Text("x").AlignedAt(AlignLeft(), VAlignMiddle(), 1, 1)
    return Eq(t, Snapshot(w, 1, 3), " \nx\n ")
}

func TestVAlignBottomPinsToBottomEdge(t T) T {
    val w = Text("x").AlignedAt(AlignLeft(), VAlignBottom(), 1, 1)
    return Eq(t, Snapshot(w, 1, 3), " \n \nx")
}

func TestCenteredNowCentresBothAxes(t T) T {
    // `Centered` claimed both axes in its doc but only ever did horizontal.
    val w = Text("x").Centered(1, 1)
    return Eq(t, Snapshot(w, 3, 3), "   \n x \n   ")
}

// ----------------------------------------------------------------------------
// List — explicit offset and direction
// ----------------------------------------------------------------------------

func listItems(n int) Array[ListItem] =
    ArrayTabulate(n, (i) => NewListItem(s"item$i"))

func TestListDefaultTracksSelection(t T) T {
    // Offset -1 keeps the historical auto-scroll: selecting past the bottom
    // pulls the viewport down.
    val w = SelectList(listItems(6), 5)
    return Eq(t, SnapshotLines(w, 6, 2).Get(1), "item5 ")
}

func TestListExplicitOffsetScrollsIndependentlyOfSelection(t T) T {
    // Selection is item0, but the viewport is parked at item3 — a wheel
    // scroll over an unfocused pane. The auto-only model could not do this.
    val w = SelectListAt(listItems(6), 0, 3)
    val rows = SnapshotLines(w, 6, 2)
    val t1 = Eq(t, rows.Get(0), "item3 ")
    return Eq(t1, rows.Get(1), "item4 ")
}

func TestListExplicitOffsetIsClampedPastTheEnd(t T) T {
    // An out-of-range offset must not render blank rows.
    val w = SelectListAt(listItems(4), 0, 99)
    return Eq(t, SnapshotLines(w, 6, 2).Get(0), "item2 ")
}

func TestListBottomToTopPinsContentToBottomEdge(t T) T {
    // Two items in a four-row pane: a transcript sits at the foot, not the
    // top, so new rows appear adjacent to the input line below it.
    val w = SelectListReversed(listItems(2), 0)
    val rows = SnapshotLines(w, 6, 4)
    val t1 = Eq(t, rows.Get(0), "      ")
    val t2 = Eq(t1, rows.Get(1), "      ")
    val t3 = Eq(t2, rows.Get(2), "item0 ")
    return Eq(t3, rows.Get(3), "item1 ")
}

func TestListSelectionHighlightSpansTheFullRow(t T) T {
    // renderList is the reference implementation for full-row highlighting;
    // sweep every cell rather than sampling one.
    val buf = NewBuffer(8, 1)
    RenderTo(SelectList(listItems(1), 0), Rect(X = 0, Y = 0, Width = 8, Height = 1), buf)
    var acc = t
    var x = 0
    for x < 8 {
        acc = IsTrue(acc, buf.StyleAt(x, 0).Reverse)
        x = x + 1
    }
    return acc
}

// ----------------------------------------------------------------------------
// Scrollbar — orientation, and the two audit fixes
// ----------------------------------------------------------------------------

func TestScrollbarVerticalLeftUsesLeftEdge(t T) T {
    val w = ScrollbarAt(10, 2, 0, DefaultStyle(), ScrollbarVerticalLeft())
    val buf = NewBuffer(3, 4)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 3, Height = 4), buf)
    val t1 = Eq(t, buf.CharAt(0, 0), '█')
    return Eq(t1, buf.CharAt(2, 0), ' ')
}

func TestScrollbarHorizontalBottomRunsAlongTheBottomRow(t T) T {
    val w = ScrollbarAt(10, 2, 0, DefaultStyle(), ScrollbarHorizontalBottom())
    val buf = NewBuffer(4, 2)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 4, Height = 2), buf)
    val t1 = Eq(t, buf.CharAt(0, 1), '█')
    val t2 = Eq(t1, buf.CharAt(3, 1), '─')
    return Eq(t2, buf.CharAt(0, 0), ' ')
}

func TestScrollbarHorizontalThumbMovesWithOffset(t T) T {
    val atEnd = ScrollbarAt(10, 2, 8, DefaultStyle(), ScrollbarHorizontalTop())
    val buf = NewBuffer(4, 1)
    RenderTo(atEnd, Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    val t1 = Eq(t, buf.CharAt(3, 0), '█')
    return Eq(t1, buf.CharAt(0, 0), '─')
}

func TestScrollbarDerivesViewportWhenVisibleIsZero(t T) T {
    // Visible = 0 means "the viewport is this bar". 10 rows of content in a
    // 5-cell bar must produce a partial thumb, not a full one.
    val buf = NewBuffer(1, 5)
    RenderTo(Scrollbar(10, 0, 0), Rect(X = 0, Y = 0, Width = 1, Height = 5), buf)
    val t1 = Eq(t, buf.CharAt(0, 0), '█')
    return Eq(t1, buf.CharAt(0, 4), '│')
}

func TestScrollPaneScrollbarThumbMovesWithOffset(t T) T {
    // The audit's S1-3: ScrollPaneView passed Visible = contentH, making
    // total == visible on every call, so the thumb was always solid and
    // never moved. These two frames used to be byte-identical.
    val body = Column(ArrayTabulate(10, (i) => Fixed(1, Text(s"row$i"))))
    val top = ScrollPaneView(body, ScrollPaneState(Offset = 0), 10)
    val bot = ScrollPaneView(body, ScrollPaneState(Offset = 6), 10)
    val topBar = SnapshotLines(top, 10, 4)
    val botBar = SnapshotLines(bot, 10, 4)
    // Thumb at the top in the first frame, away from the top in the second.
    val t1 = IsTrue(t, topBar.Get(0) != botBar.Get(0))
    return IsTrue(t1, topBar.Get(3) != botBar.Get(3))
}
