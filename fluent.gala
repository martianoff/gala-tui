package gala_tui

import (
    . "martianoff/gala/collection_immutable"
)

// ============================================================================
// Fluent Widget API.
//
// The base constructors are decoration-outside-in: you write
//     Fixed(5, BorderOf(Padding(2, Text("hi")), RoundedBorder()))
// which reads right-to-left ("first there's text, then padding, then a
// border, and finally that goes into a fixed-height layout child").
//
// The fluent API flips the reading direction:
//     Text("hi").Padded(2).Bordered().Fixed(5)
// — construct-inside-out, same behavior, less noise. Every method here is a
// trivial wrapper over an existing constructor.
//
// These are extension methods on the sealed Widget type; the compiler
// doesn't care whether you use `Border(w)` or `w.Bordered()` — they lower
// to the same AST. Picks whichever form reads better at the call site.
// ============================================================================

// OnClick attaches a click contract to the widget: a left-click anywhere
// on its rendered area dispatches `msg`. The widget tree is type-erased
// over the app's Msg type, so the payload is stored as `any` inside
// `ClickableW` and recovered by the runtime at dispatch time.
//
//     val cell = TextStyled(label, style).OnClick(OnPicked(Idx = i))
//
// `T` is inferred from `msg` — no explicit type parameter at the call
// site.
func (w Widget) OnClick[T any](msg T) Widget =
    ClickableW(Inner = w, Payload = msg)

// OnPickRow attaches a per-row click contract: the widget's rendered
// area is sliced into `count` rows of height 1 and row `i` dispatches
// `msgFor(i)` on click.
//
//     val list = SelectList(items, sel, focused)
//         .OnPickRow(items.Length(), (i) => Pick(Idx = i))
func (w Widget) OnPickRow[T any](count int, msgFor func(int) T) Widget =
    w.OnPickRowH[T](count, 1, msgFor)

// OnPickRowH is `OnPickRow` with an explicit per-row height — for
// widgets where each row spans more than one cell (e.g., a grid with
// padded entries).
func (w Widget) OnPickRowH[T any](count int, rowH int, msgFor func(int) T) Widget {
    // Erase the function's element type to `any` so it fits the
    // single, non-generic Widget sealed type. The cast is safe by
    // construction — every payload was a T just before assignment.
    val erased = (i int) => any(msgFor(i))
    return ClickableRowsW(
        Inner    = w,
        Count    = count,
        RowH     = rowH,
        Payloads = erased,
    )
}

// OnDoubleClick attaches a *double-click* contract: a left-click
// followed by a second left-click within ~400 ms at the same
// position dispatches `msg`. Single clicks at the same area still
// dispatch the widget's `OnClick` payload (if any) — the runtime
// suppresses the pending single only when the double fires.
//
//     val row = TextStyled(label, style)
//         .OnClick(SelectRow(Idx = i))
//         .OnDoubleClick(OpenRow(Idx = i))
func (w Widget) OnDoubleClick[T any](msg T) Widget =
    DblClickableW(Inner = w, Payload = msg)

// OnDoublePickRow attaches a per-row double-click contract: row `i`
// fires `msgFor(i)` only on a double-click. Pair with `.OnPickRow`
// to get the canonical "single = select / double = open" flow:
//
//     val table = DataTableView(dt, focused)
//         .OnPickRow(rowCount, (i) => SelectRow(Idx = i))
//         .OnDoublePickRow(rowCount, (i) => OpenRow(Idx = i))
func (w Widget) OnDoublePickRow[T any](count int, msgFor func(int) T) Widget =
    w.OnDoublePickRowH[T](count, 1, msgFor)

// OnDoublePickRowH is `OnDoublePickRow` with an explicit per-row
// height — same shape as `OnPickRowH` but for double-click.
func (w Widget) OnDoublePickRowH[T any](count int, rowH int, msgFor func(int) T) Widget {
    val erased = (i int) => any(msgFor(i))
    return DblClickableRowsW(
        Inner    = w,
        Count    = count,
        RowH     = rowH,
        Payloads = erased,
    )
}

// OnDrag attaches a drag contract to the widget: the runtime
// dispatches `msgFor(DragPress)` on the press that lands inside the
// widget's rectangle, then `msgFor(DragOver)` for every motion-while-
// held event whose cursor sits over a draggable region, and finally
// `msgFor(DragRelease)` on release — always against the originating
// press's payload, even when release happens off the region.
//
//     val row = TextStyled(label, style).OnDrag[Msg]((phase) =>
//         OnDragRow(Idx = i, Phase = phase))
//
// `T` is inferred from the `msgFor` return type. The closure is
// stored type-erased inside the underlying `DraggableW`; the runtime
// re-erases when calling it (returning `any`) and the dispatcher
// casts back to `T`.
func (w Widget) OnDrag[T any](msgFor func(DragPhase) T) Widget {
    val erased = (phase DragPhase) => any(msgFor(phase))
    return DraggableW(Inner = w, Payload = erased)
}

// OnDragPickRow is the per-row counterpart of OnDrag — slices the
// widget's area into `count` rows of height 1 and registers a drag
// region per row, with `msgFor(rowIdx, phase)` producing each
// (row, phase) pair's dispatched message. Row-aware drag UX
// (drag-to-select, drag-to-reorder) builds on this.
func (w Widget) OnDragPickRow[T any](count int, msgFor func(int, DragPhase) T) Widget =
    w.OnDragPickRowH[T](count, 1, msgFor)

// OnDragPickRowH is `OnDragPickRow` with an explicit per-row height.
func (w Widget) OnDragPickRowH[T any](count int, rowH int, msgFor func(int, DragPhase) T) Widget {
    val erased = (i int) => any((phase DragPhase) => any(msgFor(i, phase)))
    return DraggableRowsW(
        Inner    = w,
        Count    = count,
        RowH     = rowH,
        Payloads = erased,
    )
}

// Padded wraps the widget in equal-margin Padding.
func (w Widget) Padded(n int) Widget = Padding(n, w)

// PaddedHV wraps with separate vertical / horizontal padding.
func (w Widget) PaddedHV(vert int, horiz int) Widget = PaddingHV(vert, horiz, w)

// PaddedSides gives full control over each edge.
func (w Widget) PaddedSides(top int, right int, bottom int, left int) Widget =
    PaddingWidget(Top = top, Right = right, Bottom = bottom, Left = left, Inner = w)

// Bordered draws the default single-line border.
func (w Widget) Bordered() Widget = Border(w)

// BorderedOf picks a specific border glyph kind (rounded, thick, double, ascii).
func (w Widget) BorderedOf(kind BorderKind) Widget = BorderOf(w, kind)

// Centered centers `w` on both axes within a (width × height) box.
//
// Vertical centering is real as of the VAlign field: previously this only
// centered horizontally — `renderAlign` pinned Y to the area's top — and the
// doc comment claiming otherwise was wrong. Callers that wanted both axes
// built a Column[Flex(1), Fixed(h), Flex(1)] sandwich by hand (see
// modal.gala's centerPanel).
func (w Widget) Centered(width int, height int) Widget =
    AlignWidget(Inner = w, Horiz = AlignCenter(), Vert = VAlignMiddle(),
                ChildW = width, ChildH = height)

// AlignedLeft aligns `w` to the left of its (width × height) slot.
func (w Widget) AlignedLeft(width int, height int) Widget =
    AlignWidget(Inner = w, Horiz = AlignLeft(), Vert = VAlignTop(),
                ChildW = width, ChildH = height)

// AlignedRight pins `w` to the right of its (width × height) slot.
func (w Widget) AlignedRight(width int, height int) Widget =
    AlignWidget(Inner = w, Horiz = AlignRight(), Vert = VAlignTop(),
                ChildW = width, ChildH = height)

// AlignedAt is the explicit form — pick both axes.
func (w Widget) AlignedAt(
    horiz Align,
    vert VAlign,
    width int,
    height int,
) Widget =
    AlignWidget(Inner = w, Horiz = horiz, Vert = vert,
                ChildW = width, ChildH = height)

// AlignedBottom pins `w` to the bottom edge of its slot — a status line at
// the foot of a pane that is taller than its content.
func (w Widget) AlignedBottom(width int, height int) Widget =
    AlignWidget(Inner = w, Horiz = AlignLeft(), Vert = VAlignBottom(),
                ChildW = width, ChildH = height)

// Over draws `top` on top of `w` (so `w` is the background, `top` masks it
// where it paints). Mirrors Overlay(bottom = w, top = top).
func (w Widget) Over(top Widget) Widget = Overlay(w, top)

// Under draws `bg` behind `w` — handy for "title over a filled bar" patterns.
func (w Widget) Under(bg Widget) Widget = Overlay(bg, w)

// ----------------------------------------------------------------------------
// LayoutChild adapters — widgets constrained for Row / Column.
// ----------------------------------------------------------------------------

// AsFixed wraps the widget in a Fixed(n) LayoutChild.
// Named `AsFixed` (not `Fixed`) so it doesn't collide with the top-level
// Fixed(n, w) constructor.
func (w Widget) AsFixed(n int) LayoutChild = Fixed(n, w)

// AsFlex wraps the widget in a Fill(weight) LayoutChild.
func (w Widget) AsFlex(weight int) LayoutChild = Flex(weight, w)

// AsPct wraps the widget in a Percent constraint.
func (w Widget) AsPct(percent int) LayoutChild = Pct(percent, w)

// ----------------------------------------------------------------------------
// Styling short-cuts — for the common case of "take this text and make it
// bold red", without building a Style object explicitly.
// ----------------------------------------------------------------------------

// WithFg returns a copy of the widget with every TextWidget / FillWidget /
// inputW-like leaf re-styled with fg color applied. Only affects direct
// TextWidgets; container widgets descend recursively.
//
// Useful for one-off recolors: `TextStyled("ok", theme.Text).WithFg(Green())`.
// For anything more complex, build a Style explicitly.
func (w Widget) WithFg(c Color) Widget = restyleLeaves(w, (s) => s.WithFg(c))

// WithBold marks leaf text / fills as bold.
func (w Widget) WithBold() Widget = restyleLeaves(w, (s) => s.WithBold())

// WithReverse applies reverse-video to leaves — the usual "selected" signal.
func (w Widget) WithReverse() Widget = restyleLeaves(w, (s) => s.WithReverse())

// WithDim applies dim to leaves (faded text for secondary info).
func (w Widget) WithDim() Widget = restyleLeaves(w, (s) => s.WithDim())

// restyleLeaves walks the widget tree and applies `f` to the Style of every
// TextWidget / FillWidget / InputW placeholder / button / progress / gauge /
// spinner / paragraph / scrollbar. Container widgets (Border, Padding, Row,
// Column, Stack, Overlay, Align, Viewport) recurse into their children.
//
// Kept as its own helper because the match would otherwise repeat in every
// With-* method.
//
// restyleRichText applies `f` to every Span in a RichText block. A Span is
// a styled leaf like TextWidget is, so `.WithBold()` over a rich-text
// subtree bolds each run rather than flattening them to one style.
func restyleRichText(t RichText, f func(Style) Style) RichText =
    RichTextOf(t.Lines.Map((l) => restyleLine(l, f)))

func restyleLine(l Line, f func(Style) Style) Line =
    Line(Spans = l.Spans.Map((s) => s.Styled(f(s.Style))), Align = l.Align)

// restyleShape applies `f` to a Shape's Style. A Shape is a styled leaf the
// same way a Span is.
func restyleShape(s Shape, f func(Style) Style) Shape = s match {
    case ShapeLine(a, b, c, d, st)    => ShapeLine(X1 = a, Y1 = b, X2 = c, Y2 = d, Style = f(st))
    case ShapeRect(x, y, w, h, st)    => ShapeRect(X = x, Y = y, Width = w, Height = h, Style = f(st))
    case ShapeCircle(x, y, r, st)     => ShapeCircle(X = x, Y = y, Radius = r, Style = f(st))
    case ShapePoints(pts, st)         => ShapePoints(Pts = pts, Style = f(st))
    case ShapeLabel(x, y, text, st)   => ShapeLabel(X = x, Y = y, Text = text, Style = f(st))
    case ShapeFilledLine(a, b, c, d, yRef, st) =>
        ShapeFilledLine(X1 = a, Y1 = b, X2 = c, Y2 = d, YRef = yRef, Style = f(st))
}

func restyleLeaves(w Widget, f func(Style) Style) Widget {
    return w match {
        case EmptyWidget()                     => w
        case TextWidget(c, s)                  => TextWidget(Content = c, Style = f(s))
        case RichTextW(t)                      => RichTextW(Text = restyleRichText(t, f))
        // Recurse into the child but leave the region function alone: it
        // runs last by design, so composing it with `f` here would apply
        // `f` twice to every cell the region covers.
        case RestyleW(inner, re)               =>
            RestyleW(Inner = restyleLeaves(inner, f), Restyle = re)
        // Each Shape carries its own Style, so restyling a canvas restyles
        // its shapes — a dimmed pane dims the plot drawn in it.
        case CanvasW(x1, x2, y1, y2, mk, sh)   =>
            CanvasW(XMin = x1, XMax = x2, YMin = y1, YMax = y2, Marker = mk,
                    Shapes = sh.Map((s) => restyleShape(s, f)))
        case CellTextW(c, s)                   => CellTextW(Content = c, Style = f(s))
        case CellRichW(ls, s, o)               =>
            CellRichW(Lines = ls.Map((l) => restyleLine(l, f)), Style = f(s), Top = f(o))
        case FillWidget(ch, s)                 => FillWidget(Ch = ch, Style = f(s))
        case BorderWidget(inner, kind, sides, style, titles) =>
            // The border's own style is a leaf too — restyling a subtree
            // should recolour its frame, not just its text. That applies
            // verbatim to a title's Spans: passing them through untouched
            // made the title the *brightest* thing on a dimmed panel.
            BorderWidget(
                Inner  = restyleLeaves(inner, f),
                Kind   = kind,
                Sides  = sides,
                Style  = f(style),
                Titles = titles.Map((bt) => BlockTitle(
                    Content  = Line(
                        Spans = bt.Content.Spans.Map((s) => s.Styled(f(s.Style))),
                        Align = bt.Content.Align,
                    ),
                    Position = bt.Position,
                    Align    = bt.Align,
                )),
            )
        case PaddingWidget(t, r, b, l, inner)  =>
            PaddingWidget(Top = t, Right = r, Bottom = b, Left = l,
                          Inner = restyleLeaves(inner, f))
        case AlignWidget(inner, h, v, cw, ch)  =>
            AlignWidget(Inner = restyleLeaves(inner, f),
                        Horiz = h, Vert = v, ChildW = cw, ChildH = ch)
        case OverlayWidget(bot, top)           =>
            OverlayWidget(Bottom = restyleLeaves(bot, f),
                          Top    = restyleLeaves(top, f))
        case RowWidget(children, flex, sp)     =>
            RowWidget(Children = children.Map((c) => LayoutChild(
                Constraint = c.Constraint,
                Widget     = restyleLeaves(c.Widget, f),
            )), Flex = flex, Spacing = sp)
        case ColumnWidget(children, flex, sp)  =>
            ColumnWidget(Children = children.Map((c) => LayoutChild(
                Constraint = c.Constraint,
                Widget     = restyleLeaves(c.Widget, f),
            )), Flex = flex, Spacing = sp)
        case StackWidget(layers)               =>
            StackWidget(Layers = layers.Map((l) => restyleLeaves(l, f)))
        case ListW(items, sel, ss, off, dir)   =>
            ListW(Items = items, Selected = sel, SelStyle = f(ss),
                  Offset = off, Direction = dir)
        case AutoScrollW(build, sel, off, hs)  =>
            AutoScrollW(Build = (i) => restyleLeaves(build(i), f),
                        Heights = hs, Selected = sel, Offset = off)
        case InputW(v, cu, p, s, ps, fo)       =>
            InputW(Value = v, Cursor = cu, Placeholder = p,
                   Style = f(s), PlaceholderStyle = f(ps), Focused = fo)
        case ProgressW(p, s)                   => ProgressW(Percent = p, Style = f(s))
        case GaugeW(p, s)                      => GaugeW(Percent = p, Style = f(s))
        case SpinnerW(k, fr, s)                => SpinnerW(Kind = k, Frame = fr, Style = f(s))
        case ButtonW(l, s, fo)                 => ButtonW(Label = l, Style = f(s), Focused = fo)
        case ParagraphW(c, s)                  => ParagraphW(Content = c, Style = f(s))
        case ViewportW(inner, off, ch)         =>
            ViewportW(Inner = restyleLeaves(inner, f), Offset = off, ContentHeight = ch)
        case ScrollbarW(tot, vis, off, s, or)  =>
            ScrollbarW(Total = tot, Visible = vis, Offset = off, Style = f(s),
                       Orientation = or)
        case ClickableW(inner, payload)        =>
            ClickableW(Inner = restyleLeaves(inner, f), Payload = payload)
        case ClickableRowsW(inner, n, h, p)    =>
            ClickableRowsW(Inner = restyleLeaves(inner, f),
                           Count = n, RowH = h, Payloads = p)
        case ClickableCellW(inner, hitRows, payload) =>
            ClickableCellW(Inner = restyleLeaves(inner, f),
                           HitRows = hitRows, Payload = payload)
        case DblClickableW(inner, payload)     =>
            DblClickableW(Inner = restyleLeaves(inner, f), Payload = payload)
        case DblClickableRowsW(inner, n, h, p) =>
            DblClickableRowsW(Inner = restyleLeaves(inner, f),
                              Count = n, RowH = h, Payloads = p)
        case DraggableW(inner, payload)        =>
            DraggableW(Inner = restyleLeaves(inner, f), Payload = payload)
        case DraggableRowsW(inner, n, h, p)    =>
            DraggableRowsW(Inner = restyleLeaves(inner, f),
                           Count = n, RowH = h, Payloads = p)
        // A sparkline carries its style as a field, so it restyles like any
        // other leaf — which is the whole reason it is not a CustomW.
        case SparklineW(values, style, dir)    =>
            SparklineW(Values = values, Style = f(style), Dir = dir)
        case BarChartW(groups, style, geom, max, dir) =>
            BarChartW(Groups = barChartRestyle(groups, f), Style = f(style),
                      Geom = geom, Max = max, Dir = dir)
        // CustomW renders by user-supplied closure — restyleLeaves has
        // no way to inspect or rewrite styles inside it. Pass through.
        case CustomW(_, _, _)                  => w
    }
}
