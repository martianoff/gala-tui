package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

// ============================================================================
// Canvas — draw shapes in your own coordinate space, at sub-cell resolution.
//
// Every other widget in this library paints whole cells. A chart, a map, a
// sparkline, anything geometric therefore renders at the terminal's own
// resolution, which is coarse enough that a line looks like a staircase.
//
// Canvas gives each cell a sub-grid and lets shapes be expressed in the
// caller's units rather than in columns and rows. You say "a circle at
// (0, 0) with radius 40" against bounds you chose; the canvas maps that onto
// whatever area the layout gave it and picks glyphs whose dot patterns
// approximate the result. Braille gets 2x4 = eight dots per cell, so a
// 40x10 pane addresses 80x40 points.
//
// Shapes are pure data and the canvas is a value, in keeping with the rest
// of the widget tree: no drawing callback, no mutable painter handed out
// mid-render. The renderer rasterises the list.
//
//     Canvas(
//         XBounds(-1.0, 1.0), YBounds(-1.0, 1.0), BrailleMarker(),
//         ArrayOf[Shape](
//             ShapeCircle(X = 0.0, Y = 0.0, Radius = 0.8, Style = greenish),
//             ShapeLine(X1 = -1.0, Y1 = 0.0, X2 = 1.0, Y2 = 0.0, Style = dim),
//         ),
//     )
// ============================================================================

// CanvasMarker picks the glyph family, and with it the sub-cell resolution.
//
// Braille is the highest resolution and the usual choice. Its drawback is
// that the glyphs are small and some terminals render them in a fallback
// font; HalfBlock trades resolution for weight, and the two 1x1 markers are
// there for fonts where neither looks right.
sealed type CanvasMarker {
    case BrailleMarker()     // 2 x 4 dots per cell — U+2800 block
    case HalfBlockMarker()   // 1 x 2 per cell — ▀ ▄ █
    case DotMarker()         // 1 x 1 per cell — •
    case BlockMarker()       // 1 x 1 per cell — █
}

// CanvasPoint is one point in the caller's coordinate space.
struct CanvasPoint(X float64, Y float64)

// Shape is what a canvas draws. Each carries its own Style, so one canvas
// can hold a dim grid, a bright series and a labelled axis without the
// caller splitting them across widgets.
sealed type Shape {
    case ShapeLine(X1 float64, Y1 float64, X2 float64, Y2 float64, Style Style)
    // ShapeRect draws the outline. Fill it by passing a filled point set,
    // or overlay a second rect — an outline is what charts and maps want.
    case ShapeRect(X float64, Y float64, Width float64, Height float64, Style Style)
    case ShapeCircle(X float64, Y float64, Radius float64, Style Style)
    case ShapePoints(Pts Array[CanvasPoint], Style Style)
    // ShapeFilledLine is ShapeLine plus the band between it and `YRef` — an
    // area chart's shape. Filling under a series is what separates "this
    // much, over time" from "this value, over time": the eye reads the area
    // as a quantity, which is exactly wrong for a temperature and exactly
    // right for a throughput.
    //
    // `YRef` is a coordinate rather than "the bottom", so a series can be
    // filled to a baseline that means something — zero on an axis that goes
    // negative, a budget line, a previous run's average. Above and below it
    // fill the same way; the band is between the line and the reference,
    // whichever is higher.
    case ShapeFilledLine(
        X1 float64,
        Y1 float64,
        X2 float64,
        Y2 float64,
        YRef float64,
        Style Style,
    )
    // ShapeLabel is text, which cannot be sub-cell: it is drawn at the cell
    // containing (X, Y), after every dot shape, so a label is never buried
    // under the series it annotates.
    case ShapeLabel(X float64, Y float64, Text string, Style Style)
}

// Bounds is the caller's coordinate range along one axis.
struct Bounds(Min float64, Max float64)

func XBounds(min float64, max float64) Bounds = Bounds(Min = min, Max = max)
func YBounds(min float64, max float64) Bounds = Bounds(Min = min, Max = max)

// Canvas builds a canvas widget.
func Canvas(x Bounds, y Bounds, marker CanvasMarker, shapes Array[Shape]) Widget =
    CanvasW(
        XMin = x.Min, XMax = x.Max,
        YMin = y.Min, YMax = y.Max,
        Marker = marker, Shapes = shapes,
    )

// CanvasOf is the common case: braille markers over the given bounds.
func CanvasOf(x Bounds, y Bounds, shapes Array[Shape]) Widget =
    Canvas(x, y, BrailleMarker(), shapes)

// FilledSeriesOf builds the chain of filled segments for a series held as
// parallel x / y arrays — an area chart, from the shape a caller has.
//
// One segment per adjacent pair, so the shared endpoints meet without a
// seam. Like `PointsOf` it takes the shorter of the two arrays: parallel
// arrays are one refactor away from disagreeing about their length, and the
// shorter one is the only honest bound.
func FilledSeriesOf(
    xs Array[float64],
    ys Array[float64],
    yRef float64,
    style Style,
) Array[Shape] {
    val n = MinInt(xs.Length(), ys.Length())
    return ArrayTabulate(MaxInt(0, n - 1), (i) => ShapeFilledLine(
        X1 = xs.Get(i),
        Y1 = ys.Get(i),
        X2 = xs.Get(i + 1),
        Y2 = ys.Get(i + 1),
        YRef = yRef,
        Style = style,
    ))
}

// PointsOf builds a ShapePoints from parallel x / y arrays — the shape a
// caller usually has when plotting a series.
func PointsOf(xs Array[float64], ys Array[float64], style Style) Shape {
    val n = MinInt(xs.Length(), ys.Length())
    return ShapePoints(
        Pts = ArrayTabulate(n, (i) => CanvasPoint(X = xs.Get(i), Y = ys.Get(i))),
        Style = style,
    )
}

// ----------------------------------------------------------------------------
// Sub-cell geometry
// ----------------------------------------------------------------------------

// markerSubCells is the (columns, rows) of dots each marker packs per cell.
func markerSubCells(m CanvasMarker) Tuple[int, int] = m match {
    case BrailleMarker()   => (2, 4)
    case HalfBlockMarker() => (1, 2)
    case DotMarker()       => (1, 1)
    case BlockMarker()     => (1, 1)
}

// brailleBit is the bit for a dot at (col, row) within a braille cell.
//
// The layout is historical and not row-major — dots 1-6 were the original
// 6-dot cell and 7-8 were appended underneath — so the fourth row's bits
// are 0x40 and 0x80 rather than continuing the pattern.
func brailleBit(col int, row int) int {
    if col == 0 {
        if row == 0 { return 0x01 }
        if row == 1 { return 0x02 }
        if row == 2 { return 0x04 }
        return 0x40
    }
    if row == 0 { return 0x08 }
    if row == 1 { return 0x10 }
    if row == 2 { return 0x20 }
    return 0x80
}

// ----------------------------------------------------------------------------
// Rasterisation
// ----------------------------------------------------------------------------

// canvasGrid is the sub-cell bitmap a canvas rasterises into before it picks
// glyphs. `set` is one entry per dot; `style` is one per CELL, because a
// glyph carries a single style however many of its dots are lit — last
// writer wins, which makes a later shape draw over an earlier one.
type canvasGrid struct {
    var W     int          // dots across
    var H     int          // dots down
    var SubX  int
    var SubY  int
    var Set   []bool
    var Style []Style
    var Lit   []bool       // per-cell: has any dot been set
    var CellW int          // cells across — W / SubX, bound to the grid
}

func newCanvasGrid(area Rect, marker CanvasMarker) *canvasGrid {
    val (sx, sy) = markerSubCells(marker)
    val w = area.Width * sx
    val h = area.Height * sy
    val cells = area.Width * area.Height
    return &canvasGrid{
        W:     w,
        H:     h,
        SubX:  sx,
        SubY:  sy,
        Set:   SliceWithSize[bool](MaxInt(0, w*h)),
        Style: SliceWithSize[Style](MaxInt(0, cells)),
        Lit:   SliceWithSize[bool](MaxInt(0, cells)),
        CellW: area.Width,
    }
}

// plot lights the dot at grid coordinates, ignoring anything off-canvas so a
// shape that runs past the bounds clips instead of wrapping or trapping.
func (g *canvasGrid) plot(gx int, gy int, style Style) {
    if gx < 0 || gy < 0 || gx >= g.W || gy >= g.H {
        return
    }
    g.Set[gy*g.W+gx] = true
    val cx = gx / g.SubX
    val cy = gy / g.SubY
    val ci = cy*g.CellW + cx
    if ci >= 0 && ci < g.Style.Size() {
        g.Style[ci] = style
        g.Lit[ci] = true
    }
}

// canvasProject maps a point in the caller's space to grid coordinates.
// Y is inverted because screen rows grow downward while a plot's Y grows up.
func canvasProject(v float64, min float64, max float64, size int) int {
    val span = max - min
    if span == 0.0 || size <= 0 {
        return 0
    }
    val raw = int((v - min) / span * float64(size))
    // A value sitting exactly on the upper bound scales to `size`, which is
    // one past the last dot — so the right edge and the bottom edge of every
    // shape silently vanished. Fold it back into the last dot rather than
    // shrinking the span, which would misplace everything else. Values
    // genuinely outside the bounds still fall outside and are clipped by
    // `plot`, so this does not make out-of-range points appear at the edge.
    if raw == size && v <= max {
        return size - 1
    }
    return raw
}

func renderCanvas(
    xMin float64, xMax float64,
    yMin float64, yMax float64,
    marker CanvasMarker,
    shapes Array[Shape],
    area Rect,
    buf *Buffer,
) {
    if area.Width <= 0 || area.Height <= 0 {
        return
    }
    val g = newCanvasGrid(area, marker)
    val toGx = (x float64) => canvasProject(x, xMin, xMax, g.W)
    val toGy = (y float64) => canvasProject(yMax - y, 0.0, yMax - yMin, g.H)

    // Dot shapes first, labels after, so text is never buried under a series.
    shapes.ForEach((s) => rasterShape(s, g, toGx, toGy))
    emitCanvasGlyphs(g, marker, area, buf)
    // Every non-label case is spelled out rather than swept up by a
    // wildcard, so that adding a Shape forces a decision about this pass
    // too — the same reason `rasterShape` names ShapeLabel explicitly.
    shapes.ForEach((s) => s match {
        case ShapeLabel(lx, ly, text, style) => {
            // Clipped to the canvas the way every dot shape is clipped in
            // `plot`. A label anchored outside the bounds projects outside
            // the grid — `canvasProject` only folds a value that is ON the
            // upper bound, not past it — so an unclipped label painted over
            // whatever widget was laid out below or to the left of the
            // canvas. Its own area is the limit, not the buffer's.
            val cx = area.X + toGx(lx)/g.SubX
            val cy = area.Y + toGy(ly)/g.SubY
            if cx >= area.X && cx < area.X + area.Width &&
               cy >= area.Y && cy < area.Y + area.Height {
                renderText(text, style, Rect(
                    X = cx, Y = cy,
                    Width = area.X + area.Width - cx, Height = 1,
                ), buf)
            }
        }
        case ShapeLine(_, _, _, _, _)         => {}
        case ShapeRect(_, _, _, _, _)         => {}
        case ShapeCircle(_, _, _, _)          => {}
        case ShapePoints(_, _)                => {}
        case ShapeFilledLine(_, _, _, _, _, _) => {}
    })
}

func rasterShape(
    s Shape,
    g *canvasGrid,
    toGx func(float64) int,
    toGy func(float64) int,
) {
    s match {
        case ShapeLine(x1, y1, x2, y2, style) =>
            plotLine(g, toGx(x1), toGy(y1), toGx(x2), toGy(y2), style)
        case ShapeRect(x, y, w, h, style) => {
            val gx1 = toGx(x)
            val gy1 = toGy(y)
            val gx2 = toGx(x + w)
            val gy2 = toGy(y + h)
            plotLine(g, gx1, gy1, gx2, gy1, style)
            plotLine(g, gx2, gy1, gx2, gy2, style)
            plotLine(g, gx2, gy2, gx1, gy2, style)
            plotLine(g, gx1, gy2, gx1, gy1, style)
        }
        case ShapeCircle(cx, cy, r, style) => plotCircle(g, cx, cy, r, toGx, toGy, style)
        case ShapePoints(pts, style) =>
            pts.ForEach((p) => g.plot(toGx(p.X), toGy(p.Y), style))
        case ShapeFilledLine(x1, y1, x2, y2, yRef, style) =>
            plotFilledLine(g, toGx(x1), toGy(y1), toGx(x2), toGy(y2),
                           toGy(yRef), style)
        // Labels are text and are drawn after the glyph pass.
        case ShapeLabel(_, _, _, _) => {}
    }
}

// plotFilledLine draws the segment and the band between it and row `yRef`.
//
// Column by column rather than Bresenham: a fill needs the line's row at
// every column it covers, which is what an interpolation gives directly and
// what Bresenham's error term only passes through. The two agree on the
// endpoints, and a filled line's outline is the fill's own top edge, so the
// slight difference in which cells a steep segment lights is invisible
// under the band.
//
// A vertical segment has no columns to walk: it fills the one column it
// occupies, between whichever of its endpoints and `yRef` are extreme.
// Both loops are clipped to the grid before they run, which for every other
// shape is `plot`'s job alone. A fill cannot afford that: `plot` discards an
// off-grid dot, but only after the loop has counted its way there, and a
// fill's loops are nested. The coordinates arriving here are projections of
// the caller's own units with no bound on their magnitude — a byte count
// against auto-scaled bounds puts `YRef = 0.0` tens of thousands of rows
// below the canvas — so an unclipped version costs millions of discarded
// plots per frame in the ordinary case and effectively hangs on a shape
// placed far off-canvas. `plotLine` has its own version of this guard in
// the `limit` its Bresenham walk counts against.
func plotFilledLine(
    g *canvasGrid,
    x1 int,
    y1 int,
    x2 int,
    y2 int,
    yRef int,
    style Style,
) {
    // A vertical segment has no columns to interpolate across, and the
    // general path below would divide by zero — `int(NaN)` is whatever the
    // platform makes of it, which then becomes a loop bound. It also draws
    // something the general path cannot: the segment's own extent inside one
    // column, which is what keeps a chained series unbroken wherever two
    // adjacent points land in the same column.
    if x1 == x2 {
        fillColumn(g, x1, MinInt(y1, y2), MaxInt(MaxInt(y1, y2), yRef), style)
        return
    }
    // The walk is clipped; the slope is not. It is taken from the segment's
    // true endpoints, so the visible part of a line that starts off-canvas
    // keeps the angle the caller asked for rather than one refitted to
    // whatever survived.
    val (lo, hi) = gridSpan(x1, x2, g.W)
    // Float, and hoisted: both operands are unbounded projections, so the
    // integer form would multiply before dividing and wrap two large
    // coordinates into a garbage row.
    val slope = float64(y2 - y1) / float64(x2 - x1)
    var gx = lo
    for gx <= hi {
        val gy = y1 + int(slope * float64(gx - x1))
        fillColumn(g, gx, MinInt(gy, yRef), MaxInt(gy, yRef), style)
        gx = gx + 1
    }
}

// fillColumn plots every grid row from `top` to `bottom` inclusive, clipped
// to the grid — see `plotFilledLine` for why this one clips rather than
// leaving it to `plot`.
func fillColumn(g *canvasGrid, gx int, top int, bottom int, style Style) {
    val (first, last) = gridSpan(top, bottom, g.H)
    var gy = first
    for gy <= last {
        g.plot(gx, gy, style)
        gy = gy + 1
    }
}

// gridSpan clips the unordered span [a, b] to [0, n-1]. A span that misses
// the grid entirely comes back with lo > hi, which every caller reads as
// "walk nothing" — the asymmetry is the point, and is why `clampInt` cannot
// stand in here: clamping both ends of a span that sits past the right edge
// would fold it onto the last column and paint an edge that is not there.
func gridSpan(a int, b int, n int) Tuple[int, int] =
    (MaxInt(0, MinInt(a, b)), MinInt(n - 1, MaxInt(a, b)))

// clipSegment trims a segment to the grid, parametrically, leaving its line
// alone: the returned endpoints sit on the same infinite line as the
// originals, so a shape that runs off the canvas keeps the slope the caller
// asked for and merely starts and stops at the edge.
//
// Liang-Barsky, in floats because the inputs are projections of the caller's
// own units and have no bound on their magnitude.
struct clippedSegment(X1 int, Y1 int, X2 int, Y2 int, Visible bool)

func clipSegment(g *canvasGrid, x1 int, y1 int, x2 int, y2 int) clippedSegment {
    val dx = float64(x2 - x1)
    val dy = float64(y2 - y1)
    var t0 = 0.0
    var t1 = 1.0
    var ok = true
    // Each edge narrows the surviving parameter range: p < 0 enters the
    // half-plane, p > 0 leaves it, p == 0 is parallel and only survives if
    // the segment is already inside.
    val ps = ArrayOf[float64](-dx, dx, -dy, dy)
    val qs = ArrayOf[float64](
        float64(x1), float64(g.W - 1 - x1),
        float64(y1), float64(g.H - 1 - y1),
    )
    var i = 0
    for i < 4 {
        val p = ps.Get(i)
        val q = qs.Get(i)
        if p == 0.0 {
            if q < 0.0 {
                ok = false
            }
        } else {
            val r = q / p
            if p < 0.0 {
                if r > t1 { ok = false } else if r > t0 { t0 = r }
            } else {
                if r < t0 { ok = false } else if r < t1 { t1 = r }
            }
        }
        i = i + 1
    }
    if !ok {
        return clippedSegment(X1 = 0, Y1 = 0, X2 = 0, Y2 = 0, Visible = false)
    }
    return clippedSegment(
        X1 = x1 + int(t0 * dx),
        Y1 = y1 + int(t0 * dy),
        X2 = x1 + int(t1 * dx),
        Y2 = y1 + int(t1 * dy),
        Visible = true,
    )
}

// plotLine is Bresenham in grid space. Integer-only, so it neither
// accumulates float error along a long line nor needs a sqrt per step.
//
// Clipped to the grid before the walk starts. `plot` discards an off-grid
// dot, but a Bresenham walk visits one dot per step, and the coordinates
// arriving here are projections with no bound on their magnitude — a line
// from a million units off-canvas onto it would step sixteen million times
// to light a handful of dots, and `ShapeRect` pays that four times over.
// The `limit` below is a termination guard sized by the walk itself; it
// stops a malformed walk from running forever, but it is not a clamp to the
// canvas and never was.
func plotLine(g *canvasGrid, x1 int, y1 int, x2 int, y2 int, style Style) {
    val seg = clipSegment(g, x1, y1, x2, y2)
    if !seg.Visible {
        return
    }
    var x = seg.X1
    var y = seg.Y1
    val dx = AbsInt(seg.X2 - seg.X1)
    val dy = -AbsInt(seg.Y2 - seg.Y1)
    val sx = if (seg.X1 < seg.X2) 1 else -1
    val sy = if (seg.Y1 < seg.Y2) 1 else -1
    var err = dx + dy
    var guard = 0
    val limit = (dx - dy) + 2
    for guard <= limit {
        g.plot(x, y, style)
        if x == seg.X2 && y == seg.Y2 {
            return
        }
        val e2 = 2 * err
        if e2 >= dy {
            err = err + dy
            x = x + sx
        }
        if e2 <= dx {
            err = err + dx
            y = y + sy
        }
        guard = guard + 1
    }
}

// plotCircle walks the circle by angle rather than by the midpoint
// algorithm, because the canvas's two axes usually have different
// dots-per-unit — a midpoint circle in grid space would come out an
// ellipse in the caller's space, and vice versa. Stepping in the caller's
// space and projecting each point keeps the shape right in the units the
// caller reasons about.
func plotCircle(
    g *canvasGrid,
    cx float64,
    cy float64,
    r float64,
    toGx func(float64) int,
    toGy func(float64) int,
    style Style,
) {
    // Step count scaled to the grid so a large circle is not dotted and a
    // small one is not oversampled.
    val steps = MaxInt(16, (g.W + g.H) * 2)
    var i = 0
    for i < steps {
        val theta = 2.0 * 3.14159265358979 * float64(i) / float64(steps)
        g.plot(toGx(cx + r*cosApprox(theta)), toGy(cy + r*sinApprox(theta)), style)
        i = i + 1
    }
}

// sinApprox / cosApprox — Bhaskara-style approximation, accurate to about
// 0.2% over a full turn. A canvas quantises to dots anyway, so that is far
// below one dot of error at any practical size, and it keeps this file free
// of a math dependency for two calls.
func sinApprox(x float64) float64 {
    val twoPi = 6.28318530717958
    var t = x
    for t < 0.0 { t = t + twoPi }
    for t >= twoPi { t = t - twoPi }
    val pi = 3.14159265358979
    if t <= pi {
        return 16.0 * t * (pi - t) / (5.0*pi*pi - 4.0*t*(pi-t))
    }
    val u = t - pi
    return -(16.0 * u * (pi - u) / (5.0*pi*pi - 4.0*u*(pi-u)))
}

func cosApprox(x float64) float64 = sinApprox(x + 1.57079632679489)

// ----------------------------------------------------------------------------
// Glyph selection
// ----------------------------------------------------------------------------

// emitCanvasGlyphs turns the dot bitmap into cells. Only lit cells are
// written, so a canvas composes over whatever is underneath it rather than
// blanking its whole area.
func emitCanvasGlyphs(g *canvasGrid, marker CanvasMarker, area Rect, buf *Buffer) {
    var cy = 0
    for cy < area.Height {
        var cx = 0
        for cx < area.Width {
            val ci = cy*area.Width + cx
            if g.Lit[ci] {
                val ch = canvasGlyph(g, marker, cx, cy)
                if ch != ' ' {
                    buf.Set(area.X+cx, area.Y+cy, Cell(Ch = ch, St = g.Style[ci]))
                }
            }
            cx = cx + 1
        }
        cy = cy + 1
    }
}

func canvasGlyph(g *canvasGrid, marker CanvasMarker, cx int, cy int) rune {
    return marker match {
        case BrailleMarker() => {
            var bits = 0
            var row = 0
            for row < 4 {
                var col = 0
                for col < 2 {
                    val gx = cx*2 + col
                    val gy = cy*4 + row
                    if gx < g.W && gy < g.H && g.Set[gy*g.W+gx] {
                        bits = bits + brailleBit(col, row)
                    }
                    col = col + 1
                }
                row = row + 1
            }
            if (bits == 0) ' ' else rune(0x2800 + bits)
        }
        case HalfBlockMarker() => {
            // One cell is two vertical dots: both, upper, lower, neither.
            val top = canvasDotAt(g, cx, cy*2)
            val bot = canvasDotAt(g, cx, cy*2+1)
            if (top && bot) '█'
            else if (top) '▀'
            else if (bot) '▄'
            else ' '
        }
        case DotMarker()   => if (canvasDotAt(g, cx, cy)) '•' else ' '
        case BlockMarker() => if (canvasDotAt(g, cx, cy)) '█' else ' '
    }
}

func canvasDotAt(g *canvasGrid, gx int, gy int) bool {
    if gx < 0 || gy < 0 || gx >= g.W || gy >= g.H {
        return false
    }
    return g.Set[gy*g.W+gx]
}

// AbsInt is the integer absolute value Bresenham needs.
func AbsInt(n int) int = if (n < 0) -n else n
