package gala_tui

import (
    . "martianoff/gala/collection_immutable"
)

// This file adds the "advanced" widgets that every serious TUI eventually
// wants: Table, Sparkline, BarChart, Viewport, Tree. None of these require
// new runtime plumbing — they are pure widget data, rendered via the same
// RenderTo walk the foundation widgets use.
//
// These are the widgets that let gala-tui claim it's more than a toy
// framework: together with the foundation set (Text, List, Input, etc.)
// they cover every common pattern in Bubble Tea, Ratatui, and Textual.

// ----------------------------------------------------------------------------
// Table
// ----------------------------------------------------------------------------
//
// Rows × columns. Each column has a constraint (same solver as Row). A
// selected row index highlights an entire row. Column headers are optional;
// when present, they render with the headerStyle and are separated from
// body rows by a one-cell horizontal rule.
//
// Usage:
//     Table(
//         headers  = ArrayOf("Name", "Age", "Role"),
//         widths   = ArrayOf[Constraint](Flex(2), Length(5), Flex(1)),
//         rows     = ArrayOf(
//             ArrayOf("Alice", "30", "admin"),
//             ArrayOf("Bob",   "25", "user"),
//         ),
//         selected = 0,
//     )

struct TableData(
    Headers  Array[string],          // empty array = no header row
    Widths   Array[Constraint],      // one per column
    Rows     Array[Array[string]],   // each row is an array of cells
    Selected int,                    // -1 = no selection
)

// Table extends the Widget sealed type via composition — we render it
// through a renderTable helper that constructs a layout Row tree on the
// fly. The Widget variant carries the TableData as a single field.
//
// (We cannot add cases to the existing sealed `Widget` without editing
// widget.gala; instead we expose Table as a function that returns a
// pre-constructed Widget tree built from Row/Column/Text primitives.)
func Table(data TableData) Widget {
    val hasHeaders = data.Headers.NonEmpty()
    val bodyChildren = data.Rows.ZipWithIndex().Map((pair) =>
        Fixed(1, renderTableRow(pair.V1, data.Widths, pair.V2 == data.Selected)))
    val headerChildren = if (hasHeaders) ArrayOf[LayoutChild](
        Fixed(1, renderTableHeaderRow(data.Headers, data.Widths)),
        Fixed(1, FillCh('─')),
    ) else EmptyArray[LayoutChild]()
    return Column(headerChildren.AppendAll(bodyChildren))
}

// tableColumnSpacing is the blank column between two table columns.
//
// It is charged to the ROW, not to a cell. Reserving a gutter inside each
// non-last cell looked equivalent and was not: a table's constraints
// describe the columns the CALLER asked for, so spending one of them on
// whitespace means `Length(5)` shows four characters and "Alice" renders
// "Ali…" in a column sized to hold it. Charging the row instead takes the
// space from the slack the solver was going to distribute anyway, so
// declared widths are honoured and a column that exactly fits its value
// still gets separated from its neighbour — the case a zero gutter alone
// leaves running together as `Alicex`.
func tableColumnSpacing() int = 1

// renderTableHeaderRow builds a Row of bold header cells.
func renderTableHeaderRow(headers Array[string], widths Array[Constraint]) Widget =
    RowSpaced(headers.ZipWithIndex().Map((pair) =>
        tableHeaderCell(pair.V1, pair.V2, widths)), tableColumnSpacing())

func tableHeaderCell(header string, idx int, widths Array[Constraint]) LayoutChild {
    val w = if (idx < widths.Length()) widths.Get(idx) else Fill(1)
    return LayoutChild(Constraint = w,
        Widget = CellTextStyled(header, DefaultStyle().WithBold()))
}

// renderTableRow builds a Row of body cells. When `selected` is true the
// whole row highlights — including the inter-column gaps.
//
// Drawing each cell with reverse-video was not enough to achieve that: a
// cell's text styles only the columns it occupies, so the padding between
// columns and the tail of the row stayed unstyled and the highlight
// rendered as one chip per column. The row is restyled after it is drawn
// instead, which covers the gaps.
func renderTableRow(row Array[string], widths Array[Constraint], selected bool) Widget {
    val rowStyle = if (selected) DefaultStyle().WithReverse() else DefaultStyle()
    val cells = RowSpaced(row.ZipWithIndex().Map((pair) =>
        tableBodyCell(pair.V1, pair.V2, widths, rowStyle)), tableColumnSpacing())
    return if (selected) Highlighted(cells, rowStyle) else cells
}

// tableBodyCell lays one cell through `CellText`, which caps it to its
// slot with a "…". Drawn as a plain `Text` it filled the slot edge to edge
// and ran straight into the next column: `build-103-running-forever` in a
// `Length(10)` column came out as `build-103-running`, a row that reads as
// a single token and names a build that does not exist. A full-width CJK
// glyph on the boundary left no gap at all.
func tableBodyCell(
    cell string,
    idx int,
    widths Array[Constraint],
    style Style,
) LayoutChild {
    val w = if (idx < widths.Length()) widths.Get(idx) else Fill(1)
    return LayoutChild(Constraint = w, Widget = CellTextStyled(cell, style))
}

// NewTable is a convenience constructor for tables without headers.
func NewTable(widths Array[Constraint], rows Array[Array[string]], selected int) TableData =
    TableData(
        Headers  = EmptyArray[string](),
        Widths   = widths,
        Rows     = rows,
        Selected = selected,
    )

// NewTableWithHeaders is the most common form: headers + rows + selection.
func NewTableWithHeaders(
    headers Array[string],
    widths Array[Constraint],
    rows Array[Array[string]],
    selected int,
) TableData =
    TableData(
        Headers  = headers,
        Widths   = widths,
        Rows     = rows,
        Selected = selected,
    )

// ----------------------------------------------------------------------------
// Sparkline
// ----------------------------------------------------------------------------
//
// A one-row chart where each cell is a Unicode block character whose height
// encodes the normalized value at that column. Eight partial-block glyphs
// (U+2581..U+2588) give us 8 distinguishable "heights" per cell, enough to
// show a meaningful trend in a 40-cell wide space.

// SparkDirection is which end of the widget the *first* sample sits at.
//
// A sparkline of a live feed is usually appended to, and which end the newest
// sample lands on decides what the reader's eye tracks. Left-to-right is the
// default and matches a chart axis; right-to-left pins the newest sample to
// the right edge, so a fixed-width strip scrolls older data off the left the
// way a monitor does.
sealed type SparkDirection {
    case SparkLeftToRight()
    case SparkRightToLeft()
}

func Sparkline(values Array[int]) Widget = SparklineStyled(values, DefaultStyle())

// SparklineOf plots a series that can have gaps. `None` is a sample that does
// not exist — no reading, a dropped scrape — and renders as a blank column.
//
// This is the distinction `SparklineStyled` cannot draw. Every present sample
// floors to `▁` so that a run of zeroes still paints a baseline (see
// `sparklineBarString`), which is right: "0 errors in each of the last 40
// minutes" is data. But it leaves no way to say "no telemetry at all", and
// passing 0 for a missing reading claims a measurement nobody took. An absent
// sample is also excluded from the maximum, so one gap does not rescale the
// rest of the series.
func SparklineOf(
    values Array[Option[int]],
    style Style,
    dir SparkDirection = SparkLeftToRight(),
) Widget {
    if values.IsEmpty() { return Empty() }
    val present = values.Filter((o) => o.IsDefined()).Map((o) => o.Get())
    val maxV = MaxInt(1, present.FoldLeft(0, (acc, v) => MaxInt(acc, v)))
    val ordered = if (sparkReversed(dir)) values.Reverse() else values
    var sb = ""
    ordered.ForEach((o) => {
        sb = sb + sparklineOptGlyph(o, maxV)
    })
    if present.IsEmpty() { return Text(sb) }
    return TextStyled(sb, style)
}

// SparklineStyled renders with a caller-chosen style (e.g., green for rising,
// red for anomalous).
func SparklineStyled(
    values Array[int],
    style Style,
    dir SparkDirection = SparkLeftToRight(),
) Widget {
    if values.IsEmpty() {
        return Empty()
    }
    val ordered = if (sparkReversed(dir)) values.Reverse() else values
    val maxV = ordered.FoldLeft(0, (acc, v) => MaxInt(acc, v))
    if maxV == 0 {
        return Text(sparklineBarString(ordered, 1))
    }
    return TextStyled(sparklineBarString(ordered, maxV), style)
}

// sparklineBarString converts a series of values into a single string where
// each rune is the block glyph whose height represents value/max (in eighths).
//
// Every sample floors to `▁`, the smallest visible block, so a column that
// carries a value always paints one. Letting the arithmetic reach index 0
// (a space) put a hole in the baseline wherever a sample was small relative
// to the maximum, and blanked the whole line when every sample was the same
// low number — "0 errors in each of the last 40 minutes" drew exactly what
// "no telemetry at all" drew. An empty series is the only thing that
// renders as nothing, and `SparklineStyled` returns `Empty()` for it before
// this is reached.
func sparklineBarString(values Array[int], maxV int) string {
    var sb = ""
    var i = 0
    val n = values.Length()
    for i < n {
        sb = sb + string(sparklineGlyph(values.Get(i), maxV))
        i = i + 1
    }
    return sb
}

// sparkReversed folds the direction down to the one question the renderers
// ask. A sealed type rather than a bool at the call site, because
// `SparklineStyled(v, st, true)` says nothing about which way true is.
func sparkReversed(dir SparkDirection) bool = dir match {
    case SparkLeftToRight() => false
    case SparkRightToLeft() => true
}

// sparklineOptGlyph renders one possibly-absent sample: a block for a value,
// a blank column for a gap.
func sparklineOptGlyph(o Option[int], maxV int) string = o match {
    case Some(v) => string(sparklineGlyph(v, maxV))
    case None()  => " "
}

// sparklineGlyph is the block for one present sample. Index 0 of the ramp is
// a space and is deliberately unreachable: a column that carries a value
// always paints. Only an absent sample blanks, which is what makes the two
// distinguishable.
func sparklineGlyph(v int, maxV int) rune {
    val glyphs = ArrayOf[rune](' ', '▁', '▂', '▃', '▄', '▅', '▆', '▇', '█')
    var idx = v * 8 / maxV
    if idx < 1 { idx = 1 }
    if idx > 8 { idx = 8 }
    return glyphs.Get(idx)
}

// ----------------------------------------------------------------------------
// BarChart
// ----------------------------------------------------------------------------
//
// Horizontal bars, one per datum, each with a label and a Gauge-like bar
// whose width is proportional to the value. Useful for comparing multiple
// values at a glance — what every "top N" CLI dashboard renders.

struct BarChartDatum(
    Label string,
    Value int,
)

// BarChart renders one Gauge-like bar per datum, with labels padded so bars
// all start in the same column.
func BarChart(data Array[BarChartDatum]) Widget {
    if data.IsEmpty() {
        return Empty()
    }
    val labelWidth = data.FoldLeft(0, (acc, d) => MaxInt(acc, RuneCount(d.Label)))
    val maxV = data.FoldLeft(1, (acc, d) => MaxInt(acc, d.Value))
    val rows = data.Map((d) => {
        val pct = d.Value * 100 / maxV
        return Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(labelWidth + 1, Text(d.Label)),
            Flex(1, Gauge(pct)),
        )))
    })
    return Column(rows)
}

// ----------------------------------------------------------------------------
// Tree
// ----------------------------------------------------------------------------
//
// A tree node has a label and a list of children. Each node tracks whether
// it's expanded. The renderer walks expanded subtrees with indentation.

struct TreeNode(
    Label    string,
    Children Array[TreeNode],
    Expanded bool,
)

// NewTreeLeaf builds a leaf node (no children, expansion irrelevant).
func NewTreeLeaf(label string) TreeNode =
    TreeNode(Label = label, Children = EmptyArray[TreeNode](), Expanded = false)

// NewTreeBranch builds a branch with children, initially collapsed.
func NewTreeBranch(label string, children Array[TreeNode]) TreeNode =
    TreeNode(Label = label, Children = children, Expanded = false)

// NewTreeBranchExpanded is like NewTreeBranch but opens the node.
func NewTreeBranchExpanded(label string, children Array[TreeNode]) TreeNode =
    TreeNode(Label = label, Children = children, Expanded = true)

// Tree renders a tree node and its (possibly expanded) subtree as a Column
// of Text widgets, one per visible row. Collapsed children are hidden.
func Tree(root TreeNode) Widget {
    val lines = flattenTree(root, 0)
    val rows = lines.Map((line) => Fixed(1, Text(line)))
    return Column(rows)
}

// TreeFocused is the interactive variant: a flat-row index `cursor`
// picks one of the visible rows, and `focused` controls whether the
// cursor is rendered visibly. Apps drive cursor up/down with
// `TreeFlatRowCount` (the number of currently-visible rows) for
// clamping, and use `TreeFocused` in their view().
//
// The plain `Tree` widget is unchanged — TreeFocused is opt-in.
func TreeFocused(root TreeNode, cursor int, focused bool = false) Widget {
    val lines = flattenTree(root, 0)
    val rows = lines.ZipWithIndex().Map((pair) => {
        val (line, i) = pair
        val isCursor = i == cursor
        val style = if (isCursor && focused)
            DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
        else if (isCursor)
            DefaultStyle().WithReverse()
        else
            DefaultStyle()
        // A tree row's label length varies with its nesting depth, so
        // styling the text alone made the cursor highlight a ragged shape
        // that changed width row to row. Restyling the row's area gives a
        // straight edge.
        val cell = TextStyled(line, style)
        return Fixed(1, if (isCursor) Highlighted(cell, style) else cell)
    })
    return Column(rows)
}

// TreeFocusedClick is the click-aware sibling of TreeFocused — every
// visible row registers a hit so a left-click on row `i` dispatches
// `onNodeClick(i)` (the flat-row index, the same coordinate the
// keyboard cursor uses).
//
//     val tree = TreeFocusedClick[Msg](root, cur, true,
//         (i) => OpenNode(FlatIdx = i))
func TreeFocusedClick[T any](
    root TreeNode,
    cursor int,
    focused bool,
    onNodeClick func(int) T,
) Widget {
    val inner = TreeFocused(root, cursor, focused)
    return inner.OnPickRow[T](TreeFlatRowCount(root), onNodeClick)
}

// TreeFlatRowCount returns the number of visible rows in the tree —
// useful for clamping a cursor at the end of the navigable range.
func TreeFlatRowCount(root TreeNode) int = flattenTree(root, 0).Length()

// TreeToggleAt returns a new tree with the Expanded flag of the node at
// flat-row `cursor` flipped. If `cursor` lands on a leaf, the call is a
// no-op visually (leaves have no children to show).
//
// Walks DFS, threading the flat index — same traversal `flattenTree` uses,
// so cursor positions are stable between toggles.
func TreeToggleAt(root TreeNode, cursor int) TreeNode {
    val (next, _) = treeToggleHelper(root, cursor, 0)
    return next
}

// treeToggleHelper visits `node` at flat index `idx`. If `idx == target`,
// returns the node with Expanded flipped. Otherwise recurses into expanded
// children, threading the index. Returns (rewrittenNode, nextFreeIdx).
func treeToggleHelper(node TreeNode, target int, idx int) Tuple[TreeNode, int] {
    if idx == target {
        return (node.Copy(Expanded = !node.Expanded), idx + 1)
    }
    if !node.Expanded || node.Children.IsEmpty() {
        return (node, idx + 1)
    }
    val seed = (EmptyArray[TreeNode](), idx + 1)
    val (newChildren, cur) = node.Children.FoldLeft(
        seed,
        (acc, child) => {
            val (kids, curIdx) = acc
            val (newChild, advancedIdx) = treeToggleHelper(child, target, curIdx)
            return (kids.Append(newChild), advancedIdx)
        },
    )
    return (node.Copy(Children = newChildren), cur)
}

// flattenTree turns a TreeNode into a list of display strings with
// indentation and expand/collapse markers.
func flattenTree(node TreeNode, depth int) Array[string] {
    val indent = treeIndent(depth)
    val marker = treeMarker(node)
    val line = indent + marker + " " + node.Label
    if node.Expanded && node.Children.NonEmpty() {
        return ArrayOf(line).AppendAll(
            node.Children.FlatMap((child) => flattenTree(child, depth + 1)),
        )
    }
    return ArrayOf(line)
}

func treeIndent(depth int) string {
    var s = ""
    var i = 0
    for i < depth {
        s = s + "  "
        i = i + 1
    }
    return s
}

func treeMarker(node TreeNode) string {
    if node.Children.IsEmpty() {
        return "•"
    }
    if node.Expanded {
        return "▼"
    }
    return "▶"
}
