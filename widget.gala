package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

// Widget is the user-facing rendering primitive. A widget is a pure
// description — a value, not a handle — that the renderer walks to paint
// cells into a Buffer. The Widget *tree* is what the user composes; the
// Buffer is just the pixel-level output.
//
// All variants are intentionally data-only (no closures, no mutable state)
// so view(model) can be called many times per frame without side effects.
// This is what lets GALA's sealed-type exhaustiveness carry real safety
// — adding a new widget kind is a compile-time forcing function on every
// renderer that dispatches on the Widget type.
//
// Every container carries its children as `Array[T]` (immutable, functional) —
// user code can `.Map`, `.Filter`, `.FoldLeft` over a widget's children.
sealed type Widget {
    case EmptyWidget()
    case TextWidget(Content string, Style Style)
    // RichTextW renders a RichText block — per-Span styling within a line,
    // per-Line alignment. This is what TextWidget cannot express: a bold
    // word inside a sentence that still participates in normal layout.
    case RichTextW(Text RichText)
    // RestyleW renders `Inner`, then rewrites the Style of every cell in
    // its area through `Restyle`, keeping the glyphs.
    //
    // This is how a region carries a style. Styling the leaf text instead
    // only reaches the cells the text occupies, so a highlight applied that
    // way fragments wherever a layout leaves a gap — between a menu label
    // and its right-aligned hint, between table columns, past the end of a
    // short row. Restyling after the fact covers the whole area, and
    // because it modifies rather than replaces cells it also lets an
    // Overlay's content keep the background it was drawn over.
    case RestyleW(Inner Widget, Restyle func(Style) Style)
    case FillWidget(Ch rune, Style Style)
    case BorderWidget(
        Inner  Widget,
        Kind   BorderKind,
        Sides  BorderSides,
        Style  Style,
        Titles Array[BlockTitle],
    )
    case PaddingWidget(Top int, Right int, Bottom int, Left int, Inner Widget)
    case AlignWidget(Inner Widget, Horiz Align, Vert VAlign, ChildW int, ChildH int)
    case OverlayWidget(Bottom Widget, Top Widget)
    case RowWidget(Children Array[LayoutChild], Flex FlexMode, Spacing int)
    case ColumnWidget(Children Array[LayoutChild], Flex FlexMode, Spacing int)
    case StackWidget(Layers Array[Widget])
    // Offset is the index of the first visible item, or -1 for "track the
    // selection" — the historical auto-scroll behaviour. An explicit value
    // lets an app scroll independently of the cursor (a mouse wheel over an
    // unfocused list), which the auto-only model could not express.
    case ListW(
        Items     Array[ListItem],
        Selected  int,
        SelStyle  Style,
        Offset    int,
        Direction ListDirection,
    )
    case InputW(Value string, Cursor int, Placeholder string, Style Style, PlaceholderStyle Style)
    case ProgressW(Percent int, Style Style)
    case GaugeW(Percent int, Style Style)
    case SpinnerW(Kind SpinnerKind, Frame int, Style Style)
    case ButtonW(Label string, Style Style, Focused bool)
    case ParagraphW(Content string, Style Style)
    case ViewportW(Inner Widget, Offset int, ContentHeight int)
    case ScrollbarW(
        Total       int,
        Visible     int,
        Offset      int,
        Style       Style,
        Orientation ScrollbarOrientation,
    )
    // ClickableW wraps an inner widget and registers its rendered area
    // as a single hit region carrying `Payload`. The runtime's
    // HitRegistry receives the rect during rendering — invisible
    // widgets simply never register, so hidden widgets cannot be
    // clicked.
    //
    // The payload is `any` because the widget tree is type-erased over
    // the app's `Msg` type; the runtime restores the type when it
    // dispatches the click.
    case ClickableW(Inner Widget, Payload any)
    // ClickableRowsW slices its rendered area into `Count` horizontal
    // rows of `RowH` cells each and registers one hit region per row,
    // with the payload for row `i` produced by `Payloads(i)`. Used by
    // list / menu / table widgets that want every row clickable.
    case ClickableRowsW(Inner Widget, Count int, RowH int, Payloads func(int) any)
    // DblClickableW is the double-click sibling of ClickableW: registers
    // the wrapped widget's rectangle as a *double-click* hit. The runtime
    // dispatches the payload only when the user clicks the same region
    // twice within the double-click window. Single clicks pass through
    // to whatever single-click hit (if any) covers the same area.
    case DblClickableW(Inner Widget, Payload any)
    // DblClickableRowsW is the per-row counterpart — each of `Count`
    // stacked rows fires its `Payloads(rowIdx)` only on a double-click.
    case DblClickableRowsW(Inner Widget, Count int, RowH int, Payloads func(int) any)
    // DraggableW wraps an inner widget and registers its rendered area
    // as a drag region. The runtime threads drag state across the
    // press / motion-while-held / release sequence and dispatches
    // phase-tagged messages produced by `Payload(phase)` (typed
    // `func(DragPhase) any` after type erasure). DragRelease is
    // always dispatched against the originating press's payload —
    // even if the cursor is off the region at release — so consumers
    // get a clean "drag is over" signal.
    case DraggableW(Inner Widget, Payload any)
    // DraggableRowsW slices its rendered area into `Count` rows of
    // `RowH` cells each and registers one drag region per row, with
    // `Payloads(i)` producing row `i`'s `func(DragPhase) any`.
    // Used by list / log widgets that want every row drag-selectable.
    case DraggableRowsW(Inner Widget, Count int, RowH int, Payloads func(int) any)
    // CustomW is the escape hatch for user-authored widgets that need
    // pixel-level control. The framework hands the closure the rendered
    // area, the target Buffer, and the live HitRegistry — the user can
    // paint anything (charts, custom borders, hand-laid text) and
    // register their own click hits via `hits.Register(...)`.
    //
    // `MinW` / `MinH` are intrinsic-size hints used by the layout solver
    // and `Render()` (the no-area entrypoint). Pass 0 for "no preferred
    // size" — the widget will expand to whatever its container gives it.
    case CustomW(MinW int, MinH int, Render func(Rect, *Buffer, *HitRegistry))
}

// LayoutChild binds a widget to the Constraint Row/Column use when
// sub-allocating their area. Example:
//   Row(ArrayOf(
//       LayoutChild(Constraint = Length(3), Widget = Text("ID")),
//       LayoutChild(Constraint = Fill(1),   Widget = Text("body")),
//   ))
struct LayoutChild(
    Constraint Constraint,
    Widget     Widget,
)

// BorderKind selects the glyph set used for a BorderWidget. ASCII-only drops
// back to `-`, `|`, `+` for teletype-compatible terminals; the others emit
// Unicode box-drawing characters.
sealed type BorderKind {
    case SingleBorder()
    case DoubleBorder()
    case RoundedBorder()
    case ThickBorder()
    case AsciiBorder()
}

// BorderSides selects which edges a BorderWidget actually draws. All four
// is the usual case (`AllSides()`); partial borders are how panes are
// separated with a single rule instead of a full box — a right-hand pane
// that only draws its left edge shares one column with its neighbour
// rather than butting two box walls together.
struct BorderSides(
    Top    bool,
    Right  bool,
    Bottom bool,
    Left   bool,
)

// AllSides is the full box — the historical BorderWidget behavior.
func AllSides() BorderSides =
    BorderSides(Top = true, Right = true, Bottom = true, Left = true)

// NoSides draws no edges. Useful when a Block is wanted only for its
// titles, or when sides are toggled from app state.
func NoSides() BorderSides =
    BorderSides(Top = false, Right = false, Bottom = false, Left = false)

// SidesOf builds an arbitrary edge set, in CSS order (top, right, bottom,
// left) so it reads the way the shorthand does everywhere else.
func SidesOf(top bool, right bool, bottom bool, left bool) BorderSides =
    BorderSides(Top = top, Right = right, Bottom = bottom, Left = left)

// ListDirection selects which end of the area a list's first item sits at.
// Bottom-to-top is how a chat log or a REPL transcript reads: newest row
// pinned to the bottom edge, older rows scrolling up off the top.
sealed type ListDirection {
    case ListTopToBottom()
    case ListBottomToTop()
}

// ScrollbarOrientation places the bar on one edge of its area and fixes the
// axis it scrolls along. Vertical bars are the common case; horizontal ones
// pair with a wide table or a code view that scrolls sideways.
sealed type ScrollbarOrientation {
    case ScrollbarVerticalRight()
    case ScrollbarVerticalLeft()
    case ScrollbarHorizontalBottom()
    case ScrollbarHorizontalTop()
}

// TitlePosition selects which horizontal edge a BlockTitle sits on.
sealed type TitlePosition {
    case TitleTop()
    case TitleBottom()
}

// BlockTitle is a caption drawn into a border's edge. The content is a
// `Line`, not a string, so a title can mix styles — a bold name next to a
// dim shortcut hint — and so it aligns the same way body text does.
//
// A border may carry several titles; they are drawn in order, and titles
// sharing an edge and alignment are separated by a space.
struct BlockTitle(
    Content  Line,
    Position TitlePosition,
    Align    Align,
)

// TitleOf builds a plain top-left title from a string — the common case.
func TitleOf(content string) BlockTitle =
    BlockTitle(
        Content  = LineFromString(content, DefaultStyle()),
        Position = TitleTop(),
        Align    = AlignLeft(),
    )

// TitleStyled builds a top-left title in a given style.
func TitleStyled(content string, style Style) BlockTitle =
    BlockTitle(
        Content  = LineFromString(content, style),
        Position = TitleTop(),
        Align    = AlignLeft(),
    )

// Align picks the horizontal position of an Align'd child inside its parent
// area. Vertical placement is the separate `VAlign` type (layout.gala) so
// the two axes cannot be mixed up at a call site.
sealed type Align {
    case AlignLeft()
    case AlignCenter()
    case AlignRight()
}

// ----------------------------------------------------------------------------
// Constructor helpers — shorter, more English-like than naming variants directly.
// ----------------------------------------------------------------------------

// Empty is the no-op widget — draws nothing.
func Empty() Widget = EmptyWidget()

// Text wraps a plain string using the default style.
func Text(content string) Widget = TextWidget(Content = content, Style = DefaultStyle())

// TextStyled wraps a string with an explicit style.
func TextStyled(content string, style Style) Widget =
    TextWidget(Content = content, Style = style)

// TextEllipsis is `Text` plus a hard column cap. When `content` is
// wider than `maxCols`, the result is `<first maxCols-1 cols>…`;
// otherwise it's `content` verbatim. Use this for header lines or
// other single-row labels that must fit a fixed slot — the
// underlying terminal will clip mid-grapheme without a marker if
// you don't cap, which reads as "the UI is broken" to users.
//
// `maxCols <= 0` disables the cap (passes through, useful for
// callers that compute the cap from layout).
func TextEllipsis(content string, maxCols int) Widget =
    TextStyled(ellipsisCap(content, maxCols), DefaultStyle())

// TextEllipsisStyled is `TextEllipsis` with an explicit style.
func TextEllipsisStyled(content string, maxCols int, style Style) Widget =
    TextStyled(ellipsisCap(content, maxCols), style)

// ellipsisCap truncates `s` so the rendered string fits in
// `maxCols` cells. Counts runes, not bytes — so multi-byte
// characters (CJK, emoji) don't break the cap. The trailing "…"
// is one rune wide and is included in the budget.
func ellipsisCap(s string, maxCols int) string {
    if maxCols <= 0 { return s }
    val rs = ToRunes(s)
    if rs.Size() <= maxCols { return s }
    if maxCols == 1 { return "…" }
    return string(SliceTo(rs, maxCols - 1)) + "…"
}

// FillCh paints the entire area with `ch` in the default style.
// Useful as a background / spacer. Named FillCh because Fill is already the
// name of the Fill(weight) Constraint variant — shared package namespace.
func FillCh(ch rune) Widget = FillWidget(Ch = ch, Style = DefaultStyle())

// FillChStyled fills with an explicit style — commonly used for themed
// backgrounds (e.g., `FillChStyled(' ', DefaultStyle().On(Blue()))`).
func FillChStyled(ch rune, style Style) Widget =
    FillWidget(Ch = ch, Style = style)

// Border draws a single-line box around `inner`. Most common border; the
// default. For other glyph sets use BorderOf.
func Border(inner Widget) Widget = BorderOf(inner, SingleBorder())

// BorderOf draws a border of a chosen kind around `inner`.
func BorderOf(inner Widget, kind BorderKind) Widget =
    BorderWidget(
        Inner  = inner,
        Kind   = kind,
        Sides  = AllSides(),
        Style  = DefaultStyle(),
        Titles = EmptyArray[BlockTitle](),
    )

// BorderStyled draws a border in a given style — the colour the glyphs
// themselves are painted in, independent of whatever `inner` renders.
func BorderStyled(inner Widget, kind BorderKind, style Style) Widget =
    BorderWidget(
        Inner  = inner,
        Kind   = kind,
        Sides  = AllSides(),
        Style  = style,
        Titles = EmptyArray[BlockTitle](),
    )

// Block is the full form: choose the glyph set, which edges to draw, the
// border style, and any titles. `Border` / `BorderOf` / `BorderStyled` are
// the shorthands for the common shapes.
func Block(
    inner Widget,
    kind BorderKind,
    sides BorderSides,
    style Style,
    titles Array[BlockTitle],
) Widget =
    BorderWidget(
        Inner  = inner,
        Kind   = kind,
        Sides  = sides,
        Style  = style,
        Titles = titles,
    )

// Titled draws a single-line box with one plain top-left title — by far the
// most common titled-panel shape.
func Titled(inner Widget, title string) Widget =
    BorderWidget(
        Inner  = inner,
        Kind   = SingleBorder(),
        Sides  = AllSides(),
        Style  = DefaultStyle(),
        Titles = ArrayOf(TitleOf(title)),
    )

// borderWidthOverhead is how many columns a border steals from its inner
// area — one per drawn vertical edge, so a left-rule-only border costs 1
// rather than the 2 a full box costs.
func borderWidthOverhead(sides BorderSides) int =
    (if (sides.Left) 1 else 0) + (if (sides.Right) 1 else 0)

// borderHeightOverhead is the same count for horizontal edges.
func borderHeightOverhead(sides BorderSides) int =
    (if (sides.Top) 1 else 0) + (if (sides.Bottom) 1 else 0)

// Restyled renders `inner` and then rewrites the style of every cell in its
// area through `f`, keeping the glyphs. The way to make a region carry a
// style — a selected row, a status bar, a themed backdrop — without the
// gaps between a layout's children falling through unstyled.
func Restyled(inner Widget, f func(Style) Style) Widget =
    RestyleW(Inner = inner, Restyle = f)

// Highlighted is the selection case: paint the whole area in `style`,
// whatever the inner widget drew.
//
// It FLATTENS, so it wins over anything underneath — including an outer
// `.WithBold()` / `.WithFg()`, which `restyleLeaves` applies to the inner
// widget before the region runs. `Highlighted(x, s).WithBold()` therefore
// renders unbolded. Reach for `Restyled` when the inner styles should
// survive: it merges, so a bold label stays bold inside a highlighted row,
// and a cell that painted its own background keeps it.
func Highlighted(inner Widget, style Style) Widget =
    RestyleW(Inner = inner, Restyle = (s) => style)

// Backdrop fills in a background only where a cell has not claimed one,
// leaving foreground and attributes alone. The shape a themed pane or a
// surface wants: the text drawn into it stays legible, and anything that
// deliberately painted itself keeps its colour.
//
// The condition is the point. Swapping the background unconditionally would
// be the mirror of the bug this exists to fix — instead of the parent's
// surface losing to the child, the child's would lose to the parent, so a
// coloured chip or a success/error toast inside a themed container would
// come out indistinguishable from plain text.
func Backdrop(inner Widget, bg Color) Widget =
    RestyleW(
        Inner   = inner,
        Restyle = (s) => if (ColorEq(s.Bg, DefaultColor())) s.On(bg) else s,
    )

// RichTextView renders a RichText block — the multi-style counterpart to
// `Text`. Use it wherever a single row needs more than one style.
func RichTextView(text RichText) Widget = RichTextW(Text = text)

// SpansLine renders one row of differently-styled runs — the shorthand for
// the overwhelmingly common single-line case.
func SpansLine(spans ...Span) Widget =
    RichTextW(Text = RichTextOf(ArrayOf(LineOf(ArrayOf(spans...)))))

// Padding adds `n` cells of padding on every side of `inner`.
func Padding(n int, inner Widget) Widget =
    PaddingWidget(Top = n, Right = n, Bottom = n, Left = n, Inner = inner)

// PaddingHV gives different horizontal and vertical padding.
func PaddingHV(v int, h int, inner Widget) Widget =
    PaddingWidget(Top = v, Right = h, Bottom = v, Left = h, Inner = inner)

// Overlay stacks `top` over `bottom` — `top` is drawn after, so it masks the
// cells of `bottom` wherever it paints.
func Overlay(bottom Widget, top Widget) Widget =
    OverlayWidget(Bottom = bottom, Top = top)

// Row lays children left-to-right, sub-allocating its area with the
// constraints on each child.
func Row(children Array[LayoutChild]) Widget =
    RowWidget(Children = children, Flex = FlexLegacy(), Spacing = 0)

// RowFlex lays children left-to-right and distributes any unclaimed space
// according to `flex`, with `spacing` cells between adjacent children.
// Centering a fixed-width child no longer needs throwaway spacers.
func RowFlex(children Array[LayoutChild], flex FlexMode, spacing int) Widget =
    RowWidget(Children = children, Flex = flex, Spacing = spacing)

// RowSpaced is RowFlex with the historical distribution — just gaps.
func RowSpaced(children Array[LayoutChild], spacing int) Widget =
    RowWidget(Children = children, Flex = FlexLegacy(), Spacing = spacing)

// Column lays children top-to-bottom with the same constraint model.
func Column(children Array[LayoutChild]) Widget =
    ColumnWidget(Children = children, Flex = FlexLegacy(), Spacing = 0)

// ColumnFlex is the vertical twin of RowFlex.
func ColumnFlex(children Array[LayoutChild], flex FlexMode, spacing int) Widget =
    ColumnWidget(Children = children, Flex = flex, Spacing = spacing)

// ColumnSpaced is the vertical twin of RowSpaced.
func ColumnSpaced(children Array[LayoutChild], spacing int) Widget =
    ColumnWidget(Children = children, Flex = FlexLegacy(), Spacing = spacing)

// Stack overlays every widget on the same area — useful for modal-over-page,
// tooltip-over-widget, or a backdrop-tint effect.
func Stack(layers Array[Widget]) Widget = StackWidget(Layers = layers)

// Fixed builds a LayoutChild with a Length constraint — the most common form.
func Fixed(n int, w Widget) LayoutChild =
    LayoutChild(Constraint = Length(n), Widget = w)

// Flex builds a LayoutChild with a Fill(weight) constraint.
func Flex(weight int, w Widget) LayoutChild =
    LayoutChild(Constraint = Fill(weight), Widget = w)

// Pct builds a LayoutChild with a Percent constraint.
func Pct(p int, w Widget) LayoutChild =
    LayoutChild(Constraint = Percent(p), Widget = w)

// ----------------------------------------------------------------------------
// Interactive widget constructors.
// ----------------------------------------------------------------------------

// SelectList renders a vertical, selectable list. `selected` is the index
// (0-based) of the highlighted row. The list scrolls its viewport automatically
// so the selected row is always visible. Named SelectList (not List) because
// collection_immutable already exports `List[T]` as a functional linked-list
// type; this widget is about *selection* over a visible menu.
//
// `focused` (default false) brightens the selection row when the
// keyboard is currently driving this list — bold + bright yellow on
// reverse so the user sees where arrows will land.
func SelectList(items Array[ListItem], selected int, focused bool = false) Widget {
    val sel = if (focused)
        DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
    else
        DefaultStyle().WithReverse()
    return ListW(
        Items     = items,
        Selected  = selected,
        SelStyle  = sel,
        Offset    = -1,
        Direction = ListTopToBottom(),
    )
}

// SelectListAt is SelectList with an explicit scroll offset, for a list that
// scrolls independently of its cursor (a wheel over an unfocused pane).
// Pass -1 to restore the "keep the selection visible" behaviour.
func SelectListAt(
    items Array[ListItem],
    selected int,
    offset int,
    focused bool = false,
) Widget {
    val sel = if (focused)
        DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
    else
        DefaultStyle().WithReverse()
    return ListW(
        Items     = items,
        Selected  = selected,
        SelStyle  = sel,
        Offset    = offset,
        Direction = ListTopToBottom(),
    )
}

// SelectListReversed grows upward from the bottom edge — how a chat
// transcript or REPL log reads.
//
// Pass `selected = -1` for a transcript. That is the no-selection sentinel,
// and it is what makes the view anchor to the newest rows: with a real index
// the viewport follows the cursor instead, exactly as a top-to-bottom list
// does, because a selectable reversed list still has to keep its cursor on
// screen.
func SelectListReversed(
    items Array[ListItem],
    selected int,
    focused bool = false,
) Widget {
    val sel = if (focused)
        DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
    else
        DefaultStyle().WithReverse()
    return ListW(
        Items     = items,
        Selected  = selected,
        SelStyle  = sel,
        Offset    = -1,
        Direction = ListBottomToTop(),
    )
}

// SelectListOf is a convenience wrapper when your items are plain strings.
func SelectListOf(labels Array[string], selected int, focused bool = false) Widget =
    SelectList(labels.Map((l) => NewListItem(l)), selected, focused)

// SelectListPick is the click-aware sibling: each row is clickable and
// dispatches `onPick(rowIdx)` when clicked.
//
//     val nav = SelectListPick[Msg](items, sel, true,
//         (i) => OnPick(Idx = i))
func SelectListPick[T any](
    items Array[ListItem],
    selected int,
    focused bool,
    onPick func(int) T,
) Widget = SelectList(items, selected, focused)
    .OnPickRow(items.Length(), onPick)

// SelectListOfPick is the click-aware sibling of SelectListOf — same
// labels-first ergonomics, but each row dispatches `onPick(i)` on click.
func SelectListOfPick[T any](
    labels Array[string],
    selected int,
    focused bool,
    onPick func(int) T,
) Widget = SelectListOf(labels, selected, focused)
    .OnPickRow(labels.Length(), onPick)

// Input renders a single-line text input. `cursor` is the 0-based column of
// the insertion point. Empty value shows `placeholder` in a dimmed style.
//
// `focused` (default false) brightens the typed text when this input is
// the keyboard target.
func Input(value string, cursor int, placeholder string, focused bool = false) Widget {
    val style = if (focused) DefaultStyle().WithBold().WithFg(BrightYellow())
                else DefaultStyle()
    return InputW(Value = value, Cursor = cursor, Placeholder = placeholder,
                  Style = style,
                  PlaceholderStyle = DefaultStyle().WithDim())
}

// Progress renders a horizontal progress bar `[████░░░░]  pct%`.
func Progress(percent int) Widget =
    ProgressW(Percent = percent, Style = DefaultStyle())

// Gauge renders a smooth-edged bar using Unicode partial blocks.
func Gauge(percent int) Widget =
    GaugeW(Percent = percent, Style = DefaultStyle())

// Spinner renders a single-cell animated glyph.
func Spinner(kind SpinnerKind, frame int) Widget =
    SpinnerW(Kind = kind, Frame = frame, Style = DefaultStyle())

// Button renders a labeled button. When `focused`, a reverse style signals
// selection — pair with Enter in the user's update() to fire the action.
func Button(label string, focused bool) Widget {
    val style = if (focused) DefaultStyle().WithReverse().WithBold() else DefaultStyle()
    return ButtonW(Label = label, Style = style, Focused = focused)
}

// ButtonClick is the click-aware sibling: a left-click anywhere on the
// button dispatches `onClick`.
//
//     val saveBtn = ButtonClick[Msg]("Save", focused, Save())
func ButtonClick[T any](label string, focused bool, onClick T) Widget =
    Button(label, focused).OnClick(onClick)

// Paragraph renders multi-line text with word-wrapping within the allocated
// width. Overflow beyond the allocated height is clipped. Long runs of
// non-whitespace that exceed the width break on rune boundaries so nothing
// is dropped.
func Paragraph(content string) Widget =
    ParagraphW(Content = content, Style = DefaultStyle())

// ParagraphStyled is Paragraph with an explicit style.
func ParagraphStyled(content string, style Style) Widget =
    ParagraphW(Content = content, Style = style)

// WrapParagraph is the same word-wrap routine `ParagraphW` uses at render
// time, exposed so callers can pre-compute exact line counts at the same
// width the renderer will use. Useful for variable-height widgets like
// `ConversationLog` where the entry's height MUST match the rendered
// content — otherwise scroll math drifts and tall messages get clipped
// to a single row of body. Caller passes the body width (post-margins).
func WrapParagraph(content string, width int) Array[string] =
    wrapParagraph(content, width)

// ScrollableViewport wraps `inner` so only rows [offset, offset+visibleHeight)
// of its content are shown. `contentHeight` is what the caller expects the
// inner widget to render at full size; the runtime allocates a hidden buffer
// of that height, renders the inner into it, and copies the visible slice.
func ScrollableViewport(inner Widget, offset int, contentHeight int) Widget =
    ViewportW(Inner = inner, Offset = offset, ContentHeight = contentHeight)

// Scrollbar renders a vertical indicator showing position in a larger
// document. `total` is the document's total row count, `visible` is how many
// rows fit in the viewport, `offset` is the topmost visible row.
//
// Pass `visible = 0` to mean "the viewport is however tall the bar is" — the
// renderer then derives it from the area, which is what a caller that does
// not separately track its viewport height wants.
//
// When the document fits, the bar draws track only: a full-height solid
// thumb would give maximum visual weight to "there is nothing to scroll".
func Scrollbar(total int, visible int, offset int) Widget =
    ScrollbarW(
        Total       = total,
        Visible     = visible,
        Offset      = offset,
        Style       = DefaultStyle(),
        Orientation = ScrollbarVerticalRight(),
    )

// ScrollbarStyled is Scrollbar with explicit colors (e.g., dim when the
// viewport isn't focused).
func ScrollbarStyled(total int, visible int, offset int, style Style) Widget =
    ScrollbarW(
        Total       = total,
        Visible     = visible,
        Offset      = offset,
        Style       = style,
        Orientation = ScrollbarVerticalRight(),
    )

// ScrollbarAt places the bar on a chosen edge — the horizontal orientations
// pair with a wide table or a sideways-scrolling code view.
func ScrollbarAt(
    total int,
    visible int,
    offset int,
    style Style,
    orientation ScrollbarOrientation,
) Widget =
    ScrollbarW(
        Total       = total,
        Visible     = visible,
        Offset      = offset,
        Style       = style,
        Orientation = orientation,
    )

// ----------------------------------------------------------------------------
// Clickable / ClickableRows — widgets register their own click hits.
//
// Wrap an existing widget to make it dispatch a Msg on left-click — at
// the rectangle the widget *actually* renders into, not at hand-rolled
// coordinates. Visibility is automatic: widgets that aren't part of the
// view tree on a given frame don't register hits, so apps don't need to
// gate on which screen / modal / route is active.
// ----------------------------------------------------------------------------

// Custom is the escape hatch for user-authored widgets that need
// pixel-level rendering. The closure receives the assigned area, a
// mutable Buffer to paint into, and the live HitRegistry — register
// hit regions inside the closure if the widget should be clickable.
//
// Use this when the widget can't be expressed by composing built-in
// primitives (e.g., a custom chart, a bespoke border style). Most
// user widgets shouldn't need it — composition + `Clickable` /
// `ClickableRows` covers the ergonomic majority.
//
//     val histogram = Custom(40, 8, (area, buf, hits) => {
//         drawHistogram(buckets, area, buf)
//         // Optional: hits.Register(area, OnHistogramClicked())
//     })
func Custom(minW int, minH int, render func(Rect, *Buffer, *HitRegistry)) Widget =
    CustomW(MinW = minW, MinH = minH, Render = render)

// ----------------------------------------------------------------------------
// Tabs
// ----------------------------------------------------------------------------
//
// Tabs doesn't need its own Widget variant — it's a Column of a header row
// (constrained to 1 line) and the selected body widget below. `Tabs` is a
// plain helper; apps wire it in directly.

// Tabs builds a two-row layout: a one-line tab bar on top, then `bodies[sel]`
// below. The non-selected titles render dim, the selected one bold-reverse.
// `sel` is the selected index — callers bump it on Tab/arrow keys.
//
// `focused` (default false) brightens the selected tab so the user can
// see at a glance which tab bar the keyboard is driving.
func Tabs(titles Array[string], bodies Array[Widget], sel int, focused bool = false) Widget {
    val header = tabHeaderRow(titles, sel, focused)
    val body = if (sel >= 0 && sel < bodies.Length()) bodies.Get(sel) else Empty()
    return Column(ArrayOf(
        Fixed(1, header),
        Flex(1, body),
    ))
}

// TabsClick is the click-aware sibling: each title cell becomes clickable
// and dispatches `onTabClick(idx)` on left-click. Bodies are unchanged —
// register their own clickability internally as needed.
//
//     val pane = TabsClick[Msg](titles, bodies, sel, true,
//         (i) => SwitchTab(Idx = i))
func TabsClick[T any](
    titles Array[string],
    bodies Array[Widget],
    sel int,
    focused bool,
    onTabClick func(int) T,
) Widget {
    val header = tabHeaderRowClick[T](titles, sel, focused, onTabClick)
    val body = if (sel >= 0 && sel < bodies.Length()) bodies.Get(sel) else Empty()
    return Column(ArrayOf(
        Fixed(1, header),
        Flex(1, body),
    ))
}

func tabHeaderRow(titles Array[string], sel int, focused bool) Widget {
    val cells = titles.ZipWithIndex().Map((pair) =>
        tabHeaderCell(pair.V1, pair.V2 == sel, focused))
    return Row(cells.Append(Flex(1, FillCh(' '))))
}

// tabHeaderRowClick attaches a click contract to every title cell so
// that clicking it dispatches `onTabClick(idx)`. Cells differ in width
// per title, so this can't use the per-row helper (which assumes
// uniform row-shaped regions) — each cell gets its own `.OnClick`.
func tabHeaderRowClick[T any](
    titles Array[string],
    sel int,
    focused bool,
    onTabClick func(int) T,
) Widget {
    val cells = titles.ZipWithIndex().Map((pair) => {
        val rawCell = tabHeaderCell(pair.V1, pair.V2 == sel, focused)
        return LayoutChild(
            Constraint = rawCell.Constraint,
            Widget     = rawCell.Widget.OnClick(onTabClick(pair.V2)),
        )
    })
    return Row(cells.Append(Flex(1, FillCh(' '))))
}

func tabHeaderCell(title string, selected bool, focused bool) LayoutChild {
    val style = if (selected && focused)
        DefaultStyle().WithBold().WithReverse().WithFg(BrightYellow())
    else if (selected)
        DefaultStyle().WithBold().WithReverse()
    else
        DefaultStyle().WithDim()
    val padded = " " + title + " "
    return Fixed(RuneCount(padded), TextStyled(padded, style))
}

// ----------------------------------------------------------------------------
// Rendering
// ----------------------------------------------------------------------------

// Render renders `w` into a freshly-allocated Buffer sized to `area`. Pure:
// any side effects live in the runtime, not here.
func Render(w Widget) string {
    val buf = NewBuffer(defaultRenderWidth(w), defaultRenderHeight(w))
    RenderTo(w, Rect(X = 0, Y = 0, Width = buf.Width, Height = buf.Height), buf)
    return buf.String()
}

// RenderTo paints `w` into `buf`, restricted to the given `area`.
//
// This is the hit-unaware form — handy for tests and any one-shot
// rendering where click registration doesn't matter. The runtime uses
// `RenderToWithHits` instead so that `Clickable`/`ClickableRows`
// widgets inside `w` can register their rectangles for click dispatch.
func RenderTo(w Widget, area Rect, buf *Buffer) {
    renderToInternal(w, area, buf, nil)
}

// RenderToWithHits is the hit-aware form used by the runtime: any
// `Clickable`/`ClickableRows` widget reached during rendering registers
// its rectangle into `hits`. The runtime then queries the registry on
// every left-click to dispatch the right message — apps don't compute
// click rectangles by hand.
//
// Pass `nil` for `hits` to mirror the plain `RenderTo` behaviour
// (Clickable widgets render their inner content but skip registration).
func RenderToWithHits(w Widget, area Rect, buf *Buffer, hits *HitRegistry) {
    renderToInternal(w, area, buf, hits)
}

func renderToInternal(w Widget, area Rect, buf *Buffer, hits *HitRegistry) {
    if area.Zero() {
        return
    }
    w match {
        case EmptyWidget() => {}
        case TextWidget(content, style) =>
            renderText(content, style, area, buf)
        case RichTextW(text) =>
            renderRichText(text, area, buf)
        case RestyleW(inner, restyle) => {
            renderToInternal(inner, area, buf, hits)
            buf.RestyleRegion(area, restyle)
        }
        case FillWidget(ch, style) =>
            renderFill(ch, style, area, buf)
        case BorderWidget(inner, kind, sides, style, titles) =>
            renderBorder(inner, kind, sides, style, titles, area, buf, hits)
        case PaddingWidget(top, right, bottom, left, inner) =>
            renderPadding(top, right, bottom, left, inner, area, buf, hits)
        case AlignWidget(inner, horiz, vert, cw, ch) =>
            renderAlign(inner, horiz, vert, cw, ch, area, buf, hits)
        case OverlayWidget(bottom, top) => {
            renderToInternal(bottom, area, buf, hits)
            renderToInternal(top, area, buf, hits)
        }
        case RowWidget(children, flex, spacing) =>
            renderRow(children, flex, spacing, area, buf, hits)
        case ColumnWidget(children, flex, spacing) =>
            renderColumn(children, flex, spacing, area, buf, hits)
        case StackWidget(layers) =>
            layers.ForEach((layer) => renderToInternal(layer, area, buf, hits))
        case ListW(items, sel, selStyle, offset, direction) =>
            renderList(items, sel, selStyle, offset, direction, area, buf)
        case InputW(value, cursor, placeholder, style, phStyle) =>
            renderInput(value, cursor, placeholder, style, phStyle, area, buf)
        case ProgressW(pct, style) => {
            val bar = renderProgressBar(pct, area.Width, '█', '░')
            renderText(bar, style, area, buf)
        }
        case GaugeW(pct, style) => {
            val g = renderGauge(pct, area.Width)
            renderText(g, style, area, buf)
        }
        case SpinnerW(kind, frame, style) =>
            buf.Set(area.X, area.Y, Cell(Ch = SpinnerGlyph(kind, frame), St = style))
        case ButtonW(label, style, _) => {
            val padded = "[ " + label + " ]"
            renderText(padded, style, area, buf)
        }
        case ParagraphW(content, style) =>
            renderParagraph(content, style, area, buf)
        case ViewportW(inner, offset, ch) =>
            // Viewports render inner into a hidden buffer at translated
            // coordinates, so widget-owned hit registration would land at
            // the wrong place. We deliberately drop `hits` here — clicks
            // on scrolled viewport content are unsupported for now.
            renderViewport(inner, offset, ch, area, buf)
        case ScrollbarW(total, visible, offset, style, orientation) =>
            renderScrollbar(total, visible, offset, style, orientation, area, buf)
        case ClickableW(inner, payload) => {
            if hits != nil {
                hits.Register(area, payload)
            }
            renderToInternal(inner, area, buf, hits)
        }
        case ClickableRowsW(inner, count, rowH, payloads) => {
            if hits != nil && count > 0 && rowH > 0 {
                var i = 0
                for i < count {
                    val rowY = area.Y + i * rowH
                    if rowY < area.Y + area.Height {
                        val rowH2 = if (rowY + rowH <= area.Y + area.Height)
                                        rowH
                                    else area.Y + area.Height - rowY
                        hits.Register(Rect(
                            X = area.X, Y = rowY,
                            Width = area.Width, Height = rowH2,
                        ), payloads(i))
                    }
                    i = i + 1
                }
            }
            renderToInternal(inner, area, buf, hits)
        }
        case DblClickableW(inner, payload) => {
            if hits != nil {
                hits.RegisterDouble(area, payload)
            }
            renderToInternal(inner, area, buf, hits)
        }
        case DblClickableRowsW(inner, count, rowH, payloads) => {
            if hits != nil && count > 0 && rowH > 0 {
                var i = 0
                for i < count {
                    val rowY = area.Y + i * rowH
                    if rowY < area.Y + area.Height {
                        val rowH2 = if (rowY + rowH <= area.Y + area.Height)
                                        rowH
                                    else area.Y + area.Height - rowY
                        hits.RegisterDouble(Rect(
                            X = area.X, Y = rowY,
                            Width = area.Width, Height = rowH2,
                        ), payloads(i))
                    }
                    i = i + 1
                }
            }
            renderToInternal(inner, area, buf, hits)
        }
        case DraggableW(inner, payload) => {
            if hits != nil {
                hits.RegisterDrag(area, payload)
            }
            renderToInternal(inner, area, buf, hits)
        }
        case DraggableRowsW(inner, count, rowH, payloads) => {
            if hits != nil && count > 0 && rowH > 0 {
                var i = 0
                for i < count {
                    val rowY = area.Y + i * rowH
                    if rowY < area.Y + area.Height {
                        val rowH2 = if (rowY + rowH <= area.Y + area.Height)
                                        rowH
                                    else area.Y + area.Height - rowY
                        hits.RegisterDrag(Rect(
                            X = area.X, Y = rowY,
                            Width = area.Width, Height = rowH2,
                        ), payloads(i))
                    }
                    i = i + 1
                }
            }
            renderToInternal(inner, area, buf, hits)
        }
        case CustomW(_, _, render) =>
            render(area, buf, hits)
    }
}

// renderParagraph word-wraps `content` into the area. Words are ASCII-space
// separated; very long words that exceed area.Width break at rune boundaries.
func renderParagraph(content string, style Style, area Rect, buf *Buffer) {
    if area.Width <= 0 || area.Height <= 0 {
        return
    }
    val lines = wrapParagraph(content, area.Width)
    var y = 0
    val limit = MinInt(lines.Length(), area.Height)
    for y < limit {
        renderText(lines.Get(y), style, Rect(
            X = area.X, Y = area.Y + y,
            Width = area.Width, Height = 1,
        ), buf)
        y = y + 1
    }
}

// wrapState is the running state of the wrapParagraph word-wrap fold:
// accumulated output lines, the line being built, and the unflushed word.
struct wrapState(Out Array[string], Line string, Word string)

// wrapCommitWord folds the pending word into the current line, flushing
// the current line to Out if appending the word would exceed `width`.
// Idempotent when Word is empty.
func wrapCommitWord(s wrapState, width int) wrapState {
    if s.Word == "" { return s }
    if RuneCount(s.Line) == 0 {
        return wrapState(Out = s.Out, Line = s.Word, Word = "")
    }
    if RuneCount(s.Line) + 1 + RuneCount(s.Word) <= width {
        return wrapState(Out = s.Out, Line = s.Line + " " + s.Word, Word = "")
    }
    return wrapState(Out = s.Out.Append(s.Line), Line = s.Word, Word = "")
}

// wrapStepRune processes one input rune of the paragraph.
func wrapStepRune(s wrapState, c rune, width int) wrapState {
    if c == '\n' {
        val flushed = wrapCommitWord(s, width)
        return wrapState(Out = flushed.Out.Append(flushed.Line), Line = "", Word = "")
    }
    if c == ' ' {
        return wrapCommitWord(s, width)
    }
    // Regular rune. Break a pathologically long word if it alone would
    // overflow the current line.
    if RuneCount(s.Word) + 1 > width {
        val outAfterLine = if (RuneCount(s.Line) > 0) s.Out.Append(s.Line) else s.Out
        return wrapState(Out = outAfterLine.Append(s.Word), Line = "", Word = string(c))
    }
    return wrapState(Out = s.Out, Line = s.Line, Word = s.Word + string(c))
}

// wrapParagraph does greedy word-wrap: accumulate words on the current line
// until adding the next one would exceed `width`, then start a new line.
// A word longer than `width` is hard-split at the width boundary.
// Newlines in the input force a line break.
func wrapParagraph(content string, width int) Array[string] {
    // Iterate rune by rune so we handle multibyte UTF-8 and explicit \n.
    var st = wrapState(Out = EmptyArray[string](), Line = "", Word = "")
    for _, c := range content {
        st = wrapStepRune(st, c, width)
    }
    // Flush trailing word + line.
    val flushed = wrapCommitWord(st, width)
    if flushed.Line != "" || flushed.Out.IsEmpty() {
        return flushed.Out.Append(flushed.Line)
    }
    return flushed.Out
}

// renderViewport renders `inner` into a pseudo-buffer sized to the content
// height, then copies the slice `[offset, offset+area.Height)` into the
// viewport area. Simple, correct; fine for content sizes up to a few thousand
// rows.
func renderViewport(inner Widget, offset int, contentHeight int, area Rect, buf *Buffer) {
    if area.Width <= 0 || area.Height <= 0 {
        return
    }
    val ch = MaxInt(area.Height, contentHeight)
    var hidden = NewBuffer(area.Width, ch)
    RenderTo(inner, Rect(X = 0, Y = 0, Width = area.Width, Height = ch), hidden)
    val clampedOffset = clampInt(offset, 0, MaxInt(0, ch - area.Height))
    var y = 0
    for y < area.Height {
        val srcY = clampedOffset + y
        if srcY >= ch {
            y = y + 1
            continue
        }
        var x = 0
        for x < area.Width {
            buf.Set(area.X + x, area.Y + y, hidden.Get(x, srcY))
            x = x + 1
        }
        y = y + 1
    }
}

// renderScrollbar paints a vertical track of the given area.Height with a
// highlighted "thumb" whose size is proportional to visible/total and whose
// position is proportional to offset/total.
func renderScrollbar(
    total int,
    visible int,
    offset int,
    style Style,
    orientation ScrollbarOrientation,
    area Rect,
    buf *Buffer,
) {
    if area.Width <= 0 || area.Height <= 0 {
        return
    }
    val horizontal = orientation match {
        case ScrollbarHorizontalBottom() => true
        case ScrollbarHorizontalTop()    => true
        case ScrollbarVerticalRight()    => false
        case ScrollbarVerticalLeft()     => false
    }
    // Length along the scrolling axis; the other axis picks the edge.
    val span = if (horizontal) area.Width else area.Height
    val edge = orientation match {
        case ScrollbarVerticalRight()    => area.X + area.Width - 1
        case ScrollbarVerticalLeft()     => area.X
        case ScrollbarHorizontalBottom() => area.Y + area.Height - 1
        case ScrollbarHorizontalTop()    => area.Y
    }
    val trackCh = if (horizontal) '─' else '│'
    val track = DefaultStyle().WithDim()

    // `visible = 0` means "the viewport is this bar" — the caller does not
    // separately track a viewport height. Deriving it here is what stops a
    // caller from having to pass a value it does not have; passing
    // `visible = total` (which ScrollPaneView used to do) made every bar
    // look like a full thumb regardless of position.
    val vis = if (visible <= 0) span else visible

    var i = 0
    for i < span {
        if horizontal { buf.Set(area.X + i, edge, Cell(Ch = trackCh, St = track)) }
        else          { buf.Set(edge, area.Y + i, Cell(Ch = trackCh, St = track)) }
        i = i + 1
    }

    if total <= vis || total <= 0 {
        // Nothing to scroll. Track only — a solid full-length thumb would
        // give maximum visual weight to the absence of content.
        return
    }

    val thumbSize = MaxInt(1, span * vis / total)
    val maxOffset = total - vis
    val clamped = clampInt(offset, 0, maxOffset)
    val thumbStart = clamped * (span - thumbSize) / maxOffset
    var yy = 0
    for yy < thumbSize {
        if horizontal {
            buf.Set(area.X + thumbStart + yy, edge, Cell(Ch = '█', St = style))
        } else {
            buf.Set(edge, area.Y + thumbStart + yy, Cell(Ch = '█', St = style))
        }
        yy = yy + 1
    }
}

func clampInt(v int, lo int, hi int) int =
    if (v < lo) lo
    else if (v > hi) hi
    else v

// renderList paints each visible item into `area`. The viewport scrolls so
// that `sel` is always in view.
func renderList(
    items Array[ListItem],
    sel int,
    selStyle Style,
    explicitOffset int,
    direction ListDirection,
    area Rect,
    buf *Buffer,
) {
    val n = items.Length()
    if n == 0 {
        return
    }
    // A negative offset means "track the selection" — the historical
    // behaviour. Anything else is the caller scrolling on its own terms,
    // clamped so it can never point past the end.
    //
    // Bottom-to-top anchors to the TAIL when the offset is automatic. The
    // direction flag only changes where rows are placed, so reusing the
    // top-anchored default here meant a 5-message transcript opened in a
    // 3-row pane showed messages 1-3 — the oldest — instead of the newest
    // three, which is the opposite of what the mode is for.
    // `sel < 0` is the no-selection sentinel (the convention NewTable already
    // uses), and it is what selects tail-anchoring. Discriminating on
    // `sel > 0` instead would overload index 0 to mean both "no cursor" and
    // "cursor on the first item": a focused reversed list with the cursor at
    // 0 would render no visible highlight at all, and the viewport would
    // jump from the tail back to the head on the first Down keypress.
    val autoOffset = direction match {
        case ListTopToBottom() => listViewportOffset(n, sel, area.Height)
        case ListBottomToTop() =>
            if (sel >= 0) listViewportOffset(n, sel, area.Height)
            else MaxInt(0, n - MaxInt(1, area.Height))
    }
    val offset = if (explicitOffset < 0)
        autoOffset
    else
        clampInt(explicitOffset, 0, MaxInt(0, n - MaxInt(1, area.Height)))
    val visibleRows = MinInt(area.Height, MaxInt(0, n - offset))
    var row = 0
    for row < area.Height {
        val idx = offset + row
        if idx >= n {
            row = row + 1
            continue
        }
        // Bottom-to-top pins the first visible item to the bottom edge, so
        // a transcript grows upward and short content sits at the foot of
        // the pane instead of floating at the top.
        val y = direction match {
            case ListTopToBottom() => area.Y + row
            case ListBottomToTop() => area.Y + area.Height - visibleRows + row
        }
        val item = items.Get(idx)
        var style = item.Style
        if idx == sel {
            style = selStyle
        }
        // Clear the row to the area width (with the style) so selected
        // highlighting extends across the whole row.
        var x = area.X
        val xEnd = area.X + area.Width
        for x < xEnd {
            buf.Set(x, y, Cell(Ch = ' ', St = style))
            x = x + 1
        }
        // Then draw the label, clipped to width.
        renderText(item.Label, style, Rect(
            X = area.X, Y = y,
            Width = area.Width, Height = 1,
        ), buf)
        row = row + 1
    }
}

// listViewportOffset computes the top-of-viewport index so that `sel` is
// on-screen. Simple top-or-bottom anchor.
func listViewportOffset(n int, sel int, height int) int =
    if (height <= 0 || n <= height) 0
    else if (sel < height) 0
    else MinInt(sel - height + 1, n - height)

// renderInput paints a value or a placeholder, plus a visible cursor.
func renderInput(value string, cursor int, placeholder string, style Style, phStyle Style, area Rect, buf *Buffer) {
    if value == "" && placeholder != "" {
        renderText(placeholder, phStyle, area, buf)
        return
    }
    renderText(value, style, area, buf)
    val cx = area.X + cursor
    if cx >= area.X && cx < area.X + area.Width {
        val ch = buf.CharAt(cx, area.Y)
        buf.Set(cx, area.Y, Cell(Ch = ch, St = style.WithReverse()))
    }
}

// renderRow walks children left-to-right, handing each a Rect whose width
// comes from the Constraint solver.
func renderRow(
    children Array[LayoutChild],
    flex FlexMode,
    spacing int,
    area Rect,
    buf *Buffer,
    hits *HitRegistry,
) {
    val n = children.Length()
    val gaps = totalGaps(n, spacing)
    val widths = Solve(MaxInt(0, area.Width - gaps), children.Map((c) => c.Constraint))
    val offsets = flexOffsets(flex, area.Width, widths, spacing)
    var i = 0
    for i < n {
        renderToInternal(children.Get(i).Widget, Rect(
            X      = area.X + offsets.Get(i),
            Y      = area.Y,
            Width  = widths.Get(i),
            Height = area.Height,
        ), buf, hits)
        i = i + 1
    }
}

// renderColumn is the vertical twin of renderRow.
func renderColumn(
    children Array[LayoutChild],
    flex FlexMode,
    spacing int,
    area Rect,
    buf *Buffer,
    hits *HitRegistry,
) {
    val n = children.Length()
    val gaps = totalGaps(n, spacing)
    val heights = Solve(MaxInt(0, area.Height - gaps), children.Map((c) => c.Constraint))
    val offsets = flexOffsets(flex, area.Height, heights, spacing)
    var i = 0
    for i < n {
        renderToInternal(children.Get(i).Widget, Rect(
            X      = area.X,
            Y      = area.Y + offsets.Get(i),
            Width  = area.Width,
            Height = heights.Get(i),
        ), buf, hits)
        i = i + 1
    }
}

// totalGaps is the space consumed by inter-child spacing: one gap between
// each adjacent pair, none at the edges.
func totalGaps(n int, spacing int) int =
    if (n <= 1) 0 else MaxInt(0, spacing) * (n - 1)

// flexOffsets turns solved child sizes into start positions along the axis,
// distributing whatever space the children did not claim according to
// `flex`. Returns one offset per child, relative to the area's origin.
//
// `Solve` answers "how big is each child"; this answers the question that
// only appears once they are sized and cells are still left over. Under
// FlexLegacy the answer is the historical one — children are packed from
// the start and the slack is simply left at the end, which is where a
// trailing Fill would already have absorbed it.
func flexOffsets(
    flex FlexMode,
    total int,
    sizes Array[int],
    spacing int,
) Array[int] {
    val n = sizes.Length()
    if n == 0 {
        return EmptyArray[int]()
    }
    val used = sizes.FoldLeft(0, (acc, s) => acc + s) + totalGaps(n, spacing)
    val slack = MaxInt(0, total - used)
    val gap = MaxInt(0, spacing)

    // Every mode is the same computation over a different weighting of the
    // n+1 slots slack can land in: before the first child, between each
    // adjacent pair, and after the last. Expressing them uniformly is what
    // lets one exact-rounding pass handle the remainder for all of them.
    //
    // Integer division per gap silently dropped `slack mod divisor` onto the
    // trailing edge, which broke SpaceBetween's defining property (first
    // child at the start, last at the end) on odd slack, and left
    // SpaceAround lopsided at essentially every width.
    val gaps = flexGaps(flex, n, slack)

    var offsets = EmptyArray[int]()
    var pos = gaps.Get(0)
    var i = 0
    for i < n {
        offsets = offsets.Append(pos)
        pos = pos + sizes.Get(i) + gap + gaps.Get(i + 1)
        i = i + 1
    }
    return offsets
}

// flexGaps sizes the n+1 slots slack can land in: index 0 is the leading
// edge, index n the trailing edge, and the rest the gaps between adjacent
// children.
//
// The four edge modes place slack at one edge or split it once, so there is
// no distribution to get wrong; `lead` is stated directly. Only the three
// space-* modes divide slack across several gaps, and those are the ones
// that need exact remainder handling.
func flexGaps(flex FlexMode, n int, slack int) Array[int] =
    flex match {
        // Slack sits at the end — where a trailing Fill would already have
        // absorbed it. The historical behaviour, and the default.
        case FlexLegacy() => edgeGaps(n, 0, slack)
        case FlexStart()  => edgeGaps(n, 0, slack)
        case FlexEnd()    => edgeGaps(n, slack, 0)
        // Odd slack cannot split evenly; the extra cell goes to the trailing
        // edge, so a centred child sits one column left of true centre
        // rather than one right. Matches what Wave A shipped.
        case FlexCenter() => edgeGaps(n, slack / 2, slack - slack / 2)
        // Strictly between children: both edges get nothing. With one child
        // there is no "between", so it degenerates to trailing slack.
        case FlexSpaceBetween() =>
            if (n <= 1) edgeGaps(n, 0, slack)
            else distributeSlack(slack,
                ArrayTabulate(n + 1, (i) => if (i == 0 || i == n) 0 else 1))
        // Each child carries an equal share on both sides, so the two edge
        // gaps are half the size of the gaps between children.
        case FlexSpaceAround() =>
            distributeSlack(slack,
                ArrayTabulate(n + 1, (i) => if (i == 0 || i == n) 1 else 2))
        // Every gap equal, edges included.
        case FlexSpaceEvenly() =>
            distributeSlack(slack, ArrayTabulate(n + 1, (i) => 1))
    }

// edgeGaps builds an n+1 slot sizing that only feeds the two edges.
func edgeGaps(n int, lead int, trail int) Array[int] =
    ArrayTabulate(n + 1, (i) =>
        if (i == 0) lead else if (i == n) trail else 0)

// distributeSlack splits `total` across weighted slots so that the parts sum
// to exactly `total` and any two equally-weighted slots differ by at most one
// cell. Uses exact cumulative rounding rather than per-slot division, which
// is what keeps the remainder from piling up on the last slot.
//
// The cumulative target is rounded to nearest (`+ sumW/2`) rather than
// floored. Flooring also sums correctly, but it biases every fractional slot
// downward and then repays the debt at the end, which made SpaceAround
// asymmetric — weights 1:2:2:1 over 8 cells came out 1,3,2,2, so the left
// edge got one cell and the right edge two. Rounding gives 1,3,3,1.
//
// Rounding half UP is also why the two centring modes break ties in opposite
// directions: at a genuine tie SpaceAround gives the extra cell to the
// leading edge, while FlexCenter — which does not come through here, and
// uses `slack / 2` — gives it to the trailing edge. Both are pinned by
// tests; the asymmetry is a consequence of this line, not a bug.
func distributeSlack(total int, weights Array[int]) Array[int] {
    val sumW = weights.FoldLeft(0, (acc, w) => acc + MaxInt(0, w))
    if sumW <= 0 || total <= 0 {
        return weights.Map((w) => 0)
    }
    val half = sumW / 2
    var out = EmptyArray[int]()
    var acc = 0
    var given = 0
    var i = 0
    val n = weights.Length()
    for i < n {
        acc = acc + total * MaxInt(0, weights.Get(i))
        val upto = (acc + half) / sumW
        out = out.Append(upto - given)
        given = upto
        i = i + 1
    }
    return out
}

// renderText lays out `content` on a single line, clipped to the area width.
// Advances the cursor by each rune's grapheme cell width so CJK, emoji, and
// fullwidth glyphs occupy two columns; combining marks consume zero columns.
// A wide glyph that would only half-fit at the right edge is dropped instead
// of bleeding past the boundary.
func renderText(content string, style Style, area Rect, buf *Buffer) {
    var x = area.X
    val maxX = area.X + area.Width
    for _, r := range content {
        val w = RuneCellWidth(r)
        if w == 0 {
            // Combining mark — drop (a future iteration could merge into the
            // previous cell's glyph; ASCII/Latin paths unaffected).
            continue
        }
        if x + w > maxX {
            return
        }
        buf.Set(x, area.Y, Cell(Ch = r, St = style))
        if w == 2 {
            buf.Set(x + 1, area.Y, Cell(Ch = ' ', St = style))
        }
        x = x + w
    }
}

// renderFill paints the whole area with the fill cell.
func renderFill(ch rune, style Style, area Rect, buf *Buffer) {
    buf.Fill(area, Cell(Ch = ch, St = style))
}

// renderBorder paints a 4-corner + 4-edge frame using the glyph set chosen
// by `kind`, then recurses into the inner widget on the 1-cell-inset area.
func renderBorder(
    inner Widget,
    kind BorderKind,
    sides BorderSides,
    style Style,
    titles Array[BlockTitle],
    area Rect,
    buf *Buffer,
    hits *HitRegistry,
) {
    val g = borderGlyphs(kind)
    val right  = area.X + area.Width - 1
    val bottom = area.Y + area.Height - 1

    // Edges. Each runs the full span and lets the corner pass below
    // overwrite the ends, so a partial border (a lone left rule, say) is a
    // clean line rather than a box missing three walls.
    if sides.Top {
        var x = area.X
        for x <= right {
            buf.Set(x, area.Y, Cell(Ch = g.H, St = style))
            x = x + 1
        }
    }
    if sides.Bottom {
        var x = area.X
        for x <= right {
            buf.Set(x, bottom, Cell(Ch = g.H, St = style))
            x = x + 1
        }
    }
    if sides.Left {
        var y = area.Y
        for y <= bottom {
            buf.Set(area.X, y, Cell(Ch = g.V, St = style))
            y = y + 1
        }
    }
    if sides.Right {
        var y = area.Y
        for y <= bottom {
            buf.Set(right, y, Cell(Ch = g.V, St = style))
            y = y + 1
        }
    }

    // Corners only exist where two edges actually meet.
    if sides.Top && sides.Left     { buf.Set(area.X, area.Y, Cell(Ch = g.TL, St = style)) }
    if sides.Top && sides.Right    { buf.Set(right,  area.Y, Cell(Ch = g.TR, St = style)) }
    if sides.Bottom && sides.Left  { buf.Set(area.X, bottom, Cell(Ch = g.BL, St = style)) }
    if sides.Bottom && sides.Right { buf.Set(right,  bottom, Cell(Ch = g.BR, St = style)) }

    renderBlockTitles(titles, sides, area, buf)

    // Inner area — inset by whichever edges were actually drawn.
    val dx = if (sides.Left) 1 else 0
    val dy = if (sides.Top) 1 else 0
    val iw = MaxInt(0, area.Width - borderWidthOverhead(sides))
    val ih = MaxInt(0, area.Height - borderHeightOverhead(sides))
    if iw > 0 && ih > 0 {
        renderToInternal(inner, Rect(
            X      = area.X + dx,
            Y      = area.Y + dy,
            Width  = iw,
            Height = ih,
        ), buf, hits)
    }
}

// renderBlockTitles paints titles into the horizontal edges. Titles are
// drawn *over* the already-painted edge glyphs, and only onto an edge that
// is actually being drawn — a title asking for the bottom edge of a
// top-only border is dropped rather than floating in the body.
//
// Titles sharing an edge and an alignment are laid out left to right with a
// single space between them, matching how a tab strip or a "name ── hint"
// caption reads.
func renderBlockTitles(
    titles Array[BlockTitle],
    sides BorderSides,
    area Rect,
    buf *Buffer,
) {
    // The guard is on the caption slot, not the area: a top-rule-only
    // border has no corners to reserve, so a 2-cell area still has room.
    if titles.IsEmpty() || area.Width <= borderWidthOverhead(sides) {
        return
    }
    // The span available to captions: inside whichever corners exist. A
    // top-rule-only header has none, so hardcoding a 1-cell inset there
    // would indent the caption into the rule for no reason and leave a
    // stray glyph at each end — and a titled section rule is the main
    // reason BorderSides exists.
    val slotX = area.X + (if (sides.Left) 1 else 0)
    val slotW = MaxInt(0, area.Width - borderWidthOverhead(sides))
    ArrayOf(TitleTop(), TitleBottom()).ForEach((pos) => {
        val edgeDrawn = pos match {
            case TitleTop()    => sides.Top
            case TitleBottom() => sides.Bottom
        }
        if edgeDrawn {
            val y = pos match {
                case TitleTop()    => area.Y
                case TitleBottom() => area.Y + area.Height - 1
            }
            ArrayOf(AlignLeft(), AlignCenter(), AlignRight()).ForEach((al) => {
                val group = titles.Filter((t) =>
                    titlePositionEqual(t.Position, pos) && alignEqual(t.Align, al))
                if group.NonEmpty() {
                    renderTitleGroup(group, al, slotX, y, slotW, buf)
                }
            })
        }
    })
}

// renderTitleGroup draws one alignment bucket's titles as a single run.
func renderTitleGroup(
    group Array[BlockTitle],
    al Align,
    slotX int,
    y int,
    slotW int,
    buf *Buffer,
) {
    val spans = joinTitleSpans(group)
    val width = MinInt(slotW, spans.FoldLeft(0, (acc, s) => acc + s.CellWidth()))
    val startX = al match {
        case AlignLeft()   => slotX
        case AlignCenter() => slotX + MaxInt(0, (slotW - width) / 2)
        case AlignRight()  => slotX + MaxInt(0, slotW - width)
    }
    drawSpans(spans, startX, y, slotX + slotW, buf)
}

// joinTitleSpans flattens a title group's Lines into one span run, with a
// single default-styled space between adjacent titles.
func joinTitleSpans(group Array[BlockTitle]) Array[Span] =
    group.FoldLeft(EmptyArray[Span](), (acc, t) =>
        if (acc.IsEmpty()) t.Content.Spans
        else acc.Append(SpanOf(" ")).AppendAll(t.Content.Spans))

// drawSpans paints a span run left to right starting at `x`, clipping at
// `maxX`. Shared by title rendering and RichTextW.
// Stops at the first glyph that does not fit, exactly as `renderText` does.
// Skipping it and continuing would let a narrower glyph later in the run
// slide into the space, so the user would read a *different string* than
// the model holds: "a中b" clipped to 2 cells rendered as "ab" rather than
// "a". drawSpans backs both RichTextW and block titles, so that applied to
// every rich-text row and every caption.
func drawSpans(spans Array[Span], x int, y int, maxX int, buf *Buffer) {
    var cx = x
    var i = 0
    val n = spans.Length()
    for i < n {
        val s = spans.Get(i)
        for _, r := range s.Content {
            val w = RuneCellWidth(r)
            if w == 0 {
                // Combining mark — consumes no columns, same as renderText.
                continue
            }
            if cx + w > maxX {
                return
            }
            buf.Set(cx, y, Cell(Ch = r, St = s.Style))
            if w == 2 { buf.Set(cx + 1, y, Cell(Ch = ' ', St = s.Style)) }
            cx = cx + w
        }
        i = i + 1
    }
}

// titlePositionEqual / alignEqual — value comparison on zero-field sealed
// variants, used to bucket titles by edge and alignment.
func titlePositionEqual(a TitlePosition, b TitlePosition) bool = a match {
    case TitleTop()    => b match { case TitleTop() => true    case _ => false }
    case TitleBottom() => b match { case TitleBottom() => true case _ => false }
}

func alignEqual(a Align, b Align) bool = a match {
    case AlignLeft()   => b match { case AlignLeft() => true   case _ => false }
    case AlignCenter() => b match { case AlignCenter() => true case _ => false }
    case AlignRight()  => b match { case AlignRight() => true  case _ => false }
}

// renderRichText paints one Line per row, honouring each Line's own
// alignment. Lines past the bottom of the area are dropped; a Line wider
// than the area is clipped at the right edge (wrapping is the caller's
// decision, since only the caller knows whether the overflow should wrap,
// ellipsise or scroll).
func renderRichText(text RichText, area Rect, buf *Buffer) {
    val maxX = area.X + area.Width
    var row = 0
    for row < area.Height && row < text.Lines.Length() {
        val line = text.Lines.Get(row)
        val w = MinInt(area.Width, line.CellWidth())
        val startX = line.Align match {
            case AlignLeft()   => area.X
            case AlignCenter() => area.X + MaxInt(0, (area.Width - w) / 2)
            case AlignRight()  => area.X + MaxInt(0, area.Width - w)
        }
        drawSpans(line.Spans, startX, area.Y + row, maxX, buf)
        row = row + 1
    }
}

// renderPadding reduces the area by the padding values and recurses.
func renderPadding(top int, right int, bottom int, left int, inner Widget,
                   area Rect, buf *Buffer, hits *HitRegistry) {
    val newW = MaxInt(0, area.Width - left - right)
    val newH = MaxInt(0, area.Height - top - bottom)
    renderToInternal(inner, Rect(
        X      = area.X + left,
        Y      = area.Y + top,
        Width  = newW,
        Height = newH,
    ), buf, hits)
}

// renderAlign picks the horizontal position of an inner widget.
func renderAlign(inner Widget, horiz Align, vert VAlign, cw int, ch int,
                 area Rect, buf *Buffer, hits *HitRegistry) {
    val dx = horiz match {
        case AlignLeft()   => 0
        case AlignCenter() => MaxInt(0, (area.Width - cw) / 2)
        case AlignRight()  => MaxInt(0, area.Width - cw)
    }
    val dy = vert match {
        case VAlignTop()    => 0
        case VAlignMiddle() => MaxInt(0, (area.Height - ch) / 2)
        case VAlignBottom() => MaxInt(0, area.Height - ch)
    }
    renderToInternal(inner, Rect(
        X      = area.X + dx,
        Y      = area.Y + dy,
        Width  = MinInt(cw, area.Width - dx),
        Height = MinInt(ch, area.Height - dy),
    ), buf, hits)
}

// borderGlyphs is a tuple-ish holder for the six glyphs a border uses.
type BorderGlyphs struct {
    TL rune
    TR rune
    BL rune
    BR rune
    H  rune
    V  rune
}

// borderGlyphs maps a BorderKind to its glyph set.
func borderGlyphs(k BorderKind) BorderGlyphs {
    return k match {
        case SingleBorder()  =>
            BorderGlyphs(TL = '┌', TR = '┐', BL = '└', BR = '┘', H = '─', V = '│')
        case DoubleBorder()  =>
            BorderGlyphs(TL = '╔', TR = '╗', BL = '╚', BR = '╝', H = '═', V = '║')
        case RoundedBorder() =>
            BorderGlyphs(TL = '╭', TR = '╮', BL = '╰', BR = '╯', H = '─', V = '│')
        case ThickBorder()   =>
            BorderGlyphs(TL = '┏', TR = '┓', BL = '┗', BR = '┛', H = '━', V = '┃')
        case AsciiBorder()   =>
            BorderGlyphs(TL = '+', TR = '+', BL = '+', BR = '+', H = '-', V = '|')
    }
}

// ----------------------------------------------------------------------------
// Intrinsic-size helpers — used by Render() when no explicit area is given.
// ----------------------------------------------------------------------------

func defaultRenderWidth(w Widget) int {
    return w match {
        case EmptyWidget()                     => 0
        case TextWidget(content, _)            => RuneCount(content)
        case RichTextW(text)                   => text.CellWidth()
        case RestyleW(inner, _)                => defaultRenderWidth(inner)
        case FillWidget(_, _)                  => 1
        case BorderWidget(inner, _, sides, _, _) =>
            defaultRenderWidth(inner) + borderWidthOverhead(sides)
        case PaddingWidget(_, r, _, l, inner)  => defaultRenderWidth(inner) + l + r
        case AlignWidget(_, _, _, cw, _)       => cw
        case OverlayWidget(bottom, top)        =>
            MaxInt(defaultRenderWidth(bottom), defaultRenderWidth(top))
        case RowWidget(children, _, _)         =>
            children.FoldLeft(0, (acc, c) => acc + defaultRenderWidth(c.Widget))
        case ColumnWidget(children, _, _)      =>
            children.FoldLeft(0, (acc, c) => MaxInt(acc, defaultRenderWidth(c.Widget)))
        case StackWidget(layers)               =>
            layers.FoldLeft(0, (acc, w) => MaxInt(acc, defaultRenderWidth(w)))
        case ListW(items, _, _, _, _)          =>
            items.FoldLeft(0, (acc, it) => MaxInt(acc, RuneCount(it.Label)))
        case InputW(value, _, ph, _, _)        => MaxInt(RuneCount(value), RuneCount(ph))
        case ProgressW(_, _)                   => 20
        case GaugeW(_, _)                      => 20
        case SpinnerW(_, _, _)                 => 1
        case ButtonW(label, _, _)              => RuneCount(label) + 4
        case ParagraphW(content, _)            => paragraphIntrinsicWidth(content)
        case ViewportW(inner, _, _)            => defaultRenderWidth(inner)
        case ScrollbarW(_, _, _, _, _)         => 1
        case ClickableW(inner, _)              => defaultRenderWidth(inner)
        case ClickableRowsW(inner, _, _, _)    => defaultRenderWidth(inner)
        case DblClickableW(inner, _)           => defaultRenderWidth(inner)
        case DblClickableRowsW(inner, _, _, _) => defaultRenderWidth(inner)
        case DraggableW(inner, _)              => defaultRenderWidth(inner)
        case DraggableRowsW(inner, _, _, _)    => defaultRenderWidth(inner)
        case CustomW(minW, _, _)               => minW
    }
}

func defaultRenderHeight(w Widget) int {
    return w match {
        case EmptyWidget()                     => 0
        case TextWidget(_, _)                  => 1
        case RichTextW(text)                   => text.LineCount()
        case RestyleW(inner, _)                => defaultRenderHeight(inner)
        case FillWidget(_, _)                  => 1
        case BorderWidget(inner, _, sides, _, _) =>
            defaultRenderHeight(inner) + borderHeightOverhead(sides)
        case PaddingWidget(t, _, b, _, inner)  => defaultRenderHeight(inner) + t + b
        case AlignWidget(_, _, _, _, ch)       => ch
        case OverlayWidget(bottom, top)        =>
            MaxInt(defaultRenderHeight(bottom), defaultRenderHeight(top))
        case RowWidget(children, _, _)         =>
            children.FoldLeft(0, (acc, c) => MaxInt(acc, defaultRenderHeight(c.Widget)))
        case ColumnWidget(children, _, _)      =>
            children.FoldLeft(0, (acc, c) => acc + defaultRenderHeight(c.Widget))
        case StackWidget(layers)               =>
            layers.FoldLeft(0, (acc, w) => MaxInt(acc, defaultRenderHeight(w)))
        case ListW(items, _, _, _, _)          => MaxInt(1, items.Length())
        case InputW(_, _, _, _, _)             => 1
        case ProgressW(_, _)                   => 1
        case GaugeW(_, _)                      => 1
        case SpinnerW(_, _, _)                 => 1
        case ButtonW(_, _, _)                  => 1
        case ParagraphW(content, _)            => paragraphIntrinsicHeight(content)
        case ViewportW(_, _, _)                => 1
        case ScrollbarW(_, _, _, _, _)         => 1
        case ClickableW(inner, _)              => defaultRenderHeight(inner)
        case ClickableRowsW(inner, _, _, _)    => defaultRenderHeight(inner)
        case DblClickableW(inner, _)           => defaultRenderHeight(inner)
        case DblClickableRowsW(inner, _, _, _) => defaultRenderHeight(inner)
        case DraggableW(inner, _)              => defaultRenderHeight(inner)
        case DraggableRowsW(inner, _, _, _)    => defaultRenderHeight(inner)
        case CustomW(_, minH, _)               => minH
    }
}

// IntrinsicHeightAt is the width-aware counterpart of
// `defaultRenderHeight`. It returns the EXACT row count `w` will occupy
// when rendered into a column of the given `width` — accounting for
// `ParagraphW`'s wrap, `BorderWidget`'s frame, `PaddingWidget`'s
// padding, and `ColumnWidget`'s summing of `Fixed` children.
//
// This is the foundation primitive callers like `ConversationLog` need
// when storing a pre-computed `Height` next to a `Widget`: tell us the
// width you'll lay it out at and we'll tell you how many rows to
// allocate. If `Height` and the actual render diverge, partial-clip
// math drifts and tall content gets truncated.
//
// Caveats / current scope:
//   - `RowWidget` falls back to `defaultRenderHeight` (max child
//     height). The proper answer requires running the layout solver
//     to know each child's allocated width — we don't do that here.
//   - `Flex`/`Percent` layout-children inside a Column are treated as
//     their inner widget's intrinsic height (they have no intrinsic
//     row count of their own). In practice the natural use case is a
//     Column of `Fixed`s, where this method is exact.
//   - `ViewportW` reports `ContentHeight` (what it WILL render once
//     given its full slot). The default-render variant returns 1
//     because viewport's actual painted height is whatever slot it
//     gets — you almost always pair it with `Fixed(N, ViewportW(...))`.
func IntrinsicHeightAt(w Widget, width int) int {
    return w match {
        case EmptyWidget()                     => 0
        case TextWidget(_, _)                  => 1
        case RichTextW(text)                   => text.LineCount()
        case RestyleW(inner, _)                => IntrinsicHeightAt(inner, width)
        case FillWidget(_, _)                  => 1
        case BorderWidget(inner, _, sides, _, _) =>
            IntrinsicHeightAt(inner, MaxInt(0, width - borderWidthOverhead(sides)))
                + borderHeightOverhead(sides)
        case PaddingWidget(t, r, b, l, inner)  =>
            IntrinsicHeightAt(inner, MaxInt(0, width - r - l)) + t + b
        case AlignWidget(_, _, _, _, ch)       => ch
        case OverlayWidget(bottom, top)        =>
            MaxInt(IntrinsicHeightAt(bottom, width), IntrinsicHeightAt(top, width))
        case RowWidget(_, _, _)                => defaultRenderHeight(w)
        case ColumnWidget(children, _, _)      =>
            children.FoldLeft(0, (acc, c) => acc + intrinsicChildHeight(c, width))
        case StackWidget(layers)               =>
            layers.FoldLeft(0, (acc, l) => MaxInt(acc, IntrinsicHeightAt(l, width)))
        case ListW(items, _, _, _, _)          => MaxInt(1, items.Length())
        case InputW(_, _, _, _, _)             => 1
        case ProgressW(_, _)                   => 1
        case GaugeW(_, _)                      => 1
        case SpinnerW(_, _, _)                 => 1
        case ButtonW(_, _, _)                  => 1
        case ParagraphW(content, _)            =>
            MaxInt(1, WrapParagraph(content, MaxInt(1, width)).Length())
        case ViewportW(_, _, contentHeight)    => contentHeight
        case ScrollbarW(_, _, _, _, _)         => 1
        case ClickableW(inner, _)              => IntrinsicHeightAt(inner, width)
        case ClickableRowsW(inner, _, _, _)    => IntrinsicHeightAt(inner, width)
        case DblClickableW(inner, _)           => IntrinsicHeightAt(inner, width)
        case DblClickableRowsW(inner, _, _, _) => IntrinsicHeightAt(inner, width)
        case DraggableW(inner, _)              => IntrinsicHeightAt(inner, width)
        case DraggableRowsW(inner, _, _, _)    => IntrinsicHeightAt(inner, width)
        case CustomW(_, minH, _)               => minH
    }
}

// intrinsicChildHeight collapses a `LayoutChild`'s contribution to its
// parent Column's height. Fixed contributes its declared height
// regardless of inner widget; Flex/Percent fall back to the inner
// widget's intrinsic height (they have no intrinsic row count of their
// own).
func intrinsicChildHeight(c LayoutChild, width int) int = c.Constraint match {
    case Length(n)    => n
    case Fill(_)      => IntrinsicHeightAt(c.Widget, width)
    case Percent(_)   => IntrinsicHeightAt(c.Widget, width)
    case MinLen(n)    => MaxInt(n, IntrinsicHeightAt(c.Widget, width))
    // A cap only bites when the inner widget wants more than it allows.
    case MaxLen(n)    => MinInt(n, IntrinsicHeightAt(c.Widget, width))
    // Like Percent, a ratio is a share of a parent this function cannot
    // see, so it has no intrinsic row count of its own.
    case Ratio(_, _)  => IntrinsicHeightAt(c.Widget, width)
}

// paragraphIntrinsicWidth returns the widest line in `content` (split on
// newlines) — what a fully-expanded Paragraph would want as its natural
// width before any wrap happens.
func paragraphIntrinsicWidth(content string) int {
    var width = 0
    var current = 0
    for _, c := range content {
        if c == '\n' {
            if current > width { width = current }
            current = 0
        } else {
            current = current + 1
        }
    }
    if current > width { width = current }
    return width
}

// paragraphIntrinsicHeight counts lines (newlines + 1, with a floor of 1).
func paragraphIntrinsicHeight(content string) int {
    if content == "" { return 1 }
    var n = 1
    for _, c := range content {
        if c == '\n' { n = n + 1 }
    }
    return n
}

// RuneCount returns the number of Unicode code points in `s`. Useful for
// laying out fixed-width text slots — for cell-width math (CJK, emoji,
// combining marks) prefer `StringCellWidth` from runewidth.gala.
func RuneCount(s string) int {
    var n = 0
    for _ = range s {
        n = n + 1
    }
    return n
}

// MaxInt returns the larger of two ints.
func MaxInt(a int, b int) int = if (a > b) a else b

// MinInt returns the smaller of two ints.
func MinInt(a int, b int) int = if (a < b) a else b

