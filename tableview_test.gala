package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// TableView, Style.Patch, SpansEllipsis, variable-height AutoScroll
// ============================================================================

func tvRows(w Widget, width int, height int) Array[string] {
    val buf = renderAt(w, width, height)
    return ArrayTabulate(height, (y) => BufferText(buf, y))
}

func tvWidths() Array[Constraint] = ArrayOf[Constraint](Length(3), Length(3))

func tvBody() Array[TableRow] = ArrayOf[TableRow](
    TableRowOfStrings("a", "1"),
    TableRowOfStrings("b", "2"),
    TableRowOfStrings("c", "3"),
)

// ---- Style.Patch -----------------------------------------------------------

// The overlay's colours and attributes win; what it leaves at the default
// keeps the value underneath. A highlight that only sets a background must
// not strip the bold and the colour a cell drew with.
func TestPatchKeepsWhatTheOverlayLeavesUnset(t T) T {
    val base = DefaultStyle().WithFg(Red()).WithBold()
    val got = base.Patch(DefaultStyle().On(Blue()))
    val t1 = IsTrue(t, ColorEq(got.Fg, Red()))
    val t2 = IsTrue(t1, ColorEq(got.Bg, Blue()))
    return IsTrue(t2, got.Bold)
}

func TestPatchOverlayColourWins(t T) T =
    IsTrue(t, ColorEq(DefaultStyle().WithFg(Red()).Patch(DefaultStyle().WithFg(Green())).Fg, Green()))

// ---- SpansEllipsis ---------------------------------------------------------

// A cut marks itself with "…" in the style of the last character kept, so
// the mark reads as part of the run it shortens.
func TestSpansEllipsisCutsAcrossSpansAndKeepsTheStyle(t T) T {
    val bold = DefaultStyle().WithBold()
    val out = SpansEllipsis(ArrayOf[Span](SpanOf("ab"), SpanStyled("cdef", bold)), 4)
    val text = out.FoldLeft("", (a, s) => a + s.Content)
    val t1 = Eq(t, text, "abc…")
    return IsTrue(t1, out.Get(out.Length() - 1).Style.Bold)
}

func TestSpansEllipsisLeavesFittingTextAlone(t T) T =
    Eq(t, SpansEllipsis(ArrayOf[Span](SpanOf("abc")), 3).Get(0).Content, "abc")

// ---- AutoScroll with per-row heights ---------------------------------------

// Rows of different heights scroll by rows: with a 2-row row in the middle,
// selecting the last row in a 3-cell area shows rows 1 and 2, not a common
// height's worth.
func TestAutoScrollVarKeepsTheSelectionVisible(t T) T {
    val rows = ArrayOf[Widget](Text("r0"), Column(ArrayOf[LayoutChild](
        Fixed(1, Text("r1a")), Fixed(1, Text("r1b")))), Text("r2"))
    val out = tvRows(AutoScrollVar(rows, ArrayOf[int](1, 2, 1), 2, -1), 3, 3)
    val t1 = Eq(t, out.Get(0), "r1a")
    return Eq(t1, out.Get(2), "r2 ")
}

// A row that would be cut off at the bottom is not drawn at all.
func TestAutoScrollVarDrawsOnlyWholeRows(t T) T {
    val rows = ArrayOf[Widget](Text("r0"), Column(ArrayOf[LayoutChild](
        Fixed(1, Text("r1a")), Fixed(1, Text("r1b")))))
    return Eq(t, tvRows(AutoScrollVar(rows, ArrayOf[int](1, 2), 0, -1), 3, 2).Get(1), "   ")
}

// ---- TableView -------------------------------------------------------------

func TestTableViewHeaderRuleBodyFooter(t T) T {
    val spec = TableSpecOf(tvWidths(), tvBody())
        .WithHeader(TableRowOfStrings("k", "v"))
        .WithFooter(TableRowOfStrings("Σ", "6"))
    val out = tvRows(TableView(spec), 7, 7)
    val t1 = Eq(t, out.Get(0), "k   v  ")
    val t2 = Eq(t1, out.Get(1), "───────")
    val t3 = Eq(t2, out.Get(2), "a   1  ")
    val t4 = Eq(t3, out.Get(4), "c   3  ")
    return Eq(t4, out.Get(6), "Σ   6  ")
}

// The footer stays pinned below a body that scrolls to keep the cursor.
func TestTableViewFooterStaysPinnedWhileTheBodyScrolls(t T) T {
    val spec = TableSpecOf(tvWidths(), tvBody()).WithFooter(TableRowOfStrings("Σ", "6")).Select(2)
    val out = tvRows(TableView(spec), 7, 3)
    val t1 = Eq(t, out.Get(0), "b   2  ")
    val t2 = Eq(t1, out.Get(1), "c   3  ")
    return Eq(t2, out.Get(2), "Σ   6  ")
}

// The highlight symbol marks the selected row in a column of its own, and
// every other row — header included — is indented to match.
func TestTableViewHighlightSymbolColumn(t T) T {
    val spec = TableSpecOf(tvWidths(), tvBody())
        .WithHeader(TableRowOfStrings("k", "v"), false)
        .Select(1).WithHighlightSymbol("> ")
    val out = tvRows(TableView(spec), 9, 4)
    val t1 = Eq(t, out.Get(0), "  k   v  ")
    val t2 = Eq(t1, out.Get(1), "  a   1  ")
    return Eq(t2, out.Get(2), "> b   2  ")
}

// WhenSelected reserves the column only while something is selected;
// Always keeps it, so the columns do not jump when the cursor appears.
func TestHighlightSpacingDecidesWhenTheColumnIsReserved(t T) T {
    val base = TableSpecOf(tvWidths(), tvBody())
    val t1 = Eq(t, tvRows(TableView(base.WithHighlightSymbol("> ")), 7, 1).Get(0), "a   1  ")
    return Eq(t1, tvRows(TableView(base.WithHighlightSymbol("> ", HighlightAlways())), 9, 1).Get(0),
              "  a   1  ")
}

// A selected row is one band: the highlight covers the gap between columns.
func TestSelectedRowHighlightCoversTheColumnGap(t T) T {
    val buf = renderAt(TableView(TableSpecOf(tvWidths(), tvBody()).Select(0)), 7, 3)
    val t1 = IsTrue(t, buf.StyleAt(3, 0).Reverse)
    return IsFalse(t1, buf.StyleAt(3, 1).Reverse)
}

// Highlights patch rather than replace: a red cell stays red inside a
// selected row, and the row, column and crossing cell each get their own.
func TestHighlightsLayerOverCellStyles(t T) T {
    val rows = ArrayOf[TableRow](
        TableRowOf(CellOf("a"), CellOf("x").WithStyle(DefaultStyle().WithFg(Red()))),
        TableRowOfStrings("b", "y"),
    )
    val buf = renderAt(TableView(TableSpecOf(tvWidths(), rows).SelectCell(0, 1)), 7, 2)
    val t1 = IsTrue(t, ColorEq(buf.StyleAt(4, 0).Fg, Red()))
    val t2 = IsTrue(t1, buf.StyleAt(4, 0).Reverse)
    val t3 = IsTrue(t2, buf.StyleAt(4, 0).Underline)
    val t4 = IsTrue(t3, buf.StyleAt(4, 1).Bold)
    val t5 = IsFalse(t4, buf.StyleAt(4, 1).Reverse)
    return IsFalse(t5, buf.StyleAt(0, 0).Underline)
}

// A column highlight is for data: it skips the header.
func TestColumnHighlightSkipsTheHeader(t T) T {
    val spec = TableSpecOf(tvWidths(), tvBody()).WithHeader(TableRowOfStrings("k", "v"), false).SelectColumn(0)
    val buf = renderAt(TableView(spec), 7, 2)
    val t1 = IsFalse(t, buf.StyleAt(0, 0).Bold)
    return IsTrue(t1, buf.StyleAt(0, 1).Bold)
}

// A cell of two lines makes its row two rows tall; the other cells in the
// row keep the row's height and style.
func TestMultiLineCellMakesItsRowTaller(t T) T {
    val rows = ArrayOf[TableRow](TableRowOfStrings("a", "1\n2"), TableRowOfStrings("b", "3"))
    val out = tvRows(TableView(TableSpecOf(tvWidths(), rows)), 7, 3)
    val t1 = Eq(t, out.Get(0), "a   1  ")
    val t2 = Eq(t1, out.Get(1), "    2  ")
    return Eq(t2, out.Get(2), "b   3  ")
}

// A styled cell too wide for its column is cut with "…", not clipped
// silently into a different-looking value.
func TestStyledCellIsEllipsized(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellSpans(SpanStyled("abcdef", DefaultStyle().WithBold())), CellOf("1")))
    return Eq(t, tvRows(TableView(TableSpecOf(tvWidths(), rows)), 7, 1).Get(0), "ab… 1  ")
}

// A cell's background fills the cell to its edge, not only under its text.
func TestCellBackgroundFillsTheCell(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellOf("a").WithStyle(DefaultStyle().On(Blue())), CellOf("1")))
    val buf = renderAt(TableView(TableSpecOf(tvWidths(), rows)), 7, 1)
    return IsTrue(t, ColorEq(buf.StyleAt(2, 0).Bg, Blue()))
}

// Right-aligned cells — the shape a numeric column wants.
func TestAlignedCell(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellOf("a"), CellOf("7").Aligned(AlignRight())))
    return Eq(t, tvRows(TableView(TableSpecOf(tvWidths(), rows)), 7, 1).Get(0), "a     7")
}

// Dimming the table dims every cell, through the fluent path.
func TestTableViewRestylesWithItsPane(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellOf("a"), CellOf("x").WithStyle(DefaultStyle().WithFg(Red()))))
    val buf = renderAt(TableView(TableSpecOf(tvWidths(), rows)).WithDim(), 7, 1)
    val t1 = IsTrue(t, buf.StyleAt(0, 0).Dim)
    val t2 = IsTrue(t1, buf.StyleAt(4, 0).Dim)
    return IsTrue(t2, ColorEq(buf.StyleAt(4, 0).Fg, Red()))
}

// A highlight that sets a colour wins over the cell's own: the cursor must
// stay visible on a cell that paints its own background.
func TestRowHighlightColourWinsOverTheCellsOwn(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellOf("a").WithStyle(DefaultStyle().On(Red())), CellOf("1")))
    val spec = TableSpecOf(tvWidths(), rows).Select(0)
        .WithHighlights(DefaultStyle().On(Blue()), DefaultStyle(), DefaultStyle())
    return IsTrue(t, ColorEq(renderAt(TableView(spec), 7, 1).StyleAt(0, 0).Bg, Blue()))
}

// Only the rows on screen are built: a table far taller than its area asks
// for no more rows than fit.
func TestTableViewBuildsOnlyVisibleRows(t T) T {
    var built = 0
    val rows = AutoScrollLazy(1000, EmptyArray[int](), (i) => {
        built = built + 1
        return Text(s"r$i")
    }, 0, -1)
    val _ = renderAt(rows, 4, 3)
    return IsTrue(t, built <= 3)
}

// A styled span cannot hide the cursor: the row highlight is patched over the
// cell's text as well as its background.
func TestRowHighlightWinsOverAStyledSpan(t T) T {
    val rows = ArrayOf[TableRow](TableRowOf(CellSpans(SpanStyled("x", DefaultStyle().On(Red()))), CellOf("1")))
    val spec = TableSpecOf(tvWidths(), rows).Select(0)
        .WithHighlights(DefaultStyle().On(Blue()), DefaultStyle(), DefaultStyle())
    return IsTrue(t, ColorEq(renderAt(TableView(spec), 7, 1).StyleAt(0, 0).Bg, Blue()))
}

// A selected row taller than the body is drawn clipped, not left blank.
func TestSelectedRowTallerThanTheBodyIsStillDrawn(t T) T {
    val rows = ArrayOf[TableRow](TableRowOfStrings("a", "1\n2\n3"))
    return Eq(t, tvRows(TableView(TableSpecOf(tvWidths(), rows).Select(0)), 7, 2).Get(0), "a   1  ")
}

// Cells beyond the declared widths are dropped rather than squeezing the
// row's columns out of line with the rest of the table.
func TestExtraCellsBeyondTheWidthsAreDropped(t T) T {
    val rows = ArrayOf[TableRow](TableRowOfStrings("a", "1", "extra"), TableRowOfStrings("b", "2"))
    val out = tvRows(TableView(TableSpecOf(tvWidths(), rows)), 7, 2)
    val t1 = Eq(t, out.Get(0), "a   1  ")
    return Eq(t1, out.Get(1), "b   2  ")
}

// A cursor past the end of the rows — kept after a filter shrank the table —
// is no cursor: no symbol column, no highlight, no scroll to the bottom.
func TestOutOfRangeSelectionIsNoSelection(t T) T {
    val spec = TableSpecOf(tvWidths(), tvBody()).Select(7).WithHighlightSymbol("> ")
    val out = tvRows(TableView(spec), 7, 2)
    return Eq(t, out.Get(0), "a   1  ")
}

// A full-width character straddling the cut leaves no short result: the hole
// is filled before the mark, so the cut text is exactly `width` cells.
func TestSpansEllipsisFillsTheHoleAFullWidthCharLeaves(t T) T {
    val out = SpansEllipsis(ArrayOf[Span](SpanOf("ab中文")), 4)
    return Eq(t, out.FoldLeft("", (a, s) => a + s.Content), "ab …")
}

// TableView scrolls with the same padding rule as a list. In a 3-row body
// with the cursor on row 2, no padding keeps the view at the top; 1 row of
// padding scrolls one early so row 3 is already in view.
func TestTableViewScrollPaddingKeepsTheNextRowInView(t T) T {
    val rows = ArrayTabulate(5, (i) => TableRowOfStrings(s"r$i", s"$i"))
    val plain = tvRows(TableView(TableSpecOf(tvWidths(), rows).Select(2)), 7, 3)
    val padded = tvRows(TableView(TableSpecOf(tvWidths(), rows).Select(2).WithScrollPadding(1)), 7, 3)
    val t1 = Eq(t, plain.Get(2), "r2  2  ")
    return Eq(t1, padded.Get(2), "r3  3  ")
}

// Rows too tall for the full padding still get what fits rather than none:
// two-cell rows in a six-cell body, padding 2 asked, padding 1 given.
func TestScrollPaddingDegradesToWhatFits(t T) T {
    val heights = ArrayOf[int](2, 2, 2, 2, 2, 2)
    val t1 = Eq(t, scrollOffsetToShow(heights, 2, 6, 2), 1)
    return Eq(t1, scrollOffsetToShow(heights, 2, 6, 0), 0)
}

// For uniform rows the shared rule and the list's closed form agree, padding
// included — one rule, two implementations only for the allocation.
func TestUniformScrollPaddingMatchesTheListRule(t T) T {
    val ones = ArrayTabulate(12, (_) => 1)
    val cases = ArrayOf[Tuple[int, int]]((0, 0), (3, 1), (5, 2), (7, 9), (11, 3), (4, 1))
    return IsTrue(t, cases.ForAll((c) =>
        ArrayOf[int](2, 3, 5, 6).ForAll((h) =>
            scrollOffsetToShow(ones, c.V1, h, c.V2) == listViewportOffset(12, c.V1, h, c.V2))))
}
