package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// List widget
// ============================================================================

func TestListSelectionHighlight(t T) T {
    val buf = NewBuffer(6, 3)
    val w = SelectListOf(ArrayOf[string]("apple", "banana", "cherry"), 1)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 6, Height = 3), buf)
    val t1 = Eq(t, BufferText(buf, 0), "apple ")
    val t2 = Eq(t1, BufferText(buf, 1), "banana")   // selected row filled to width
    // Selected row style should be reverse.
    return IsTrue(t2, buf.StyleAt(0, 1).Reverse)
}

func TestListHandlesEmpty(t T) T {
    val buf = NewBuffer(5, 2)
    val w = SelectListOf(EmptyArray[string](), 0)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 5, Height = 2), buf)
    // Nothing should crash; buffer stays blank.
    return Eq(t, BufferText(buf, 0), "     ")
}

func TestListScrollsToShowSelected(t T) T {
    // 5 items, viewport height 2, selected = 4. Viewport must slide to show
    // items 3 and 4 (offset = 3).
    val buf = NewBuffer(4, 2)
    val w = SelectListOf(ArrayOf[string]("a", "b", "c", "d", "e"), 4)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 4, Height = 2), buf)
    val t1 = Eq(t, BufferText(buf, 0), "d   ")
    return Eq(t1, BufferText(buf, 1), "e   ")
}

func TestListViewportOffsetBasic(t T) T {
    val t1 = Eq(t, listViewportOffset(5, 0, 3), 0)
    val t2 = Eq(t1, listViewportOffset(5, 2, 3), 0)
    val t3 = Eq(t2, listViewportOffset(5, 3, 3), 1)
    return Eq(t3, listViewportOffset(5, 4, 3), 2)
}

// ============================================================================
// Input widget
// ============================================================================

func TestInputShowsPlaceholderWhenEmpty(t T) T {
    val buf = NewBuffer(12, 1)
    val w = Input("", 0, "type here", true)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 12, Height = 1), buf)
    val t1 = Eq(t, BufferText(buf, 0), "type here   ")
    // Placeholder rendered with dim style. Sampled at cell 1, not cell 0:
    // an empty field now draws its caret at column 0, so that cell carries
    // the field style inverted rather than the placeholder's dim. Before,
    // the empty+placeholder case returned early and drew no caret at all,
    // which is the state every form starts in.
    val t2 = IsTrue(t1, buf.StyleAt(1, 0).Dim)
    return IsTrue(t2, buf.StyleAt(0, 0).Reverse)
}

func TestInputShowsValueAndCursor(t T) T {
    val buf = NewBuffer(10, 1)
    val w = Input("hello", 3, "", true)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    val t1 = Eq(t, BufferText(buf, 0), "hello     ")
    // Cursor at column 3 → that cell should be reversed.
    return IsTrue(t1, buf.StyleAt(3, 0).Reverse)
}

// ============================================================================
// Progress / Gauge
// ============================================================================

func TestProgressBarHalf(t T) T {
    val buf = NewBuffer(10, 1)
    val w = Progress(50)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    // 10-width bar, 50%: "[████░░░░]" — 4 filled + 4 empty between brackets.
    return Eq(t, BufferText(buf, 0), "[████░░░░]")
}

func TestProgressBarFull(t T) T {
    val buf = NewBuffer(8, 1)
    val w = Progress(100)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 8, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "[██████]")
}

func TestProgressBarEmpty(t T) T {
    val buf = NewBuffer(8, 1)
    val w = Progress(0)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 8, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "[░░░░░░]")
}

func TestProgressClampsOverflow(t T) T {
    val buf = NewBuffer(8, 1)
    val w = Progress(250)   // out of range
    RenderTo(w, Rect(X = 0, Y = 0, Width = 8, Height = 1), buf)
    // Clamped to 100% → all inner cells filled.
    return Eq(t, BufferText(buf, 0), "[██████]")
}

func TestGaugeFullCells(t T) T {
    val buf = NewBuffer(4, 1)
    val w = Gauge(50)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    // 4 cells, 50% → 2 full + 2 track. The empty half now draws a track
    // glyph rather than spaces: a Gauge at 0% was indistinguishable from an
    // empty layout slot, while Progress — the other bar widget in this
    // library — has always drawn `[░░░░░░]`.
    return Eq(t, BufferText(buf, 0), "██░░")
}

// ============================================================================
// LineGauge
// ============================================================================

func TestLineGaugeSplitsTheRuleAtThePercentage(t T) T {
    val buf = NewBuffer(14, 1)
    // A four-column caption plus its separator claims 5, leaving a 9-cell
    // rule. Half of nine is four and a half, so four heavy cells and a head.
    RenderTo(LineGauge(50), Rect(X = 0, Y = 0, Width = 14, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), " 50% ━━━━╸────")
}

func TestLineGaugeCaptionKeepsTheRuleOriginFixed(t T) T {
    // The caption is right-aligned in a fixed slot, so a one-digit and a
    // three-digit percentage put the rule in the same column. Without this
    // the rule slides right as the number grows — and shrinks as it slides.
    val small = NewBuffer(20, 1)
    RenderTo(LineGauge(5), Rect(X = 0, Y = 0, Width = 20, Height = 1), small)
    val big = NewBuffer(20, 1)
    RenderTo(LineGauge(100), Rect(X = 0, Y = 0, Width = 20, Height = 1), big)
    val t1 = Eq(t, small.CharAt(4, 0), ' ')
    val t2 = Eq(t1, big.CharAt(4, 0), ' ')
    val t3 = Eq(t2, small.CharAt(5, 0), lineGaugeHead())
    return Eq(t3, big.CharAt(5, 0), lineGaugeFilled())
}

func TestLineGaugeStillGrowsFrom99To100(t T) T {
    // The transition that matters most. A fitted caption would shrink the
    // rule by the column the third digit took, and floor(0.99 * n) == n - 1
    // for every width a terminal can hold — so both would paint the same
    // number of heavy cells and the bar would only slide sideways.
    val nearly = NewBuffer(24, 1)
    RenderTo(LineGauge(99), Rect(X = 0, Y = 0, Width = 24, Height = 1), nearly)
    val done = NewBuffer(24, 1)
    RenderTo(LineGauge(100), Rect(X = 0, Y = 0, Width = 24, Height = 1), done)
    // Same last cell, two different glyphs: 99% ends on the head, 100% on a
    // full cell. Nothing short of done paints the done picture.
    val t1 = Eq(t, nearly.CharAt(23, 0), lineGaugeHead())
    return Eq(t1, done.CharAt(23, 0), lineGaugeFilled())
}

func TestLineGaugeDrawsAHeadWhenTheFillEndsMidCell(t T) T {
    val buf = NewBuffer(5, 1)
    // Half of five cells is two and a half.
    RenderTo(LineGaugeLabeled("", 50), Rect(X = 0, Y = 0, Width = 5, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "━━╸──")
}

func TestLineGaugePaintsTheSeparatorCell(t T) T {
    val buf = NewBuffer(16, 1)
    // A gauge on a highlighted list row: the parent painted the whole row
    // first. An unwritten cell between caption and rule would show that
    // background — glyph and attributes both — as a hole in the widget.
    buf.Fill(
        Rect(X = 0, Y = 0, Width = 16, Height = 1),
        Cell(Ch = '.', St = DefaultStyle().WithReverse()),
    )
    RenderTo(
        LineGaugeLabeled("Sync", 50),
        Rect(X = 0, Y = 0, Width = 16, Height = 1),
        buf,
    )
    val t1 = Eq(t, buf.CharAt(4, 0), ' ')
    return IsTrue(t1, !buf.StyleAt(4, 0).Reverse)
}

func TestLineGaugeBareRuleDrawsBelowTheMinimumRuleWidth(t T) T {
    // With no caption there is nothing to trade the row for, so the rule
    // keeps it down to a single cell. The alternative is a blank row, which
    // is the picture `gaugeTrack` exists to prevent.
    val one = NewBuffer(1, 1)
    RenderTo(LineGaugeLabeled("", 100), Rect(X = 0, Y = 0, Width = 1, Height = 1), one)
    val t1 = Eq(t, BufferText(one, 0), "━")
    val three = NewBuffer(3, 1)
    RenderTo(LineGaugeLabeled("", 0), Rect(X = 0, Y = 0, Width = 3, Height = 1), three)
    return Eq(t1, BufferText(three, 0), "───")
}

func TestLineGaugeIntrinsicWidthDoesNotVaryWithTheValue(t T) T {
    // A fitted caption would make the widget's intrinsic width grow at 10%
    // and again at 100%, nudging every sibling in an auto-sized Row twice
    // during a single run — and giving snapshot tests a different buffer
    // size per value.
    val t1 = Eq(t, defaultRenderWidth(LineGauge(5)), defaultRenderWidth(LineGauge(50)))
    return Eq(t1, defaultRenderWidth(LineGauge(50)), defaultRenderWidth(LineGauge(100)))
}

func TestLineGaugeDrawsItsTrackAtZero(t T) T {
    val buf = NewBuffer(10, 1)
    // A gauge at 0% must still look like a gauge — same reason Gauge draws
    // `░` rather than spaces.
    RenderTo(LineGaugeLabeled("", 0), Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "──────────")
}

func TestLineGaugeFillsEveryCellAtFull(t T) T {
    val buf = NewBuffer(10, 1)
    RenderTo(LineGaugeLabeled("", 100), Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "━━━━━━━━━━")
}

func TestLineGaugeClampsOutOfRangePercentages(t T) T {
    val over = NewBuffer(8, 1)
    RenderTo(LineGaugeLabeled("", 250), Rect(X = 0, Y = 0, Width = 8, Height = 1), over)
    val t1 = Eq(t, BufferText(over, 0), "━━━━━━━━")
    val under = NewBuffer(8, 1)
    RenderTo(LineGaugeLabeled("", -40), Rect(X = 0, Y = 0, Width = 8, Height = 1), under)
    return Eq(t1, BufferText(under, 0), "────────")
}

func TestLineGaugeEmptyLabelGivesTheRuleTheWholeRow(t T) T {
    val buf = NewBuffer(8, 1)
    // No label means no separating space either — all eight cells are rule.
    RenderTo(LineGaugeLabeled("", 50), Rect(X = 0, Y = 0, Width = 8, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "━━━━────")
}

func TestLineGaugeKeepsTheLabelWhenTheRowIsTooNarrowForARule(t T) T {
    val buf = NewBuffer(6, 1)
    // "Sync" + space + a 4-cell minimum rule needs 9 columns; at 6 the rule
    // is dropped rather than drawn too short to mean anything.
    RenderTo(LineGaugeLabeled("Sync", 50), Rect(X = 0, Y = 0, Width = 6, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "Sync  ")
}

func TestLineGaugeTruncatesALabelWiderThanTheRow(t T) T {
    val buf = NewBuffer(4, 1)
    RenderTo(LineGaugeLabeled("Uploading", 50), Rect(X = 0, Y = 0, Width = 4, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "Uplo")
}

func TestLineGaugeStylesTheFilledRunAndTheTrackApart(t T) T {
    val buf = NewBuffer(8, 1)
    val filled = DefaultStyle().WithFg(Green())
    val track = DefaultStyle().WithFg(BrightBlack())
    RenderTo(
        LineGaugeStyled("", 50, filled, track),
        Rect(X = 0, Y = 0, Width = 8, Height = 1),
        buf,
    )
    val t1 = IsTrue(t, ColorEq(buf.StyleAt(0, 0).Fg, Green()))
    val t2 = IsTrue(t1, ColorEq(buf.StyleAt(3, 0).Fg, Green()))
    return IsTrue(t2, ColorEq(buf.StyleAt(4, 0).Fg, BrightBlack()))
}

func TestLineGaugeLabelCarriesTheFilledStyle(t T) T {
    val buf = NewBuffer(12, 1)
    val filled = DefaultStyle().WithFg(Green())
    RenderTo(
        LineGaugeStyled("Sync", 50, filled, DefaultStyle().WithDim()),
        Rect(X = 0, Y = 0, Width = 12, Height = 1),
        buf,
    )
    // The caption is the value, not chrome — it must not read as disabled.
    return IsTrue(t, ColorEq(buf.StyleAt(0, 0).Fg, Green()))
}

func TestLineGaugeRendersNothingIntoAZeroArea(t T) T {
    val buf = NewBuffer(6, 1)
    RenderTo(LineGauge(50), Rect(X = 0, Y = 0, Width = 0, Height = 0), buf)
    return Eq(t, BufferText(buf, 0), "      ")
}

// ============================================================================
// Spinner
// ============================================================================

func TestSpinnerWrapsFrameIndex(t T) T {
    // Pipe spinner has 4 frames; frame=5 should wrap to frame 1.
    val t1 = Eq(t, SpinnerGlyph(PipeSpinner(), 0), '|')
    val t2 = Eq(t1, SpinnerGlyph(PipeSpinner(), 1), '/')
    val t3 = Eq(t2, SpinnerGlyph(PipeSpinner(), 4), '|')   // wrap
    return Eq(t3, SpinnerGlyph(PipeSpinner(), 5), '/')
}

func TestSpinnerRendersCell(t T) T {
    val buf = NewBuffer(3, 1)
    val w = Spinner(PipeSpinner(), 2)  // '-'
    RenderTo(w, Rect(X = 0, Y = 0, Width = 3, Height = 1), buf)
    return Eq(t, BufferText(buf, 0), "-  ")
}

// ============================================================================
// Button
// ============================================================================

func TestButtonRendersLabel(t T) T {
    val buf = NewBuffer(10, 1)
    val w = Button("OK", false)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    // "[ OK ]" = 6 chars + 4 blanks = 10.
    return Eq(t, BufferText(buf, 0), "[ OK ]    ")
}

func TestFocusedButtonIsReversed(t T) T {
    val buf = NewBuffer(10, 1)
    val w = Button("OK", true)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 10, Height = 1), buf)
    val t1 = Eq(t, BufferText(buf, 0), "[ OK ]    ")
    return IsTrue(t1, buf.StyleAt(0, 0).Reverse)
}
