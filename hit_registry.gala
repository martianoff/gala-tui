package gala_tui

import (
    . "martianoff/gala/go_interop"
    . "martianoff/gala/std"
)

// ============================================================================
// HitRegistry — per-frame, widget-owned click hit-test storage.
//
// Replaces the pre-existing "hand-rolled ClickMap" pattern, where every app
// computed widget rectangles by hand and matched clicks against them. That
// approach broke whenever a widget was hidden (clicks at the same coords
// kept firing) or moved (a scroll, resize, or layout tweak silently
// invalidated the hand-rolled map).
//
// The registry is mutated *during* a render pass: widgets that want to be
// clickable (`Clickable`, `ClickableRows`, …) call `Register` with their
// actual rendered rectangle. After the frame is painted, the runtime keeps
// the registry around; on the next mouse click, `HitAt(x, y)` returns the
// payload of the topmost widget under the cursor.
//
// Mutability is intentional and matches `Buffer`'s shape — a TUI redraw can
// touch tens of thousands of cells per frame, and doing it functionally
// would mean an allocation per registered region.
//
// The payload is `any` because the widget tree itself is type-erased over
// the app's `Msg` type. Runtime callers cast it back to their `Msg` via
// `castHitPayload`. The runtime owns the cast point so app code never sees
// `any` — apps just hand a typed `Msg` to `Clickable(...)`.
// ============================================================================

// HitEntry pairs a rectangle with the payload to dispatch when a
// click / double-click / drag lands inside it. The Kind discriminator
// keeps single-click / double-click / drag lookups separate so a
// click never accidentally fires a double-click handler and a drag
// motion never re-dispatches a click region's payload mid-drag.
//
// Encoded as two flags rather than a sealed enum because the Widget
// type is sealed and adding a new HitEntry case rippled into many
// match sites; the runtime only switches on these two flags so the
// dispatch paths stay simple.
// `AtPoint`, when set, computes the payload from the click's position
// *within* the entry's rectangle — local (col, row), origin at the
// rect's top-left. It is what a text widget needs: "which character did
// they click" is not answerable when the widget renders, only when the
// click lands. A nil `AtPoint` means `Payload` is the answer, which is
// every other hit in the library.
struct HitEntry(
    R        Rect,
    Payload  any,
    // Mutable only so it can be nil: a `val` field rejects nil, and an
    // Option of a function type is not expressible here. Nothing ever
    // reassigns it — the registry builds an entry and never edits one.
    var AtPoint func(int, int) any,
    IsDouble bool,
    IsDrag   bool,
)

// HitRegistry is the mutable accumulator.
type HitRegistry struct {
    var entries []HitEntry
}

// NewHitRegistry allocates an empty registry. The runtime calls this once
// per frame before painting the widget tree.
func NewHitRegistry() *HitRegistry {
    return &HitRegistry{entries: SliceEmpty[HitEntry]()}
}

// Register adds a single-click `(rect, payload)` to the registry.
// Out-of-area or zero-sized rects are ignored — they could never be
// hit anyway and pruning early keeps lookup fast.
func (h *HitRegistry) Register(r Rect, payload any) {
    if r.Zero() {
        return
    }
    h.entries = SliceAppend(h.entries, HitEntry(
        R = r, Payload = payload, AtPoint = nil, IsDouble = false, IsDrag = false))
}

// RegisterAt adds a single-click region whose payload depends on WHERE
// inside it the click landed — `atPoint(col, row)` in coordinates local
// to `r`. Everything else about dispatch is unchanged: same ordering,
// same last-registered-wins, and the three HitAt* lookups share one
// scan, so cells work for double-click and drag at no extra cost.
func (h *HitRegistry) RegisterAt(r Rect, atPoint func(int, int) any) {
    if r.Zero() {
        return
    }
    h.entries = SliceAppend(h.entries, HitEntry(
        // `Payload` is never read for a cell entry — `AtPoint` takes
        // precedence in `lastPayloadAt` — but the field cannot be nil, so
        // it carries the same closure rather than a stand-in value that
        // would read as meaningful.
        R = r, Payload = any(atPoint), AtPoint = atPoint,
        IsDouble = false, IsDrag = false))
}

// RegisterDouble adds a double-click `(rect, payload)` to the registry.
// The runtime only fires it when the user clicks the same region twice
// within the double-click window — single-clicks at the same coords
// dispatch any matching single-click hit (or fall through to the user
// input adapter) instead.
func (h *HitRegistry) RegisterDouble(r Rect, payload any) {
    if r.Zero() {
        return
    }
    h.entries = SliceAppend(h.entries, HitEntry(
        R = r, Payload = payload, AtPoint = nil, IsDouble = true, IsDrag = false))
}

// RegisterDrag adds a drag `(rect, payload)` to the registry. The
// runtime threads drag state across press / motion / release events
// and dispatches phase-tagged messages — consumers register ONE
// region per draggable element and receive DragPress / DragOver /
// DragRelease through the same payload.
//
// Payloads here are typically functions of shape `func(DragPhase) any`
// — DraggableW stores the user's `msgFor` closure as `any` and the
// runtime calls it with the phase before dispatching. Consumer code
// uses `OnDrag` (the fluent method) which hides this detail.
func (h *HitRegistry) RegisterDrag(r Rect, payload any) {
    if r.Zero() {
        return
    }
    h.entries = SliceAppend(h.entries, HitEntry(
        R = r, Payload = payload, AtPoint = nil, IsDouble = false, IsDrag = true))
}

// HitAt returns the payload of the LAST-registered single-click entry
// whose rectangle contains `(x, y)`, or `None` if no single-click
// entry matches. Double-click and drag entries are skipped — query
// `HitAtDouble` / `HitAtDrag` for those.
//
// Last-wins is intentional: layouts render children in document order, so
// a widget rendered later (a modal stacked on top, a row drawn after its
// container) appears at later indices. Walking entries back-to-front
// surfaces the topmost hit naturally.
func (h *HitRegistry) HitAt(x int, y int) Option[any] =
    h.lastPayloadAt(x, y, (e) => !e.IsDouble && !e.IsDrag)

// lastPayloadAt is the one scan the three HitAt* lookups share: walk
// entries back-to-front and return the payload of the first one whose
// rectangle contains `(x, y)` and that `kindMatches` accepts.
//
// The reverse index walk is deliberate rather than `Reverse().Find(...)`:
// this runs on every mouse event against a registry rebuilt each frame,
// and the functional form would copy the entry slice per lookup. The
// predicate parameter is what removes the duplication; the loop shape is
// the part that has to stay allocation-free.
func (h *HitRegistry) lastPayloadAt(
    x int,
    y int,
    kindMatches func(HitEntry) bool,
) Option[any] {
    var i = h.entries.Size() - 1
    for i >= 0 {
        val e = h.entries[i]
        if kindMatches(e) && e.R.Contains(x, y) {
            // Local coordinates, so a caller reasons in "column 3 of this
            // field" rather than in screen space it never chose. A plain
            // entry has no AtPoint and falls back to its fixed payload.
            if e.AtPoint != nil {
                return Some[any](e.AtPoint(x - e.R.X, y - e.R.Y))
            }
            return Some[any](e.Payload)
        }
        i = i - 1
    }
    return None[any]()
}

// HitAtDouble is the double-click counterpart of HitAt. Returns the
// payload of the LAST-registered double-click entry containing
// `(x, y)`, or None if no double-click region matches.
func (h *HitRegistry) HitAtDouble(x int, y int) Option[any] =
    h.lastPayloadAt(x, y, (e) => e.IsDouble)

// HitAtDrag is the drag-region counterpart of HitAt. Returns the
// payload of the LAST-registered drag entry containing `(x, y)`,
// or None if no drag region matches. The runtime calls this on
// press to start a drag, and on each motion-while-held event to
// resolve which region the cursor is currently over.
func (h *HitRegistry) HitAtDrag(x int, y int) Option[any] =
    h.lastPayloadAt(x, y, (e) => e.IsDrag)

// Length reports how many entries are registered. Used by tests; the
// runtime does not need it.
func (h *HitRegistry) Length() int = h.entries.Size()

// Reset wipes the registry without freeing the slice — the runtime calls
// this between frames so each repaint starts from a clean slate.
func (h *HitRegistry) Reset() {
    h.entries = SliceEmpty[HitEntry]()
}
