package main

import (
    . "github.com/martianoff/gala-tui"
    "github.com/martianoff/gala-tui/state"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

// ============================================================================
// The screens that exist so the demo can *show* the rest of the framework.
//
// The overview, builds, pipelines and logs screens grew out of a plausible
// application. These four did not: they are here because a recorded tour is
// the only artefact that shows what a widget looks like while it is being
// used, and a widget the tour cannot reach may as well not ship. Each screen
// is therefore grouped by what a viewer is being shown rather than by what an
// application would group together:
//
//   charts  — every plotting widget against the same data, so the choice
//             between them is a visual one
//   forms   — the input path end to end: type, click to move the caret,
//             mask a secret, submit
//   data    — the selection widgets, and the scrollbar that pairs with them
//   review  — the read-only widgets: diff, markdown, links, tags
//
// The tour drives all four with both keys and clicks; see demo/record/tour.txt.
// ============================================================================

// ----------------------------------------------------------------------------
// Charts
// ----------------------------------------------------------------------------

// megaChartWidth is how many samples a chart panel shows at once — one column
// per sample, so it is also the panel's width in cells.
func megaChartWidth() int = 86

// megaChartFeed is the whole signal: far longer than a panel, so a window onto
// it can scroll without ever running out.
//
// A random walk from a fixed seed, not a hand-written array. The charts paint
// one column per sample, so a short series leaves most of the panel empty, and
// hand-writing hundreds of numbers is hundreds of chances to make the curve
// look artificial. Fixed seed because a recorded demo that drifted between
// runs would make every re-record a diff.
func megaChartFeed() Array[int] {
    var seed = 1234567
    var v = 28
    var out = EmptyArray[int]()
    var i = 0
    for i < 420 {
        seed = (seed * 1103515245 + 12345) % 2147483648
        val step = (seed / 65536) % 19 - 9
        // Pull back towards the middle. A plain random walk has no reason to
        // return anywhere, so it wanders into a corner and sits there — and a
        // chart pinned at its ceiling for forty columns is a filled rectangle,
        // which is exactly as informative as it looks. The reversion term is
        // what makes the signal keep having shape.
        v = MinInt(92, MaxInt(8, v + step - (v - 50) / 9))
        out = out.Append(v)
        i = i + 1
    }
    return out
}

// megaChartSeries is the window the charts actually plot: `megaChartWidth`
// samples ending at the tick, so the signal streams leftwards the way a
// monitor's does. Every chart on the screen reads the same window, which is
// what keeps "one series through every widget" true while it moves.
//
// The window wraps rather than stopping at the end of the feed, so the screen
// can be held for as long as the tour wants without the charts freezing.
func megaChartSeries(tick int) Array[int] {
    val feed = megaChartFeed()
    val span = feed.Length() - megaChartWidth()
    val offset = ((tick % span) + span) % span
    return feed.Drop(offset).Take(megaChartWidth())
}

func megaChartsBody(m MegaModel, th Theme) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(28, megaSidebar(m, th)),
        Flex(3, megaChartsMain(m, th)),
    ))

func megaChartsMain(m MegaModel, th Theme) Widget {
    // Both sources of motion on this screen come from the model, so the
    // charts stream and the gauges sweep without the tour pressing anything:
    // the window advances one sample per tick, the gauges follow the tween.
    val series = megaChartSeries(m.Tick)
    val pct = state.TweenAt(m.Progress, m.Now)
    return Column(ArrayOf[LayoutChild](
        Fixed(9, Titled(LineChart(series), " LineChart ")),
        Fixed(9, Titled(megaAreaChart(series), " Canvas — live filled area, braille 2x4 ")),
        Fixed(7, Titled(megaGaugeStack(series, pct), " Gauges ")),
        Flex(1, Titled(megaMultiChart(series), " MultiLineChart ")),
    ))
}

// megaAreaChart plots the series as a filled area on a Canvas. Braille cells
// are 2x4, so the canvas resolves finer than one glyph per sample — which is
// the reason to reach for it over LineChart.
func megaAreaChart(series Array[int]) Widget {
    val n = series.Length()
    val xs = ArrayTabulate(n, (i) => float64(i))
    val ys = series.Map((v) => float64(v))
    return CanvasOf(
        XBounds(0.0, float64(n - 1)),
        YBounds(0.0, 100.0),
        FilledSeriesOf(xs, ys, 0.0, DefaultStyle().WithFg(BrightCyan())))
}

// megaGaugeStack shows the three gauge shapes against one value, which is the
// comparison a reader actually wants: they differ in how much room they take,
// not in what they mean.
func megaGaugeStack(series Array[int], pct int) Widget =
    Column(ArrayOf[LayoutChild](
        Fixed(1, LineGauge(pct)),
        Fixed(1, LineGaugeLabeled(" deploy ", pct)),
        Fixed(1, Text("")),
        Fixed(1, Gauge(pct)),
        Fixed(1, Sparkline(series)),
    ))

// megaMultiChart overlays two series. The chart is a filled glyph matrix, so
// the second one painted wins every cell they share — which means two series
// only read as two if the gap between them is wider than a row. A baseline at
// just over half the primary leaves the taller one showing as a band above it.
func megaMultiChart(series Array[int]) Widget {
    val baseline = series.Map((v) => v * 55 / 100)
    return MultiLineChart(
        ArrayOf[Array[int]](series, baseline),
        ArrayOf[Style](
            DefaultStyle().WithFg(BrightGreen()),
            DefaultStyle().WithFg(BrightMagenta())))
}

// ----------------------------------------------------------------------------
// Forms
// ----------------------------------------------------------------------------

func megaFormsBody(m MegaModel, th Theme) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(28, megaSidebar(m, th)),
        Flex(3, megaFormsMain(m, th)),
    ))

func megaFormsMain(m MegaModel, th Theme) Widget =
    Column(ArrayOf[LayoutChild](
        Fixed(12, Titled(megaCredentialsForm(m), " Sign in ")),
        Fixed(7, Titled(megaSearchRow(m), " SearchInput ")),
        Flex(1, Titled(megaFormNotes(m), " What the tour is doing ")),
    ))

// megaCredentialsForm is the whole input story on one screen: a plain field,
// a masked one, and a button. Both fields are built with `InputClick`, so a
// click inside the text moves the caret to the clicked character instead of
// merely focusing the field — the thing a text field is expected to do and
// the thing a scripted tour can actually show.
func megaCredentialsForm(m MegaModel) Widget =
    PaddingHV(1, 1, Column(ArrayOf[LayoutChild](
        Fixed(1, TextStyled(" user", DefaultStyle().WithDim())),
        Fixed(1, InputClick[MegaMsg](
            m.FormUser, m.FormUserCur, "you@example.com",
            (i) => MegaFormCaret(Field = 0, Idx = i),
            m.FormField == 0)),
        Fixed(1, Text("")),
        Fixed(1, TextStyled(" password", DefaultStyle().WithDim())),
        Fixed(1, megaSecretField(m)),
        Fixed(1, Text("")),
        Fixed(1, megaSubmitRow(m)),
    )))

// megaSecretField masks the value but keeps the caret honest: the click lands
// on the character under the pointer even though every glyph on screen is the
// same bullet.
//
// There is no `InputMaskedClick`, and none is needed. `InputMasked` is
// `Input(MaskValue(value), …)`, and `MaskValue` replaces one code point with
// one mask rune — so a rune index into the mask is the same rune index into
// the secret, and `InputClick` over the masked value reports it directly.
func megaSecretField(m MegaModel) Widget = InputClick[MegaMsg](
    MaskValue(m.FormPass), m.FormPassCur, "required",
    (i) => MegaFormCaret(Field = 1, Idx = i),
    m.FormField == 1)

func megaSubmitRow(m MegaModel) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(14, Button(" Sign in ", m.FormField == 2).OnClick(MegaFormSubmit())),
        Fixed(2, Empty()),
        Flex(1, megaFormStatus(m)),
    ))

func megaFormStatus(m MegaModel) Widget {
    if m.FormSubmitted {
        return Tag(" signed in ", BrightGreen())
    }
    if RuneCount(m.FormPass) == 0 {
        return TextStyled(" password required", DefaultStyle().WithDim())
    }
    return TextStyled(s" ${RuneCount(m.FormPass)} characters", DefaultStyle().WithDim())
}

func megaSearchRow(m MegaModel) Widget {
    val total = megaSearchCorpus().Length()
    val matched = megaSearchMatches(m.SearchQuery).Length()
    return PaddingHV(1, 1, Column(ArrayOf[LayoutChild](
        Fixed(1, SearchInput(m.SearchQuery, matched, total)),
        Fixed(1, Text("")),
        Fixed(1, megaSearchHits(m)),
    )))
}

func megaSearchHits(m MegaModel) Widget {
    val hits = megaSearchMatches(m.SearchQuery)
    if hits.IsEmpty() {
        return TextStyled(" no matches", DefaultStyle().WithDim())
    }
    return TextStyled(s" ${hits.MkString(" · ")}", DefaultStyle().WithFg(BrightCyan()))
}

func megaSearchCorpus() Array[string] = ArrayOf[string](
    "deploy", "deploy:staging", "deploy:prod", "rollback",
    "restart", "scale", "logs", "status")

func megaSearchMatches(q string) Array[string] =
    if (RuneCount(q) == 0) EmptyArray[string]()
    else megaSearchCorpus().Filter((c) => MatchSubstring(c, q))

func megaFormNotes(m MegaModel) Widget =
    PaddingHV(1, 1, Column(ArrayOf[LayoutChild](
        Fixed(1, TextStyled("Both fields are built with InputClick:",
            DefaultStyle().WithBold())),
        Fixed(1, TextStyled("a click lands the caret on the character under",
            DefaultStyle().WithDim())),
        Fixed(1, TextStyled("the pointer — including inside the mask, where",
            DefaultStyle().WithDim())),
        Fixed(1, TextStyled("every glyph looks the same.",
            DefaultStyle().WithDim())),
        Flex(1, Empty()),
    )))

// ----------------------------------------------------------------------------
// Data
// ----------------------------------------------------------------------------

func megaDataBody(m MegaModel, th Theme) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(28, megaSidebar(m, th)),
        Flex(3, megaDataMain(m, th)),
    ))

func megaDataMain(m MegaModel, th Theme) Widget =
    Column(ArrayOf[LayoutChild](
        Fixed(12, Row(ArrayOf[LayoutChild](
            Flex(1, Titled(megaRegionList(m), " SelectList ")),
            Flex(1, Titled(megaEnvDropdown(m), " Dropdown ")),
        ))),
        Flex(1, Titled(megaQuotaTable(m), " Table + Scrollbar ")),
    ))

// megaRegionList is a clickable SelectList — the rows dispatch on click, and
// the same selection moves with the arrow keys, so the tour can show that a
// widget is not "mouse-driven" or "keyboard-driven" but simply driven.
func megaRegionList(m MegaModel) Widget =
    SelectListOf(megaRegions(), m.SelectIdx, true)
        .OnPickRow(megaRegions().Length(), (i) => MegaSelectPick(Idx = i))

func megaRegions() Array[string] =
    megaQuotaRows().Map((r) => s"  ${r.Get(0)}")

func megaEnvDropdown(m MegaModel) Widget {
    val menu = NewMenu(ArrayOf[MenuItem](
        NewMenuItemWithHint("staging", "auto"),
        NewMenuItemWithHint("canary", "10%"),
        NewMenuItem("production"),
        NewMenuItemDisabled("archived"),
    )).Copy(Selected = m.DropSel)
    val label = if (m.DropOpen) " environment ▴ " else " environment ▾ "
    val drop = Dropdown(
        Trigger = Button(label, m.DropOpen).OnClick(MegaDropToggle()),
        Menu    = menu,
        Open    = m.DropOpen,
        Width   = 24)
    if !m.DropOpen {
        return PaddingHV(1, 1, DropdownView(drop, true))
    }
    // Only the open menu's rows are clickable — a closed dropdown has no rows
    // on screen, and registering hits for them would swallow clicks meant for
    // whatever the layout put underneath.
    return PaddingHV(1, 1, Column(ArrayOf[LayoutChild](
        Fixed(1, Button(label, true).OnClick(MegaDropToggle())),
        Flex(1, MenuView(menu, true)
            .OnPickRow(menu.Items.Length(), (i) => MegaDropPick(Idx = i))
            .Bordered()),
    )))
}

func megaQuotaTable(m MegaModel) Widget {
    val rows = megaQuotaRows()
    val visible = megaQuotaVisible()
    return Row(ArrayOf[LayoutChild](
        Flex(1, Table(TableData(
            Headers  = ArrayOf[string]("region", "quota", "used", "state"),
            Widths   = ArrayOf[Constraint](
                Percent(N = 34), Percent(N = 22), Percent(N = 22), Percent(N = 22)),
            Rows     = rows.Drop(m.DataScroll).Take(visible),
            Selected = m.SelectIdx - m.DataScroll))),
        Fixed(1, Scrollbar(rows.Length(), visible, m.DataScroll)),
    ))
}

// megaQuotaVisible is the window the table shows and the scrollbar reports.
// One number, used by the view and by the update that scrolls it — two copies
// would drift and the thumb would stop matching the rows.
func megaQuotaVisible() int = 6

func megaQuotaRowCount() int = megaQuotaRows().Length()

func megaQuotaRows() Array[Array[string]] = ArrayOf[Array[string]](
    ArrayOf[string]("us-east-1",    "400", "318", "ok"),
    ArrayOf[string]("us-west-2",    "400", "122", "ok"),
    ArrayOf[string]("eu-west-1",    "250", "241", "near limit"),
    ArrayOf[string]("eu-central-1", "250", "88",  "ok"),
    ArrayOf[string]("ap-south-1",   "150", "149", "near limit"),
    ArrayOf[string]("sa-east-1",    "100", "12",  "ok"),
    ArrayOf[string]("af-south-1",   "100", "0",   "unused"),
    ArrayOf[string]("me-south-1",   "100", "44",  "ok"),
    ArrayOf[string]("ca-central-1", "200", "173", "ok"),
    ArrayOf[string]("ap-northeast-1", "300", "295", "near limit"))

// ----------------------------------------------------------------------------
// Review
// ----------------------------------------------------------------------------

func megaReviewBody(m MegaModel, th Theme) Widget =
    Row(ArrayOf[LayoutChild](
        Fixed(28, megaSidebar(m, th)),
        Flex(3, megaReviewMain(m, th)),
    ))

func megaReviewMain(m MegaModel, th Theme) Widget =
    Row(ArrayOf[LayoutChild](
        Flex(1, Titled(DiffViewStats(megaDiffLines()), " DiffViewStats ")),
        Flex(1, Column(ArrayOf[LayoutChild](
            Flex(1, Titled(MarkdownView(megaReviewNotes()), " MarkdownView ")),
            Fixed(6, Titled(megaLinkRow(), " Links & tags ")),
        ))),
    ))

func megaDiffLines() Array[DiffLine] = ArrayOf[DiffLine](
    DiffContext(Text = "func (b *Buffer) String() string {"),
    DiffContext(Text = "    if y < b.Height-1 {"),
    DiffRemoved(Text = "        sb.WriteString(\"\\n\")"),
    DiffAdded(Text = "        sb.WriteString(\"\\r\\n\")"),
    DiffContext(Text = "    }"),
    DiffContext(Text = "}"),
    DiffContext(Text = ""),
    DiffContext(Text = "// a full-width row ends in deferred wrap, so LF"),
    DiffAdded(Text = "// alone moves down without returning the carriage"),
)

func megaReviewNotes() string =
    "# Release notes\n" +
    "\n" +
    "Rendering\n" +
    "\n" +
    "- rows are separated by `\\r\\n`\n" +
    "- a wide glyph covers **two cells**, not two writes\n" +
    "\n" +
    "> A recorded demo is a test you can look at.\n"

func megaLinkRow() Widget =
    PaddingHV(1, 1, Column(ArrayOf[LayoutChild](
        Fixed(1, Link("gala-tui on GitHub", "https://github.com/martianoff/gala-tui")),
        Fixed(1, Text("")),
        Fixed(1, Row(ArrayOf[LayoutChild](
            Fixed(12, Tag(" passing ", BrightGreen())),
            Fixed(12, Tag(" 0.12.0 ", BrightCyan())),
            Flex(1, Tag(" opus ", BrightMagenta())),
        ))),
    )))
