# Keep Bazel files LF on every platform. gazelle writes LF; without this an
# autocrlf=true checkout (Windows) rewrites the stored-LF BUILD files to CRLF,
# producing perpetual churn in `bazel run //:gazelle` output.
*.bazel    text eol=lf
*.bzl      text eol=lf
BUILD      text eol=lf
WORKSPACE  text eol=lf
gala.mod   text eol=lf

# The demo recorder runs under Linux (WSL on Windows). bash reads a CRLF
# script as `set -euo pipefail\r` and fails, and a CRLF shebang names an
# interpreter that does not exist — so the recording pipeline stays LF.
*.sh       text eol=lf
*.py       text eol=lf
demo/record/tour.txt text eol=lf
