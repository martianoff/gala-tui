package gala_tui

import (
    . "martianoff/gala/collection_immutable"
)

// ============================================================================
// DataTable — an interactive upgrade of the static Table widget.
//
// Features that Table lacks:
//   1. Frozen header row (stays while body scrolls)
//   2. Row selection cursor (moves with arrow keys)
//   3. Vertical scrolling when rows exceed available height
//   4. Column sorting (ascending / descending / unsorted) on any column
//   5. Row filtering via a predicate
//
// Everything is immutable. Apps hold a DataTable in their model, route key
// events into DataTableUpdate, and render with DataTableView.
//
// Typical pattern:
//     case KeyDown()  => m.Copy(Table = DataTableUpdate(m.Table, DTCursorDown()))
//     case KeyUp()    => m.Copy(Table = DataTableUpdate(m.Table, DTCursorUp()))
//     case KeyChar('s') => m.Copy(Table = DataTableUpdate(m.Table, DTSort(m.FocusedCol)))
//     case KeyChar('/') => m.Copy(Filter = !m.Filter)   // toggle filter input
// ============================================================================

sealed type SortDir {
    case SortNone()
    case SortAsc()
    case SortDesc()
}

struct DataTable(
    Headers     Array[string],
    Widths      Array[Constraint],
    Rows        Array[Array[string]],
    Selected    int,                    // row cursor within visible rows
    // First visible row in the filtered view, or -1 to track the cursor.
    // Same convention as ListW.Offset: an explicit value scrolls the body
    // independently of the selection (a wheel over an unfocused table).
    Offset      int,
    SortCol     int,                    // -1 = no sort
    SortDir     SortDir,
    FilterQuery string,                 // empty = no filter
)

// NewDataTable builds a table with the first row selected, no filter, no sort.
func NewDataTable(
    headers Array[string],
    widths Array[Constraint],
    rows Array[Array[string]],
) DataTable =
    DataTable(
        Headers     = headers,
        Widths      = widths,
        Rows        = rows,
        Selected    = 0,
        Offset      = -1,
        SortCol     = -1,
        SortDir     = SortNone(),
        FilterQuery = "",
    )

// ----------------------------------------------------------------------------
// Update
// ----------------------------------------------------------------------------

sealed type DataTableEvent {
    case DTCursorUp()
    case DTCursorDown()
    case DTPageUp(Rows int)
    case DTPageDown(Rows int)
    case DTHome()
    case DTEnd()
    case DTSort(Col int)
    case DTFilter(Query string)
    case DTClearFilter()
    case DTNoOp()
}

func DataTableUpdate(dt DataTable, ev DataTableEvent) DataTable {
    return ev match {
        case DTCursorUp()      => dtMoveCursor(dt, -1)
        case DTCursorDown()    => dtMoveCursor(dt, 1)
        case DTPageUp(rows)    => dtMoveCursor(dt, -rows)
        case DTPageDown(rows)  => dtMoveCursor(dt, rows)
        case DTHome()          => dt.Copy(Selected = 0)
        case DTEnd()           => dt.Copy(Selected = dtVisible(dt).Length() - 1)
        case DTSort(col)       => dtCycleSort(dt, col)
        case DTFilter(q)       => dt.Copy(FilterQuery = q, Selected = 0, Offset = -1)
        case DTClearFilter()   => dt.Copy(FilterQuery = "", Selected = 0, Offset = -1)
        case DTNoOp()          => dt
    }
}

func dtMoveCursor(dt DataTable, delta int) DataTable {
    val n = dtVisible(dt).Length()
    if n == 0 { return dt }
    var sel = dt.Selected + delta
    if sel < 0 { sel = 0 }
    if sel >= n { sel = n - 1 }
    return dt.Copy(Selected = sel)
}

// dtCycleSort toggles sort direction for the given column: None → Asc → Desc → None.
func dtCycleSort(dt DataTable, col int) DataTable {
    if col < 0 || col >= dt.Headers.Length() { return dt }
    if dt.SortCol != col {
        return dt.Copy(SortCol = col, SortDir = SortAsc(), Selected = 0, Offset = -1)
    }
    val next = dt.SortDir match {
        case SortNone() => SortAsc()
        case SortAsc()  => SortDesc()
        case SortDesc() => SortNone()
    }
    return next match {
        case SortNone() => dt.Copy(SortCol = -1, SortDir = SortNone(), Selected = 0, Offset = -1)
        case _          => dt.Copy(SortDir = next, Selected = 0, Offset = -1)
    }
}

// ----------------------------------------------------------------------------
// Derivation — produce the ordered, filtered view from the raw rows.
// ----------------------------------------------------------------------------

// dtVisible returns the rows to show: filter applied, then sorted.
func dtVisible(dt DataTable) Array[Array[string]] {
    val filtered = dtFilter(dt)
    return dtSort(dt, filtered)
}

// dtFilter keeps rows whose concatenated cells contain (case-insensitively)
// the filter query. Empty query keeps everything.
func dtFilter(dt DataTable) Array[Array[string]] {
    if dt.FilterQuery == "" { return dt.Rows }
    return dt.Rows.Filter((row) => dtRowMatchesFilter(row, dt.FilterQuery))
}

func dtRowMatchesFilter(row Array[string], q string) bool {
    val ql = strToLower(q)
    var i = 0
    val n = row.Length()
    for i < n {
        if strContains(strToLower(row.Get(i)), ql) { return true }
        i = i + 1
    }
    return false
}

func dtSort(dt DataTable, rows Array[Array[string]]) Array[Array[string]] {
    if dt.SortCol < 0 { return rows }
    val col = dt.SortCol
    val asc = dt.SortDir match {
        case SortAsc()  => true
        case SortDesc() => false
        case SortNone() => true
    }
    return dtInsertionSort(rows, col, asc)
}

// dtInsertionSort — simple stable sort adequate for typical table sizes.
func dtInsertionSort(rows Array[Array[string]], col int, asc bool) Array[Array[string]] {
    var out = EmptyArray[Array[string]]()
    var i = 0
    val n = rows.Length()
    for i < n {
        val r = rows.Get(i)
        out = dtInsertSorted(out, r, col, asc)
        i = i + 1
    }
    return out
}

func dtInsertSorted(sorted Array[Array[string]], r Array[string], col int, asc bool) Array[Array[string]] {
    val rv = if (col < r.Length()) r.Get(col) else ""
    val keepBefore = (cur Array[string]) => {
        val cv = if (col < cur.Length()) cur.Get(col) else ""
        return if (asc) rv >= cv else rv <= cv
    }
    val (before, after) = sorted.Span(keepBefore)
    return before.Append(r).AppendAll(after)
}

// ----------------------------------------------------------------------------
// View
// ----------------------------------------------------------------------------

// dtRuleRow is the horizontal rule under the header, carrying the filter
// state when one is active.
//
// A filtered table used to be pixel-identical to an unfiltered one: same
// header, same rule, fewer rows and nothing to say why. Scroll away from
// the row you were looking at and nothing on screen records that a filter
// ever happened, so the natural reading of the pane is "this is the
// dataset" — the one reading that is false. The empty case already said
// `(no rows)`; the non-empty case said nothing at all, which is the more
// dangerous of the two because it looks like data.
//
// The banner goes on the rule rather than on a row of its own so that
// turning a filter on never changes the table's height or pushes a row out
// of view. The rule carries no information otherwise, and a table showing
// everything still renders it unbroken.
func dtRuleRow(dt DataTable) Widget {
    if dt.FilterQuery == "" {
        return FillCh('─')
    }
    val shown = VisibleRowCount(dt)
    val total = dt.Rows.Length()
    // Count first, query second. The count is the part that says a filter is
    // on and how much is hidden, so it must survive truncation — with the
    // query leading, a long query pushed "0 of 4" off the end of a narrow
    // table and the indicator stopped indicating anything.
    val label = s"─ $shown of $total · ${dt.FilterQuery} "
    return CustomW(MinW = 1, MinH = 1, Render = (area, buf, hits) => {
        if area.Width > 0 && area.Height > 0 {
            renderFill('─', DefaultStyle().WithDim(), area, buf)
            renderText(StringCellTruncate(label, area.Width),
                       DefaultStyle().WithDim(), area, buf)
        }
    })
}

// DataTableView renders the whole data table: frozen header row, horizontal
// rule, then the scrollable body with selection highlight. Caller sizes the
// area; body height = total height - 2 (header + rule).
//
// `focused` (default false) controls visual emphasis of the cursor row.
// When focused, the selected row is rendered with reverse + bold + bright
// yellow foreground so the user can tell at a glance where keyboard arrows
// will land. Unfocused tables still highlight the row but use plain reverse.
func DataTableView(dt DataTable, focused bool = false) Widget {
    val header = dtHeaderRow(dt)
    val rule = dtRuleRow(dt)
    val body = dtBodyWidget(dt, focused)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, header),
        Fixed(1, rule),
        Flex(1, body),
    ))
}

// DataTableViewClick is the click-aware sibling: each visible row of the
// body is registered as a hit region carrying `onRowClick(rowIdx)`.
// `rowIdx` is the absolute row index in the (filtered) data, not the
// visible offset, so apps can dispatch the same `OpenRow(Idx = i)` for
// keyboard Enter and a click without translating.
//
//     val table = DataTableViewClick[Msg](dt, focused, (i) => OpenRow(Idx = i))
func DataTableViewClick[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
) Widget {
    val header = dtHeaderRow(dt)
    val rule = dtRuleRow(dt)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, header),
        Fixed(1, rule),
        Flex(1, dtBodyWidgetClick[T](dt, focused, onRowClick)),
    ))
}

// DataTableViewClickable is the full click-aware DataTable: row clicks
// AND header clicks. Header cells dispatch `onHeaderClick(colIdx)` —
// the canonical "click column header → sort by column" shape — and
// body rows dispatch `onRowClick(rowIdx)` like `DataTableViewClick`.
//
// To add row-double-click on top, chain `.OnDoublePickRow(...)`:
//
//     DataTableViewClickable[Msg](dt, focused,
//         (i) => SelectRow(Idx = i),
//         (c) => SortBy(Col = c),
//     ).OnDoublePickRow[Msg](dt.Rows.Length(), (i) => OpenRow(Idx = i))
func DataTableViewClickable[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
    onHeaderClick func(int) T,
) Widget {
    val header = dtHeaderRowClick[T](dt, onHeaderClick)
    val rule = dtRuleRow(dt)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, header),
        Fixed(1, rule),
        Flex(1, dtBodyWidgetClick[T](dt, focused, onRowClick)),
    ))
}

func dtHeaderRow(dt DataTable) Widget =
    Row(dt.Headers.ZipWithIndex().Map((p) => LayoutChild(
        Constraint = if (p.V2 < dt.Widths.Length()) dt.Widths.Get(p.V2) else Fill(1),
        Widget     = CellTextGutter(dtHeaderLabel(dt, p.V2),
                                    DefaultStyle().WithBold(),
                                    cellGutter(p.V2, dt.Headers.Length())),
    )))

// dtHeaderRowClick wraps each header cell with `.OnClick` so clicking
// a header dispatches `onHeaderClick(colIdx)`.
func dtHeaderRowClick[T any](dt DataTable, onHeaderClick func(int) T) Widget =
    Row(dt.Headers.ZipWithIndex().Map((p) => LayoutChild(
        Constraint = if (p.V2 < dt.Widths.Length()) dt.Widths.Get(p.V2) else Fill(1),
        Widget     = CellTextGutter(dtHeaderLabel(dt, p.V2),
                                    DefaultStyle().WithBold(),
                                    cellGutter(p.V2, dt.Headers.Length()))
                         .OnClick[T](onHeaderClick(p.V2)),
    )))

func dtHeaderLabel(dt DataTable, col int) string {
    val base = dt.Headers.Get(col)
    if dt.SortCol != col { return base }
    val arrow = dt.SortDir match {
        case SortAsc()  => " ↑"
        case SortDesc() => " ↓"
        case SortNone() => ""
    }
    return base + arrow
}

// dtBodyWidget builds the scrolling body.
//
// It used to emit a `Column` of every visible row and let the renderer clip,
// which meant `Offset` was never read and the cursor simply disappeared once
// it moved past the bottom of the pane — `DTEnd` on a table taller than its
// slot left no highlight anywhere on screen. `AutoScrollW` computes the
// window from the area height the way `renderList` always has.
func dtBodyWidget(dt DataTable, focused bool) Widget =
    dtBodyOf(dt, focused, (row, absIdx) => row)

// dtBodyWidgetClick is the click-aware body. `decorate` attaches each row's
// hit region to the row widget itself, so a payload travels with its row as
// the body scrolls — visible row 0 at offset 3 dispatches index 3.
//
// Wrapping the whole body in `OnPickRow` instead, as this used to do, binds
// payloads to screen positions rather than to rows, which silently targets
// the wrong record the moment the body scrolls. That form also counted
// `dt.Rows` rather than the filtered view, so it was already wrong whenever
// a filter was active.
func dtBodyWidgetClick[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
) Widget =
    dtBodyOf(dt, focused, (row, absIdx) => row.OnClick[T](onRowClick(absIdx)))

// dtBodyWidgetClickDouble attaches single AND double click to each row.
func dtBodyWidgetClickDouble[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
    onRowDoubleClick func(int) T,
) Widget =
    dtBodyOf(dt, focused, (row, absIdx) =>
        row.OnClick[T](onRowClick(absIdx))
           .OnDoubleClick[T](onRowDoubleClick(absIdx)))

func dtBodyOf(
    dt DataTable,
    focused bool,
    decorate func(Widget, int) Widget,
) Widget {
    val visible = dtVisible(dt)
    if visible.IsEmpty() {
        return TextStyled("  (no rows)", DefaultStyle().WithDim())
    }
    val rows = visible.ZipWithIndex().Map((p) =>
        decorate(dtRowWidget(dt, p.V1, p.V2 == dt.Selected, focused), p.V2))
    return AutoScrollAt(rows, dt.Selected, dt.Offset)
}

func dtRowWidget(dt DataTable, row Array[string], selected bool, focused bool) Widget {
    val rowStyle = if (selected && focused)
        DefaultStyle().WithReverse().WithBold().WithFg(BrightYellow())
    else if (selected)
        DefaultStyle().WithReverse()
    else
        DefaultStyle()
    // `CellText` rather than `Text`: a value wider than its column is cut
    // with a "…" and keeps a gutter, so it cannot run into the next
    // column and cannot pass itself off as a shorter value that fits.
    val cells = Row(row.ZipWithIndex().Map((p) => LayoutChild(
        Constraint = if (p.V2 < dt.Widths.Length()) dt.Widths.Get(p.V2) else Fill(1),
        Widget     = CellTextGutter(p.V1, rowStyle,
                                    cellGutter(p.V2, row.Length())),
    )))
    // Restyle the whole row so the highlight spans the inter-column padding
    // as well as the text; styling the cells alone left it in fragments.
    return if (selected) Highlighted(cells, rowStyle) else cells
}

// SelectedRow returns the currently-selected row's cells, or an empty array.
// DataTableViewInteractive is the full click surface: row click, row
// double-click, and header click, all bound to the rows themselves.
//
// Chaining `.OnDoublePickRow(n, ...)` onto a table instead — the shape the
// docs used to suggest — slices the table's WHOLE area into n regions
// starting at its top, so region 0 lands on the header and every dispatched
// index is offset by the header and rule. Attaching the contract per row
// inside the body removes both that offset and the need for the caller to
// know a row count at all.
func DataTableViewInteractive[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
    onRowDoubleClick func(int) T,
    onHeaderClick func(int) T,
) Widget {
    val header = dtHeaderRowClick[T](dt, onHeaderClick)
    val rule = dtRuleRow(dt)
    return Column(ArrayOf[LayoutChild](
        Fixed(1, header),
        Fixed(1, rule),
        Flex(1, dtBodyWidgetClickDouble[T](dt, focused, onRowClick, onRowDoubleClick)),
    ))
}

// VisibleRowCount is how many rows the table will actually render — after
// the filter, which is not the same as `dt.Rows.Length()`.
//
// Apps need this whenever they wrap a table in their own row-indexed
// helper, such as chaining `.OnDoublePickRow(n, ...)`. Passing the raw row
// count there registers hit regions for rows that do not exist, so a click
// below the last visible row dispatches an index into nothing — and with a
// filter active the indices are wrong even where rows do exist.
func VisibleRowCount(dt DataTable) int = dtVisible(dt).Length()

func SelectedRow(dt DataTable) Array[string] {
    val v = dtVisible(dt)
    if v.IsEmpty() || dt.Selected >= v.Length() {
        return EmptyArray[string]()
    }
    return v.Get(dt.Selected)
}

// ----------------------------------------------------------------------------
// String helpers (case-insensitive contains + lower-case).
// ----------------------------------------------------------------------------

func strToLower(s string) string {
    var out = ""
    for _, c := range s {
        if c >= 'A' && c <= 'Z' {
            out = out + string(rune(c + 32))
        } else {
            out = out + string(c)
        }
    }
    return out
}

func strContains(hay string, needle string) bool {
    val h = strRunes(hay)
    val n = strRunes(needle)
    val hn = h.Length()
    val nn = n.Length()
    if nn == 0 { return true }
    if nn > hn { return false }
    var i = 0
    for i <= hn - nn {
        var j = 0
        var ok = true
        for j < nn {
            if h.Get(i + j) != n.Get(j) {
                ok = false
                j = nn
            } else {
                j = j + 1
            }
        }
        if ok { return true }
        i = i + 1
    }
    return false
}
