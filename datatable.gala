package gala_tui

import (
    . "martianoff/gala/collection_immutable"
)

// ============================================================================
// DataTable — an interactive upgrade of the static Table widget.
//
// Features that Table lacks:
//   1. Frozen header row (stays while body scrolls)
//   2. Row selection cursor (moves with arrow keys)
//   3. Vertical scrolling when rows exceed available height
//   4. Column sorting (ascending / descending / unsorted) on any column
//   5. Row filtering via a predicate
//
// Everything is immutable. Apps hold a DataTable in their model, route key
// events into DataTableUpdate, and render with DataTableView.
//
// Typical pattern:
//     case KeyDown()  => m.Copy(Table = DataTableUpdate(m.Table, DTCursorDown()))
//     case KeyUp()    => m.Copy(Table = DataTableUpdate(m.Table, DTCursorUp()))
//     case KeyChar('s') => m.Copy(Table = DataTableUpdate(m.Table, DTSort(m.FocusedCol)))
//     case KeyChar('/') => m.Copy(Filter = !m.Filter)   // toggle filter input
// ============================================================================

sealed type SortDir {
    case SortNone()
    case SortAsc()
    case SortDesc()
}

struct DataTable(
    Headers     Array[string],
    Widths      Array[Constraint],
    Rows        Array[Array[string]],
    Selected    int,                    // row cursor within visible rows
    // First visible row in the filtered view, or -1 to track the cursor.
    // Same convention as ListW.Offset: an explicit value scrolls the body
    // independently of the selection (a wheel over an unfocused table).
    Offset      int,
    SortCol     int,                    // -1 = no sort
    SortDir     SortDir,
    FilterQuery string,                 // empty = no filter
)

// NewDataTable builds a table with the first row selected, no filter, no sort.
func NewDataTable(
    headers Array[string],
    widths Array[Constraint],
    rows Array[Array[string]],
) DataTable =
    DataTable(
        Headers     = headers,
        Widths      = widths,
        Rows        = rows,
        Selected    = 0,
        Offset      = -1,
        SortCol     = -1,
        SortDir     = SortNone(),
        FilterQuery = "",
    )

// ----------------------------------------------------------------------------
// Update
// ----------------------------------------------------------------------------

sealed type DataTableEvent {
    case DTCursorUp()
    case DTCursorDown()
    case DTPageUp(Rows int)
    case DTPageDown(Rows int)
    case DTHome()
    case DTEnd()
    case DTSort(Col int)
    case DTFilter(Query string)
    case DTClearFilter()
    case DTNoOp()
}

func DataTableUpdate(dt DataTable, ev DataTableEvent) DataTable {
    return ev match {
        case DTCursorUp()      => dtMoveCursor(dt, -1)
        case DTCursorDown()    => dtMoveCursor(dt, 1)
        case DTPageUp(rows)    => dtMoveCursor(dt, -rows)
        case DTPageDown(rows)  => dtMoveCursor(dt, rows)
        case DTHome()          => dt.Copy(Selected = 0)
        case DTEnd()           => dt.Copy(Selected = dtVisible(dt).Length() - 1)
        case DTSort(col)       => dtCycleSort(dt, col)
        case DTFilter(q)       => dt.Copy(FilterQuery = q, Selected = 0, Offset = -1)
        case DTClearFilter()   => dt.Copy(FilterQuery = "", Selected = 0, Offset = -1)
        case DTNoOp()          => dt
    }
}

func dtMoveCursor(dt DataTable, delta int) DataTable {
    val n = dtVisible(dt).Length()
    if n == 0 { return dt }
    var sel = dt.Selected + delta
    if sel < 0 { sel = 0 }
    if sel >= n { sel = n - 1 }
    return dt.Copy(Selected = sel)
}

// dtCycleSort toggles sort direction for the given column: None → Asc → Desc → None.
func dtCycleSort(dt DataTable, col int) DataTable {
    if col < 0 || col >= dt.Headers.Length() { return dt }
    if dt.SortCol != col {
        return dt.Copy(SortCol = col, SortDir = SortAsc(), Selected = 0, Offset = -1)
    }
    val next = dt.SortDir match {
        case SortNone() => SortAsc()
        case SortAsc()  => SortDesc()
        case SortDesc() => SortNone()
    }
    return next match {
        case SortNone() => dt.Copy(SortCol = -1, SortDir = SortNone(), Selected = 0, Offset = -1)
        case _          => dt.Copy(SortDir = next, Selected = 0, Offset = -1)
    }
}

// ----------------------------------------------------------------------------
// Derivation — produce the ordered, filtered view from the raw rows.
// ----------------------------------------------------------------------------

// dtVisible returns the rows to show: filter applied, then sorted.
func dtVisible(dt DataTable) Array[Array[string]] {
    val filtered = dtFilter(dt)
    return dtSort(dt, filtered)
}

// dtFilter keeps rows with a cell that contains the filter query,
// case-insensitively (MatchSubstring). Empty query keeps everything.
func dtFilter(dt DataTable) Array[Array[string]] {
    if dt.FilterQuery == "" { return dt.Rows }
    return dt.Rows.Filter((row) => row.Exists((cell) => MatchSubstring(cell, dt.FilterQuery)))
}

func dtSort(dt DataTable, rows Array[Array[string]]) Array[Array[string]] {
    if dt.SortCol < 0 { return rows }
    val col = dt.SortCol
    val asc = dt.SortDir match {
        case SortAsc()  => true
        case SortDesc() => false
        case SortNone() => true
    }
    // Each row's key is read once, not once per comparison. Both sorts are
    // stable, so rows with equal keys keep their input order in either
    // direction.
    val keyed = rows.Map((r) => (r.GetOption(col).GetOrElse(""), r))
    val sorted = if (asc) keyed.SortBy((p) => p.V1) else keyed.SortWith((a, b) => a.V1 > b.V1)
    return sorted.Map((p) => p.V2)
}

// ----------------------------------------------------------------------------
// View
// ----------------------------------------------------------------------------

// DataTableSpec is the `TableSpec` a DataTable renders as: its headers,
// with an arrow on the sorted column; the filtered, sorted rows; the cursor
// and scroll offset; and, while a filter is on, a count of what it shows on
// the header rule.
//
// Reach for it to draw a DataTable some way `DataTableView` does not — a
// footer with totals, a `▶` on the cursor row, a highlight of your own:
//
//     TableView(DataTableSpec(dt, focused).WithHighlightSymbol("▶ "))
//
// `focused` (default false) sets how loud the cursor row is. A focused
// table's row is reverse, bold and bright yellow, so it is plain which pane
// the arrow keys will move; an unfocused one's is plain reverse.
func DataTableSpec(dt DataTable, focused bool = false) TableSpec {
    val visible = dtVisible(dt)
    val labels = ArrayTabulate(dt.Headers.Length(), (i) => dtHeaderLabel(dt, i))
    return tableStringSpec(labels, dt.Widths, visible, cellOfFirstLine)
        .Select(dt.Selected)
        .ScrollTo(dt.Offset)
        .Focus(focused)
        .WithEmptyText("  (no rows)")
        .WithRuleLabel(dtFilterLabel(dt, visible.Length()))
}

// dtFilterLabel is what the header rule says while a filter is on, and
// nothing otherwise.
//
// A filtered table used to be pixel-identical to an unfiltered one: same
// header, same rule, fewer rows and nothing to say why. Scroll away from the
// row you were looking at and nothing on screen records that a filter ever
// happened, so the natural reading of the pane is "this is the dataset" —
// the one reading that is false.
//
// Count first, query second. The count is the part that says a filter is on
// and how much is hidden, so it must survive truncation — with the query
// leading, a long query pushed "0 of 4" off the end of a narrow table and
// the indicator stopped indicating anything.
func dtFilterLabel(dt DataTable, shown int) string =
    if (dt.FilterQuery == "") ""
    else s"$shown of ${dt.Rows.Length()} · ${dt.FilterQuery}"

// DataTableView renders the whole data table: frozen header row, horizontal
// rule, then the scrollable body with the cursor row highlighted. Caller
// sizes the area; the body is what is left after the header and the rule.
func DataTableView(dt DataTable, focused bool = false) Widget =
    TableView(DataTableSpec(dt, focused))

// DataTableViewClick is the click-aware sibling: each body row dispatches
// `onRowClick(rowIdx)`. `rowIdx` is the row's index in the (filtered) data,
// not its position on screen, so apps can dispatch the same
// `OpenRow(Idx = i)` for keyboard Enter and a click without translating.
//
//     val table = DataTableViewClick[Msg](dt, focused, (i) => OpenRow(Idx = i))
func DataTableViewClick[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
) Widget =
    TableView(DataTableSpec(dt, focused).OnRowClick[T](onRowClick))

// DataTableViewClickable is the full click-aware DataTable: row clicks AND
// header clicks. Header cells dispatch `onHeaderClick(colIdx)` — the
// canonical "click column header → sort by column" shape — and body rows
// dispatch `onRowClick(rowIdx)` like `DataTableViewClick`.
func DataTableViewClickable[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
    onHeaderClick func(int) T,
) Widget =
    TableView(DataTableSpec(dt, focused)
        .OnRowClick[T](onRowClick)
        .OnHeaderClick[T](onHeaderClick))

func dtHeaderLabel(dt DataTable, col int) string {
    val base = dt.Headers.Get(col)
    if dt.SortCol != col { return base }
    val arrow = dt.SortDir match {
        case SortAsc()  => " ↑"
        case SortDesc() => " ↓"
        case SortNone() => ""
    }
    return base + arrow
}

// DataTableViewInteractive is the full click surface: row click, row
// double-click, and header click, all bound to the rows themselves.
//
// Chaining `.OnDoublePickRow(n, ...)` onto a table instead — the shape the
// docs used to suggest — slices the table's WHOLE area into n regions
// starting at its top, so region 0 lands on the header and every dispatched
// index is offset by the header and rule. Attaching the contract per row
// inside the body removes both that offset and the need for the caller to
// know a row count at all.
func DataTableViewInteractive[T any](
    dt DataTable,
    focused bool,
    onRowClick func(int) T,
    onRowDoubleClick func(int) T,
    onHeaderClick func(int) T,
) Widget =
    TableView(DataTableSpec(dt, focused)
        .OnRowClick[T](onRowClick)
        .OnRowDoubleClick[T](onRowDoubleClick)
        .OnHeaderClick[T](onHeaderClick))

// VisibleRowCount is how many rows the table will actually render — after
// the filter, which is not the same as `dt.Rows.Length()`.
//
// Apps need this whenever they wrap a table in their own row-indexed
// helper, such as chaining `.OnDoublePickRow(n, ...)`. Passing the raw row
// count there registers hit regions for rows that do not exist, so a click
// below the last visible row dispatches an index into nothing — and with a
// filter active the indices are wrong even where rows do exist.
func VisibleRowCount(dt DataTable) int = dtVisible(dt).Length()

// SelectedRow returns the currently-selected row's cells, or an empty array
// when there is none — an empty table, or a filter that hides every row.
func SelectedRow(dt DataTable) Array[string] {
    val v = dtVisible(dt)
    if v.IsEmpty() || dt.Selected >= v.Length() {
        return EmptyArray[string]()
    }
    return v.Get(dt.Selected)
}
