package gala_tui

import (
    . "martianoff/gala/collection_immutable"
)

// ============================================================================
// Rich text — Span / Line / RichText.
//
// `TextWidget` carries exactly one Style for its whole string, which makes
// "bold this word inside this sentence" inexpressible. Callers worked around
// it by composing a Row of one TextWidget per styled run, but a Row cannot
// wrap: the runs are laid out as independent columns, so a paragraph that
// needs to flow onto a second line has nowhere to flow to. That is why
// `markdown.gala` drops inline styling whenever a paragraph wraps.
//
// The fix is the three-level model every mature TUI toolkit converges on:
//
//   Span     — a run of text where every character shares one Style.
//   Line     — one visual row: an ordered list of Spans, plus an alignment.
//   RichText — a block of Lines.
//
// Named `RichText` rather than `Text` because `Text(...)` is already the
// plain-string widget constructor.
//
// These are pure data with no Buffer dependency, so they are cheap to build,
// compare and test. `RichTextW` renders them.
// ============================================================================

// Span is a run of characters sharing one Style. The atom of rich text.
struct Span(
    Content string,
    Style   Style,
)

// Line is a single visual row: its Spans in left-to-right order, plus the
// horizontal alignment used when the rendered width is narrower than the
// area it is drawn into.
struct Line(
    Spans Array[Span],
    Align Align,
)

// RichText is a block of Lines. Line count is the intrinsic height; the
// widest Line is the intrinsic width.
struct RichText(
    Lines Array[Line],
)

// ----------------------------------------------------------------------------
// Constructors
// ----------------------------------------------------------------------------

// SpanOf builds a Span in the default style — the common case when the
// styling is applied later with `.Styled`.
func SpanOf(content string) Span = Span(Content = content, Style = DefaultStyle())

// SpanStyled builds a styled Span.
func SpanStyled(content string, style Style) Span =
    Span(Content = content, Style = style)

// Styled returns a copy of this Span with a different Style. Lets a caller
// build the runs first and paint them afterwards.
func (s Span) Styled(style Style) Span = Span(Content = s.Content, Style = style)

// CellWidth is how many terminal cells this Span occupies — grapheme-aware,
// so CJK and emoji count as the 2 cells they actually take.
func (s Span) CellWidth() int = StringCellWidth(s.Content)

// LineOf builds a left-aligned Line from Spans.
func LineOf(spans Array[Span]) Line = Line(Spans = spans, Align = AlignLeft())

// LineOfSpans is the variadic form of LineOf, for literal construction.
func LineOfSpans(spans ...Span) Line = LineOf(ArrayOf(spans...))

// LineFromString builds a single-Span Line in the given style — the bridge
// from the plain-string world into rich text.
func LineFromString(content string, style Style) Line =
    LineOf(ArrayOf(SpanStyled(content, style)))

// Aligned returns a copy of this Line with a different alignment.
func (l Line) Aligned(align Align) Line = Line(Spans = l.Spans, Align = align)

// CellWidth is the total rendered width of every Span on this Line.
func (l Line) CellWidth() int =
    l.Spans.FoldLeft(0, (acc, s) => acc + s.CellWidth())

// PlainText is the Line's characters with all styling discarded — the
// substrate for wrapping decisions and for plain-text assertions in tests.
func (l Line) PlainText() string =
    l.Spans.FoldLeft("", (acc, s) => acc + s.Content)

// RichTextOf builds a RichText from Lines.
func RichTextOf(lines Array[Line]) RichText = RichText(Lines = lines)

// RichTextOfLines is the variadic form, for literal construction.
func RichTextOfLines(lines ...Line) RichText = RichTextOf(ArrayOf(lines...))

// RichTextFromString builds a single-Line RichText in the given style.
func RichTextFromString(content string, style Style) RichText =
    RichTextOf(ArrayOf(LineFromString(content, style)))

// CellWidth is the widest Line's rendered width — the intrinsic width of
// the block.
func (t RichText) CellWidth() int =
    t.Lines.FoldLeft(0, (acc, l) => MaxInt(acc, l.CellWidth()))

// LineCount is the intrinsic height of the block.
func (t RichText) LineCount() int = t.Lines.Length()

// PlainText joins every Line's plain text with newlines.
func (t RichText) PlainText() string =
    t.Lines.Map((l) => l.PlainText()).MkString("\n")

// ----------------------------------------------------------------------------
// Wrapping
//
// This is THE wrap engine for the library: `wrapParagraph` delegates to it
// with a single unstyled span, so plain and styled wrapping cannot disagree
// about where the breaks fall. That agreement is load-bearing —
// `MarkdownLineCountAt` pre-computes heights with one path and the renderer
// lays out rows with the other, and a table's row heights are wrong the
// moment they diverge.
//
// The budget is counted in CELLS, not runes. The plain wrapper counted
// runes, so a CJK paragraph broke at `width` glyphs and rendered twice that
// many columns — overflowing whatever sat beside it. For ASCII the two
// metrics are identical, so nothing about existing Latin layouts moves.
// ----------------------------------------------------------------------------

// styledRune is one character carrying the style it inherited from its Span.
// Wrapping has to work at this granularity: a break can fall in the middle
// of a Span, and both halves must keep the Span's style.
struct styledRune(Ch rune, St Style)

// spanRunes flattens Spans into one styled-character sequence, which is the
// form the wrap fold consumes.
func spanRunes(spans Array[Span]) Array[styledRune] =
    spans.FoldLeft(EmptyArray[styledRune](), (acc, sp) => {
        var out = acc
        for _, c := range sp.Content {
            out = out.Append(styledRune(Ch = c, St = sp.Style))
        }
        return out
    })

func styledRunesWidth(rs Array[styledRune]) int =
    rs.FoldLeft(0, (acc, r) => acc + RuneCellWidth(r.Ch))

// coalesceSpans rebuilds Spans from a styled-character run, merging
// neighbours that share a style. Without the merge a wrapped line would
// carry one Span per character, which is correct but turns every render and
// every comparison into per-character work.
func coalesceSpans(rs Array[styledRune]) Array[Span] {
    var out = EmptyArray[Span]()
    var cur = ""
    var curStyle = DefaultStyle()
    var started = false
    var i = 0
    val n = rs.Length()
    for i < n {
        val r = rs.Get(i)
        if !started {
            cur = string(r.Ch)
            curStyle = r.St
            started = true
        } else {
            if StyleEqual(curStyle, r.St) {
                cur = cur + string(r.Ch)
            } else {
                out = out.Append(Span(Content = cur, Style = curStyle))
                cur = string(r.Ch)
                curStyle = r.St
            }
        }
        i = i + 1
    }
    if started {
        out = out.Append(Span(Content = cur, Style = curStyle))
    }
    return out
}

// spanWrapState mirrors `wrapState`: finished lines, the line being built,
// and the unflushed word — all as styled characters.
struct spanWrapState(
    Out  Array[Line],
    Line Array[styledRune],
    Word Array[styledRune],
)

func emptySpanWrapState() spanWrapState = spanWrapState(
    Out  = EmptyArray[Line](),
    Line = EmptyArray[styledRune](),
    Word = EmptyArray[styledRune](),
)

func spanWrapFlushLine(s spanWrapState) spanWrapState = spanWrapState(
    Out  = s.Out.Append(LineOf(coalesceSpans(s.Line))),
    Line = EmptyArray[styledRune](),
    Word = s.Word,
)

// spanWrapCommitWord folds the pending word into the current line, breaking
// first if it would not fit. The separating space inherits the style of the
// character it follows, so a highlighted or underlined run stays continuous
// across the gap instead of showing a hole.
func spanWrapCommitWord(s spanWrapState, width int) spanWrapState {
    if s.Word.IsEmpty() { return s }
    if s.Line.IsEmpty() {
        return spanWrapState(Out = s.Out, Line = s.Word, Word = EmptyArray[styledRune]())
    }
    val joined = styledRunesWidth(s.Line) + 1 + styledRunesWidth(s.Word)
    if joined <= width {
        val gap = styledRune(Ch = ' ', St = s.Line.Get(s.Line.Length() - 1).St)
        return spanWrapState(
            Out  = s.Out,
            Line = s.Line.Append(gap).AppendAll(s.Word),
            Word = EmptyArray[styledRune](),
        )
    }
    return spanWrapState(
        Out  = s.Out.Append(LineOf(coalesceSpans(s.Line))),
        Line = s.Word,
        Word = EmptyArray[styledRune](),
    )
}

func spanWrapStepRune(s spanWrapState, r styledRune, width int) spanWrapState {
    if r.Ch == '\n' {
        return spanWrapFlushLine(spanWrapCommitWord(s, width))
    }
    if r.Ch == ' ' {
        return spanWrapCommitWord(s, width)
    }
    // A single word wider than the whole line is hard-split at the boundary,
    // the same rule the plain wrapper uses.
    if styledRunesWidth(s.Word) + RuneCellWidth(r.Ch) > width {
        val afterLine = if (s.Line.IsEmpty()) s.Out
                        else s.Out.Append(LineOf(coalesceSpans(s.Line)))
        return spanWrapState(
            Out  = afterLine.Append(LineOf(coalesceSpans(s.Word))),
            Line = EmptyArray[styledRune](),
            Word = ArrayOf[styledRune](r),
        )
    }
    return spanWrapState(Out = s.Out, Line = s.Line, Word = s.Word.Append(r))
}

// WrapSpans greedily word-wraps `spans` to `width` cells, preserving each
// character's style across the breaks.
//
// This is what `markdown.gala` needed and did not have: wrapping used to be
// computed on the joined plain text, so a paragraph that flowed onto a
// second row lost every bold, italic, code span and link it contained.
//
// Rules match `wrapParagraph` exactly: words break at spaces, an explicit
// newline forces a break, and a word wider than the line is hard-split.
func WrapSpans(spans Array[Span], width int) Array[Line] {
    val w = MaxInt(1, width)
    val flushed = spanWrapCommitWord(
        spanRunes(spans).FoldLeft(emptySpanWrapState(),
            (acc, r) => spanWrapStepRune(acc, r, w)), w)
    if !flushed.Line.IsEmpty() || flushed.Out.IsEmpty() {
        return flushed.Out.Append(LineOf(coalesceSpans(flushed.Line)))
    }
    return flushed.Out
}

// WrapRichText wraps every line of `t` to `width`, flattening the result.
// A Line's own alignment is carried onto each row it produces.
func WrapRichText(t RichText, width int) RichText =
    RichTextOf(t.Lines.FoldLeft(EmptyArray[Line](), (acc, l) =>
        acc.AppendAll(WrapSpans(l.Spans, width).Map((w) => w.Aligned(l.Align)))))

// SpansEllipsis is `StringCellEllipsis` for styled text: spans that fit in
// `width` cells come back unchanged, and spans that do not are cut to
// `width - 1` cells and marked with a "…" in the style of the last kept
// character — so a cut inside a bold run ends in a bold ellipsis, and the
// mark reads as part of the text it shortens.
//
// The result is always exactly `width` cells. A full-width character that
// straddles the cut leaves a one-cell hole, which is filled before the mark
// so a right-aligned column of cut cells ends flush.
func SpansEllipsis(spans Array[Span], width int) Array[Span] {
    if width <= 0 { return EmptyArray[Span]() }
    val rs = spanRunes(spans)
    if styledRunesWidth(rs) <= width { return spans }
    val cut = rs.FoldLeft((EmptyArray[styledRune](), 0), (acc, r) => {
        val w = RuneCellWidth(r.Ch)
        return if (acc.V2 + w > width - 1) (acc.V1, width) else (acc.V1.Append(r), acc.V2 + w)
    }).V1
    val markStyle = if (cut.IsEmpty()) rs.Get(0).St else cut.Get(cut.Length() - 1).St
    val hole = ArrayTabulate(width - 1 - styledRunesWidth(cut), (_) => styledRune(Ch = ' ', St = markStyle))
    return coalesceSpans(cut.AppendAll(hole).Append(styledRune(Ch = '…', St = markStyle)))
}
