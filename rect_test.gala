package gala_tui

import (
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Rect arithmetic
//
// The interesting cases are all degenerate ones: a margin wider than the
// rectangle, operands that merely touch, an empty operand in a union, a
// rectangle that does not fit where it is being clamped. Those are where the
// inline versions of this maths disagreed with each other, so those are what
// these pin.
// ============================================================================

func rect(x int, y int, w int, h int) Rect =
    Rect(X = x, Y = y, Width = w, Height = h)

func rectEq(t T, got Rect, want Rect) T =
    Eq(t, s"${got.X},${got.Y} ${got.Width}x${got.Height}",
          s"${want.X},${want.Y} ${want.Width}x${want.Height}")

// ----------------------------------------------------------------------------
// Edges
// ----------------------------------------------------------------------------

// Right and Bottom are one past the last cell, so the last cell a rectangle
// covers is Right()-1. Getting this backwards is an off-by-one in every
// clipping test that uses it.
func TestRectEdgesAreHalfOpen(t T) T {
    val r = rect(3, 4, 10, 5)
    val t1 = Eq(t, r.Left(), 3)
    val t2 = Eq(t1, r.Top(), 4)
    val t3 = Eq(t2, r.Right(), 13)
    val t4 = Eq(t3, r.Bottom(), 9)
    return IsTrue(t4, r.Contains(r.Right() - 1, r.Bottom() - 1))
}

func TestRectRightIsNotACellOfTheRect(t T) T {
    val r = rect(0, 0, 4, 4)
    return IsFalse(t, r.Contains(r.Right(), 0))
}

func TestRectArea(t T) T = Eq(t, rect(2, 2, 6, 3).Area(), 18)

// ----------------------------------------------------------------------------
// Inner
// ----------------------------------------------------------------------------

func TestRectInnerShrinksBothSides(t T) T =
    rectEq(t, rect(0, 0, 10, 6).Inner(1), rect(1, 1, 8, 4))

func TestRectInnerHVTakesDifferentAxes(t T) T =
    rectEq(t, rect(0, 0, 10, 6).InnerHV(2, 1), rect(2, 1, 6, 4))

// A margin that would consume the rectangle yields an empty one rather than a
// negative extent — a negative width read as an unsigned length is how a clip
// becomes a crash.
func TestRectInnerLargerThanTheRectIsEmptyNotNegative(t T) T {
    val got = rect(0, 0, 4, 4).Inner(5)
    val t1 = Eq(t, got.Width, 0)
    val t2 = Eq(t1, got.Height, 0)
    return IsTrue(t2, got.Zero())
}

// An empty result still has its origin read for positioning, so it must land
// inside the parent — advancing X by the full margin put it past the right
// edge, which the doc claim ("at the centre") did not match.
func TestRectInnerKeepsAnEmptyResultInsideTheParent(t T) T =
    rectEq(t, rect(0, 0, 4, 4).Inner(5), rect(2, 2, 0, 0))

func TestRectInnerHVOversizedMarginCentresPerAxis(t T) T =
    rectEq(t, rect(2, 3, 4, 6).InnerHV(10, 10), rect(4, 6, 0, 0))

// ----------------------------------------------------------------------------
// Inset
//
// The four-sided form is what the renderers needed; `Inner` and `InnerHV` are
// now the symmetric special cases of it. These pin the asymmetry, which
// neither of those could express.
// ----------------------------------------------------------------------------

// CSS order — top, right, bottom, left — and each side moves only its own
// edge. Transposing two sides here is the kind of error that renders as a
// widget nudged one column, so it is spelled out with four distinct values.
func TestRectInsetTakesEachSideSeparately(t T) T =
    rectEq(t, rect(10, 20, 30, 40).Inset(1, 2, 3, 4), rect(14, 21, 24, 36))

// A side may be negative, which grows that edge outwards.
func TestRectInsetNegativeSideGrowsThatEdge(t T) T =
    rectEq(t, rect(5, 5, 10, 10).Inset(0, 0, 0, -3), rect(2, 5, 13, 10))

// An outset is never clamped, even when the opposite side collapses the rect.
// Clamping it proportionally gave X = -1 here: neither the -3 the caller asked
// for nor anywhere inside the parent, so it satisfied nobody.
func TestRectInsetOutsetIsNotClampedByTheOppositeSide(t T) T =
    rectEq(t, rect(0, 0, 4, 4).Inset(0, 10, 0, -3), rect(-3, 0, 0, 4))

// The mirror: a positive inset paired with an outset on the far side. The
// proportional split only lands inside the extent while the far side is
// non-negative — here it reaches 8 on a 4-wide rect, so the origin is capped
// at the far edge.
func TestRectInsetPositiveSideStaysInsideWhenTheFarSideGrows(t T) T =
    rectEq(t, rect(0, 0, 4, 4).Inset(0, -5, 0, 10), rect(4, 0, 0, 4))

// When two opposing insets together exceed the extent they meet *inside* the
// rectangle, and the meeting point is split between them in proportion. A
// left-heavy pair therefore lands nearer the right edge than an even one
// would — and, crucially, still inside the parent.
//
// left=9 right=3 on a width of 4: the pair wants 12 columns of a 4-column
// rect, so the origin advances 9*4/12 = 3 rather than the full 9, which would
// have put it 8 columns past the parent's right edge.
func TestRectInsetCollapsesInProportionNotAtTheMidpoint(t T) T {
    val got = rect(0, 0, 4, 4).Inset(0, 3, 0, 9)
    val t1 = rectEq(t, got, rect(3, 0, 0, 4))
    // The invariant the whole clamp exists for.
    return IsTrue(t1, got.X >= 0 && got.X <= 4)
}

// An even collapse is the midpoint, which is what `Inner` always relied on.
func TestRectInsetEvenCollapseIsTheMidpoint(t T) T =
    rectEq(t, rect(0, 0, 5, 5).Inset(4, 4, 4, 4), rect(2, 2, 0, 0))

// Inner and InnerHV are now defined through Inset, so this pins that the
// translation did not transpose an axis: InnerHV's first argument is the
// HORIZONTAL one, which maps to right and left.
func TestRectInnerHVIsInsetWithAxesSwapped(t T) T {
    val r = rect(7, 11, 20, 14)
    return rectEq(t, r.InnerHV(3, 5), r.Inset(5, 3, 5, 3))
}

func TestRectInnerIsInsetOnEverySide(t T) T {
    val r = rect(7, 11, 20, 14)
    return rectEq(t, r.Inner(2), r.Inset(2, 2, 2, 2))
}

// The clamp can only ever engage on an EMPTY result. It fires exactly when
// the two insets together exceed the extent, which is exactly when the extent
// floors to zero — so no rectangle a widget actually draws into can be
// shifted by it. That is what makes converting `renderBorder` and
// `renderPadding` to `Inset` a no-op for every non-degenerate layout, and it
// is worth pinning because the proportional split looks like it could move a
// live origin and must not.
func TestRectInsetClampNeverMovesANonEmptyRect(t T) T {
    val r = rect(0, 0, 9, 9)
    val sides = ArrayTabulate(13, (i) => i)
    return sides.FoldLeft(t, (acc, left) =>
        sides.FoldLeft(acc, (inner, right) => {
            val got = r.Inset(0, right, 0, left)
            // Either the origin advanced by the full left inset, or the
            // rectangle came out empty. Never both false.
            val moved = IsTrue(inner, got.X == left || got.Width == 0)
            // And the origin lands inside the parent either way.
            return IsTrue(moved, got.X >= 0 && got.X <= r.Width)
        }))
}

// ----------------------------------------------------------------------------
// Offset
// ----------------------------------------------------------------------------

func TestRectOffsetMovesWithoutResizing(t T) T =
    rectEq(t, rect(1, 1, 4, 3).Offset(5, -1), rect(6, 0, 4, 3))

// ----------------------------------------------------------------------------
// Intersection
// ----------------------------------------------------------------------------

func TestRectIntersectionOverlap(t T) T =
    rectEq(t, rect(0, 0, 6, 6).Intersection(rect(4, 4, 6, 6)), rect(4, 4, 2, 2))

// Touching edges share no cell. `a` covers columns 0..3 and `b` starts at 4,
// so they are adjacent — a widget that treated this as an overlap would
// refuse to place two panels side by side.
func TestRectIntersectionOfTouchingRectsIsEmpty(t T) T {
    val a = rect(0, 0, 4, 4)
    val b = rect(4, 0, 4, 4)
    val t1 = IsTrue(t, a.Intersection(b).Zero())
    return IsFalse(t1, a.Intersects(b))
}

func TestRectIntersectionOfDisjointRectsIsEmpty(t T) T =
    IsTrue(t, rect(0, 0, 2, 2).Intersection(rect(10, 10, 2, 2)).Zero())

func TestRectIntersectsWhenTheyShareACell(t T) T =
    IsTrue(t, rect(0, 0, 5, 5).Intersects(rect(4, 4, 5, 5)))

// Containment is intersection with one operand unchanged.
func TestRectIntersectionOfNestedRectsIsTheInnerOne(t T) T =
    rectEq(t, rect(0, 0, 10, 10).Intersection(rect(2, 2, 3, 3)), rect(2, 2, 3, 3))

// ----------------------------------------------------------------------------
// Union
// ----------------------------------------------------------------------------

func TestRectUnionCoversBoth(t T) T =
    rectEq(t, rect(0, 0, 2, 2).Union(rect(8, 5, 2, 2)), rect(0, 0, 10, 7))

// An empty operand has an origin, and honouring it would drag the union to
// 0,0 — so the union of something and nothing is that something.
func TestRectUnionIgnoresAnEmptyOperand(t T) T {
    val r = rect(4, 4, 3, 3)
    val t1 = rectEq(t, r.Union(rect(0, 0, 0, 0)), r)
    return rectEq(t1, rect(0, 0, 0, 0).Union(r), r)
}

// ----------------------------------------------------------------------------
// Clamp
// ----------------------------------------------------------------------------

// The popup-near-an-edge case: slide it back into view rather than truncate.
func TestRectClampSlidesBackInsideWithoutShrinking(t T) T =
    rectEq(t, rect(8, 8, 4, 4).Clamp(rect(0, 0, 10, 10)), rect(6, 6, 4, 4))

// Only shrink when it genuinely cannot fit.
func TestRectClampShrinksOnlyWhenTooBig(t T) T =
    rectEq(t, rect(0, 0, 20, 3).Clamp(rect(0, 0, 10, 10)), rect(0, 0, 10, 3))

func TestRectClampLeavesAContainedRectAlone(t T) T {
    val r = rect(2, 2, 3, 3)
    return rectEq(t, r.Clamp(rect(0, 0, 10, 10)), r)
}

// Clamping against a smaller origin moves rather than just resizes.
func TestRectClampRespectsBoundsOrigin(t T) T =
    rectEq(t, rect(0, 0, 4, 4).Clamp(rect(5, 5, 10, 10)), rect(5, 5, 4, 4))

// ----------------------------------------------------------------------------
// Centered
// ----------------------------------------------------------------------------

func TestRectCentered(t T) T =
    rectEq(t, rect(0, 0, 10, 10).Centered(4, 2), rect(3, 4, 4, 2))

// An odd leftover goes right and down, matching AlignCenter, so a panel built
// from this lands on the same column as one the layout centres.
func TestRectCenteredRoundsTowardsTheFarEdge(t T) T =
    rectEq(t, rect(0, 0, 10, 10).Centered(5, 5), rect(2, 2, 5, 5))

// The size is caller arithmetic, so it can arrive negative — and a negative
// extent read as an unsigned length is the crash this block exists to avoid.
func TestRectCenteredFloorsANegativeSizeAtZero(t T) T {
    val got = rect(0, 0, 10, 10).Centered(-4, 2)
    val t1 = Eq(t, got.Width, 0)
    return IsTrue(t1, got.Zero())
}

// Asking for more room than there is clamps instead of overflowing.
func TestRectCenteredLargerThanTheParentIsClamped(t T) T =
    rectEq(t, rect(0, 0, 6, 6).Centered(20, 20), rect(0, 0, 6, 6))
