package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
)

// Style bundles every SGR-level attribute a cell can carry. It is a plain
// immutable struct — each builder method returns a new Style with the
// modified field, so users compose styles fluently:
//
//     val s = DefaultStyle().WithFg(Red).On(Black).WithBold().WithItalic()
//
// Builder methods use a `With` prefix to avoid colliding with the exported
// fields of the same name (Go forbids a field and a method to share a name
// on the same type); `On(color)` is the only exception — a read-only sugar
// for WithBg that reads naturally in English.
struct Style(
    Fg        Color,
    Bg        Color,
    Bold      bool,
    Italic    bool,
    Underline bool,
    Reverse   bool,
    Dim       bool,
    Blink     bool,
    Strike    bool,
    // Hidden (SGR 8) keeps the text in the cell but does not show it —
    // a spoiler, an answer revealed on the next frame.
    Hidden     bool,
    // RapidBlink (SGR 6) is the fast blink; `Blink` is the slow one. Most
    // terminals render both the same or not at all.
    RapidBlink bool,
    // UnderlineColor colours the underline independently of the text —
    // SGR 58, which kitty, WezTerm, iTerm2, foot and VTE honour and other
    // terminals ignore, leaving the ordinary underline. DefaultColor draws
    // the underline in the text colour.
    UnderlineColor Color,
    // Link is the OSC 8 hyperlink target for cells carrying this style, or
    // None for ordinary text.
    //
    // A hyperlink is a property of a RANGE of cells, not of any glyph, and
    // it has to be emitted as escape bytes BETWEEN cells at flush time.
    // Putting the escapes in a TextWidget's content string — which is what
    // `Link` used to do — does not work: the renderer walks content rune by
    // rune and control characters are zero-width, so the ESC is dropped and
    // everything after it is painted as ordinary text. The user read
    // `]8;;https://github.com\github.com]8;;\`, the terminal never received
    // a hyperlink, and the widget claimed 42 columns for a 10-column label.
    //
    // Carrying it per cell means the writers below already know where the
    // boundaries are: a link change is a style change, so the same run
    // detection that emits SGR transitions emits the OSC 8 open and close.
    // It also survives partial redraws, because every cell knows its own
    // link rather than the renderer having to reconcile a separate range
    // list against whatever region it happens to be repainting.
    Link      Option[string],
    // Unset lists the attributes this style takes AWAY when it is patched
    // over another. `WithoutBold()` records it; the style's own `Bold` is
    // false either way, so it renders the same, but `row.Patch(highlight)`
    // drops a bold the row had instead of keeping it. A `false` field alone
    // cannot say that: it is indistinguishable from "not mentioned".
    Unset     Attrs,
)

// Attrs is a set of text attributes, one flag per SGR attribute `Style`
// carries. It is how a style names the attributes it removes (`Unset`).
struct Attrs(
    Bold       bool,
    Italic     bool,
    Underline  bool,
    Reverse    bool,
    Dim        bool,
    Blink      bool,
    Strike     bool,
    Hidden     bool,
    RapidBlink bool,
)

// NoAttrs is the empty attribute set.
func NoAttrs() Attrs = Attrs(
    Bold = false, Italic = false, Underline = false, Reverse = false, Dim = false,
    Blink = false, Strike = false, Hidden = false, RapidBlink = false,
)

// DefaultStyle returns a style with both colors defaulted to the terminal's
// theme and every attribute disabled. This is the "no-op" style — rendering
// it emits no SGR codes at all.
func DefaultStyle() Style = Style(
    Fg = DefaultColor(),
    Bg = DefaultColor(),
    Bold = false, Italic = false, Underline = false,
    Reverse = false, Dim = false, Blink = false, Strike = false,
    Hidden = false, RapidBlink = false,
    UnderlineColor = DefaultColor(),
    Link = None[string](),
    Unset = NoAttrs(),
)

// ----------------------------------------------------------------------------
// Fluent builders. Each returns a new Style — the receiver is unchanged.
// ----------------------------------------------------------------------------

// WithFg sets the foreground color.
func (s Style) WithFg(c Color) Style = s.Copy(Fg = c)

// WithBg sets the background color.
func (s Style) WithBg(c Color) Style = s.Copy(Bg = c)

// On is a readability alias for WithBg: `DefaultStyle().WithFg(Red).On(Black)`.
func (s Style) On(c Color) Style = s.Copy(Bg = c)

// Attribute toggles. Each turns the attribute on, and takes back an earlier
// `Without` of the same attribute.
func (s Style) WithBold() Style      = s.Copy(Bold = true, Unset = s.Unset.Copy(Bold = false))
func (s Style) WithItalic() Style    = s.Copy(Italic = true, Unset = s.Unset.Copy(Italic = false))
func (s Style) WithUnderline() Style = s.Copy(Underline = true, Unset = s.Unset.Copy(Underline = false))
func (s Style) WithReverse() Style   = s.Copy(Reverse = true, Unset = s.Unset.Copy(Reverse = false))
func (s Style) WithDim() Style       = s.Copy(Dim = true, Unset = s.Unset.Copy(Dim = false))
func (s Style) WithBlink() Style     = s.Copy(Blink = true, Unset = s.Unset.Copy(Blink = false))
func (s Style) WithStrike() Style    = s.Copy(Strike = true, Unset = s.Unset.Copy(Strike = false))
func (s Style) WithHidden() Style    = s.Copy(Hidden = true, Unset = s.Unset.Copy(Hidden = false))
func (s Style) WithRapidBlink() Style = s.Copy(RapidBlink = true, Unset = s.Unset.Copy(RapidBlink = false))

// Removals. Each turns the attribute off here AND in whatever this style is
// patched over: a selection highlight built with `.WithoutDim()` lifts a
// dimmed row instead of inheriting the dim.
func (s Style) WithoutBold() Style      = s.Copy(Bold = false, Unset = s.Unset.Copy(Bold = true))
func (s Style) WithoutItalic() Style    = s.Copy(Italic = false, Unset = s.Unset.Copy(Italic = true))
func (s Style) WithoutUnderline() Style = s.Copy(Underline = false, Unset = s.Unset.Copy(Underline = true))
func (s Style) WithoutReverse() Style   = s.Copy(Reverse = false, Unset = s.Unset.Copy(Reverse = true))
func (s Style) WithoutDim() Style       = s.Copy(Dim = false, Unset = s.Unset.Copy(Dim = true))
func (s Style) WithoutBlink() Style     = s.Copy(Blink = false, Unset = s.Unset.Copy(Blink = true))
func (s Style) WithoutStrike() Style    = s.Copy(Strike = false, Unset = s.Unset.Copy(Strike = true))
func (s Style) WithoutHidden() Style    = s.Copy(Hidden = false, Unset = s.Unset.Copy(Hidden = true))
func (s Style) WithoutRapidBlink() Style = s.Copy(RapidBlink = false, Unset = s.Unset.Copy(RapidBlink = true))

// WithUnderlineColor underlines in `c` rather than in the text colour — a
// red squiggle under an error, a dim rule under a link.
func (s Style) WithUnderlineColor(c Color) Style =
    s.WithUnderline().Copy(UnderlineColor = c)

// WithLink marks cells carrying this style as an OSC 8 hyperlink to `url`.
// The escape bytes are emitted by the buffer writers at the boundaries of
// the run, never stored in a cell's glyph.
func (s Style) WithLink(url string) Style = s.Copy(Link = Some(url))

// WithoutLink clears the hyperlink, for deriving an ordinary style from a
// linked one.
func (s Style) WithoutLink() Style = s.Copy(Link = None[string]())

// Patch layers `over` on top of `s`: every colour `over` sets and every
// attribute it turns on wins, and everything it leaves at the default keeps
// the value underneath. It is how a table cell's style sits on its row's,
// and a highlight on the cell's — a highlight that only sets a background
// must not strip the bold or the colour the cell drew with, and a plain
// `Highlighted`, which replaces the style outright, does exactly that.
//
// An attribute `over` leaves as a plain `false` keeps the value underneath
// — a `false` alone cannot be told apart from "not mentioned". One `over`
// removes with `Without…` (its `Unset`) is turned off. The removals carry
// into the result, so patching the result over something else removes them
// there too.
func (s Style) Patch(over Style) Style = Style(
    Fg        = patchColor(s.Fg, over.Fg),
    Bg        = patchColor(s.Bg, over.Bg),
    Bold      = patchAttr(s.Bold, over.Bold, over.Unset.Bold),
    Italic    = patchAttr(s.Italic, over.Italic, over.Unset.Italic),
    Underline = patchAttr(s.Underline, over.Underline, over.Unset.Underline),
    Reverse   = patchAttr(s.Reverse, over.Reverse, over.Unset.Reverse),
    Dim       = patchAttr(s.Dim, over.Dim, over.Unset.Dim),
    Blink     = patchAttr(s.Blink, over.Blink, over.Unset.Blink),
    Strike    = patchAttr(s.Strike, over.Strike, over.Unset.Strike),
    Hidden    = patchAttr(s.Hidden, over.Hidden, over.Unset.Hidden),
    RapidBlink = patchAttr(s.RapidBlink, over.RapidBlink, over.Unset.RapidBlink),
    UnderlineColor = patchColor(s.UnderlineColor, over.UnderlineColor),
    Link      = over.Link match {
        case Some(_) => over.Link
        case None()  => s.Link
    },
    // A removal survives unless `over` turns the attribute back on.
    Unset     = Attrs(
        Bold       = patchAttr(s.Unset.Bold, over.Unset.Bold, over.Bold),
        Italic     = patchAttr(s.Unset.Italic, over.Unset.Italic, over.Italic),
        Underline  = patchAttr(s.Unset.Underline, over.Unset.Underline, over.Underline),
        Reverse    = patchAttr(s.Unset.Reverse, over.Unset.Reverse, over.Reverse),
        Dim        = patchAttr(s.Unset.Dim, over.Unset.Dim, over.Dim),
        Blink      = patchAttr(s.Unset.Blink, over.Unset.Blink, over.Blink),
        Strike     = patchAttr(s.Unset.Strike, over.Unset.Strike, over.Strike),
        Hidden     = patchAttr(s.Unset.Hidden, over.Unset.Hidden, over.Hidden),
        RapidBlink = patchAttr(s.Unset.RapidBlink, over.Unset.RapidBlink, over.RapidBlink),
    ),
)

// patchAttr is one attribute of a patch: on when the patch sets it, off
// when the patch removes it, and otherwise whatever it was underneath.
func patchAttr(under bool, set bool, remove bool) bool = set || (under && !remove)

func patchColor(under Color, over Color) Color = over match {
    case DefaultColor() => under
    case _              => over
}

// ----------------------------------------------------------------------------
// SGR rendering.
// ----------------------------------------------------------------------------

// ToSgr renders the style as a complete ANSI SGR escape sequence — including
// the leading CSI `\x1b[` and the trailing `m`. Attributes are emitted in a
// canonical order so two styles that differ only in builder-call order
// produce identical output (keeps the differential renderer's equality check
// cheap and deterministic).
//
// If the style is equal to DefaultStyle(), returns the empty string (no-op).
func (s Style) ToSgr() string {
    val parts = s.sgrParts()
    if parts.IsEmpty() {
        return ""
    }
    return "\x1b[" + strings.Join(parts.ToGoSlice(), ";") + "m"
}

// sgrParts collects the individual SGR codes that make up this style in
// canonical order. Also used by the (forthcoming) differential renderer to
// compare per-cell diffs.
func (s Style) sgrParts() Array[string] {
    val flagParts = ArrayOf[Tuple[bool, string]](
        (s.Bold,      "1"), (s.Dim,    "2"), (s.Italic,  "3"),
        (s.Underline, "4"), (s.Blink,  "5"), (s.Reverse, "7"),
        (s.Strike,    "9"), (s.RapidBlink, "6"), (s.Hidden, "8"),
    ).Collect({ case (true, code) => code })
    val withFg = s.Fg match {
        case DefaultColor() => flagParts
        case _              => flagParts.Append(ToSgrFg(s.Fg))
    }
    val withBg = s.Bg match {
        case DefaultColor() => withFg
        case _              => withFg.Append(ToSgrBg(s.Bg))
    }
    // Only an underlined cell says which colour its underline is: SGR 58 on
    // a cell with no underline would be dead bytes on every flush.
    return if (s.Underline && !ColorEq(s.UnderlineColor, DefaultColor()))
        withBg.Append(ToSgrUnderline(s.UnderlineColor))
    else withBg
}

// ResetSgr is the universal "reset everything" escape — written before moving
// to a cell with a radically different style to guarantee a clean slate.
func ResetSgr() string = "\x1b[0m"

// StyleEqual reports true when two styles produce identical SGR output.
// Needed by the buffer renderer to collapse adjacent same-styled cells into
// a single SGR emission.
func StyleEqual(a Style, b Style) bool {
    return a.Bold == b.Bold &&
        a.Italic == b.Italic &&
        a.Underline == b.Underline &&
        a.Reverse == b.Reverse &&
        a.Dim == b.Dim &&
        a.Blink == b.Blink &&
        a.Strike == b.Strike &&
        a.Hidden == b.Hidden &&
        a.RapidBlink == b.RapidBlink &&
        // An underline colour only shows on an underlined cell; comparing it
        // otherwise would split runs of cells that look identical.
        (!a.Underline || ColorEq(a.UnderlineColor, b.UnderlineColor)) &&
        ColorEq(a.Fg, b.Fg) &&
        ColorEq(a.Bg, b.Bg) &&
        LinkUrl(a) == LinkUrl(b)
}

// LinkUrl is the style's hyperlink target, or "" when it has none. The
// writers compare and emit on this rather than on Option directly, so a
// link boundary is detected by the same run logic that detects an SGR
// boundary.
func LinkUrl(s Style) string = s.Link.GetOrElse("")

