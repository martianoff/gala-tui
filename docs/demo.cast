[11.527772, "o", "H\u001b[0m\u2502\u250c Canvas \u2014 live filled area, braille\u001b[0m\u001b[12;66H\u001b[0m2x4\u001b[0m\u001b[12;70H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[13;1H\u001b[0m\u2502\u001b[0m\u001b[13;28H\u001b[0m\u2502\u001b[0m\u001b[13;30H\u001b[0m                        \u001b[0m\u001b[96m\u2840\u001b[0m     \u001b[0m\u001b[13;63H\u001b[0m\u001b[96m\u2840\u001b[0m\u001b[14;1H\u001b[0m\u2502\u001b[0m\u001b[14;28H\u001b[0m\u2502\u001b[0m\u001b[14;30H\u001b[0m      \u001b[0m\u001b[96m\u28c0\u28c0\u001b[0m     \u001b[0m\u001b[96m\u28c0\u28e0\u28f6\u28f6\u28e4\u28e4\u28e4\u28f4\u28ff\u28f6\u28ff\u28ff\u28f6\u28f7\u28e4\u28f6\u28ff\u28f6\u28ff\u28ff\u28ff\u28f6\u28e4\u28c0\u001b[0m\u001b[14;105H\u001b[0m\u001b[96m\u2880\u2840\u2880\u001b[0m\u001b[14;109H\u001b[0m\u001b[96m\u2880\u001b[0m\u001b[14;115H\u001b[0m\u001b[96m\u2880\u2840\u001b[0m\u001b[14;118H\u001b[0m\u001b[96m\u2880\u2840\u001b[0m\u001b[15;1H\u001b[0m\u2502\u001b[0m\u001b[15;28H\u001b[0m\u2502\u001b[0m\u001b[15;30H\u001b[0m\u001b[96m\u28ff\u28f6\u28ff\u28ff\u28f6\u28ff\u28ff\u28ff\u28ff\u28f6\u28ff\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6\u28ff\u28f6\u28ff\u28f6\u28f6\u28ff\u28f7\u28f6\u28fe\u28e6\u28c4\u28c0\u001b[0m\u001b[15;101H\u001b[0m\u001b[96m\u2880\u28f4\u28f6\u28fe\u28ff\u28ff\u28ff\u28f7\u28ff\u28f7\u28f6\u28fe\u28ff\u28f7\u28ff\u28ff\u28f7\u28ff\u28ff\u001b[0m\u001b[16;1H\u001b[0m\u2502\u001b[0m\u001b[16;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff"]
[11.527826, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28e6\u28c4\u28c0\u28c0\u28f4\u28f6\u28f6\u28fe\u28e6\u28c4\u2840\u28e0\u28f4\u28c4\u28e0\u28fe\u28f7\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[0m\u2502\u001b[0m\u001b[17;1H\u001b[0m\u2502\u001b[0m\u001b[17;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[0m\u2502\u001b[0m\u001b[18;1H\u001b[0m\u2502\u001b[0m\u001b[18;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[19;1H\u001b[0m\u2502\u001b[0m\u001b[19;28H\u001b[0m\u2502\u250c\u001b[0m\u001b[19;31H\u001b[0mGauges\u001b[0m\u001b[19;38H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u