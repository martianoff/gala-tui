[11.52799, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mcha\u001b[0m\u001b[2;36H\u001b[0m\u001b[1;96mts\u001b[0m  \u001b[0m\u001b[4;1H\u001b[0m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u250c LineChart \u001b[0m\u001b[4;120H\u001b[0m\u2510\u001b[0m\u001b[5;1H\u001b[0m\u2502\u001b[0m\u001b[5;3H\u001b[0m\u001b[1;96m Nav \u001b[0m                  \u001b[0m\u001b[5;28H\u001b[0m\u2502\u001b[0m\u001b[5;30H\u001b[0m\u001b[92m           \u2582    \u2583 \u2584\u2586\u2581\u2583 \u2582\u2583\u2582\u2584\u2584\u2588\u2582                                                        \u001b[0m\u001b[6;1H\u001b[0m\u2502\u001b[0m\u001b[6;3H\u001b[0m  Overview              \u001b[0m\u001b[6;28H\u001b[0m\u2502\u001b[0m\u001b[6;30H\u001b[0m\u001b[92m\u2581\u2584\u2582\u2581    \u2584\u2583\u2588\u2588\u001b[0m\u001b[6;43H\u001b[0m\u001b[92m\u2586\u2587\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2585\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2587\u2584\u2581                                     \u2583 \u2582 \u2582  \u2581\u2581 \u2582\u2581 \u2582 \u2582\u001b[0m\u001b[7;1H\u001b[0m\u2502\u001b[0m\u001b[7;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2584\u2588\u2586\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u2587\u2584\u2587\u2586\u2586\u2587\u2586\u2585\u2587\u2583                       \u2584\u2586\u2588\u2588\u2587\u2588\u2585\u2588\u2586\u2584\u2588\u2588\u2585\u2588\u2588\u2585\u2588\u2587\u2588\u001b[0m    \u2502\u001b[0m\u001b[8;1H\u001b[0m\u2502\u001b[0m\u001b[8;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588"]
[11.528093, "o", "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2587\u2582\u2582    \u2582\u2581\u2581\u2583       \u2583 \u2582\u2586\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m    \u2502\u001b[0m\u001b[9;1H\u001b[0m\u2502\u001b[0m\u001b[9;28H\u001b[0m\u2502\u001b[0m\u001b[9;30H\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2585\u2583\u2584\u2584\u2588\u2588\u2588\u2588\u2587\u2584\u2581\u2585\u2588\u2584\u2585\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[10;1H\u001b[0m\u2502\u001b[0m\u001b[10;3H\u001b[0m\u001b[7m  Charts                \u001b[0m\u001b[10;28H\u001b[0m\u2502\u001b[0m\u001b[10;30H\u001b[0m                              \u001b[0m\u001b[11;1H\u001b[0m\u2502\u001b[0m\u001b[11;28H\u001b[0m\u2502\u001b[0m\u001b[11;30H\u001b[0m                              \u001b[0m\u001b[12;1H\u001b[0m\u2502\u001b[0m\u001b[12;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[11.528207, "o", "\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[13;1H\u001b[0m\u2502\u001b[0m\u001b[13;28H\u001b[0m\u2502\u250c Canvas \u2014 live filled area, braille\u001b[0m\u001b[13;66H\u001b[0m2x4\u001b[0m\u001b[13;70H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[14;1H\u001b[0m\u2502\u001b[0m\u001b[14;28H\u001b[0m\u2502\u001b[0m\u001b[14;30H\u001b[0m                              \u001b[0m\u001b[15;1H\u001b[0m\u2502\u001b[0m\u001b[15;28H\u001b[0m\u2502\u001b[0m\u001b[15;41H\u001b[0m\u001b[96m\u2880\u2840\u001b[0m\u001b[15;46H\u001b[0m\u001b[96m\u28e0\u28c4\u2880\u28e4\u28e6\u28c0\u28c4\u001b[0m\u001b[15;54H\u001b[0m\u001b[96m\u28c0\u28e4\u28c0\u28e0\u28e4\u28fe\u28c6\u2840\u001b[0m\u001b[16;1H\u001b[0m\u2502\u001b[0m\u001b[16;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\u28e0\u28f6\u28e4\u2840\u001b[0m \u001b[0m\u001b[96m\u28c0\u001b[0m \u001b[0m\u001b[96m\u2880\u28f6\u28e6\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e6\u28c4\u001b[0m                                       \u001b[0m\u001b[96m\u28c0\u28c4\u2880\u28c4\u001b[0m \u001b[0m\u001b[96m\u28c4\u001b[0m  \u001b[0m\u001b[96m\u2880\u28c0\u001b[0m \u001b[0m\u001b[96m\u28a0\u28c4\u001b[0m \u001b[0m\u001b[96m\u28a0\u2840\u28e0\u001b[0m\u2502\u001b[0m\u001b[17;1H\u001b[0m\u2502\u001b[0m\u001b[17;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28ff\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28f6"]
[11.528243, "o", "\u28ff\u28e6\u28c4\u28c0\u001b[0m                      \u001b[0m\u001b[96m\u28f0\u28f6\u28ff\u28ff\u28ff\u28ff\u28ff\u28fe\u28ff\u28ff\u28f6\u28ff\u28ff\u28f7\u28ff\u28ff\u28f7\u28ff\u28ff\u28ff\u001b[0m\u2502\u001b[0m\u001b[18;1H\u001b[0m\u2502\u001b[0m\u001b[18;28H\u001b[0m\u2502\u001b[0m\u001b[18;30H\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28e7\u28e4\u2840\u001b[0m\u001b[18;85H\u001b[0m\u001b[96m\u28e4\u28e4\u28e4\u28e6\u2840\u001b[0m\u001b[18;93H\u001b[0m\u001b[96m\u2880\u001b[0m\u001b[18;96H\u001b[0m\u001b[96m\u28f0\u28c4\u28e0\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[0m\u001b[19;1H\u001b[0m\u2502\u001b[0m\u001b[19;28H\u001b[0m\u2502\u001b[0m\u001b[19;30H\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28f7\u28f6\u28f6\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28e6\u28e0\u28ff\u28ff\u28f7\u28fe\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[0m\u001b[20;1H\u001b[0m\u2502\u001b[0m\u001b[20;28H\u001b[0m\u2502\u001b[0m\u001b[20;30H\u001b[0m\u001b[96m\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff"]
[11.528272, "o", "\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u28ff\u001b[0m\u001b[21;1H\u001b[0m\u2502\u001b[0m\u001b[21;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[22;1H\u001b[0m\u2502\u001b[0m\u001b[22;28H\u001b[0m\u2502\u250c\u001b[0m\u001b[22;31H\u001b[0mGauges\u001b[0m\u001b[22;38H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[23;1H\u001b[0m\u2502\u001b[0m\u001b[23;28H\u001b[0m\u2502\u001b[0m\u001b[23;32H\u001b[0m0%\u001b[0m\u001b[23;35H\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500"]
[11.528337, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[24;1H\u001b[0m\u2502\u001b[0m\u001b[24;28H\u001b[0m\u2502\u001b[0m\u001b[24;31H\u001b[0mdeploy\u001b[0m\u001b[24;39H\u001b[0m\u001b[2m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[25;1H\u001b[0m\u2502\u001b[0m\u001b[25;28H\u001b[0m\u2502\u001b[0m\u001b[26;1H\u001b[0m\u2502\u001b[0m\u001b[26;28H\u001b[0m\u2502\u001b[0m\u001b[26;30H\u001b[0m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[27;1H\u001b[0m\u2502\u001b[0m\u001b[27;28H\u001b[0m\u2502\u001b[0m\u001b[27;30H\u001b[0m\u2585\u2586\u2585\u2585\u2584\u2585\u2585\u2585\u2586\u2586\u2586\u2587\u2586\u2586\u2586\u2586\u2587\u2586\u2587\u2587\u2586\u2587\u2586\u2587\u2587\u2587\u2587\u2587\u2588\u2587\u2586\u2586\u2585\u2584\u2585\u2584\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2584\u2584\u2584\u2583\u2583\u2582\u2582\u2582\u2582\u2583\u2583\u2583\u2583\u2582\u2582\u2581\u2582\u2583\u2582\u2582\u2583\u2583\u2583\u2583\u2584\u2