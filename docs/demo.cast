[11.499502, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mcha\u001b[0m\u001b[2;36H\u001b[0m\u001b[1;96mts\u001b[0m  \u001b[0m\u001b[4;1H\u001b[0m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u250c LineChart \u001b[0m\u001b[4;120H\u001b[0m\u2510\u001b[0m\u001b[5;1H\u001b[0m\u2502\u001b[0m\u001b[5;3H\u001b[0m\u001b[1;96m Nav \u001b[0m                  \u001b[0m\u001b[5;28H\u001b[0m\u2502\u001b[0m\u001b[5;30H\u001b[0m\u001b[92m             \u2582    \u2583 \u2584\u2586\u2581\u2583 \u2582\u2583\u2582\u2584\u2584\u2588\u2582                                                          \u001b[0m\u001b[6;1H\u001b[0m\u2502\u001b[0m\u001b[6;3H\u001b[0m  Overview              \u001b[0m\u001b[6;28H\u001b[0m\u2502\u001b[0m\u001b[6;30H\u001b[0m\u001b[92m  \u2581\u001b[0m\u001b[6;34H\u001b[0m\u001b[92m\u2582\u2581    \u001b[0m\u001b[6;41H\u001b[0m\u001b[92m\u2583\u2588\u2588\u2587\u2586\u2587\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2585\u2588\u2588\u2588\u001b[0m\u001b[6;59H\u001b[0m\u001b[92m\u2588\u2588\u2588\u001b[0m\u001b[6;63H\u001b[0m\u001b[92m\u2584\u2581                                     \u2583 \u2582 \u2582  \u2581\u2581 \u2582\u2581 \u2582 \u2582  \u001b[0m\u001b[7;1H\u001b[0m\u2502\u001b[0m\u001b[7;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2587\u2586\u2588\u2588\u2588\u2588\u2584\u2588\u2586\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u2587\u2584\u2587\u2586\u2586\u2587\u2586\u2585\u2587\u2583                       \u2584\u2586\u2588\u2588\u2587\u2588\u2585\u2588\u2586\u2584\u2588\u2588\u2585\u2588\u2588\u2585\u2588\u2587\u2588\u2587\u2583\u001b[0m\u2502\u001b[0m\u001b[8;1H\u001b[0m\u2502\u001b[0m\u001b[8;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u258