[20.952012, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mreview\u001b[0m\u001b[4;31H\u001b[0mDiffViewS\u001b[0m\u001b[4;41H\u001b[0mats \u2500\u001b[0m\u001b[4;74H\u001b[0m\u2510\u250c MarkdownView \u001b[0m\u001b[5;30H\u001b[0m\u001b[1;92m+2 \u001b[0m\u001b[1;91m-1 \u001b[0m\u001b[2m~6 \u001b[0m                                   \u001b[0m\u001b[5;75H\u001b[0m\u2502\u001b[0m\u001b[1;4;96mRelease notes\u001b[0m\u001b[6;30H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[6;75H\u001b[0m\u2502 \u001b[0m\u001b[6;79H\u001b[0m           \u001b[0m\u001b[6;91H\u001b[0m \u001b[0m\u001b[6;94H\u001b[0m \u001b[0m\u001b[7;30H\u001b[0m\u001b[2m  func (b *Buffer) String() string {\u001b[0m\u001b[7;75H\u001b[0m\u2502Rendering\u001b[0m\u001b[8;30H\u001b[0m\u001b[2m      if y < b.Height-1 {\u001b[0m\u001b[8;75H\u001b[0m\u2502\u001b[0m\u001b[9;30H\u001b[0m\u001b[91m-         sb.WriteString(\"\\n\")\u001b[0m\u001b[9;75H\u001b[0m\u2502\u001b[0m\u001b[1m \u2022\u001b[0m\u001b[9;79H\u001b[0mrows\u001b[0m\u001b[9;84H\u001b[0mare\u001b[0m\u001b[9;88H\u001b[0mseparated\u001b[0m\u001b[9;98H\u001b[0mby\u001b[0m\u001b[9;101H\u001b[0m\u001b[93;40m\\r\\n\u001b[0m\u001b[10;30H\u001b[0m\u001b[92m+         sb.WriteString(\"\\r\\n\")\u001b[0m\u001b[10;75H\u001b[0m\u2502\u001b[0m\u001b[1m \u2022\u001b[0m\u001b[10;79H\u001b[0ma\u001b[0m\u001b[10;81H\u001b[0mwide\u001b[0m\u001b[10;86H\u001b[0mglyph\u001b[0m\u001b[10;92H\u001b[0mcovers\u001b[0m\u001b[10;99H\u001b[0m\u001b[1mtwo cells\u001b[0m,\u001b[0m\u001b[10;110H\u001b[0mnot\u001b[0m\u001b[10;114H\u001b[0mtwo\u001b[0m\u001b[10;118H\u001b[0mw\u001b[0m\u001b[11;30H\u001b[0m\u001b[2m      }\u001b[0m     \u001b[0m\u001b[11;75H\u001b[0m\u2502\u001b[0m\u001b[12;3H\u001b[0m  Data                  \u001b[0m\u001b[12;30H\u001b[0m\u001b[2m  }\u001b[0m         \u001b[0m\u001b[12;75H\u001b[0m\u2502>\u001b[0m\u001b[12;78H\u001b[0mA\u001b[0m\u001b[12;80H\u001b[0mrecorded\u001b[0m\u001b[12;89H\u001b[0mdemo\u001b[0m\u001b[12;94H\u001b[0mis\u001b[0m\u001b[12;97H\u001b[0ma\u001b[0m\u001b[12;99H\u001b[0mtest\u001b[0m\u001b[12;104H\u001b[0myou\u001b[0m\u001b[12;108H\u001b[0mcan\u001b[0m\u001b[12;112H\u001b[0mlook\u001b[0m\u001b[12;117H\u001b[0mat.\u001b[0m\u001b[13;3H\u001b[0m\u001b[7m  Review                \u001b[0m\u001b[13;30H\u001b[0m\u001b[2m  \u001b[0m            \u001b[0m\u001b[13;75H\u001b[0m\u2502\u001b[0m\u001b[14;30H\u001b[0m\u001b[2m  // a full-width row ends in deferred wrap,\u001b[0m\u001b[14;75H\u001b[0m\u2502\u001b[0m\u001b[15;29H\u001b[0m\u2502\u001b[0m\u001b[92m+ // alone moves down without returning the \u001b[0m\u2502\u2502                                            \u2502\u001b[0m\u001b[16;29H\u001b[0m\u2502\u001b[0m\u001b[16;31H\u001b[0m         \u001b[0m\u001b[16;41H\u001b[0m \u001b[0m\u001b[16;43H\u001b[0m         \u001b[0m\u001b[16;53H\u001b[0m                     \u2502\u2502                                            \u2502\u001b[0m\u001b[17;30H\u001b[0m                                            \u2502\u2502                                           \u001b[0m\u001b[18;30H\u001b[0m                                            \u2502\u2502                                           \u001b[0m\u001b[19;30H\u001b[0m                                            \u2502\u2502                                            \u001b[0m\u001b[20;32H\u001b[0m         \u001b[0m\u001b[20;73H\u001b[0m \u2502\u2502\u001b[0m\u001b[20;89H\u001b[0m   \u001b[0m\u001b[20;93H\u001b[0m                         \u001b[0m\u001b[20;119H\u001b[0m \u001b[0m\u001b[21;32H\u001b[0m         \u001b[0m\u001b[21;73H\u001b[0m \u2502\u2502\u001b[0m\u001b[21;89H\u001b[0m   \u001b[0m\u001b[21;93H\u001b[0m                         \u001b[0m\u001b[21;119H\u001b[0m \u001b[0m\u001b[22;32H\u001b[0m            \u001b[0m\u001b[22;73