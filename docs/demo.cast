[25.476089, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mforms\u001b[0m \u001b[0m\u001b[4;31H\u001b[0mS\u001b[0m\u001b[4;33H\u001b[0mgn \u001b[0m\u001b[4;37H\u001b[0mn \u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[4;74H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[5;30H\u001b[0m         \u001b[0m\u001b[5;74H\u001b[0m               \u001b[0m\u001b[6;30H\u001b[0m \u001b[0m\u001b[2m user\u001b[0m                                        \u001b[0m\u001b[7;30H\u001b[0m \u001b[0m\u001b[1;7;93my\u001b[0m\u001b[2mo\u001b[0m\u001b[7;34H\u001b[0m\u001b[2m@example.com\u001b[0m\u001b[1;93m                                                                         \u001b[0m\u001b[8;30H\u001b[0m                         \u001b[0m\u001b[8;74H\u001b[0m  \u001b[0m\u001b[9;30H\u001b[0m \u001b[0m\u001b[2m password\u001b[0m                    \u001b[0m\u001b[9;74H\u001b[0m    \u001b[0m\u001b[9;79H\u001b[0m    \u001b[0m\u001b[9;84H\u001b[0m   \u001b[0m\u001b[9;88H\u001b[0m         \u001b[0m\u001b[9;98H\u001b[0m  \u001b[0m\u001b[9;101H\u001b[0m    \u001b[0m\u001b[10;30H\u001b[0m \u001b[0m\u001b[2mrequired\u001b[0m                       \u001b[0m\u001b[10;74H\u001b[0m    \u001b[0m\u001b[10;79H\u001b[0m \u001b[0m\u001b[10;81H\u001b[0m    \u001b[0m\u001b[10;86H\u001b[0m     \u001b[0m\u001b[10;92H\u001b[0m      \u001b[0m\u001b[10;99H\u001b[0m          \u001b[0m\u001b[10;110H\u001b[0m   \u001b[0m\u001b[10;114H\u001b[0m   \u001b[0m\u001b[10;118H\u001b[0m \u001b[0m\u001b[11;3H\u001b[0m\u001b[7m  Forms                 \u001b[0m\u001b[11;30H\u001b[0m       \u001b[0m\u001b[11;74H\u001b[0m  \u001b[0m\u001b[12;30H\u001b[0m [ \u001b[0m\u001b[12;34H\u001b[0mSign\u001b[0m\u001b[12;39H\u001b[0min\u001b[0m\u001b[12;43H\u001b[0m]\u001b[0m\u001b[12;47H\u001b[0m\u001b[2m password required\u001b[0m\u001b[12;74H\u001b[0m   \u001b[0m\u001b[12;78H\u001b[0m \u001b[0m\u001b[12;80H\u001b[0m        \u001b[0m\u001b[12;89H\u001b[0m    \u001b[0m\u001