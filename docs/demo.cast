[11.613982, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[12;1H\u001b[0m\u2502\u001b[0m\u001b[12;28H\u001b[0m\u2502\u250c Canvas \u2014 live filled area, braille\u001b[0m\u001b[12;66H\u001b[0m2x4\u001b[0m\u001b[12;70H\u001b[0m\u2500\u2500\u2500\u2500\u2510\u250c\u001b[0m\u001b[12;77H\u001b[0msextant\u001b[0m\u001b[12;85H\u001b[0m2x3\u001b[0m\u001b[12;89H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u250c\u001b[0m\u001b[12;100H\u001b[0mquadrant\u001b[0m\u001b[12;109H\u001b[0m2x2\u001b[0m\u001b[12;113H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[13;1H\u001b[0m\u2502\u001b[0m\u001b[13;28H\u001b[0m\u2502\u001b[0m\u001b[13;30H\u001b[0m          \u001b[0m\u001b[96m\u2840\u001b[0m   \u001b[0m\u001b[96m\u2880\u001b[0m               \u001b[0m\u001b[13;74H\u001b[0m\u2502\u2502\u001b[0m\u001b[13;80H\u001b[0m\u001b[96m\ud83e\udf1e\u001b[0m\u001b[13;83H\u001b[0m\u001b[96m\ud83e\udf0f\u001b[0m\u001b[13;97H\u001b[0m\u2502\u2502\u001b[0m\u001b[13;103H\u001b[0m\u001b[96m\u2597\u001b[0m\u001b[13;106H\u001b[0m\u001b[96m\u2596\u001b[0m\u001b[14;1H\u001b[0m\u2502\u001b[0m\u001b[14;28H\u001b[0m\u2502\u001b[0m\u001b[14;30H\u001b[0m \u001b[0m\u001b[96m\u28c0\u001b[0m  \u001b[0m\u001b[96m\u2880\u28f0\u28e6\u28e4\u28fc\u28fe\u28f7\u28e7\u28fe\u28fe\u28ff\u28e6\u2840\u001b[0m             \u001b[0m\u001b[14;65H\u001b[0m\u001b[96m\u2880\u2880\u2880\u001b[0m\u001b[14;70H\u001b[0m\u001b[96m\u2880\u001b[0m\u001b[14;72H\u001b[0m\u001b[96m\u2840\u2840\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\ud83e\udf1e\u001b[0m\u001b[14;78H\u001b[0m\u001b[96m\ud83e\udf35\ud83e\udf3a\u2588\u2588\u2588\ud83e\udf3a\u001b[0m\u001b[14;92H\u001b[0m\u001b[96m\ud83e\udf1e\ud83e\udf2d\u001b[0m\u001b[14;95H\u001b[0m\u001b[96m\ud83e\udf0f\ud83e\udf2d\u001b[0m\u2502\u2502\u001b[0m\u001b[96m\u2597\u001b[0m\u001b[14;101H\u001b[0m\u001b[96m\u259f\u2599\u2588\u2588\u2588\u2599\u001b[0m\u001b[14;115H\u001b[0m\u001b[96m\u2597\u2584\u001b[0m\u001b[14;118