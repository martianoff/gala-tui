[11.489939, "o", "\u2584\u2581\u2584\u2581\u001b[0m\u001b[33;1H\u001b[0m\u2502\u001b[0m\u001b[33;28H\u001b[0m\u2502\u001b[0m\u001b[33;30H\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2586\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[95m\u2581\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u001b[0m\u001b[95m\u2581\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[95m\u2581\u2583\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[95m\u2581\u001b[0m\u001b[92m\u2588\u2588\u001b[0m\u001b[95m\u2581\u2581\u2581\u2581\u2583\u2581\u001b[0m\u001b[92m\u2588\u2588\u2588\u2586\u2588\u2586\u2588\u2588\u2588\u2588\u2588\u2587\u2588\u2585\u2583\u2582\u001b[0m\u001b[33;97H\u001b[0m\u001b[92m\u2581\u2586\u2588\u2588\u2588\u2588\u2588\u2587\u2588\u2588\u2586\u2588\u2588\u2587\u2588\u2588\u2587\u2588\u2588\u2588\u2588\u2585\u2582\u001b[0m\u001b[34;1H\u001b[0m\u2502\u001b[0m\u001b[34;28H\u001b[0m\u2502\u001b[0m\u001b[34;30H\u001b[0m\u001b[95m\u2583\u2584\u2585\u2585\u2584\u2582\u2583\u2583\u2583\u2585\u2585\u2588\u2588\u2587\u2586\u2586\u2586\u2588\u2588\u2588\u2588\u2588\u2588\u2586\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2586\u2585\u2584\u2582\u2583\u2582\u2583\u2583\u2582\u2583\u2583\u2582\u2583\u2581\u001b[0m\u001b[92m\u2588\u2588\u2585\u2585\u2581\u001b[0m\u001b[34;83H\u001b[0m\u001b[92m\u2585\u2584\u2584\u2586\u2583\u001b[0m\u001b[34;90H\u001b[0m\u001b[92m\u2581\u2584\u001b[0m\u001b[34;93H\u001b[0m\u001b[92m\u2581\u2586\u2584\u2585\u2588\u001b[0m\u001b[95m\u2582\u2583\u2583\u2585\u2583\u2584\u2582\u2585\u2583\u2582\u2584\u2584\u2582\u2585\u2584\u2582\u2585\u2583\u2585\u2583\u2581\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[35;1H\u001b[0m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u2514\u001b[0m\u001b[35;120H\u001b[0m\u2518\u001b[0m\u001b[36;9H\u001b[0m\u001b[7;97mtable  \u001b[0m\u001b[36;17H\u001b[0m\u001b[7;97mthem\u001b[0m\u001b[36;22H\u001b[0m\u001b[7;97m: dark \u001b[