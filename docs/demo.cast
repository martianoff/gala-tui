[14.045894, "o", "\u001b[0m\u001b[92m\u2587\u2588\u001b[0m\u001b[32;86H\u001b[0m\u001b[92m\u2587\u2588\u001b[0m\u001b[32;91H\u001b[0m\u001b[92m\u2585\u2582\u2587\u2588\u001b[0m\u001b[32;96H\u001b[0m\u001b[92m\u2584\u2588\u2587\u001b[0m\u001b[32;100H\u001b[0m\u001b[92m\u2586\u2588\u001b[0m\u001b[32;103H\u001b[0m\u001b[92m\u2587\u2583\u001b[0m \u001b[0m\u001b[33;34H\u001b[0m\u001b[95m\u2586\u2585\u2584\u2582\u2583\u2582\u2583\u001b[0m\u001b[33;42H\u001b[0m\u001b[95m\u2582\u2583\u001b[0m\u001b[33;45H\u001b[0m\u001b[95m\u2582\u2583\u2581\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[33;50H\u001b[0m\u001b[92m\u2585\u001b[0m\u001b[33;52H\u001b[0m\u001b[92m\u2581\u001b[0m \u001b[0m\u001b[33;56H\u001b[0m\u001b[92m\u2585\u2584\u001b[0m\u001b[33;59H\u001b[0m\u001b[92m\u2586\u2583\u001b[0m \u001b[0m\u001b[33;63H\u001b[0m\u001b[92m\u2581\u2584\u001b[0m \u001b[0m\u001b[92m\u2581\u2586\u2584\u2585\u2588\u001b[0m\u001b[95m\u2582\u2583\u001b[0m\u001b[33;74H\u001b[0m\u001b[95m\u2585\u2583\u2584\u2582\u2585\u2583\u2582\u2584\u001b[0m\u001b[33;83H\u001b[0m\u001b[95m\u2582\u2585\u2584\u2582\u2585\u2583\u2585\u2583\u2581\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[95m\u2582\u2584\u2583\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[95m\u2583\u2582\u001b[0m\u001b[33;101H\u001b[0m\u001b[95m\u2584\u001b[0m\u001b[33;103H\u001b[0m\u001b[95m\u2582\u001b[0m\u001b[92m\u2588\u001b[0m\u001b[33;106H\u001b[0m\u001b[92m\u2583\u2582\u2585\u2584\u001b[0m\u001b[33;111H\u001b[0m\u001b[92m\u2581\u001b[0m \u001b[0m\u001b[33;115H\u001b[0m\u001b[92m\u2584\u001b[0m\u001b[34;49H\u001b[0m\u001b[95m\u2587\u2585\u2584\u2582\u2581\u2582\u001b[0m\u001b[34;56H\u001b[0m\u001b[95m\u2585\u2584\u001b[0m\u001b[34;59H\u001b[0m\u001b[95m\u2585\u2583\u2582\u2581\u2582\u2584\u2582\u001b[0m\u001b[34;67H\u001b[0m\u001b[95m\u2585\u2584\u001b[0m\u001b[34;70H\u001b[0m\u001b[95m\u2586\u2588\u001b[0m\u001b[34;105H\u001b[0m\u001b[95m\u2586\u2584\u2583\u2585\u2584\u001b[0m\u001b[34;111H\u001b[0m\u001b[95m\u2582\u2581\u2582\u2581\u2584\u001b[0m"]
