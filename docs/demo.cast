[20.952298, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mreview\u001b[0m\u001b[4;31H\u001b[0mDiffViewS\u001b[0m\u001b[4;41H\u001b[0mats \u2500\u001b[0m\u001b[4;74H\u001b[0m\u2510\u250c MarkdownView \u001b[0m\u001b[5;30H\u001b[0m\u001b[1;92m+2 \u001b[0m\u001b[1;91m-1 \u001b[0m\u001b[2m~6 \u001b[0m                                   \u001b[0m\u001b[5;75H\u001b[0m\u2502\u001b[0m\u001b[1;4;96mRelease notes\u001b[0m\u001b[6;30H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[6;75H\u001b[0m\u2502 \u001b[0m\u001b[6;79H\u001b[0m           \u001b[0m\u001b[6;91H\u001b[0m \u001b[0m\u001b[6;94H\u001b[0m \u001b[0m\u001b[7;30H\u001b[0m\u001b[2m  func (b *Buffer) String() string {\u001b[0m\u001b[7;75H\u001b[0m\u2502Rendering\u001b[0m\u001b[8;30H\u001b[0m\u001b[2m      if y < b.Height-1 {\u001b[0m\u001b[8;75H\u001b[0m\u2502\u001b[0m\u001b[9;30H\u001b[0m\u001b[91m-         sb.WriteString(\"\\n\")\u001b[0m\u001b[9;75H\u001b[0m\u2502\u001b[0m\u001b[1m \u2022\u001b[0m\u001b[9;79H\u001b[0mrows\u001b[0m\u001b[9;84H\u001b[0mare\u001b[0m\u001b[9;88H\u001b[0mseparated\u001b[0m\u001b[9;98H\u001b[0mby\u001b[0m\u001b[9;101H\u001b[0m\u001b[93;40m\\r\\n\u001b[0m\u001b[10;30H\u001b[0m\u001b[92m+         sb.WriteString(\"\\r\\n\")\u001b[0m\u001b[10;75H\u001b[0m\u2502\u001b[0m\u001b[1m \u2022\u001b[0m\u001b[10;79H\u001b[0ma\u001b[0m\u001b[10;81H\u001b[0mwide\u001b[0m\u001b[10;86H\u001b[0mglyph\u001b[0m\u001b[10;92H\u001b[0mcovers\u001b[0m\u001b[10;99H\u001b[0m\u001b[1mtwo cells\u001b[0m,\u001b[0m\u001b[10;110H\u001b[0mnot\u001b[0m\u001b[10;114H\u001b[0mtwo\u001b[0m\u001b[10;118H\u001b[0mw\u001b[0m\u001b[11;30H\u001b[0m\u001b[2m      }\u001b[0m     \u001b[0m\u001b[11;75H\u001b[0m\u2502\u001b[0m\u001b[12;3H\u001b[0m  Data                  \u001b[0m\u001b[12;30H\u001b[0m\u