[25.469562, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mforms\u001b[0m \u001b[0m\u001b[4;31H\u001b[0mS\u001b[0m\u001b[4;33H\u001b[0mgn \u001b[0m\u001b[4;37H\u001b[0mn \u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[4;74H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[5;30H\u001b[0m         \u001b[0m\u001b[5;74H\u001b[0m               \u001b[0m\u001b[6;30H\u001b[0m \u001b[0m\u001b[2m user\u001b[0m                                        \u001b[0m\u001b[7;30H\u001b[0m \u001b[0m\u001b[1;7;93my\u001b[0m\u001b[2mo\u001b[0m\u001b[7;34H\u001b[0m\u001b[2m@example.com\u001b[0m\u001b[1;93m                                                                         \u001b[0m\u001b[8;30H\u001b[0m                         \u001b[0m\u001b[8;74H\u001b[0m  \u001b[0m\u001b[9;30H\u001b[0m \u001b[0m\u001b[2m password\u001b[0m                    \u001b[0m\u001b[9;74H\u001b[0m    \u001b[0m\u001b[9;79H\u001b[0m    \u001b[0m\u001b[9;84H\u001b[0m   \u001b[0m\u001b[9;88H\u001b[0m         \u001b[0m\u001b[9;98H\u001b[0m  \u001b[0m\u001b[9;101H\u001b[0m    \u001b[0m\u001b[10;30H\u001b[0m \u001b[0m\u001b[2mrequired\u001b[0m                       \u001b[0m\u001b[10;74H\u001b[0m    \u001b[0m\u001b[10;79H\u001b[0m \u001b[0m\u001b[10;81H\u001b[0m    \u001b[0m\u001b[10;86H\u001b[0m     \u001b[0m\u001b[10;92H\u001b[0m      \u001b[0m\u001b[10;99H\u001b[0m          \u001b[0m\u001b[10;110H\u001b[0m   \u001b[0m\u001b[10;114H\u001b[0m   \u001b[0m\u001b[10;118H\u001b[0m \u001b[0m\u001b[11;3H\u001b[0m\u001b[7m  Forms                 \u001b[0m\u001b[11;30H\u001b[0m       \u001b[0m\u001b[11;74H\u001b[0m  \u001b[0m\u001b[12;30H\u001b[0m [ \u001b[0m\u001b[12;34H\u001b[0mSign\u001b[0m\u001b[12;39H\u001b[0min\u001b[0m\u001b[12;43H\u001b[0m]\u001b[0m\u001b[12;47H\u001b[0m\u001b[2m password required\u001b[0m\u001b[12;74H\u001b[0m   \u001b[0m\u001b[12;78H\u001b[0m \u001b[0m\u001b[12;80H\u001b[0m        \u001b[0m\u001b[12;89H\u001b[0m    \u001b[0m\u001b[12;94H\u001b[0m  \u001b[0m\u001b[12;97H\u001b[0m \u001b[0m\u001b[12;99H\u001b[0m    \u001b[0m\u001b[12;104H\u001b[0m   \u001b[0m\u001b[12;108H\u001b[0m   \u001b[0m\u001b[12;112H\u001b[0m    \u001b[0m\u001b[12;117H\u001b[0m   \u001b[0m\u001b[13;3H\u001b[0m  Review                \u001b[0m\u001b[13;30H\u001b[0m  \u001b[0m\u001b[13;74H\u001b[0m  \u001b[0m\u001b[14;30H\u001b[0m                                              \u001b[0m\u001b[15;29H\u001b[0m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[16;29H\u001b[0m\u250c\u001b[0m\u001b[16;31H\u001b[0mSearchInput\u001b[0m\u001b[16;43H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[17;74H\u001b[0m  \u001b[0m\u001b[18;31H\u001b[0m\u001b[1;96m /  \u001b[0m\u001b[2;3mType to search\u2026\u001b[0m\u001b[18;74H\u001b[0m  \u001b[0m\u001b[19;74H\u001b[0m  \u001b[0m\u001b[20;31H\u001b[0m\u001b[2m no matches\u001b[0m\u001b[20;74H\u001b[0m  \u001b[0m\u001b[21;74H\u001b[0m  \u001b[0m\u001b[22;29H\u001b[0m\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2