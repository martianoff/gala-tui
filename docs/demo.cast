[11.480161, "o", "\u001b[2;63H\u001b[0m\u2839\u001b[0m\u001b[2;65H\u001b[0m\u001b[1;92m \u25cf \u001b[0m\u001b[2;87H\u001b[0m\u001b[2m2\u001b[0m\u001b[6;30H\u001b[0m\u001b[92m\u2588\u2587\u2587\u2587\u2587\u2587\u2587\u2587\u2587\u2587\u2586\u2586\u2586\u2586\u2586\u2586\u2586\u2586\u2586\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2584\u2583\u2583\u001b[0m\u001b[10;30H\u001b[0m\u001b[1;95m \u2585\u001b[0m\u001b[10;34H\u001b[0m\u001b[1;95m \u001b[0m\u001b[10;36H\u001b[0m\u001b[1;95m\u2581\u001b[0m\u001b[10;39H\u001b[0m\u001b[1;95m \u2586\u001b[0m\u001b[10;45H\u001b[0m\u001b[1;95m\u2582\u001b[0m\u001b[10;48H\u001b[0m\u001b[1;95m \u2587\u001b[0m\u001b[10;54H\u001b[0m\u001b[1;95m\u2582\u001b[0m\u001b[10;57H\u001b[0m\u001b[1;95m \u2588\u001b[0m\u001b[11;30H\u001b[0m\u001b[1;95m \u2588\u2584\u001b[0m\u001b[11;34H\u001b[0m\u001b[1;95m  \u2588\u001b[0m\u001b[11;39H\u001b[0m\u001b[1;95m \u2588\u2584\u001b[0m\u001b[11;44H\u001b[0m\u001b[1;95m \u2588\u001b[0m\u001b[11;48H\u001b[0m\u001b[1;95m \u2588\u2585\u001b[0m\u001b[11;53H\u001b[0m\u001b[1;95m \u2588\u2581\u001b[0m\u001b[11;57H\u001b[0m\u001b[1;95m \u2588\u2586\u001b[0m\u001b[12;30H\u001b[0m\u001b[1;95m \u001b[0m\u001b[12;32H\u001b[0m\u001b[1;95m\u2588\u2582  \u2588\u2587\u001b[0m\u001b[12;39H\u001b[0m\u001b[1;95m \u001b[0m\u001b[12;41H\u001b[0m\u001b[1;95m\u2588\u2583\u001b[0m\u001b[12;44H\u001b[0m\u001b[1;95m \u2588\u2588\u001b[0m\u001b[12;48H\u001b[0m\u001b[1;95m \u001b[0m\u001b[12;50H\u001b[0m\u001b[1;95m\u2588\u2584\u001b[0m\u001b[12;53H\u001b[0m\u001b[1;95m \u2588\u2588\u001b[0m\u001b[12;57H\u001b[0m\u001b[1;95m \u001b[0m\u001b[12;59H\u001b[0m\u001b[1;95m\u2588\u001b[0m\u001b[13;30H\u001b[0m\u001b[1;95m \u001b[0m\u001b[13;33H\u001b[0m\u001b[1;95m\u2588\u2581 \u001b[0m\u001b[13;37H\u001b[0m\u001b[1;95m\u2588\u2586 \u001b[0m\u001b[13;42H\u001b[0m\u001b[1;95m\u2588\u2582 \u001b[0m\u001b[13;46H\u001b[0m\u001b[1;95m\u2588\u2587 \u001b[0m\u001b[13;51H\u001b[