[11.527454, "o", "\u001b[2;32H\u001b[0m\u001b[1;96mcha\u001b[0m\u001b[2;36H\u001b[0m\u001b[1;96mts\u001b[0m  \u001b[0m\u001b[4;1H\u001b[0m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u250c LineChart \u001b[0m\u001b[4;120H\u001b[0m\u2510\u001b[0m\u001b[5;1H\u001b[0m\u2502\u001b[0m\u001b[5;3H\u001b[0m\u001b[1;96m Nav \u001b[0m                  \u001b[0m\u001b[5;28H\u001b[0m\u2502\u001b[0m\u001b[5;30H\u001b[0m\u001b[92m                \u2582    \u2583 \u2584\u2586\u2581\u2583 \u2582\u2583\u2582\u2584\u2584\u2588\u2582                                                       \u001b[0m\u001b[6;1H\u001b[0m\u2502\u001b[0m\u001b[6;3H\u001b[0m  Overview              \u001b[0m\u001b[6;28H\u001b[0m\u2502\u001b[0m\u001b[6;30H\u001b[0m\u001b[92m\u2581    \u2581\u2584\u2582\u2581    \u001b[0m\u001b[6;44H\u001b[0m\u001b[92m\u2583\u2588\u2588\u2587\u2586\u2587\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2585\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2587\u2584\u2581                                     \u2583 \u2582 \u2582  \u2581\u2581 \u2582\u2581 \u2582 \u001b[0m\u001b[7;1H\u001b[0m\u2502\u001b[0m\u001b[7;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2588\u2585\u2588\u2587\u2586\u2588\u2588\u2588\u2588\u2584\u2588\u2586\u2587\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2584\u2587\u2584\u2587\u2586\u2586\u2587\u2586\u2585\u2587\u2583                       \u2584\u2586\u2588\u2588\u2587\u2588\u2585\u2588\u2586\u2584\u2588\u2588\u2585\u2588\u2588\u2585\u2588\u2587\u001b[0m\u2502\u001b[0m\u001b[8;1H\u001b[0m\u2502\u001b[0m\u001b[8;28H\u001b[0m\u2502\u2502\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2588\u2588"]
[11.527525, "o", "\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2587\u2582\u2582    \u2582\u2581\u2581\u2583       \u2583 \u2582\u2586\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u2502\u001b[0m\u001b[9;1H\u001b[0m\u2502\u001b[0m\u001b[9;28H\u001b[0m\u2502\u001b[0m\u001b[9;30H\u001b[0m\u001b[92m\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2585\u2583\u2584\u2584\u2588\u2588\u2588\u2588\u2587\u2584\u2581\u2585\u2588\u2584\u2585\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u001b[0m\u001b[10;1H\u001b[0m\u2502\u001b[0m\u001b[10;3H\u001b[0m\u001b[7m  Charts                \u001b[0m\u001b[10;28H\u001b[0m\u2502\u001b[0m\u001b[10;30H\u001b[0m                              \u001b[0m\u001b[11;1H\u001b[0m\u2502\u001b[0m\u001b[11;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[12;1H\u001b[0m\u2502\u001b[0m\u001b[12;2