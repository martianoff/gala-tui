[12.859136, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[16;29H\u001b[0m\u250c\u001b[0m\u001b[16;31H\u001b[0mSearchInput\u001b[0m\u001b[16;43H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2510\u001b[0m\u001b[17;50H\u001b[0m                                                                      \u001b[0m\u001b[18;31H\u001b[0m\u001b[1;96m /  \u001b[0m\u001b[2;3mType to search\u2026\u001b[0m                                                                      \u001b[0m\u001b[19;31H\u001b[0m                                                                                         \u001b[0m\u001b[20;30H\u001b[0m \u001b[0m\u001b[2m no matches\u001b[0m                                                                              \u001b[0m\u001b[21;29H\u001b[0m\u2502                                                                                          \u2502\u001b[0m\u001b[22;29H\u001b[0m\u2514"]
