[11.537944, "o", "\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[25;1H\u001b[0m\u2502\u001b[0m\u001b[25;28H\u001b[0m\u2502\u001b[0m\u001b[26;1H\u001b[0m\u2502\u001b[0m\u001b[26;28H\u001b[0m\u2502\u001b[0m\u001b[26;30H\u001b[0m\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u2591\u001b[0m\u001b[27;1H\u001b[0m\u2502\u001b[0m\u001b[27;28H\u001b[0m\u2502\u001b[0m\u001b[27;30H\u001b[0m\u2582\u2582\u2581\u2581\u2581\u2581\u2582\u2583\u2583\u2583\u2584\u2583\u2583\u2582\u2582\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2581\u2582\u2582\u2582\u2583\u2584\u2584\u2584\u2584\u2583\u2584\u2584\u2584\u2584\u2584\u2584\u2585\u2585\u2584\u2584\u2583\u2583\u2583\u2584\u2584\u2584\u2585\u2585\u2585\u2586\u2586\u2586\u2586\u2586\u2586\u2587\u2587\u2587\u2587\u2586\u2586\u2586\u2586\u2586\u2587\u2587\u2588\u2587\u2587\u2587\u2586\u2586\u001b[0m\u001b[28;1H\u001b[0m\u2502\u001b[0m\u001b[28;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u