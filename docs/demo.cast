[11.535555, "o", "\u2583\u2582\u2582\u2583\u2583\u2583\u2583\u2584\u2585\u2585\u2586\u2585\u2585\u2585\u2585\u2585\u2584\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u001b[0m\u001b[28;1H\u001b[0m\u2502\u001b[0m\u001b[28;28H\u001b[0m\u2502\u001b[0m\u001b[28;30H\u001b[0m\u2585\u2585\u2585\u2586\u2586\u2585\u2584\u2585\u2585\u2585\u2586\u2586\u2586\u2587\u2586\u2586\u2586\u2586\u2587\u2586\u2587\u2588\u2587\u2587\u2586\u2587\u2587\u2587\u2587\u2587\u001b[0m\u001b[28;62H\u001b[0m\u2586\u2586\u2585\u2584\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2585\u2584\u2584\u2584\u2583\u2583\u2582\u2582\u2582\u2582\u2583\u2583\u2583\u2583\u2582\u2582\u2581\u2582\u2583\u2582\u2582\u2583\u2583\u2583\u2584\u2584\u2585\u2585\u2586\u2585\u2585\u2585\u2586\u2585\u2584\u2585\u2585\u2585\u2586\u2585\u2585\u2586\u001b[0m\u001b[29;1H\u001b[0m\u2502\u001b[0m\u001b[29;28H\u001b[0m\u2502\u2514\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2518\u001b[0m\u001b[30;1H\u001b[0m\u2502\u001b[0m\u001b[30;28H\u001b[0m\u2502\u250c\u001b[0m\u001b[30;31H\u001b[0mMultiLineChart\u001b[0m\u001b[30;46H\u001b[0m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250