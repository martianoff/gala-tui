package gala_tui

import (
    "fmt"
    "strings"
    "martianoff/gala/concurrent"
    "os"
    "golang.org/x/term"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/go_interop"
    . "martianoff/gala/time_utils"
)

// ============================================================================
// Backend — the seam between the runtime and the terminal.
//
// Everything the run loop needs from the outside world is four operations:
// how big the screen is, write some bytes, read some bytes, and acquire or
// release the terminal's global state (raw mode, alternate screen, input
// protocols). Until now all four were `os.Stdout` / `os.Stdin` /
// `golang.org/x/term` calls written inline in `runtime.gala`, which had two
// consequences:
//
//   - **The run loop was untestable.** The widget harness renders widgets
//     directly, so everything between "bytes arrive" and "a frame is
//     painted" — parsing, carry-over, click resolution, subscription
//     draining, quit handling — had no test that drove it end to end. The
//     bracketed-paste defects found in the 0.12.0 review all lived in that
//     gap, and none of them could have been caught by a widget test.
//
//   - **The viewport was fixed.** "Where do I write, and how much of the
//     screen do I own" is a backend question. Answering it inline is why
//     every app is full-screen on the alternate screen.
//
// A Backend is a struct of functions rather than an interface: GALA models
// this shape with closures, and it makes a test backend a literal rather
// than a type declaration.
//
// The Run entry points take `backend Backend = TerminalBackend()`, so this
// is additive — existing calls are unchanged and get the real terminal.
// ============================================================================

// BackendSession is the release half of acquiring the terminal. `Close`
// restores whatever `Open` changed and must be safe to call once.
struct BackendSession(
    Close func(),
)

// Backend is the terminal seam.
//
// `Read` fills `buf` and returns (bytes read, ok). `ok = false` means the
// input stream ended or failed, which the run loop treats as a quit — a
// closed stdin is not recoverable and spinning on it burns a core.
// `ReadAsync` is a separate operation rather than `Read` wrapped in a
// Future by the runtime, and that is forced by GALA's data-race checker
// rather than chosen: a closure crossing into a Future cannot capture the
// Backend, because a backend's read state is mutable and E0037 refuses to
// let it be shared. Each backend therefore builds its own Future, where it
// knows whether that is safe — the terminal reads from a file descriptor
// with nothing captured, while the test backend reads synchronously and
// returns an already-completed Future, which is both correct and exactly
// what a deterministic test wants.
// `Paint` puts a rendered frame on screen. It belongs to the backend
// rather than the runtime because "where does this buffer go" is the
// question that separates a full-screen app from an inline one: the
// full-screen backend homes the cursor absolutely and diffs against the
// previous frame, while the inline backend positions relative to wherever
// the shell prompt left the cursor. `prev` is the last frame painted, or
// nil to force a full repaint.
// `InsertBefore` puts lines into the scrollback above the viewport, where
// they survive the app. Like `Paint`, it belongs to the backend because
// only the backend knows what "above the viewport" is: an inline app owns a
// few rows below the prompt and can scroll text in above them, while a
// full-screen app on the alternate screen has no scrollback to insert into
// at all and discards them.
//
// It reports whether the lines went anywhere, which is not bookkeeping:
// `emitPrints` repaints after an insert that landed, because the lines were
// written over the viewport's rows on their way up. A backend that
// discarded them disturbed nothing, and the repaint would be
// `Buffer.DiffString(nil)` — every cell of the terminal, not the empty diff
// it might sound like — on every frame an app printed.
//
// A backend with nowhere to put them leaves the field out: the default
// drops the lines and reports `false`.
struct Backend(
    Name         string,
    Size         func() Tuple[int, int],
    Write        func(string),
    Read         func([]byte) Tuple[int, bool],
    ReadAsync    func() concurrent.Future[ReadResult],
    // Open acquires the terminal for a run. `mouse` selects the input
    // protocols — see `currentTermModes`.
    Open         func(bool) BackendSession,
    Paint        func(*Buffer, *Buffer),
    InsertBefore func(Array[string]) bool = (lines) => false,
    // Origin is where the viewport's top-left cell sits on the screen:
    // (0, 0) unless the backend's viewport starts elsewhere. Mouse events
    // arrive in SCREEN cells and hit regions are in buffer cells, so the run
    // loop shifts every mouse event by it.
    Origin       func() Tuple[int, int] = () => (0, 0),
    // CursorReport receives the terminal's answer to a cursor-position
    // query (`ESC[6n` → `ESC[row;colR`, 1-based) the backend wrote. The run
    // loop takes the reply out of the input stream before it can be read as
    // a key. A backend that never asks has nothing to receive and leaves the
    // field out.
    CursorReport func(int, int) = (row, col) => {},
)

// ----------------------------------------------------------------------------
// The real terminal
// ----------------------------------------------------------------------------

// TerminalBackend is the default: raw mode on stdin, ANSI to stdout, size
// probed from whichever of the three standard fds is a tty.
func TerminalBackend() Backend {
    var shown = false
    var shape = 0
    return Backend(
        Name  = "terminal",
        Size  = () => TermSize(),
        Write = (s) => stdoutWrite(s),
        Read  = (buf) => stdinRead(buf),
        ReadAsync = () => terminalReadFuture(),
        Open  = (mouse) => withCursorShapeReset(terminalOpen(mouse), () => shape),
        Paint = (frame, prev) => {
            stdoutWrite(terminalPaintString(frame, prev, shown, shape))
            shown = frame.Cursor().IsDefined()
            if shown { shape = frame.cursorShape }
        },
        // InsertBefore keeps its default: the alternate screen has no
        // scrollback to insert into.
    )
}

// terminalPaintString is what one full-screen paint writes: the whole frame
// on the first paint, the cells that changed after that, then the cursor —
// as one synchronized update. `shape` is the cursor shape the terminal was
// last told.
func terminalPaintString(frame *Buffer, prev *Buffer, shown bool, shape int = 0) string {
    val body = if (prev == nil) ansiHome + frame.String() else frame.DiffString(prev)
    return synchronized(body + cursorTail(frame, prev, body, shown, 0, 0, shape))
}

// cursorShapeChange tells the terminal the frame's cursor shape when it is
// not `shape`, the one it was last told — and nothing when it is, so a
// steady caret does not re-send its shape every tick.
func cursorShapeChange(frame *Buffer, shape int) string =
    if (frame.cursorShape == shape) "" else ansiCursorShape(frame.cursorShape)

// withCursorShapeReset hands the terminal its own cursor shape back when the
// session closes, if the app ever changed it (`shape()` is the last shape
// sent). The shape is the terminal's, not the screen's: left as a bar, the
// shell's prompt would inherit it.
func withCursorShapeReset(session BackendSession, shape func() int) BackendSession =
    BackendSession(Close = () => {
        stdoutWrite(cursorShapeReset(shape()))
        session.Close()
    })

// cursorShapeReset is what closing writes when the last shape sent was
// `shape`: the terminal's own shape back, or nothing if it never changed.
func cursorShapeReset(shape int) string = if (shape != 0) ansiCursorShape(0) else ""

// cursorTail follows a paint to leave the real terminal cursor where the
// frame asked, in screen cells offset by (ox, oy):
//
//   - asked for: placed and shown — after any paint that wrote something,
//     since drawing moved the cursor, and whenever it moved, changed shape
//     or was hidden. An idle paint with the cursor already there sends
//     nothing: a move per tick restarts the blink on terminals that tie
//     blinking to movement.
//   - not asked for: hidden once, when the last frame had it showing.
//
// `shape` is the cursor shape the terminal was last told.
func cursorTail(
    frame *Buffer,
    prev *Buffer,
    painted string,
    shown bool,
    ox int,
    oy int,
    shape int = 0,
) string =
    frame.Cursor() match {
        case Some(p) =>
            if (painted == "" && shown && prev != nil && cursorAt(prev, p) && frame.cursorShape == shape) ""
            else ansiMoveTo(oy + p.V2 + 1, ox + p.V1 + 1) + cursorShapeChange(frame, shape) + ansiCursorShow
        case None() => if (shown) ansiCursorHide else ""
    }

// sameCursor is whether two frames asked for the same cursor — place and
// shape — or both for none.
func sameCursor(a *Buffer, b *Buffer) bool = a.Cursor() match {
    case Some(p) => cursorAt(b, p) && a.cursorShape == b.cursorShape
    case None()  => b.Cursor().IsEmpty()
}

// cursorAt is whether `frame` asked for the cursor at `p`.
func cursorAt(frame *Buffer, p Tuple[int, int]) bool = frame.Cursor() match {
    case Some(q) => q.V1 == p.V1 && q.V2 == p.V2
    case None()  => false
}

// stdoutWrite / stdinRead are the real terminal's byte I/O, shared by every
// backend that talks to it. A read error ends the input stream: a closed
// stdin is not recoverable, and spinning on it burns a core.
func stdoutWrite(s string) {
    fmt.Fprint(os.Stdout, s)
}

func stdinRead(buf []byte) Tuple[int, bool] {
    var n, err = os.Stdin.Read(buf)
    if err != nil {
        return (0, false)
    }
    return (n, true)
}

// terminalOpen puts the terminal into raw mode and enters the alternate
// screen, returning the session that undoes both.
//
// A failure to enter raw mode is NOT fatal here. It means stdin is not a
// tty — a piped or redirected run — and the caller's degraded path handles
// that; the session it gets back is a no-op so `Close` stays safe to call.
func terminalOpen(mouse bool) BackendSession {
    val fd = int(os.Stdin.Fd())
    var state, err = term.MakeRaw(fd)
    if err != nil {
        return BackendSession(Close = () => {})
    }
    val session = enterTermSession(fd, state, mouse)
    return BackendSession(Close = () => {
        FromError(session.Close())
    })
}

// ----------------------------------------------------------------------------
// Test backend
// ----------------------------------------------------------------------------

// TestBackendState is the recorded side of a scripted run: every byte the
// runtime wrote, and how much of the scripted input it has consumed.
type TestBackendState struct {
    var Written string
    var Input   []byte
    var Pos     int
    var Opened  int
    var Closed  int
    // The real cursor the last painted frame asked for, in its own cells.
    var CursorShown bool
    var CursorX     int
    var CursorY     int
}

// testBackendRecordCursor keeps the cursor the frame asked for, so a run-loop
// test can assert where the real cursor ended up.
func testBackendRecordCursor(st *TestBackendState, frame *Buffer) {
    frame.Cursor() match {
        case Some(p) => {
            st.CursorShown = true
            st.CursorX = p.V1
            st.CursorY = p.V2
        }
        case None() => {
            st.CursorShown = false
        }
    }
}

// NewTestBackend builds a Backend that reads from `input`, records
// everything written, and reports a fixed size.
//
// This is what makes the run loop testable: a test can hand it a byte
// sequence — an escape sequence split across two reads, a bracketed paste
// with no closer, a mouse packet racing a keypress — and assert on what the
// program did with it. Those are exactly the cases the widget harness
// cannot reach, and exactly where this library's input bugs have been.
//
// `Read` returns `ok = false` once the script is exhausted, which the run
// loop treats as end of input, so a scripted run terminates on its own
// rather than needing a Quit message in every fixture.
func NewTestBackend(width int, height int, input string) Tuple[Backend, *TestBackendState] {
    val st = &TestBackendState{
        Written: "",
        Input:   ToBytes(input),
        Pos:     0,
        Opened:  0,
        Closed:  0,
    }
    val b = Backend(
        Name  = "test",
        Size  = () => (width, height),
        Write = (s) => {
            st.Written = st.Written + s
        },
        Read  = (buf) => testBackendRead(st, buf),
        ReadAsync = () => {
            val buf = SliceWithSize[byte](readBufBytes)
            val (n, ok) = testBackendRead(st, buf)
            if !ok {
                return concurrent.FutureOf[ReadResult](ReadResult(Buf = buf, N = 0, Err = true))
            }
            return concurrent.FutureOf[ReadResult](ReadResult(Buf = buf, N = n, Err = false))
        },
        Open  = (mouse) => {
            st.Opened = st.Opened + 1
            return BackendSession(Close = () => {
                st.Closed = st.Closed + 1
            })
        },
        Paint = (frame, prev) => {
            st.Written = st.Written + frame.String()
            testBackendRecordCursor(st, frame)
        },
        // Recorded verbatim, in order, into the same stream as the frames,
        // so a test can assert both that a line was printed and that it was
        // printed before the frame that followed it.
        InsertBefore = (lines) => testBackendInsertBefore(st, lines),
    )
    return (b, st)
}

// Wrote reports whether the run emitted `needle` at any point. Enough for
// the questions a run-loop test actually asks — "did it paint", "did it
// enable bracketed paste", "did it restore the cursor" — without pinning
// the exact byte stream, which would make every test brittle to an
// unrelated escape-sequence change.
func (s *TestBackendState) Wrote(needle string) bool =
    strings.Contains(s.Written, needle)

// closeOnExit adapts a BackendSession to the `Close() error` shape a `use`
// binding requires, so the runtime releases the terminal on every exit path
// — normal return, an early return from inside the read loop, or a panic.
struct backendGuard(Session BackendSession)

func (g backendGuard) Close() error {
    g.Session.Close()
    return nil
}

func closeOnExit(s BackendSession) backendGuard = backendGuard(Session = s)


// testBackendInsertBefore records scrollback lines verbatim, in order, into
// the same stream as the frames — so a test can assert both that a line was
// printed and that it was printed before the frame that followed it.
func testBackendInsertBefore(st *TestBackendState, lines Array[string]) bool {
    lines.ForEach((line) => {
        st.Written = st.Written + line + "\n"
    })
    return true
}

// copyBytes writes the head of `src` into `dst` and returns how many bytes
// that was: Go's `copy`, which GALA does not expose (it points at
// `SliceCopy`, which allocates a new slice instead of filling the reader's
// buffer). With no primitive to call, this is the one byte loop the test
// backends share.
func copyBytes(dst []byte, src []byte) int {
    val n = MinInt(dst.Size(), src.Size())
    var i = 0
    for i < n {
        dst[i] = src[i]
        i = i + 1
    }
    return n
}

// testBackendRead copies the next chunk of the script into `buf`, returning
// (bytes, ok). `ok = false` once the script is exhausted, which the run loop
// reads as end of input — so a scripted run terminates on its own instead of
// needing a Quit message in every fixture.
func testBackendRead(st *TestBackendState, buf []byte) Tuple[int, bool] {
    val avail = st.Input.Size() - st.Pos
    if avail <= 0 {
        return (0, false)
    }
    val n = copyBytes(buf, SliceFrom(st.Input, st.Pos))
    st.Pos = st.Pos + n
    return (n, true)
}

// terminalReadFuture is the real backend's async read: a blocking stdin read
// on a pooled goroutine. It captures nothing, which is what lets it cross
// the concurrency boundary at all.
func terminalReadFuture() concurrent.Future[ReadResult] {
    return concurrent.Future[ReadResult](() => {
        var buf = SliceWithSize[byte](readBufBytes)
        var n, err = os.Stdin.Read(buf)
        if err != nil {
            return ReadResult(Buf = buf, N = 0, Err = true)
        }
        return ReadResult(Buf = buf, N = n, Err = false)
    })
}

// NewTestBackendChunks is `NewTestBackend` with the input pre-split into
// reads: each `Read` returns exactly one chunk.
//
// This is how a test reproduces a sequence torn across two stdin reads,
// which is the case the carry buffer exists for and the one a single string
// cannot express — a whole script handed over at once always arrives in one
// read, so `ESC [` and the keystroke after it become indistinguishable from
// a single CSI sequence.
func NewTestBackendChunks(
    width int,
    height int,
    chunks Array[string],
) Tuple[Backend, *TestBackendState] {
    val st = &TestBackendState{
        Written: "",
        Input:   ToBytes(""),
        Pos:     0,
        Opened:  0,
        Closed:  0,
    }
    val queue = &chunkQueue{Chunks: chunks, Idx: 0}
    val read = (buf []byte) => {
        if queue.Idx >= queue.Chunks.Length() {
            return (0, false)
        }
        val chunk = ToBytes(queue.Chunks.Get(queue.Idx))
        queue.Idx = queue.Idx + 1
        return (copyBytes(buf, chunk), true)
    }
    val b = Backend(
        Name  = "test-chunks",
        Size  = () => (width, height),
        Write = (s) => {
            st.Written = st.Written + s
        },
        Read  = read,
        ReadAsync = () => {
            val buf = SliceWithSize[byte](readBufBytes)
            val (n, ok) = read(buf)
            if !ok {
                return concurrent.FutureOf[ReadResult](ReadResult(Buf = buf, N = 0, Err = true))
            }
            return concurrent.FutureOf[ReadResult](ReadResult(Buf = buf, N = n, Err = false))
        },
        Open  = (mouse) => {
            st.Opened = st.Opened + 1
            return BackendSession(Close = () => {
                st.Closed = st.Closed + 1
            })
        },
        Paint = (frame, prev) => {
            st.Written = st.Written + frame.String()
            testBackendRecordCursor(st, frame)
        },
        // Recorded verbatim, in order, into the same stream as the frames,
        // so a test can assert both that a line was printed and that it was
        // printed before the frame that followed it.
        InsertBefore = (lines) => testBackendInsertBefore(st, lines),
    )
    return (b, st)
}

type chunkQueue struct {
    var Chunks Array[string]
    var Idx    int
}

// ----------------------------------------------------------------------------
// Inline viewport
// ----------------------------------------------------------------------------

// ansiCursorUp / ansiCursorDown move the cursor by whole rows. Inline
// rendering is entirely relative — it never knows, and must never assume,
// where on the screen the shell left the prompt.
func ansiCursorUp(n int) string   = if (n <= 0) "" else s"\x1b[${n}A"
func ansiCursorDown(n int) string = if (n <= 0) "" else s"\x1b[${n}B"
func ansiCursorForward(n int) string = if (n <= 0) "" else s"\x1b[${n}C"

// ansiClearLine erases the current row from the cursor to the end. Inline
// frames are repainted in place over whatever was there, and without this a
// row that shrinks leaves the tail of the previous frame behind.
func ansiClearLine() string = "\x1b[K"

// InlineBackend renders into `height` rows in the normal screen, directly
// below wherever the shell prompt sits, instead of taking over the terminal.
//
// This is the shape a CLI wants when the TUI is part of a command rather
// than the whole session: a progress view, a picker, a confirmation. The app
// draws, the user answers, the program exits and its output stays in the
// scrollback above — which is exactly what the alternate screen destroys,
// since leaving it wipes everything the app displayed.
//
// The viewport is relative throughout. `Open` scrolls `height` rows into
// existence and parks the cursor at the top of them; every paint returns
// there when it finishes; `Close` steps below the block so the shell's next
// prompt lands after the app's output rather than on top of it. Nothing
// here uses absolute positioning, so the app coexists with whatever is
// already on screen.
//
// Repaints are full rather than diffed. An inline viewport is a handful of
// rows, so the bandwidth argument that motivates diffing full-screen apps
// does not apply, and a diff expressed in relative moves is far easier to
// get wrong than it is to make fast.
func InlineBackend(height int) Backend {
    val h = MaxInt(1, height)
    // Whether the real cursor was left out in the block by the last paint.
    // Everything here positions relative to the block's top-left, so a paint
    // that shows the cursor saves that position first (DECSC), and anything
    // that writes next restores it (DECRC) before relying on it.
    var shown = false
    // Where the block is. Mouse events arrive in screen rows, so without the
    // block's top row every click missed unless the block happened to start
    // on the first row of the screen. The terminal is asked (`ESC[6n`) on the
    // first paint, after an insert, and when the terminal's size changes —
    // the three things that move the block — and never otherwise: a query
    // per tick would be a round trip per tick over SSH.
    //
    // `pending` counts queries not yet answered. Only an answer to one is
    // taken: xterm's Shift+F3 is the same bytes as a report, and must not
    // move the block. It is also what the exit waits on, so a late answer
    // does not land in the shell after raw mode is released.
    var top = -1
    var pending = 0
    var ask = true
    var lastTerm = (0, 0)
    var shape = 0
    val home = () => {
        val s = if (shown) ansiCursorHide + ansiCursorRestore else ""
        shown = false
        return s
    }
    return Backend(
        Name  = "inline",
        Size  = () => {
            val (w, _) = TermSize()
            return (w, h)
        },
        Write = (s) => stdoutWrite(s),
        Read  = (buf) => stdinRead(buf),
        ReadAsync = () => terminalReadFuture(),
        Open  = (mouse) => {
            val session = inlineOpen(h, mouse)
            return withCursorShapeReset(BackendSession(Close = () => {
                stdoutWrite(home())
                if pending > 0 { drainCursorReport() }
                session.Close()
            }), () => shape)
        },
        Paint = (frame, prev) => {
            val term = TermSize()
            if term != lastTerm {
                lastTerm = term
                ask = true
            }
            // An idle paint — same cells, same cursor — sends no frame: an
            // inline repaint is a full one, and hiding, redrawing and
            // re-showing the cursor every tick flickers it and restarts its
            // blink. A query that is due still goes out.
            val redraw = prev == nil || !frame.ContentsEqual(prev) || !sameCursor(frame, prev)
            val body = if (redraw) home() + inlineFrameString(frame, h) else ""
            val query = if (ask) ansiCursorQuery else ""
            if redraw || ask {
                stdoutWrite(synchronized(body + query + (if (redraw) inlineCursorString(frame, shape) else "")))
            }
            if ask { pending = pending + 1 }
            ask = false
            if redraw { shown = frame.Cursor().IsDefined() }
            if redraw && shown { shape = frame.cursorShape }
        },
        InsertBefore = (lines) => {
            stdoutWrite(synchronized(home() + inlineInsertBeforeString(lines, h)))
            ask = true
            return true
        },
        Origin = () => (0, MaxInt(0, top)),
        CursorReport = (row, col) => {
            if pending > 0 {
                pending = pending - 1
                top = row - 1
            }
        },
    )
}

// drainCursorReport waits briefly for an answer to a query still in flight at
// exit, so it is read here — in raw mode, and thrown away — rather than
// arriving after the terminal is handed back and printing `^[[17;1R` at the
// shell prompt. Bounded: a terminal that never answers costs this long once.
func drainCursorReport() {
    terminalReadFuture().AwaitFor(Milliseconds(150))
}

// inlineCursorString moves from the block's top-left — where every inline
// paint leaves the cursor — to the frame's cursor, saving the top-left on
// the way so the next write can come back to it. Nothing when the frame
// asked for no cursor. `shape` is the cursor shape the terminal was last
// told.
func inlineCursorString(frame *Buffer, shape int = 0) string = frame.Cursor() match {
    case Some(p) => ansiCursorSave + ansiCursorDown(p.V2) + "\r" +
                    ansiCursorForward(p.V1) + cursorShapeChange(frame, shape) + ansiCursorShow
    case None()  => ""
}

// inlineInsertBeforeString writes `lines` where the viewport's top row is,
// then re-reserves the viewport below them.
//
// The cursor sits at the top of the block between paints, so the lines go
// in exactly where the frame would have. Each one overwrites a viewport row
// and pushes the rest of the terminal's content up; once more lines have
// been written than the viewport is tall, the terminal is scrolling, which
// is what puts them in the scrollback. The viewport rows are then scrolled
// back into existence the same way `inlineEnterString` created them — by
// printing newlines, the only portable way to make a terminal scroll at the
// bottom of the screen — and the cursor returns to the top of the block.
//
// The block is blanked before any of that, which is not redundant with the
// per-line erase. `ESC[K` clears to the end of the row the cursor is on; a
// line wider than the terminal soft-wraps onto the *next* row, which is
// still showing the previous frame, and whose tail no erase would ever
// reach — the row has gone into the scrollback by the time the caller
// repaints. Blanking the rows the lines are about to land on fixes that
// without having to know how wide the terminal is or how many cells a line
// occupies, which for a line carrying its own SGR escapes is not a question
// `StringCellWidth` can answer. Rows past the block need no blanking: they
// arrive by scrolling, and a terminal scrolls in blank rows.
//
// Empty input returns "" rather than walking the viewport down `height`
// rows, so the guard lives here and callers cannot forget it.
//
// The rows it leaves are stale until the caller paints, which `emitPrints`
// does as the other half of the same operation — see its comment for why
// the pairing lives there and not in this string.
func inlineInsertBeforeString(lines Array[string], height int) string {
    if lines.IsEmpty() {
        return ""
    }
    var sb strings.Builder
    sb.WriteString(inlineBlankBlockString(height))
    lines.ForEach((line) => {
        sb.WriteString(line)
        // A line that set a colour and did not clear it would otherwise
        // paint every row after it: `ESC[K` erases with the *current*
        // background in every terminal that matters, so the blanking of the
        // next block would fill its whole width with this line's colour.
        sb.WriteString(ResetSgr)
        sb.WriteString("\r\n")
    })
    // No per-line erase: every row a line can land on is already blank —
    // the block's own rows were just cleared above, and rows past it arrive
    // by scrolling, which scrolls in blank rows.
    sb.WriteString(inlineReserveString(height))
    return sb.String()
}

// inlineBlankBlockString erases the viewport's rows and returns the cursor
// to the top of the block, leaving it where it started.
func inlineBlankBlockString(height int) string = inlineRowsString(height, (i) => "")

// inlineFrameString is one repaint: each row cleared and rewritten from
// column 0, then the cursor walked back to the top of the block so the next
// paint starts from the same place.
func inlineFrameString(frame *Buffer, height int) string {
    val rows = stringToLines(frame.String())
    return inlineRowsString(height, (i) => rows.GetOption(i).GetOrElse(""))
}

// inlineRowsString walks the block once, writing `rowText(i)` into each row
// over an erase, and leaves the cursor back at the top.
//
// The one place that knows the inline row protocol. A paint and a blanking
// pass differ only in what they put in the row, and when the insert path
// needed a trailing `ResetSgr` it was the paint path's loop it would have
// drifted from.
func inlineRowsString(height int, rowText func(int) string) string {
    val rows = ArrayTabulate(height, (i) => "\r" + ansiClearLine() + rowText(i))
    // Back to the top of the block, column 0.
    return rows.MkString("\r\n") + "\r" + ansiCursorUp(height - 1)
}

// inlineReserveString scrolls `height` rows into existence and parks the
// cursor on the first of them.
//
// Printing newlines is the only portable way to make a terminal scroll at
// the bottom of the screen, and stepping back up leaves the cursor at the
// top of a block that is now guaranteed to be on screen. Both the entry
// sequence and every insert need exactly this: one creates the viewport,
// the other puts it back after lines have pushed it up.
func inlineReserveString(height int) string =
    strings.Repeat("\r\n", MaxInt(0, height - 1)) + "\r" + ansiCursorUp(height - 1)

// inlineOpen takes raw mode and the input protocols but NOT the alternate
// screen, then reserves the viewport.
//
// Reserving is the subtle part: the rows have to be scrolled into existence
// before anything is drawn into them. Printing `height - 1` newlines makes
// the terminal scroll if the prompt was near the bottom, and stepping back
// up leaves the cursor at the top of a block that is now guaranteed to be
// on screen. Drawing first and scrolling later would push the top of the
// frame into the scrollback mid-render.
func inlineOpen(height int, mouse bool) BackendSession =
    openRawSession(mouse,
        (modesOn) => inlineEnterString(height, modesOn),
        (modesOff) => inlineExitString(height, modesOff))

// openRawSession takes raw mode and the input modes on the NORMAL screen —
// what every backend but the full-screen one wants — writing `enter` once
// the modes are known and `exit` when the session closes. A failure to enter
// raw mode means stdin is not a tty, and the session is a no-op.
func openRawSession(
    mouse bool,
    enter func(string) string,
    exit func(string) string,
) BackendSession {
    val fd = int(os.Stdin.Fd())
    var state, err = term.MakeRaw(fd)
    if err != nil {
        return BackendSession(Close = () => {})
    }
    val modes = currentTermModes(mouse)
    val modesOff = termModesOff(modes)
    installCleanupGuard(fd, state, modesOff)
    if mouse {
        EnableVTInput()
    }
    stdoutWrite(enter(termModesOn(modes)))
    return BackendSession(Close = () => {
        stdoutWrite(exit(modesOff))
        FromError(term.Restore(fd, state))
    })
}

// inlineEnterString reserves the viewport: hide the cursor, turn on the
// input modes, scroll `height` rows into existence, and come back to the
// first of them.
//
// The scroll has to happen BEFORE anything is drawn. If the prompt sits near
// the bottom of the screen, printing the newlines is what makes the terminal
// scroll; drawing first and scrolling later would push the top of the frame
// into the scrollback mid-render.
func inlineEnterString(height int, modesOn string) string =
    ansiCursorHide + modesOn + inlineReserveString(height)

// inlineExitString releases it: step past the block so the shell's next
// prompt lands BELOW the app's final frame rather than overwriting it, then
// undo the modes and show the cursor.
//
// Leaving the frame on screen is the whole point of an inline viewport —
// the alternate screen would erase it on exit, which is exactly what a
// command whose output should survive must not do.
func inlineExitString(height int, modesOff string) string {
    var sb strings.Builder
    sb.WriteString("\r")
    sb.WriteString(ansiCursorDown(height - 1))
    sb.WriteString("\r\n")
    sb.WriteString(modesOff)
    sb.WriteString(ansiCursorShow)
    return sb.String()
}

// ----------------------------------------------------------------------------
// Fixed viewport
// ----------------------------------------------------------------------------

// FixedBackend renders into a fixed rectangle of the normal screen. The
// app owns `area` and nothing else: the terminal around it keeps whatever
// the shell or another program drew there, and on exit the frame stays
// where it was drawn.
//
// It is the shape for a TUI that is one panel of a larger screen — a status
// strip pinned to the top rows, a pane beside output another process owns.
// Unlike `InlineBackend`, whose rows follow the prompt, the rectangle is in
// absolute screen cells.
//
// What sharing the screen asks of it:
//
//   - Every paint saves and restores the cursor (DECSC / DECRC), so text
//     another process writes next still lands where that process left it,
//     not wherever the last diff run ended inside the panel.
//   - A terminal resize forces a full repaint even when the clipped
//     rectangle is the same size: the normal screen reflows or scrolls on
//     a resize, and the cells a diff would not touch are the damaged ones.
//   - A rectangle, or the part of one, off the screen is not drawn — the
//     terminal would clamp those moves onto a cell the app does not own.
//
// Mouse events are shifted into the rectangle through `Origin`, and events
// outside it are dropped by the run loop.
func FixedBackend(area Rect) Backend {
    val a = fixedArea(area)
    var lastTerm = (0, 0)
    var shown = false
    var shape = 0
    return Backend(
        Name  = "fixed",
        Size  = () => fixedSize(a, TermSize()),
        Write = (s) => stdoutWrite(s),
        Read  = (buf) => stdinRead(buf),
        ReadAsync = () => terminalReadFuture(),
        Open  = (mouse) => withCursorShapeReset(fixedOpen(a, mouse), () => shape),
        Paint = (frame, prev) => {
            val term = TermSize()
            val resized = term != lastTerm
            lastTerm = term
            stdoutWrite(synchronized(fixedPaintString(frame, if (resized) nil else prev, a, term, shown, shape)))
            // An off-screen paint drew nothing — hid nothing — so it must not
            // record a cursor state the terminal never saw.
            if !fixedOffScreen(a, term) {
                shown = frame.Cursor().IsDefined()
                if shown { shape = frame.cursorShape }
            }
        },
        Origin = () => (a.X, a.Y),
        // InsertBefore keeps its default: the rows above a fixed rectangle
        // belong to someone else.
    )
}

// fixedArea clips the rectangle at the top and left edges of the screen: a
// negative origin would put malformed `ESC[row;-1H` moves on the wire.
func fixedArea(area Rect) Rect {
    val x = MaxInt(0, area.X)
    val y = MaxInt(0, area.Y)
    return Rect(X = x, Y = y,
                Width = MaxInt(0, area.Width - (x - area.X)),
                Height = MaxInt(0, area.Height - (y - area.Y)))
}

// fixedSize is the rectangle clipped to a terminal of `term` cells, at least
// one cell each way so the app always has a frame to render into — an
// off-screen rectangle renders it and `fixedPaintString` draws none of it.
func fixedSize(area Rect, term Tuple[int, int]) Tuple[int, int] =
    (MaxInt(1, MinInt(area.Width, term.V1 - area.X)),
     MaxInt(1, MinInt(area.Height, term.V2 - area.Y)))

// fixedPaintString is one paint: nothing when the rectangle is off the
// screen, otherwise the diff offset to the rectangle.
//
// The terminal has one saved-cursor slot, and the other program's cursor
// lives in it for as long as the app is not holding the cursor. So:
//
//   - not holding, still not: save, draw, restore — the other program's
//     cursor is exactly where it was.
//   - starts holding (a field is focused): save it once, draw, move to the
//     field. While the app holds the cursor an IME has to find it in the
//     field, which means the other program's next output lands there too —
//     the price of typing into a panel on a shared screen.
//   - keeps holding: draw and re-place, never saving again — a second save
//     would overwrite the other program's position with the field's.
//   - lets go: draw, restore the other program's cursor, hide.
func fixedPaintString(
    frame *Buffer,
    prev *Buffer,
    area Rect,
    term Tuple[int, int],
    shown bool,
    shape int = 0,
) string {
    if fixedOffScreen(area, term) { return "" }
    val diff = frame.DiffStringAt(prev, area.X, area.Y)
    val asking = frame.Cursor().IsDefined()
    val tail = cursorTail(frame, prev, diff, shown, area.X, area.Y, shape)
    return if (asking && !shown) ansiCursorSave + diff + tail
    else if (asking) diff + tail
    else if (shown) diff + ansiCursorRestore + tail
    else if (diff == "") ""
    else ansiCursorSave + diff + ansiCursorRestore
}

func fixedOffScreen(area Rect, term Tuple[int, int]) bool =
    area.X >= term.V1 || area.Y >= term.V2 || area.Width <= 0 || area.Height <= 0

// fixedOpen takes raw mode and the input modes without the alternate screen:
// the screen around the rectangle is not the app's to hide.
func fixedOpen(area Rect, mouse bool) BackendSession =
    openRawSession(mouse,
        (modesOn) => ansiCursorHide + modesOn,
        (modesOff) => fixedExitString(area, TermSize(), modesOff))

// fixedExitString leaves the cursor on the line below the rectangle, so the
// shell's next prompt does not land on top of the app's last frame. When the
// rectangle reaches the bottom of the screen there is no line below: the
// cursor goes to the last row and a newline scrolls one into existence.
func fixedExitString(area Rect, term Tuple[int, int], modesOff string) string {
    val below = area.Y + MinInt(area.Height, term.V2 - area.Y)
    val move = if (below < term.V2) ansiMoveTo(below + 1, 1)
               else ansiMoveTo(term.V2, 1) + "\r\n"
    return ResetSgr + move + modesOff + ansiCursorShow
}
