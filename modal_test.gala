package gala_tui

import (
    "strings"
    . "martianoff/gala/collection_immutable"
    . "martianoff/gala/test"
)

// ============================================================================
// Modal / dialog rendering tests.
// ============================================================================

func TestModalHasDimBackdrop(t T) T {
    val buf = NewBuffer(20, 10)
    RenderTo(Modal(10, 4, Text("hi")),
        Rect(X = 0, Y = 0, Width = 20, Height = 10), buf)
    // Top-left corner is backdrop (not masked by panel).
    return IsTrue(t, buf.Get(0, 0).St.Dim)
}

func TestModalCentersPanelHorizontally(t T) T {
    val buf = NewBuffer(20, 6)
    RenderTo(Modal(10, 4, Text("hi")),
        Rect(X = 0, Y = 0, Width = 20, Height = 6), buf)
    // Panel is 10 wide in a 20-wide area → starts at col 5.
    return Eq(t, buf.Get(5, 1).Ch, '┌')
}

func TestConfirmDialogRendersBothButtons(t T) T {
    val buf = NewBuffer(40, 6)
    RenderTo(ConfirmDialog("Confirm", "Proceed?", true),
        Rect(X = 0, Y = 0, Width = 40, Height = 6), buf)
    val combined = allRows(buf)
    val t1 = IsTrue(t, strings.Contains(combined, "Yes"))
    return IsTrue(t1, strings.Contains(combined, "No"))
}

func TestAlertDialogRendersOK(t T) T {
    val buf = NewBuffer(30, 6)
    RenderTo(AlertDialog("Heads up", "All good."),
        Rect(X = 0, Y = 0, Width = 30, Height = 6), buf)
    val combined = allRows(buf)
    return IsTrue(t, strings.Contains(combined, "OK"))
}

// ----------------------------------------------------------------------------
// ModalOver
// ----------------------------------------------------------------------------

// The defect ModalOver exists for: `Modal`'s backdrop is a fill of spaces, so
// stacking it over the screen — the composition the docs showed — erased the
// context the dialog was asking about, and the dialog floated on black.
func TestModalOverKeepsTheScreenBehindIt(t T) T {
    val below = Text("context that must survive")
    val w = ModalOver(below, 10, 3, Text("hi"))
    val buf = NewBuffer(40, 11)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 40, Height = 11), buf)
    // Row 0 is well clear of a 3-row panel centred in 11 rows.
    return Eq(t, strings.TrimSpace(RowText(buf, 0)), "context that must survive")
}

func TestModalOverDimsWhatItCovers(t T) T {
    val w = ModalOver(Text("behind"), 10, 3, Text("hi"))
    val buf = NewBuffer(40, 11)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 40, Height = 11), buf)
    return Eq(t, buf.Get(0, 0).St.Dim, true)
}

// Dimming leaves the layer beneath visible, so the panel needs its own floor:
// without one, the screen shows through the gaps between the dialog's lines.
func TestModalOverPanelIsOpaque(t T) T {
    val w = ModalOver(FillCh('x'), 20, 5, Text("hi"))
    val buf = NewBuffer(40, 11)
    RenderTo(w, Rect(X = 0, Y = 0, Width = 40, Height = 11), buf)
    // Inside the panel, below the body's single line of text: the backdrop
    // must not show through.
    val t1 = Eq(t, buf.Get(20, 6).Ch, ' ')
    // …while outside it the layer beneath is still there.
    return Eq(t1, buf.Get(0, 0).Ch, 'x')
}

// Modal still erases, deliberately — it has nothing to dim.
func TestModalWithoutALayerBeneathStillFills(t T) T {
    val buf = NewBuffer(40, 11)
    RenderTo(Stack(ArrayOf[Widget](Text("gone"), Modal(10, 3, Text("hi")))),
        Rect(X = 0, Y = 0, Width = 40, Height = 11), buf)
    return Eq(t, strings.TrimSpace(RowText(buf, 0)), "")
}
